<section class="notae-auth-page">
  <div class="notae-auth-brand">
    <%= image_tag notae_auth_brand_icon_path, alt: "Notae icon", class: "notae-auth-brand-icon" %>
    <div>
      <h1>Notae</h1>
      <p>Create your account to start a workspace.</p>
    </div>
  </div>

  <section class="notae-auth-card">
    <h2>Create account</h2>

    <% if resource.errors.any? %>
      <p class="notae-flash alert"><%= resource.errors.full_messages.to_sentence %></p>
    <% end %>

    <ol class="notae-onboarding-progress" aria-label="Onboarding progress">
      <li class="is-current">
        <span>1</span>
        <strong>Account</strong>
      </li>
      <li>
        <span>2</span>
        <strong>Email confirmation</strong>
      </li>
      <li>
        <span>3</span>
        <strong>Workspace & trial</strong>
      </li>
    </ol>

    <%= form_for(resource,
                 as: resource_name,
                 url: registration_path(resource_name),
                 html: {
                   class: "notae-auth-form",
                   data: {
                     controller: "auth-submit",
                     action: "submit->auth-submit#submit",
                     turbo: false,
                     auth_submit_busy_text_value: "Creating account...",
                     auth_submit_status_text_value: "Creating your account and preparing the next onboarding step."
                   }
                 }) do |form| %>
      <div class="notae-auth-field">
        <%= form.label :email %>
        <%= form.email_field :email, autofocus: true, autocomplete: "email", class: "notae-auth-input" %>
      </div>

      <div aria-hidden="true" style="position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden;">
        <%= form.label :website, "Website" %>
        <%= form.text_field :website, tabindex: -1, autocomplete: "off" %>
      </div>
      <%= form.hidden_field :plan, value: session[:notae_signup_plan] if session[:notae_signup_plan].present? %>

      <div class="notae-auth-field">
        <%= form.label :password %>
        <%= form.password_field :password, autocomplete: "new-password", class: "notae-auth-input" %>
        <% if @minimum_password_length %>
          <small class="notae-page-subtle">Minimum <%= @minimum_password_length %> characters.</small>
        <% end %>
      </div>

      <div class="notae-auth-field">
        <%= form.label :password_confirmation %>
        <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "notae-auth-input" %>
      </div>

      <div class="notae-auth-submit-zone">
        <%= form.submit "Create account",
                        class: "notae-chip-button notae-auth-submit",
                        data: { auth_submit_target: "submit" } %>
        <div class="notae-auth-submit-progress" data-auth-submit-target="progress" hidden>
          <span class="notae-auth-submit-spinner" aria-hidden="true"></span>
          <div>
            <strong data-auth-submit-target="status">Creating your account. This can take a moment.</strong>
            <span>Keep this tab open. We will move you to the next step as soon as the account is ready.</span>
          </div>
        </div>
      </div>
    <% end %>

    <div class="notae-auth-links">
      <%= link_to "Already have an account?", new_session_path(resource_name) %>
      <% if devise_mapping.recoverable? %>
        <%= link_to "Forgot your password?", new_password_path(resource_name) %>
      <% end %>
    </div>
  </section>
</section>
