<% content_for :title, @database.name %>

<section class="mx-auto max-w-6xl space-y-6 px-4 py-8">
  <header class="space-y-2 border-b border-stone-200 pb-4">
    <p class="text-xs uppercase tracking-wide text-stone-500">Shared grid</p>
    <h1 class="break-words text-3xl font-semibold text-stone-900">
      <%= render_notae_icon(@database.icon, workspace: @workspace, fallback: "🗃️", css_class: "notae-inline-linked-icon", label: @database.name) %>
      <%= @database.name %>
    </h1>
    <p class="text-sm text-stone-500">Shared from <%= @workspace.name %></p>
    <% if @database.description.present? %>
      <p class="text-sm text-stone-600"><%= @database.description %></p>
    <% end %>
  </header>

  <%= render "shared/read_only_notice",
             label: "Read-only share",
             message: "This shared grid is view-only here. Open Notae with edit access to change rows, properties, or views." %>

  <section class="overflow-x-auto rounded-lg border border-stone-200 bg-white">
    <table class="min-w-full border-collapse text-sm">
      <thead>
        <tr class="bg-stone-50">
          <th class="border-b border-stone-200 px-3 py-2 text-left font-semibold text-stone-700">Name</th>
          <% @visible_properties.each do |property| %>
            <th class="border-b border-stone-200 px-3 py-2 text-left font-semibold text-stone-700"><%= property.name %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% if @rows.any? %>
          <% @rows.each do |row| %>
            <tr>
              <td class="border-b border-stone-100 px-3 py-2 text-stone-800"><%= row.title.presence || "Untitled row" %></td>
              <% @visible_properties.each do |property| %>
                <% cell = @cells[[row.id, property.id]] %>
                <td class="border-b border-stone-100 px-3 py-2 text-stone-700"><%= cell&.value_text.to_s.presence || "—" %></td>
              <% end %>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="<%= @visible_properties.size + 1 %>" class="px-3 py-6 text-center text-stone-500">No rows in this grid.</td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </section>
</section>
