<% content_for :title, @page.title %>

<section class="mx-auto max-w-4xl space-y-6 px-4 py-8">
  <header class="space-y-2 border-b border-stone-200 pb-4">
    <p class="text-xs uppercase tracking-wide text-stone-500">Shared page</p>
    <h1 class="break-words text-3xl font-semibold text-stone-900"><%= @page.title %></h1>
    <p class="text-sm text-stone-500">Shared from <%= @workspace.name %></p>
  </header>

  <% public_share_notice_message =
       if @share_link.edit?
         "This link was created with edit access. This public preview is view-only; open Notae to change content or add comments."
       elsif @share_link.comment?
         "This link was created with comment access. This public preview is view-only; open Notae to add comments."
       else
         "This shared page is view-only here. Open Notae with edit access to change content or add comments."
       end %>
  <%= render "shared/read_only_notice",
             label: "#{@share_link.access_level_label} share",
             message: public_share_notice_message %>

  <section class="space-y-3">
    <%= render partial: "public/pages/block_tree",
               locals: {
                 blocks_by_parent: @blocks_by_parent,
                 parent_id: nil
               } %>
  </section>
</section>
