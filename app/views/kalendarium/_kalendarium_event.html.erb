<% calendar_options = (Array(local_assigns[:calendars]) + [event.kalendarium_calendar]).compact.uniq(&:id) %>
<% project_options = (Array(local_assigns[:projects]) + [event.kalendarium_project]).compact.uniq(&:id) %>
<% timeline = local_assigns.fetch(:timeline, false) %>
<% timeline_style = local_assigns[:timeline_style] %>
<% timeline_start_minutes = local_assigns[:timeline_start_minutes] %>
<% timeline_end_minutes = local_assigns[:timeline_end_minutes] %>
<% compact = local_assigns.fetch(:compact, false) %>
<% all_day_badge = local_assigns.fetch(:all_day, event.all_day?) %>
<% starts_local = event.starts_at_utc.in_time_zone(current_user.time_zone) %>
<% ends_local = event.ends_at_utc.in_time_zone(current_user.time_zone) %>
<% invitees = event.invitees %>
<% invitee_labels = invitees.map { |invitee| invitee["name"].presence || invitee["email"] }.compact %>
<% invitee_preview = invitee_labels.first(3).join(", ") %>
<% invitee_extra_count = [invitee_labels.length - 3, 0].max %>
<% meeting_join_url = event.meeting_join_url %>
<% event_color = event.kalendarium_project&.color_hex.presence || event.kalendarium_calendar.color_hex %>
<% event_workspace_slug = event.workspace.slug %>

<article id="kalendarium_event_<%= event.id %>"
         class="notae-kalendarium-event-card <%= "is-timeline" if timeline %> <%= "is-compact" if compact %> <%= "is-all-day" if all_day_badge %>"
         style="--kal-color: <%= event_color %>;<%= " #{timeline_style}" if timeline_style.present? %>"
         data-start-minutes="<%= timeline_start_minutes if timeline %>"
         data-end-minutes="<%= timeline_end_minutes if timeline %>"
         data-controller="kalendarium-event-modal"
         data-kalendarium-event-modal-event-title-value="<%= event.title %>"
         data-action="click->kalendarium-event-modal#openView keydown.enter->kalendarium-event-modal#openView keydown.space->kalendarium-event-modal#openView"
         role="button"
         tabindex="0"
         aria-label="View event details for <%= event.title %>">
  <% if compact %>
    <header class="notae-kalendarium-event-header-compact">
      <strong><%= event.title %></strong>
    </header>
    <p class="notae-kalendarium-event-time-line"><%= all_day_badge ? "All day" : "#{starts_local.strftime("%H:%M")} - #{ends_local.strftime("%H:%M")}" %></p>
    <% if meeting_join_url.present? %>
      <div class="notae-kalendarium-event-links is-compact">
        <%= link_to "Join meeting", meeting_join_url, class: "notae-utility-link", target: "_blank", rel: "noopener noreferrer" %>
      </div>
    <% end %>
  <% else %>
    <header>
      <strong><%= event.title %></strong>
      <div class="notae-kalendarium-event-header-actions">
        <span><%= all_day_badge ? "All day" : "#{starts_local.strftime("%H:%M")} - #{ends_local.strftime("%H:%M")}" %></span>
        <button type="button"
                class="notae-inline-icon-button notae-kalendarium-event-edit-button"
                aria-label="Edit event"
                data-action="kalendarium-event-modal#openEdit">✎</button>
      </div>
    </header>
  <% end %>

  <% if !compact && event.location.present? %>
    <p><%= event.location %></p>
  <% end %>
  <% if !compact && event.description.present? %>
    <p><%= truncate(event.description, length: 120) %></p>
  <% end %>

  <% if !compact && invitee_labels.any? %>
    <p class="notae-kalendarium-event-meta">
      Invitees:
      <%= invitee_preview %><%= invitee_extra_count.positive? ? " +#{invitee_extra_count}" : "" %>
    </p>
  <% end %>

  <% if !compact && (event.linked_page.present? || meeting_join_url.present?) %>
    <div class="notae-kalendarium-event-links">
      <% if meeting_join_url.present? %>
        <%= link_to "Join meeting", meeting_join_url, class: "notae-utility-link", target: "_blank", rel: "noopener noreferrer" %>
      <% end %>
        <% if event.linked_page.present? %>
          <%= link_to "📄 Nota", page_path(workspace_slug: event_workspace_slug, id: event.linked_page_id), class: "notae-utility-link" %>
        <% end %>
    </div>
  <% end %>

  <dialog class="notae-danger-modal notae-kalendarium-event-modal"
          data-kalendarium-event-modal-target="dialog"
          data-action="click->kalendarium-event-modal#backdropClose">
    <div class="notae-danger-modal-panel notae-kalendarium-event-modal-panel">
      <div class="notae-danger-modal-header">
        <div class="notae-kalendarium-event-modal-title">
          <p class="notae-page-subtle">Event details</p>
          <h3 data-kalendarium-event-modal-target="heading"><%= event.title %></h3>
        </div>
        <button type="button"
                class="notae-inline-icon-button"
                aria-label="Close edit event dialog"
                data-action="kalendarium-event-modal#close">✕</button>
      </div>

      <section class="notae-kalendarium-event-view" data-kalendarium-event-modal-target="viewPanel">
        <dl class="notae-kalendarium-event-view-list">
          <div>
            <dt>When</dt>
            <dd>
              <% if event.all_day? %>
                <%= starts_local.to_date.strftime("%a %-d %b %Y") %> (all day)
              <% else %>
                <%= starts_local.strftime("%a %-d %b %Y %H:%M") %> - <%= ends_local.strftime("%H:%M") %>
              <% end %>
            </dd>
          </div>
          <div>
            <dt>Calendar</dt>
            <dd><%= event.kalendarium_calendar.name %></dd>
          </div>
          <% if event.kalendarium_project.present? %>
            <div>
              <dt>Project</dt>
              <dd><%= event.kalendarium_project.name %></dd>
            </div>
          <% end %>
          <% if event.location.present? %>
            <div>
              <dt>Location</dt>
              <dd><%= event.location %></dd>
            </div>
          <% end %>
          <% if event.description.present? %>
            <div>
              <dt>Description</dt>
              <dd><%= simple_format(h(event.description), {}, wrapper_tag: "div") %></dd>
            </div>
          <% end %>
          <% if invitee_labels.any? %>
            <div>
              <dt>Invitees</dt>
              <dd><%= invitee_labels.join(", ") %></dd>
            </div>
          <% end %>
          <% if meeting_join_url.present? %>
            <div>
              <dt>Meeting link</dt>
              <dd><%= link_to meeting_join_url, meeting_join_url, class: "notae-utility-link", target: "_blank", rel: "noopener noreferrer" %></dd>
            </div>
          <% end %>
          <% if event.meeting_capture_enabled? %>
            <div>
              <dt>Meet extension</dt>
              <dd>
                Enabled
                <% if event.latest_meeting_session.present? %>
                  · <%= link_to "Latest session", workspace_meetings_path(workspace_slug: event_workspace_slug), class: "notae-utility-link" %>
                <% end %>
              </dd>
            </div>
          <% end %>
          <div>
            <dt>Status</dt>
            <dd><%= event.status.titleize %></dd>
          </div>
        </dl>

        <% if event.linked_page.present? || meeting_join_url.present? %>
          <div class="notae-kalendarium-event-links notae-kalendarium-event-view-links">
            <% if meeting_join_url.present? %>
              <%= link_to "Join meeting", meeting_join_url, class: "notae-utility-link", target: "_blank", rel: "noopener noreferrer" %>
            <% end %>
            <% if event.linked_page.present? %>
              <%= link_to "Open linked Nota", page_path(workspace_slug: event_workspace_slug, id: event.linked_page_id), class: "notae-utility-link" %>
            <% end %>
          </div>
        <% end %>

        <div class="notae-danger-modal-actions">
          <button type="button" class="notae-chip-button" data-action="kalendarium-event-modal#close">Close</button>
          <button type="button" class="notae-chip-button" data-action="kalendarium-event-modal#openEdit">Edit</button>
        </div>
      </section>

      <section class="notae-kalendarium-event-edit" data-kalendarium-event-modal-target="editPanel" hidden>
        <%= form_with model: event,
                      url: kalendarium_event_path(workspace_slug: event_workspace_slug, id: event.id),
                      method: :patch,
                      class: "notae-kalendarium-event-modal-form",
                      data: { controller: "kalendarium-event-form" } do |form| %>
          <%= hidden_field_tag :view, view %>
          <%= hidden_field_tag :date, date %>
          <%= form.text_field :title, placeholder: "Event title", required: true, class: "notae-auth-input" %>
          <%= form.select :kalendarium_calendar_id,
                          options_from_collection_for_select(calendar_options, :id, :name, event.kalendarium_calendar_id),
                          {},
                          class: "notae-auth-input" %>
          <%= form.select :kalendarium_project_id,
                          options_for_select([["No project", ""]] + project_options.map { |project| [project.name, project.id] }, event.kalendarium_project_id),
                          {},
                          class: "notae-auth-input" %>
          <%= form.datetime_local_field :starts_at_local,
                                        value: starts_local.strftime("%Y-%m-%dT%H:%M"),
                                        class: "notae-auth-input",
                                        data: {
                                          kalendarium_event_form_target: "startInput",
                                          action: "change->kalendarium-event-form#startChanged"
                                        } %>
          <%= form.datetime_local_field :ends_at_local,
                                        value: ends_local.strftime("%Y-%m-%dT%H:%M"),
                                        class: "notae-auth-input",
                                        data: {
                                          kalendarium_event_form_target: "endInput",
                                          action: "change->kalendarium-event-form#endChanged"
                                        } %>
          <label class="notae-options-checkbox">
            <%= form.check_box :all_day,
                               data: {
                                 kalendarium_event_form_target: "allDayInput",
                                 action: "change->kalendarium-event-form#toggleAllDay"
                               } %>
            <span>All day</span>
          </label>
          <label class="notae-options-checkbox">
            <%= form.check_box :meeting_capture_enabled %>
            <span>Prefer this event when the Google Meet extension starts a transcript</span>
          </label>
          <%= form.text_field :location, placeholder: "Location", class: "notae-auth-input" %>
          <%= form.text_area :description, rows: 3, placeholder: "Description", class: "notae-auth-input" %>
          <% if event.linked_page.present? %>
            <div class="notae-kalendarium-event-links">
              <%= link_to "Open linked Nota", page_path(workspace_slug: event_workspace_slug, id: event.linked_page_id), class: "notae-utility-link" %>
              <button type="submit"
                      name="kalendarium_event[linked_page_action]"
                      value="clear"
                      class="notae-chip-button">Unlink Nota</button>
            </div>
          <% else %>
            <button type="submit"
                    name="kalendarium_event[linked_page_action]"
                    value="create_page"
                    class="notae-chip-button">Create linked Nota</button>
          <% end %>
          <div class="notae-danger-modal-actions">
            <button type="button" class="notae-chip-button" data-action="kalendarium-event-modal#openView">Back</button>
            <button type="button" class="notae-chip-button" data-action="kalendarium-event-modal#close">Cancel</button>
            <%= form.submit "Save changes", class: "notae-chip-button" %>
          </div>
        <% end %>

        <div class="notae-kalendarium-event-modal-delete">
          <%= button_to "Delete event",
                        kalendarium_event_path(workspace_slug: event_workspace_slug, id: event.id, view: view, date: date),
                        method: :delete,
                        class: "notae-chip-button notae-chip-danger notae-kalendarium-event-delete-button",
                        form: {
                          class: "notae-kalendarium-event-delete-form",
                          data: { turbo_confirm: "Delete this event?" }
                        } %>
        </div>
      </section>
    </div>
  </dialog>
</article>
