<% content_for :title, "Kalendārium" %>
<% content_for :head do %>
  <meta name="turbo-cache-control" content="no-cache">
<% end %>
<% content_for :topbar_page_icon do %>
  <%= notae_icon_svg(:kalendarium, css_class: "notae-topbar-page-icon-glyph") %>
<% end %>
<% content_for :topbar_privacy, @workspace.name %>
<% widget_view = @widget_mode %>
<% requested_timeline_time_zone = Array(params[:tz]).map(&:to_s).reject(&:blank?).first %>
<% timeline_time_zone = requested_timeline_time_zone || current_user.time_zone %>
<% wide_planning_view = @wide_planning_view && !widget_view %>
<% content_for :content_class, ["notae-content-wide", "notae-content-kalendarium", ("notae-content-kalendarium-widget" if widget_view), ("notae-content-kalendarium-planning-wide" if wide_planning_view)].compact.join(" ") %>
<% content_for :topbar_actions do %>
  <%= link_to "Settings", workspace_kalendarium_settings_path(workspace_slug: @workspace.slug), class: "notae-chip-button" %>
<% end %>
<% project_scope_params = @scoped_project_id.present? ? { project_scope_id: @scoped_project_id } : {} %>
<% embedded_params = params[:embedded].to_s == "1" ? { embedded: "1" } : {} %>
<% widget_params = widget_view ? { widget: "1" } : {} %>
<% embedded_split_view = embedded_params[:embedded] == "1" && !widget_view %>
<% embedded_compact_view = embedded_split_view || widget_view %>
<% widget_view_options = [
     ["(1)", "day", "Day"],
     ["(7)", "week", "Week"],
     ["(7+)", "next_7_days", "Next 7 days"],
     ["(31)", "month", "Month"],
     ["(365)", "year", "Year"]
   ] %>
<% task_schedule_params = @task_schedule_row.present? ? { task_row_id: @task_schedule_row.id } : {} %>
<% window_start_value = params[:window_start].presence || (@view == "next_7_days" ? @next_seven_days_start.strftime("%Y-%m-%d") : nil) %>
<% window_start_params = window_start_value.present? ? { window_start: window_start_value } : {} %>
<% planning_params = wide_planning_view ? { planning: "wide" } : {} %>
<% kalendarium_controllers = ["kalendarium-focus", "kalendarium-preview"] %>
<% kalendarium_controllers << "kalendarium-task-slot" if @task_schedule_row.present? %>
<% kalendarium_actions = [
  "kalendarium:quick-create->kalendarium-focus#prepareNewEvent",
  "kalendarium:preview-event->kalendarium-preview#render",
  "kalendarium:preview-clear->kalendarium-preview#clear"
] %>
<% kalendarium_actions << "kalendarium:task-slot-draft->kalendarium-task-slot#openDraft" if @task_schedule_row.present? %>
<% database_return_params = {
  view_id: params[:view_id].presence,
  month: params[:month].presence,
  sort_property_id: params[:sort_property_id].presence,
  sort_direction: params[:sort_direction].presence,
  sort_mode: params[:sort_mode].presence,
  filter_property_id: params[:filter_property_id].presence,
  filter_value: params[:filter_value].presence,
  filter_operator: params[:filter_operator].presence,
  rows_page: params[:rows_page].presence,
  view_settings: params[:view_settings].presence,
  actions_menu: params[:actions_menu].presence,
  options_menu: params[:options_menu].presence
}.compact %>
<% kalendarium_base_params = { workspace_slug: @workspace.slug }.merge(embedded_params).merge(widget_params).merge(task_schedule_params).merge(window_start_params).merge(planning_params).merge(database_return_params) %>

<section class="<%= ["notae-kalendarium", ("is-month-view" if @view == "month"), ("is-embedded-split" if embedded_split_view), ("is-widget" if widget_view), ("is-planning-wide" if wide_planning_view)].compact.join(" ") %>"
         data-controller="<%= kalendarium_controllers.join(" ") %>"
         data-action="<%= kalendarium_actions.join(" ") %>"
         data-kalendarium-focus-selected-date-value="<%= @selected_date.strftime("%Y-%m-%d") %>"
         data-kalendarium-focus-view-value="<%= @view %>"
         data-kalendarium-focus-window-start-value="<%= @view == "next_7_days" ? @next_seven_days_start.strftime("%Y-%m-%d") : "" %>"
         data-kalendarium-focus-widget-value="<%= widget_view ? "true" : "false" %>"
         <% if @task_schedule_row.present? %>
         data-kalendarium-task-slot-task-title-value="<%= @task_schedule_row.title %>"
         data-kalendarium-task-slot-default-duration-minutes-value="<%= Kalendarium::TaskSchedulingService::DEFAULT_DURATION_MINUTES %>"
         <% end %>>
  <% year_daily_events_param = @show_year_daily_events ? "1" : nil %>
  <% selected_offset_days = @view == "next_7_days" ? (@selected_date - @next_seven_days_start).to_i : 0 %>
  <% previous_window_start = @view == "next_7_days" ? @next_seven_days_start - 7.days : nil %>
  <% next_window_start = @view == "next_7_days" ? @next_seven_days_start + 7.days : nil %>
  <% previous_date = case @view
                    when "day" then @selected_date - 1.day
                    when "next_7_days" then previous_window_start + selected_offset_days.days
                    when "week" then @selected_date - 1.week
                    when "year" then @selected_date - 1.year
                    else @selected_date - 1.month
                    end %>
  <% next_date = case @view
                when "day" then @selected_date + 1.day
                when "next_7_days" then next_window_start + selected_offset_days.days
                when "week" then @selected_date + 1.week
                when "year" then @selected_date + 1.year
                else @selected_date + 1.month
                end %>
  <% selected_date_label = case @view
                           when "day"
                             @selected_date.strftime("%A, %-d %B %Y")
                           when "next_7_days"
                             "#{@next_seven_days_start.strftime("%b %-d")} - #{(@next_seven_days_start + 6.days).strftime("%b %-d, %Y")}"
                           when "year"
                             @selected_date.strftime("%Y")
                           else
                             @selected_date.strftime("%b %-d, %Y")
                           end %>
  <% planning_toggle_base_params = kalendarium_base_params.merge(
       view: @view,
       date: @selected_date,
       window_start: window_start_value,
       project_id: @selected_project_id,
       calendar_ids: @selected_calendar_ids,
       year_daily_events: year_daily_events_param
     ).merge(project_scope_params) %>
  <% planning_toggle_params = wide_planning_view ? planning_toggle_base_params.merge(planning: "standard") : planning_toggle_base_params.merge(planning: "wide") %>
  <% refresh_kalendarium_params = {
       view: @view,
       date: @selected_date,
       window_start: window_start_value,
       project_id: @selected_project_id,
       calendar_ids: @selected_calendar_ids,
       project_scope_id: @scoped_project_id,
       calendar_filter_applied: "1",
       year_daily_events: year_daily_events_param,
       planning: planning_params[:planning],
       embedded: embedded_params[:embedded],
       widget: widget_params[:widget],
       task_row_id: task_schedule_params[:task_row_id]
     }.merge(database_return_params) %>
  <header class="notae-kalendarium-head notae-auth-card">
    <% if widget_view %>
      <div class="notae-kalendarium-widget-head">
        <div class="notae-kalendarium-widget-title-wrap">
          <p class="notae-kalendarium-widget-eyebrow">Kalendārium</p>
          <h1 class="notae-kalendarium-widget-title">Quick calendar</h1>
        </div>
        <div class="notae-kalendarium-widget-controls">
          <button type="button"
                  class="notae-kalendarium-widget-control"
                  aria-label="Add event"
                  title="Add event"
                  data-action="kalendarium-focus#openCreateModal">+</button>
          <button type="button"
                  class="notae-kalendarium-widget-control"
                  aria-label="Minimise quick calendar"
                  title="Minimise"
                  data-action="kalendarium-focus#minimizeWidget">−</button>
        </div>
      </div>

      <div class="notae-kalendarium-nav-buttons notae-kalendarium-widget-nav">
        <%= link_to "←",
                    kalendarium_path(
                      kalendarium_base_params.merge(
                        view: @view,
                        date: previous_date,
                        window_start: previous_window_start&.strftime("%Y-%m-%d"),
                        project_id: @selected_project_id,
                        calendar_ids: @selected_calendar_ids,
                        year_daily_events: year_daily_events_param
                      ).merge(project_scope_params)
                    ),
                    class: "notae-chip-button" %>
        <span class="notae-kalendarium-date-label" data-kalendarium-focus-target="dateLabel"><%= selected_date_label %></span>
        <%= link_to "→",
                    kalendarium_path(
                      kalendarium_base_params.merge(
                        view: @view,
                        date: next_date,
                        window_start: next_window_start&.strftime("%Y-%m-%d"),
                        project_id: @selected_project_id,
                        calendar_ids: @selected_calendar_ids,
                        year_daily_events: year_daily_events_param
                      ).merge(project_scope_params)
                    ),
                    class: "notae-chip-button" %>
        <%= link_to "Today",
                    kalendarium_path(
                      kalendarium_base_params.merge(
                        view: @view,
                        date: Date.current,
                        window_start: (@view == "next_7_days" ? Date.current.strftime("%Y-%m-%d") : nil),
                        project_id: @selected_project_id,
                        calendar_ids: @selected_calendar_ids,
                        year_daily_events: year_daily_events_param
                      ).merge(project_scope_params)
                    ),
                    class: "notae-chip-button" %>
      </div>

      <div class="notae-kalendarium-view-switch notae-kalendarium-widget-view-switch"
           aria-label="Quick calendar range switch">
        <% widget_view_options.each do |label, view_option, accessible_label| %>
          <%= link_to label,
                      kalendarium_path(
                        kalendarium_base_params.merge(
                          view: view_option,
                          date: @selected_date,
                          window_start: (view_option == "next_7_days" ? @selected_date.strftime("%Y-%m-%d") : nil),
                          project_id: @selected_project_id,
                          calendar_ids: @selected_calendar_ids,
                          year_daily_events: year_daily_events_param
                        ).merge(project_scope_params)
                      ),
                      class: ["notae-chip-button", ("is-active" if @view == view_option)].compact.join(" "),
                      title: accessible_label,
                      aria: { label: accessible_label },
                      data: { kalendarium_focus_target: "viewLink", view_option: view_option } %>
        <% end %>
      </div>
    <% else %>
      <div class="notae-kalendarium-head-top">
        <h1 class="notae-tool-page-title">Kalendārium</h1>
        <div class="notae-kalendarium-nav-buttons">
          <%= link_to "←",
                      kalendarium_path(
                        kalendarium_base_params.merge(
                          view: @view,
                          date: previous_date,
                          window_start: previous_window_start&.strftime("%Y-%m-%d"),
                          project_id: @selected_project_id,
                          calendar_ids: @selected_calendar_ids,
                          year_daily_events: year_daily_events_param
                        ).merge(project_scope_params)
                      ),
                      class: "notae-chip-button" %>
          <span class="notae-kalendarium-date-label" data-kalendarium-focus-target="dateLabel"><%= selected_date_label %></span>
          <%= link_to "→",
                      kalendarium_path(
                        kalendarium_base_params.merge(
                          view: @view,
                          date: next_date,
                          window_start: next_window_start&.strftime("%Y-%m-%d"),
                          project_id: @selected_project_id,
                          calendar_ids: @selected_calendar_ids,
                          year_daily_events: year_daily_events_param
                        ).merge(project_scope_params)
                      ),
                      class: "notae-chip-button" %>
          <%= link_to "Today",
                      kalendarium_path(
                        kalendarium_base_params.merge(
                          view: @view,
                          date: Date.current,
                          window_start: (@view == "next_7_days" ? Date.current.strftime("%Y-%m-%d") : nil),
                          project_id: @selected_project_id,
                          calendar_ids: @selected_calendar_ids,
                          year_daily_events: year_daily_events_param
                        ).merge(project_scope_params)
                      ),
                      class: "notae-chip-button" %>
        </div>
      </div>

      <div class="notae-kalendarium-head-row">
        <div class="notae-kalendarium-view-switch">
          <% KalendariumController::VIEW_OPTIONS.each do |view_option| %>
            <% view_label = view_option == "next_7_days" ? "Next 7 days" : view_option.titleize %>
            <%= link_to view_label,
                        kalendarium_path(
                          kalendarium_base_params.merge(
                            view: view_option,
                            date: @selected_date,
                            project_id: @selected_project_id,
                            calendar_ids: @selected_calendar_ids,
                            year_daily_events: year_daily_events_param
                          ).merge(project_scope_params)
                        ),
                        class: ["notae-chip-button", ("is-active" if @view == view_option)].compact.join(" "),
                        data: { kalendarium_focus_target: "viewLink", view_option: view_option } %>
          <% end %>
        </div>

        <div class="notae-kalendarium-filter-controls">
          <%= link_to wide_planning_view ? "Standard view" : "Wide view",
                      kalendarium_path(planning_toggle_params),
                      class: ["notae-chip-button", "notae-kalendarium-planning-toggle", ("is-active" if wide_planning_view)].compact.join(" "),
                      aria: { pressed: wide_planning_view, label: wide_planning_view ? "Return Kalendārium to standard view" : "Expand Kalendārium planning view" },
                      title: wide_planning_view ? "Return to standard calendar layout" : "Use more screen space for the current calendar view" %>
          <%= button_to refresh_kalendarium_path(workspace_slug: @workspace.slug),
                        method: :post,
                        params: refresh_kalendarium_params,
                        class: "notae-chip-button notae-kalendarium-refresh-button",
                        form: { data: { turbo: false } },
                        title: "Refresh calendars",
                        aria: { label: "Refresh calendars" } do %>
            <span class="notae-kalendarium-refresh-glyph" aria-hidden="true">↻</span>
          <% end %>

        <div class="notae-kalendarium-workspace-filter" data-controller="auto-submit">
          <% workspace_options = @workspace_options.map do |workspace_option|
               [
                 workspace_option.name,
                 kalendarium_path(
                   { workspace_slug: workspace_option.slug }
                     .merge(embedded_params)
                     .merge(window_start_params)
                     .merge(planning_params)
                     .merge(database_return_params)
                     .merge(
                       view: @view,
                       date: @selected_date,
                       year_daily_events: year_daily_events_param
                     )
                     .merge(project_scope_params)
                 )
               ]
             end %>
          <%= select_tag :kalendarium_workspace,
                         options_for_select(
                           workspace_options,
                           kalendarium_path(
                             kalendarium_base_params.merge(
                               view: @view,
                               date: @selected_date,
                               year_daily_events: year_daily_events_param
                             ).merge(project_scope_params)
                           )
                         ),
                         class: "notae-chip-button notae-kalendarium-workspace-select",
                         data: { action: "change->auto-submit#navigate" },
                         aria: { label: "Select workspace calendar view" } %>
        </div>

        <%= form_with url: kalendarium_path(kalendarium_base_params),
                      method: :get,
                      class: "notae-kalendarium-calendar-filter",
                      html: {
                        data: {
                          turbo: (embedded_split_view ? false : nil)
                        }.compact
                      } do |form| %>
          <%= hidden_field_tag :view, @view %>
          <%= hidden_field_tag :date, @selected_date, data: { kalendarium_focus_target: "dateInput" } %>
          <%= hidden_field_tag :year_daily_events, year_daily_events_param %>
          <%= hidden_field_tag :calendar_filter_applied, "1" %>
          <% if wide_planning_view %>
            <%= hidden_field_tag :planning, "wide" %>
          <% end %>
          <% if embedded_split_view %>
            <%= hidden_field_tag :embedded, "1" %>
          <% end %>
          <% if @scoped_project_id.present? %>
            <%= hidden_field_tag :project_scope_id, @scoped_project_id %>
          <% end %>
          <details data-controller="floating-panel"
                   data-action="toggle->floating-panel#toggle">
            <summary class="notae-chip-button" data-floating-panel-target="summary">Calendars (<%= @selected_calendar_ids.size %>)</summary>
            <div class="notae-kalendarium-calendar-popover" data-floating-panel-target="panel">
              <% if window_start_value.present? %>
                <%= hidden_field_tag :window_start, window_start_value %>
              <% end %>
              <% @calendar_filter_calendars.each do |calendar| %>
                <label class="notae-options-checkbox">
                  <%= check_box_tag "calendar_ids[]", calendar.id, @selected_calendar_ids.include?(calendar.id.to_s) %>
                  <span class="notae-kalendarium-dot" style="--kal-color: <%= calendar.color_hex %>"></span>
                  <span><%= calendar.name %></span>
                </label>
              <% end %>
              <div class="notae-kalendarium-calendar-popover-actions">
                <%= submit_tag "Apply", class: "notae-chip-button" %>
              </div>
            </div>
          </details>
        <% end %>

        <% visible_project_id_set = @visible_project_id_set || @visible_project_ids.index_with(true) %>
        <% menu_time_zones = Array(params[:tz]).map(&:to_s).reject(&:blank?) %>
        <% project_menu_params = {
             view: @view,
             date: @selected_date,
             window_start: window_start_value,
             calendar_ids: @selected_calendar_ids,
             year_daily_events: year_daily_events_param
           }.merge(kalendarium_base_params).merge(project_scope_params) %>
        <% project_menu_params[:tz] = menu_time_zones if menu_time_zones.any? %>
        <div class="notae-kalendarium-project-filter">
          <details data-controller="floating-panel"
                   data-action="toggle->floating-panel#toggle">
            <summary class="notae-chip-button" data-floating-panel-target="summary">Projects (<%= @visible_project_ids.size %>)</summary>
            <div class="notae-kalendarium-project-popover" data-floating-panel-target="panel">
              <% if @projects.any? %>
                <% @projects.each do |project| %>
                  <% project_visible = visible_project_id_set.include?(project.id.to_s) %>
                  <div class="notae-kalendarium-project-option-row">
                    <%= form_with model: project,
                                  url: kalendarium_project_path(project_menu_params.merge(id: project.id)),
                                  method: :patch,
                                  class: "notae-kalendarium-project-option-name is-color-editable",
                                  title: "Double-click to change #{project.name} color",
                                  data: {
                                    controller: "project-color-picker",
                                    action: "dblclick->project-color-picker#open"
                                  } do |form| %>
                      <span class="notae-kalendarium-dot"
                            style="--kal-color: <%= project.color_hex %>"
                            data-project-color-picker-target="swatch"></span>
                      <span class="notae-kalendarium-project-option-label"><%= project.name %></span>
                      <%= form.color_field :color_hex,
                                           value: project.color_hex,
                                           class: "notae-kalendarium-project-color-input",
                                           aria: { label: "Choose color for #{project.name}" },
                                           data: {
                                             project_color_picker_target: "input",
                                             action: "change->project-color-picker#save"
                                           } %>
                    <% end %>
                    <div class="notae-kalendarium-project-option-actions">
                      <%= link_to(project_visible ? "Show: On" : "Show: Off",
                                  kalendarium_path(
                                    project_menu_params.merge(
                                      toggle_project_id: project.id,
                                      project_visible: project_visible ? "0" : "1"
                                    )
                                  ),
                                  class: ["notae-kalendarium-project-action-link is-toggle", ("is-active" if project_visible)].compact.join(" "),
                                  aria: { pressed: project_visible, label: "Toggle project visibility for #{project.name}" }) %>
                      <%= link_to "Archive",
                                  archive_kalendarium_project_path(
                                    project_menu_params.merge(
                                      id: project.id
                                    )
                                  ),
                                  class: "notae-kalendarium-project-action-link",
                                  data: { turbo_method: :patch, turbo_confirm: "Archive #{project.name}?" } %>
                      <%= link_to "Delete",
                                  kalendarium_project_path(
                                    project_menu_params.merge(
                                      id: project.id
                                    )
                                  ),
                                  class: "notae-kalendarium-project-action-link is-danger",
                                  data: { turbo_method: :delete, turbo_confirm: "Delete #{project.name}? This removes the project and unassigns its events." } %>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <p class="notae-options-empty">No projects yet.</p>
              <% end %>

              <div class="notae-kalendarium-project-popover-actions">
                <%= link_to "Edit projects",
                            kalendarium_path(project_menu_params.merge(view: "project", return_view: @project_return_view)),
                            class: "notae-kalendarium-project-action-link notae-kalendarium-project-edit-link" %>
              </div>
            </div>
          </details>
        </div>
        <% if @view == "year" %>
          <%= form_with url: kalendarium_path(kalendarium_base_params),
                        method: :get,
                        class: "notae-kalendarium-year-toggle",
                        data: {
                          controller: "auto-submit"
                        },
                        html: {
                          data: {
                            turbo: (embedded_split_view ? false : nil)
                          }.compact
                        } do |form| %>
            <%= hidden_field_tag :view, @view %>
            <%= hidden_field_tag :date, @selected_date %>
            <% if wide_planning_view %>
              <%= hidden_field_tag :planning, "wide" %>
            <% end %>
            <% if embedded_split_view %>
              <%= hidden_field_tag :embedded, "1" %>
            <% end %>
            <% if window_start_value.present? %>
              <%= hidden_field_tag :window_start, window_start_value %>
            <% end %>
            <% if @scoped_project_id.present? %>
              <%= hidden_field_tag :project_scope_id, @scoped_project_id %>
            <% end %>
            <% @selected_calendar_ids.each do |calendar_id| %>
              <%= hidden_field_tag "calendar_ids[]", calendar_id %>
            <% end %>
            <label class="notae-kalendarium-year-toggle-label">
              <%= check_box_tag :year_daily_events, "1", @show_year_daily_events, data: { action: "change->auto-submit#submit" } %>
              <span>Show daily events</span>
            </label>
          <% end %>
        <% end %>
      </div>
      </div>
    <% end %>
  </header>

  <section class="notae-kalendarium-grid">
    <% unless embedded_compact_view || wide_planning_view %>
      <aside class="notae-kalendarium-sidebar notae-auth-card is-pinned">
        <% if @task_schedule_row.present? %>
          <section class="notae-kalendarium-task-schedule-panel">
            <p class="notae-page-subtle">Choose a slot for</p>
            <strong><%= @task_schedule_row.title %></strong>
            <% if @task_slot_error.present? %>
              <p class="notae-page-subtle"><%= @task_slot_error %></p>
            <% else %>
              <p class="notae-page-subtle">Click a suggested slot in the calendar to lock it in.</p>
            <% end %>
          </section>
        <% end %>

        <details class="notae-kalendarium-sidebar-accordion" data-kalendarium-focus-target="createAccordion">
          <summary class="notae-kalendarium-sidebar-accordion-summary">Create event</summary>
          <div class="notae-kalendarium-sidebar-accordion-body">
            <div class="notae-kalendarium-sidebar-accordion-body-inner">
              <%= render "create_event_form",
                         new_event: @new_event,
                         kalendarium_base_params: kalendarium_base_params,
                         selected_date: @selected_date,
                         scoped_project_id: @scoped_project_id,
                         visible_calendars: @visible_calendars,
                         projects: @projects,
                         selected_project_id: @selected_project_id,
                         form_class: "notae-kalendarium-form",
                         view_name: @view,
                         preview_enabled: true,
                         cancel_label: "Cancel",
                         submit_label: "Create" %>
            </div>
          </div>
        </details>

        <details class="notae-kalendarium-sidebar-accordion">
          <summary class="notae-kalendarium-sidebar-accordion-summary">Create project</summary>
          <div class="notae-kalendarium-sidebar-accordion-body">
            <div class="notae-kalendarium-sidebar-accordion-body-inner">
              <%= form_with model: @new_project,
                            url: kalendarium_projects_path(kalendarium_base_params),
                            class: "notae-kalendarium-form" do |form| %>
                <% if @scoped_project_id.present? %>
                  <%= hidden_field_tag :project_scope_id, @scoped_project_id %>
                <% end %>
                <%= form.text_field :name, placeholder: "Project name", required: true, class: "notae-auth-input" %>
                <%= form.text_field :slug, placeholder: "project-slug", class: "notae-auth-input" %>
                <%= form.color_field :color_hex, value: "#8B5CF6", class: "notae-auth-input" %>
                <div class="notae-kalendarium-project-actions">
                  <%= button_tag "Quick link Nota", type: "submit", name: "kalendarium_project[linked_page_action]", value: "create_page", class: "notae-chip-button" %>
                  <%= form.submit "Create project", class: "notae-chip-button" %>
                </div>
              <% end %>
            </div>
          </div>
        </details>

        <% if @time_zone_rail.any? %>
          <section class="notae-kalendarium-timezones-section">
            <h2>Time zones</h2>
            <ul class="notae-kalendarium-timezones">
              <% @time_zone_rail.each do |time_zone| %>
                <% zone = ActiveSupport::TimeZone[time_zone] %>
                <% next if zone.blank? %>
                <li>
                  <strong><%= time_zone %></strong>
                  <span><%= Time.current.in_time_zone(zone).strftime("%H:%M") %></span>
                </li>
              <% end %>
            </ul>
          </section>
        <% end %>
      </aside>
    <% end %>

    <div class="notae-kalendarium-main notae-auth-card">
      <% today_local = Time.current.in_time_zone(current_user.time_zone).to_date %>
      <% if @view == "day" %>
        <h2><%= @selected_date.strftime("%A, %-d %B %Y") %></h2>
        <% slot_height = 28 %>
        <% slots_per_day = 48 %>
        <% day_all_day_events = @day_timeline[:all_day_events] %>
        <% day_timed_events = @day_timeline[:timed_events] %>
        <% day_task_slot_candidates = @task_slot_candidate_layouts_by_day.fetch(@selected_date, []) %>
        <div class="notae-kalendarium-timeline"
             data-controller="kalendarium-timeline"
             data-kalendarium-timeline-start-hour-value="5"
             data-kalendarium-timeline-slot-height-value="<%= slot_height %>"
             data-kalendarium-timeline-all-day-offset-value="<%= @day_all_day_offset %>"
             data-kalendarium-timeline-center-current-time-value="<%= widget_view ? "true" : "false" %>"
             data-kalendarium-timeline-time-zone-value="<%= timeline_time_zone %>"
             data-kalendarium-timeline-task-scheduling-value="<%= @task_schedule_row.present? %>"
             <% if @task_slot_focus_minutes.present? %>
             data-kalendarium-timeline-initial-focus-minutes-value="<%= @task_slot_focus_minutes %>"
             <% end %>
             data-kalendarium-timeline-task-default-duration-minutes-value="<%= Kalendarium::TaskSchedulingService::DEFAULT_DURATION_MINUTES %>">
          <div class="notae-kalendarium-timeline-scroller" data-kalendarium-timeline-target="scroller">
            <div class="notae-kalendarium-day-columns">
              <div class="notae-kalendarium-time-rail" aria-hidden="true">
                <% 24.times do |hour| %>
                  <div class="notae-kalendarium-time-hour" style="--kal-slot-height: <%= slot_height %>px;">
                    <span><%= format("%02d:00", hour) %></span>
                    <span class="notae-kalendarium-time-half"></span>
                  </div>
                <% end %>
              </div>
              <div class="notae-kalendarium-day-track"
                   data-day-date="<%= @selected_date.strftime("%Y-%m-%d") %>"
                   data-action="dblclick->kalendarium-timeline#quickCreate"
                   style="--kal-slot-height: <%= slot_height %>px; --kal-slots-per-day: <%= slots_per_day %>; --kal-all-day-offset: <%= @day_all_day_offset %>px;">
                <% if @day_all_day_offset.positive? %>
                  <div class="notae-kalendarium-all-day-strip">
                    <% day_all_day_events.each do |event| %>
                      <%= render "kalendarium_event",
                                 event: event,
                                 workspace: @workspace,
                                 view: @view,
                                 date: @selected_date,
                                 calendars: @all_calendars,
                                 projects: @projects,
                                 compact: true,
                                 all_day: true %>
                    <% end %>
                  </div>
                <% end %>
                <div class="notae-kalendarium-slot-grid" aria-hidden="true">
                  <% slots_per_day.times do |slot| %>
                    <div class="notae-kalendarium-slot-line <%= "is-hour" if (slot % 2).zero? %>"></div>
                  <% end %>
                </div>
                <div class="notae-kalendarium-events-layer">
                  <div class="notae-kalendarium-now-line"
                       data-kalendarium-timeline-target="nowLine"
                       data-now-date="<%= @selected_date.strftime("%Y-%m-%d") %>"
                       aria-hidden="true"
                       hidden>
                    <span class="notae-kalendarium-now-line-label"
                          data-kalendarium-timeline-target="nowLineLabel"></span>
                  </div>
                  <% day_task_slot_candidates.each do |candidate| %>
                    <div class="notae-kalendarium-task-slot-form" style="<%= candidate[:timeline_style] %>">
                      <button type="button"
                              class="notae-kalendarium-task-slot-candidate"
                              data-action="click->kalendarium-task-slot#openCandidate"
                              data-slot-label="<%= candidate[:label] %>"
                              data-start-local="<%= candidate[:start_local_value] %>"
                              data-end-local="<%= candidate[:end_local_value] %>">
                        <span class="notae-kalendarium-task-slot-label">Suggested slot</span>
                        <strong><%= candidate[:label] %></strong>
                      </button>
                    </div>
                  <% end %>
                  <% day_timed_events.each do |placement| %>
                    <%= render "kalendarium_event",
                               event: placement[:event],
                               workspace: @workspace,
                               view: @view,
                               date: @selected_date,
                               calendars: @all_calendars,
                               projects: @projects,
                               timeline: true,
                               timeline_style: placement[:timeline_style],
                               timeline_start_minutes: placement[:start_minutes],
                               timeline_end_minutes: placement[:end_minutes] %>
                  <% end %>
                </div>
                <% if day_timed_events.blank? && day_all_day_events.blank? && day_task_slot_candidates.blank? %>
                  <p class="notae-page-subtle notae-kalendarium-empty-message">No events for this day.</p>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% elsif @view == "week" || @view == "next_7_days" %>
        <h2><%= @view == "next_7_days" ? "Next 7 days" : "Week view" %></h2>
        <% slot_height = 28 %>
        <% slots_per_day = 48 %>
        <div class="notae-kalendarium-week-timeline"
             data-controller="kalendarium-timeline"
             data-kalendarium-timeline-start-hour-value="5"
             data-kalendarium-timeline-slot-height-value="<%= slot_height %>"
             data-kalendarium-timeline-all-day-offset-value="<%= @week_all_day_offset %>"
             data-kalendarium-timeline-time-zone-value="<%= timeline_time_zone %>"
             data-kalendarium-timeline-task-scheduling-value="<%= @task_schedule_row.present? %>"
             <% if @task_slot_focus_minutes.present? %>
             data-kalendarium-timeline-initial-focus-minutes-value="<%= @task_slot_focus_minutes %>"
             <% end %>
             data-kalendarium-timeline-task-default-duration-minutes-value="<%= Kalendarium::TaskSchedulingService::DEFAULT_DURATION_MINUTES %>">
          <div class="notae-kalendarium-week-header">
            <span class="notae-kalendarium-week-header-spacer" aria-hidden="true"></span>
            <div class="notae-kalendarium-week-header-days">
              <% @week_days.each do |day| %>
                <div>
                  <%= link_to kalendarium_path(
                                kalendarium_base_params.merge(
                                  view: @view,
                                  date: day,
                                  project_id: @selected_project_id,
                                  calendar_ids: @selected_calendar_ids,
                                  year_daily_events: year_daily_events_param
                                ).merge(project_scope_params)
                              ),
                              class: ["notae-kalendarium-day-focus-link", ("is-selected" if day == @selected_date)].compact.join(" "),
                              data: {
                                action: "click->kalendarium-focus#selectDay dblclick->kalendarium-focus#quickCreateDay",
                                kalendarium_focus_target: "dayLink",
                                kalendarium_day_focus: true,
                                day_date: day.strftime("%Y-%m-%d")
                              } do %>
                    <strong><%= day.strftime("%a") %></strong>
                    <span><%= day.strftime("%-d %b") %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
          <div class="notae-kalendarium-timeline-scroller notae-kalendarium-timeline-scroller-week" data-kalendarium-timeline-target="scroller">
            <div class="notae-kalendarium-week-body">
              <div class="notae-kalendarium-time-rail" aria-hidden="true">
                <% 24.times do |hour| %>
                  <div class="notae-kalendarium-time-hour" style="--kal-slot-height: <%= slot_height %>px;">
                    <span><%= format("%02d:00", hour) %></span>
                    <span class="notae-kalendarium-time-half"></span>
                  </div>
                <% end %>
              </div>
              <div class="notae-kalendarium-week-columns">
                <% @week_days.each do |day| %>
                  <% day_timeline = @week_timelines[day] || { all_day_events: [], timed_events: [] } %>
                  <% day_all_day_events = day_timeline[:all_day_events] %>
                  <% day_timed_events = day_timeline[:timed_events] %>
                  <% day_task_slot_candidates = @task_slot_candidate_layouts_by_day.fetch(day, []) %>
                  <div class="<%= ["notae-kalendarium-week-day-track", ("is-selected" if day == @selected_date)].compact.join(" ") %>"
                       data-kalendarium-focus-target="weekTrack"
                       data-day-date="<%= day.strftime("%Y-%m-%d") %>"
                       data-action="dblclick->kalendarium-timeline#quickCreate"
                       style="--kal-slot-height: <%= slot_height %>px; --kal-slots-per-day: <%= slots_per_day %>; --kal-all-day-offset: <%= @week_all_day_offset %>px;">
                    <header class="notae-kalendarium-week-day-label">
                      <%= link_to kalendarium_path(
                                    kalendarium_base_params.merge(
                                      view: @view,
                                      date: day,
                                      project_id: @selected_project_id,
                                      calendar_ids: @selected_calendar_ids,
                                      year_daily_events: year_daily_events_param
                                    ).merge(project_scope_params)
                                  ),
                                  class: ["notae-kalendarium-day-focus-link", ("is-selected" if day == @selected_date)].compact.join(" "),
                                  data: {
                                    action: "click->kalendarium-focus#selectDay",
                                    kalendarium_focus_target: "dayLink",
                                    kalendarium_day_focus: true,
                                    day_date: day.strftime("%Y-%m-%d")
                                  } do %>
                        <strong><%= day.strftime("%a") %></strong>
                        <span><%= day.strftime("%-d %b") %></span>
                      <% end %>
                    </header>
                    <% if @week_all_day_offset.positive? %>
                      <div class="notae-kalendarium-all-day-strip">
                        <% day_all_day_events.each do |event| %>
                          <%= render "kalendarium_event",
                                     event: event,
                                     workspace: @workspace,
                                     view: @view,
                                     date: @selected_date,
                                     calendars: @all_calendars,
                                     projects: @projects,
                                     compact: true,
                                     all_day: true %>
                        <% end %>
                      </div>
                    <% end %>
                    <div class="notae-kalendarium-slot-grid" aria-hidden="true">
                      <% slots_per_day.times do |slot| %>
                        <div class="notae-kalendarium-slot-line <%= "is-hour" if (slot % 2).zero? %>"></div>
                      <% end %>
                    </div>
                    <div class="notae-kalendarium-events-layer">
                      <div class="notae-kalendarium-now-line"
                           data-kalendarium-timeline-target="nowLine"
                           data-now-date="<%= day.strftime("%Y-%m-%d") %>"
                           aria-hidden="true"
                           hidden>
                        <span class="notae-kalendarium-now-line-label"
                              data-kalendarium-timeline-target="nowLineLabel"></span>
                      </div>
                      <% day_task_slot_candidates.each do |candidate| %>
                        <div class="notae-kalendarium-task-slot-form" style="<%= candidate[:timeline_style] %>">
                          <button type="button"
                                  class="notae-kalendarium-task-slot-candidate"
                                  data-action="click->kalendarium-task-slot#openCandidate"
                                  data-slot-label="<%= candidate[:label] %>"
                                  data-start-local="<%= candidate[:start_local_value] %>"
                                  data-end-local="<%= candidate[:end_local_value] %>">
                            <span class="notae-kalendarium-task-slot-label">Suggested slot</span>
                            <strong><%= candidate[:label] %></strong>
                          </button>
                        </div>
                      <% end %>
                      <% day_timed_events.each do |placement| %>
                        <%= render "kalendarium_event",
                                   event: placement[:event],
                                   workspace: @workspace,
                                   view: @view,
                                   date: @selected_date,
                                   calendars: @all_calendars,
                                   projects: @projects,
                                   timeline: true,
                                   timeline_style: placement[:timeline_style],
                                   timeline_start_minutes: placement[:start_minutes],
                                   timeline_end_minutes: placement[:end_minutes] %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% elsif @view == "year" %>
        <h2><%= @selected_date.strftime("%Y") %></h2>
        <div class="notae-kalendarium-year-grid">
          <% @year_months.each do |month_date| %>
            <% month_count = @year_month_event_counts.fetch(month_date.month, 0) %>
            <% month_grid_start = month_date.beginning_of_month.beginning_of_week(@week_start_day) %>
            <% month_grid_end = month_date.end_of_month.end_of_week(@week_start_day) %>
            <article class="notae-kalendarium-year-card">
              <header class="notae-kalendarium-year-card-header">
                <%= link_to month_date.strftime("%B"),
                            kalendarium_path(
                              kalendarium_base_params.merge(
                                view: "month",
                                date: month_date,
                                project_id: @selected_project_id,
                                calendar_ids: @selected_calendar_ids,
                                year_daily_events: year_daily_events_param
                              ).merge(project_scope_params)
                            ),
                            class: "notae-kalendarium-year-month-link" %>
                <span><%= pluralize(month_count, "event") %></span>
              </header>
              <div class="notae-kalendarium-year-month-grid">
                <% @year_weekday_labels.each do |weekday| %>
                  <span class="notae-kalendarium-year-weekday"><%= weekday %></span>
                <% end %>
                <% (month_grid_start..month_grid_end).each do |day| %>
                  <% in_month = day.month == month_date.month %>
                  <% day_events = if @show_year_daily_events
                                    @year_events_by_day[day] || []
                                  else
                                    @year_all_day_events_by_day[day] || []
                                  end %>
                  <% first_day_event = day_events.first %>
                  <% hidden_day_event_count = [day_events.size - 1, 0].max %>
                  <% first_event_color = first_day_event&.kalendarium_project&.color_hex.presence || first_day_event&.kalendarium_calendar&.color_hex.presence || "#3b82f6" %>
                  <%= link_to kalendarium_path(
                                kalendarium_base_params.merge(
                                  view: "year",
                                  date: day,
                                  project_id: @selected_project_id,
                                  calendar_ids: @selected_calendar_ids,
                                  year_daily_events: year_daily_events_param
                                ).merge(project_scope_params)
                              ),
                              class: [
                                "notae-kalendarium-year-day",
                                ("is-outside-month" unless in_month),
                                ("is-today" if day == today_local),
                                ("is-selected" if day == @selected_date),
                                ("has-event-label" if first_day_event.present?)
                              ].compact.join(" "),
                              data: {
                                action: "click->kalendarium-focus#selectDay dblclick->kalendarium-focus#quickCreateDay",
                                kalendarium_focus_target: "dayLink",
                                kalendarium_day_focus: true,
                                day_date: day.strftime("%Y-%m-%d")
                              } do %>
                    <span class="notae-kalendarium-year-day-number"><%= day.day %></span>
                    <% if first_day_event.present? %>
                      <span class="notae-kalendarium-year-day-event-label" style="--kal-year-event-color: <%= first_event_color %>;">
                        <%= truncate(first_day_event.title.to_s, length: 18) %><%= hidden_day_event_count.positive? ? " +#{hidden_day_event_count}" : "" %>
                      </span>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
      <% elsif @view == "project" %>
        <% project_close_params = {
             view: @project_return_view,
             date: @selected_date,
             calendar_ids: @selected_calendar_ids,
             year_daily_events: year_daily_events_param
           }.merge(kalendarium_base_params).merge(project_scope_params) %>
        <% project_close_time_zones = Array(params[:tz]).map(&:to_s).reject(&:blank?) %>
        <% project_close_params[:tz] = project_close_time_zones if project_close_time_zones.any? %>
        <div class="notae-kalendarium-section-header">
          <h2>Project view</h2>
          <%= link_to "✕",
                      kalendarium_path(project_close_params),
                      class: "notae-inline-icon-button notae-kalendarium-project-close-button",
                      aria: { label: "Close project management and return to #{@project_return_view.titleize} view" },
                      title: "Close" %>
        </div>
        <% if @projects.any? %>
          <div class="notae-kalendarium-project-grid">
            <% @projects.each do |project| %>
              <article class="notae-kalendarium-project-card">
                <header>
                  <%= form_with model: project,
                                url: kalendarium_project_path(
                                  kalendarium_base_params.merge(
                                    id: project.id,
                                    view: @view,
                                    date: @selected_date,
                                    project_id: @selected_project_id,
                                    calendar_ids: @selected_calendar_ids
                                  ).merge(project_scope_params)
                                ),
                                method: :patch,
                                class: "notae-kalendarium-project-card-title is-color-editable",
                                title: "Double-click to change #{project.name} color",
                                data: {
                                  controller: "project-color-picker",
                                  action: "dblclick->project-color-picker#open"
                                } do |form| %>
                    <span class="notae-kalendarium-dot"
                          style="--kal-color: <%= project.color_hex %>"
                          data-project-color-picker-target="swatch"></span>
                    <strong><%= project.name %></strong>
                    <%= form.color_field :color_hex,
                                         value: project.color_hex,
                                         class: "notae-kalendarium-project-color-input",
                                         aria: { label: "Choose color for #{project.name}" },
                                         data: {
                                           project_color_picker_target: "input",
                                           action: "change->project-color-picker#save"
                                         } %>
                  <% end %>
                  <div class="notae-kalendarium-project-card-actions">
                    <%= button_to "Archive",
                                  archive_kalendarium_project_path(
                                    kalendarium_base_params.merge(
                                      id: project.id,
                                      view: @view,
                                      date: @selected_date,
                                      project_id: @selected_project_id,
                                      calendar_ids: @selected_calendar_ids
                                    ).merge(project_scope_params)
                                  ),
                                  method: :patch,
                                  class: "notae-chip-button",
                                  form: { data: { turbo_confirm: "Archive #{project.name}?" } } %>
                    <%= button_to "Delete",
                                  kalendarium_project_path(
                                    kalendarium_base_params.merge(
                                      id: project.id,
                                      view: @view,
                                      date: @selected_date,
                                      project_id: @selected_project_id,
                                      calendar_ids: @selected_calendar_ids
                                    ).merge(project_scope_params)
                                  ),
                                  method: :delete,
                                  class: "notae-chip-button notae-chip-danger",
                                  form: { data: { turbo_confirm: "Delete #{project.name}? This removes the project and unassigns its events." } } %>
                  </div>
                </header>
                <% project_events = @project_events_by_project_id[project.id] %>
                <% if project.linked_page.present? %>
                  <p><%= link_to "Linked Nota", page_path(workspace_slug: @workspace.slug, id: project.linked_page_id), class: "notae-utility-link" %></p>
                <% end %>
                <% if project_events.any? %>
                  <% project_events.first(6).each do |event| %>
                    <%= render "kalendarium_event",
                               event: event,
                               workspace: @workspace,
                               view: @view,
                               date: @selected_date,
                               calendars: @all_calendars,
                               projects: @projects %>
                  <% end %>
                <% else %>
                  <p class="notae-page-subtle">No events yet.</p>
                <% end %>
              </article>
            <% end %>
          </div>
        <% else %>
          <p class="notae-page-subtle">No projects yet.</p>
        <% end %>
        <% if @archived_projects.any? %>
          <section class="notae-kalendarium-archived-projects">
            <h3>Archived projects</h3>
            <ul class="notae-kalendarium-archived-project-list">
              <% @archived_projects.each do |project| %>
                <li>
                  <span><%= project.name %></span>
                  <div class="notae-kalendarium-project-card-actions">
                    <%= button_to "Restore",
                                  unarchive_kalendarium_project_path(
                                    kalendarium_base_params.merge(
                                      id: project.id,
                                      view: @view,
                                      date: @selected_date,
                                      calendar_ids: @selected_calendar_ids
                                    ).merge(project_scope_params)
                                  ),
                                  method: :patch,
                                  class: "notae-chip-button" %>
                    <%= button_to "Delete",
                                  kalendarium_project_path(
                                    kalendarium_base_params.merge(
                                      id: project.id,
                                      view: @view,
                                      date: @selected_date,
                                      calendar_ids: @selected_calendar_ids
                                    ).merge(project_scope_params)
                                  ),
                                  method: :delete,
                                  class: "notae-chip-button notae-chip-danger",
                                  form: { data: { turbo_confirm: "Delete archived project #{project.name}?" } } %>
                  </div>
                </li>
              <% end %>
            </ul>
          </section>
        <% elsif @projects.blank? %>
          <p class="notae-page-subtle">No archived projects.</p>
        <% end %>
      <% else %>
        <h2>Month view · <%= @selected_date.strftime("%B %Y") %></h2>
        <div class="notae-kalendarium-month-grid">
          <% @weekday_labels.each do |label| %>
            <div class="notae-kalendarium-month-weekday"><%= label %></div>
          <% end %>
          <% @month_days.each do |day| %>
            <% day_events = @events_by_day[day] || [] %>
            <section class="<%= ["notae-kalendarium-month-cell", ("is-today" if day == today_local), ("is-selected" if day == @selected_date)].compact.join(" ") %>"
                     data-kalendarium-focus-target="monthCell"
                     data-action="dblclick->kalendarium-focus#quickCreateDay"
                     data-day-date="<%= day.strftime("%Y-%m-%d") %>">
              <header>
                <strong>
                  <%= link_to day.day,
                              kalendarium_path(
                                kalendarium_base_params.merge(
                                  view: @view,
                                  date: day,
                                  project_id: @selected_project_id,
                                  calendar_ids: @selected_calendar_ids,
                                  year_daily_events: year_daily_events_param
                                ).merge(project_scope_params)
                              ),
                              class: ["notae-kalendarium-month-day-focus-link", ("is-today" if day == today_local), ("is-selected" if day == @selected_date)].compact.join(" "),
                              data: {
                                action: "click->kalendarium-focus#selectDay dblclick->kalendarium-focus#quickCreateDay",
                                kalendarium_focus_target: "dayLink",
                                kalendarium_day_focus: true,
                                day_date: day.strftime("%Y-%m-%d")
                              } %>
                </strong>
                <% if day_events.size > 3 %>
                  <span class="notae-kalendarium-month-overflow-label">+<%= day_events.size - 3 %> more</span>
                <% end %>
              </header>
              <div class="notae-kalendarium-month-events">
                <% day_events.each do |event| %>
                  <%= render "kalendarium_event",
                             event: event,
                             workspace: @workspace,
                             view: @view,
                             date: @selected_date,
                             compact: true,
                             calendars: @all_calendars,
                             projects: @projects %>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      <% end %>

      <% if @pending_write_proposals.any? %>
        <section class="notae-kalendarium-proposals">
          <h3>Pending agent write proposals</h3>
          <ul>
            <% @pending_write_proposals.each do |proposal| %>
              <li>
                <div>
                  <strong><%= proposal.operation.titleize %></strong>
                  <code><%= proposal.payload_json.to_json %></code>
                </div>
                <div class="notae-kalendarium-proposal-actions">
                  <%= button_to "Confirm",
                                confirm_kalendarium_write_proposal_path(
                                  kalendarium_base_params.merge(
                                    id: proposal.id,
                                    view: @view,
                                    date: @selected_date
                                  )
                                ),
                                method: :post,
                                class: "notae-chip-button" %>
                  <%= button_to "Reject",
                                reject_kalendarium_write_proposal_path(
                                  kalendarium_base_params.merge(
                                    id: proposal.id,
                                    view: @view,
                                    date: @selected_date
                                  )
                                ),
                                method: :post,
                                class: "notae-chip-button" %>
                </div>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  </section>

  <% if widget_view || wide_planning_view %>
    <dialog class="notae-danger-modal notae-kalendarium-event-modal"
            data-kalendarium-focus-target="createDialog"
            data-action="click->kalendarium-focus#backdropCloseCreateDialog">
      <div class="notae-danger-modal-panel notae-kalendarium-event-modal-panel">
        <div class="notae-danger-modal-header">
          <div class="notae-kalendarium-event-modal-title">
            <span class="notae-page-subtle">Quick calendar</span>
            <h3>Create event</h3>
          </div>
          <button type="button"
                  class="notae-inline-icon-button"
                  aria-label="Close create event dialog"
                  data-action="kalendarium-focus#closeCreateDialog">✕</button>
        </div>

        <%= render "create_event_form",
                   new_event: @new_event,
                   kalendarium_base_params: kalendarium_base_params,
                   selected_date: @selected_date,
                   scoped_project_id: @scoped_project_id,
                   visible_calendars: @visible_calendars,
                   projects: @projects,
                   selected_project_id: @selected_project_id,
                   form_class: "notae-kalendarium-event-modal-form",
                   view_name: @view,
                   preview_enabled: true,
                   cancel_label: "Cancel",
                   submit_label: "Create event" %>
      </div>
    </dialog>
  <% end %>

  <% if @task_schedule_row.present? %>
    <dialog class="notae-danger-modal notae-kalendarium-task-slot-modal"
            data-kalendarium-task-slot-target="dialog"
            data-action="click->kalendarium-task-slot#backdropClose">
      <div class="notae-danger-modal-panel notae-kalendarium-event-modal-panel">
        <div class="notae-danger-modal-header">
          <h3 data-kalendarium-task-slot-target="heading">Schedule task</h3>
          <button type="button"
                  class="notae-inline-icon-button"
                  aria-label="Close schedule task dialog"
                  data-action="kalendarium-task-slot#close">✕</button>
        </div>

        <%= form_with url: confirm_schedule_in_kalendarium_database_db_row_path(
                        workspace_slug: @workspace.slug,
                        database_id: @task_schedule_row.database_id,
                        id: @task_schedule_row.id
                      ),
                      method: :post,
                      class: "notae-kalendarium-event-modal-form",
                      html: {
                        target: "_top",
                        data: {
                          turbo: false,
                          turbo_frame: "_top"
                        }
                      } do %>
          <% database_return_params.each do |name, value| %>
            <%= hidden_field_tag name, value %>
          <% end %>
          <div class="notae-kalendarium-task-slot-editor-meta">
            <p class="notae-page-subtle">Adjust the time if needed, then save it into the Tasks calendar.</p>
          </div>
          <%= label_tag :starts_at_local, "Start", class: "notae-page-subtle" %>
          <%= datetime_local_field_tag :starts_at_local,
                                       nil,
                                       class: "notae-auth-input",
                                       data: {
                                         kalendarium_task_slot_target: "startInput",
                                         action: "change->kalendarium-task-slot#startChanged"
                                       } %>
          <%= label_tag :duration_minutes, "Duration", class: "notae-page-subtle" %>
          <%= select_tag :duration_minutes,
                         options_for_select([[ "20 minutes", 20 ], [ "30 minutes", 30 ], [ "45 minutes", 45 ], [ "60 minutes", 60 ], [ "90 minutes", 90 ], [ "Custom", "custom" ]], Kalendarium::TaskSchedulingService::DEFAULT_DURATION_MINUTES),
                         class: "notae-auth-input",
                         data: {
                           kalendarium_task_slot_target: "durationInput",
                           action: "change->kalendarium-task-slot#durationChanged"
                         } %>
          <%= label_tag :ends_at_local, "End", class: "notae-page-subtle" %>
          <%= datetime_local_field_tag :ends_at_local,
                                       nil,
                                       class: "notae-auth-input",
                                       data: {
                                         kalendarium_task_slot_target: "endInput",
                                         action: "change->kalendarium-task-slot#endChanged"
                                       } %>

          <div class="notae-danger-modal-actions">
            <button type="button" class="notae-chip-button" data-action="kalendarium-task-slot#close">Cancel</button>
            <%= submit_tag "Schedule task", class: "notae-chip-button" %>
          </div>
        <% end %>
      </div>
    </dialog>
  <% end %>
</section>
