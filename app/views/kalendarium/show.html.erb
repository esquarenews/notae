<% content_for :title, "Kalendārium" %>
<% content_for :topbar_page_icon, "🗓️" %>
<% content_for :topbar_privacy, @workspace.name %>
<% content_for :content_class, "notae-content-page" %>
<% content_for :topbar_actions do %>
  <%= link_to "Settings", workspace_kalendarium_settings_path(workspace_slug: @workspace.slug), class: "notae-chip-button" %>
<% end %>

<section class="notae-kalendarium"
         data-controller="kalendarium-focus"
         data-kalendarium-focus-selected-date-value="<%= @selected_date.strftime("%Y-%m-%d") %>"
         data-kalendarium-focus-view-value="<%= @view %>">
  <header class="notae-kalendarium-head notae-auth-card">
    <div class="notae-kalendarium-head-top">
      <h1>Kalendārium</h1>
      <div class="notae-kalendarium-nav-buttons">
        <% year_daily_events_param = @show_year_daily_events ? "1" : nil %>
        <% previous_date = case @view
                          when "day" then @selected_date - 1.day
                          when "week" then @selected_date - 1.week
                          when "year" then @selected_date - 1.year
                          else @selected_date - 1.month
                          end %>
        <% next_date = case @view
                      when "day" then @selected_date + 1.day
                      when "week" then @selected_date + 1.week
                      when "year" then @selected_date + 1.year
                      else @selected_date + 1.month
                      end %>
        <% selected_date_label = case @view
                                 when "day"
                                   @selected_date.strftime("%A, %-d %B %Y")
                                 when "year"
                                   @selected_date.strftime("%Y")
                                 else
                                   @selected_date.strftime("%b %-d, %Y")
                                 end %>
        <%= link_to "←", kalendarium_path(workspace_slug: @workspace.slug, view: @view, date: previous_date, project_id: @selected_project_id, calendar_ids: @selected_calendar_ids, year_daily_events: year_daily_events_param), class: "notae-chip-button" %>
        <span class="notae-kalendarium-date-label" data-kalendarium-focus-target="dateLabel"><%= selected_date_label %></span>
        <%= link_to "→", kalendarium_path(workspace_slug: @workspace.slug, view: @view, date: next_date, project_id: @selected_project_id, calendar_ids: @selected_calendar_ids, year_daily_events: year_daily_events_param), class: "notae-chip-button" %>
        <%= link_to "Today", kalendarium_path(workspace_slug: @workspace.slug, view: @view, date: Date.current, project_id: @selected_project_id, calendar_ids: @selected_calendar_ids, year_daily_events: year_daily_events_param), class: "notae-chip-button" %>
      </div>
    </div>

    <div class="notae-kalendarium-head-row">
      <div class="notae-kalendarium-view-switch">
        <% KalendariumController::VIEW_OPTIONS.each do |view_option| %>
          <%= link_to view_option.titleize,
                      kalendarium_path(workspace_slug: @workspace.slug, view: view_option, date: @selected_date, project_id: @selected_project_id, calendar_ids: @selected_calendar_ids, year_daily_events: year_daily_events_param),
                      class: ["notae-chip-button", ("is-active" if @view == view_option)].compact.join(" "),
                      data: { kalendarium_focus_target: "viewLink", view_option: view_option } %>
        <% end %>
      </div>

      <div class="notae-kalendarium-filter-controls">
        <%= button_to refresh_kalendarium_path(workspace_slug: @workspace.slug),
                      method: :post,
                      params: {
                        view: @view,
                        date: @selected_date,
                        project_id: @selected_project_id,
                        calendar_ids: @selected_calendar_ids,
                        year_daily_events: year_daily_events_param
                      },
                      class: "notae-chip-button notae-kalendarium-refresh-button",
                      title: "Refresh calendars",
                      aria: { label: "Refresh calendars" } do %>
          <span class="notae-kalendarium-refresh-glyph" aria-hidden="true">↻</span>
        <% end %>

        <div class="notae-kalendarium-workspace-filter" data-controller="auto-submit">
          <% workspace_options = @workspace_options.map do |workspace_option|
               [
                 workspace_option.name,
                 kalendarium_path(
                   workspace_slug: workspace_option.slug,
                   view: @view,
                   date: @selected_date,
                   year_daily_events: year_daily_events_param
                 )
               ]
             end %>
          <%= select_tag :kalendarium_workspace,
                         options_for_select(
                           workspace_options,
                           kalendarium_path(workspace_slug: @workspace.slug, view: @view, date: @selected_date, year_daily_events: year_daily_events_param)
                         ),
                         class: "notae-chip-button notae-kalendarium-workspace-select",
                         data: { action: "change->auto-submit#navigate" },
                         aria: { label: "Select workspace calendar view" } %>
        </div>

        <%= form_with url: kalendarium_path(workspace_slug: @workspace.slug), method: :get, class: "notae-kalendarium-calendar-filter" do |form| %>
          <%= hidden_field_tag :view, @view %>
          <%= hidden_field_tag :date, @selected_date, data: { kalendarium_focus_target: "dateInput" } %>
          <%= hidden_field_tag :project_id, @selected_project_id %>
          <%= hidden_field_tag :year_daily_events, year_daily_events_param %>
          <%= hidden_field_tag :calendar_filter_applied, "1" %>
          <details data-controller="floating-panel"
                   data-action="toggle->floating-panel#toggle">
            <summary class="notae-chip-button" data-floating-panel-target="summary">Calendars (<%= @selected_calendar_ids.size %>)</summary>
            <div class="notae-kalendarium-calendar-popover" data-floating-panel-target="panel">
              <% @calendar_filter_calendars.each do |calendar| %>
                <label class="notae-options-checkbox">
                  <%= check_box_tag "calendar_ids[]", calendar.id, @selected_calendar_ids.include?(calendar.id.to_s) %>
                  <span class="notae-kalendarium-dot" style="--kal-color: <%= calendar.color_hex %>"></span>
                  <span><%= calendar.name %></span>
                </label>
              <% end %>
              <div class="notae-kalendarium-calendar-popover-actions">
                <%= submit_tag "Apply", class: "notae-chip-button" %>
              </div>
            </div>
          </details>
        <% end %>

        <% selected_project = @projects.find { |project| project.id.to_s == @selected_project_id } %>
        <% selected_project_label = selected_project&.name || "All" %>
        <%= form_with url: kalendarium_path(workspace_slug: @workspace.slug), method: :get, class: "notae-kalendarium-project-filter" do |form| %>
          <%= hidden_field_tag :view, @view %>
          <%= hidden_field_tag :date, @selected_date, data: { kalendarium_focus_target: "dateInput" } %>
          <%= hidden_field_tag :year_daily_events, year_daily_events_param %>
          <% @selected_calendar_ids.each do |calendar_id| %>
            <%= hidden_field_tag "calendar_ids[]", calendar_id %>
          <% end %>
          <details data-controller="floating-panel"
                   data-action="toggle->floating-panel#toggle">
            <summary class="notae-chip-button" data-floating-panel-target="summary">Projects (<%= selected_project_label %>)</summary>
            <div class="notae-kalendarium-project-popover" data-floating-panel-target="panel">
              <% if @projects.any? %>
                <label class="notae-options-checkbox">
                  <%= radio_button_tag :project_id, "", @selected_project_id.blank? %>
                  <span>All projects</span>
                </label>
                <% @projects.each do |project| %>
                  <div class="notae-kalendarium-project-option-row">
                    <label class="notae-options-checkbox">
                      <%= radio_button_tag :project_id, project.id, @selected_project_id == project.id.to_s %>
                      <span><%= project.name %></span>
                    </label>
                    <div class="notae-kalendarium-project-option-actions">
                      <%= link_to "Archive",
                                  archive_kalendarium_project_path(
                                    workspace_slug: @workspace.slug,
                                    id: project.id,
                                    view: @view,
                                    date: @selected_date,
                                    project_id: @selected_project_id,
                                    calendar_ids: @selected_calendar_ids,
                                    year_daily_events: year_daily_events_param
                                  ),
                                  class: "notae-kalendarium-project-action-link",
                                  data: { turbo_method: :patch, turbo_confirm: "Archive #{project.name}?" } %>
                      <%= link_to "Delete",
                                  kalendarium_project_path(
                                    workspace_slug: @workspace.slug,
                                    id: project.id,
                                    view: @view,
                                    date: @selected_date,
                                    project_id: @selected_project_id,
                                    calendar_ids: @selected_calendar_ids,
                                    year_daily_events: year_daily_events_param
                                  ),
                                  class: "notae-kalendarium-project-action-link is-danger",
                                  data: { turbo_method: :delete, turbo_confirm: "Delete #{project.name}? This removes the project and unassigns its events." } %>
                    </div>
                  </div>
                <% end %>
              <% else %>
                <p class="notae-options-empty">No projects yet.</p>
              <% end %>
              <div class="notae-kalendarium-calendar-popover-actions">
                <%= submit_tag "Apply", class: "notae-chip-button" %>
              </div>
            </div>
          </details>
        <% end %>
        <% if @view == "year" %>
          <%= form_with url: kalendarium_path(workspace_slug: @workspace.slug), method: :get, class: "notae-kalendarium-year-toggle", data: { controller: "auto-submit" } do |form| %>
            <%= hidden_field_tag :view, @view %>
            <%= hidden_field_tag :date, @selected_date %>
            <%= hidden_field_tag :project_id, @selected_project_id %>
            <% @selected_calendar_ids.each do |calendar_id| %>
              <%= hidden_field_tag "calendar_ids[]", calendar_id %>
            <% end %>
            <label class="notae-kalendarium-year-toggle-label">
              <%= check_box_tag :year_daily_events, "1", @show_year_daily_events, data: { action: "change->auto-submit#submit" } %>
              <span>Show daily events</span>
            </label>
          <% end %>
        <% end %>
      </div>
    </div>
  </header>

  <section class="notae-kalendarium-grid">
    <aside class="notae-kalendarium-sidebar notae-auth-card">
      <details class="notae-kalendarium-sidebar-accordion">
        <summary class="notae-kalendarium-sidebar-accordion-summary">Create event</summary>
        <div class="notae-kalendarium-sidebar-accordion-body">
          <div class="notae-kalendarium-sidebar-accordion-body-inner">
            <%= form_with model: @new_event,
                          url: kalendarium_events_path(workspace_slug: @workspace.slug),
                          class: "notae-kalendarium-form",
                          data: {
                            controller: "kalendarium-event-form",
                            kalendarium_event_form_enforce_future_end_value: true
                          } do |form| %>
              <%= hidden_field_tag :view, @view %>
              <%= hidden_field_tag :date, @selected_date, data: { kalendarium_focus_target: "dateInput" } %>
              <%= form.text_field :title, placeholder: "Event title", required: true, class: "notae-auth-input" %>
              <%= form.select :kalendarium_calendar_id,
                              options_from_collection_for_select(@visible_calendars, :id, :name),
                              {},
                              class: "notae-auth-input" %>
              <%= form.select :kalendarium_project_id,
                              options_for_select([["No project", ""]] + @projects.map { |project| [project.name, project.id] }, @selected_project_id),
                              {},
                              class: "notae-auth-input" %>
              <%= form.datetime_local_field :starts_at_local,
                                            value: @selected_date.to_time.change(hour: 9).strftime("%Y-%m-%dT%H:%M"),
                                            class: "notae-auth-input",
                                            data: {
                                              kalendarium_event_form_target: "startInput",
                                              action: "change->kalendarium-event-form#startChanged"
                                            } %>
              <%= form.datetime_local_field :ends_at_local,
                                            value: @selected_date.to_time.change(hour: 10).strftime("%Y-%m-%dT%H:%M"),
                                            min: Time.current.in_time_zone(current_user.time_zone).strftime("%Y-%m-%dT%H:%M"),
                                            class: "notae-auth-input",
                                            data: {
                                              kalendarium_event_form_target: "endInput",
                                              action: "change->kalendarium-event-form#endChanged"
                                            } %>
              <label class="notae-options-checkbox">
                <%= form.check_box :all_day,
                                   data: {
                                     kalendarium_event_form_target: "allDayInput",
                                     action: "change->kalendarium-event-form#toggleAllDay"
                                   } %>
                <span>All day</span>
              </label>
              <%= form.text_field :location, placeholder: "Location", class: "notae-auth-input" %>
              <%= form.text_area :description, rows: 3, placeholder: "Description", class: "notae-auth-input" %>
              <%= form.hidden_field :linked_page_action, value: "" %>
              <%= form.submit "Create", class: "notae-chip-button" %>
            <% end %>
          </div>
        </div>
      </details>

      <details class="notae-kalendarium-sidebar-accordion">
        <summary class="notae-kalendarium-sidebar-accordion-summary">Create project</summary>
        <div class="notae-kalendarium-sidebar-accordion-body">
          <div class="notae-kalendarium-sidebar-accordion-body-inner">
            <%= form_with model: @new_project,
                          url: kalendarium_projects_path(workspace_slug: @workspace.slug),
                          class: "notae-kalendarium-form" do |form| %>
              <%= form.text_field :name, placeholder: "Project name", required: true, class: "notae-auth-input" %>
              <%= form.text_field :slug, placeholder: "project-slug", class: "notae-auth-input" %>
              <%= form.color_field :color_hex, value: "#8B5CF6", class: "notae-auth-input" %>
              <div class="notae-kalendarium-project-actions">
                <%= button_tag "Quick link Nota", type: "submit", name: "kalendarium_project[linked_page_action]", value: "create_page", class: "notae-chip-button" %>
                <%= form.submit "Create project", class: "notae-chip-button" %>
              </div>
            <% end %>
          </div>
        </div>
      </details>

      <% if @time_zone_rail.any? %>
        <section class="notae-kalendarium-timezones-section">
          <h2>Time zones</h2>
          <ul class="notae-kalendarium-timezones">
            <% @time_zone_rail.each do |time_zone| %>
              <% zone = ActiveSupport::TimeZone[time_zone] %>
              <% next if zone.blank? %>
              <li>
                <strong><%= time_zone %></strong>
                <span><%= Time.current.in_time_zone(zone).strftime("%H:%M") %></span>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </aside>

    <div class="notae-kalendarium-main notae-auth-card">
      <% today_local = Time.current.in_time_zone(current_user.time_zone).to_date %>
      <% if @view == "day" %>
        <h2><%= @selected_date.strftime("%A, %-d %B %Y") %></h2>
        <% slot_height = 28 %>
        <% slots_per_day = 48 %>
        <% day_all_day_events = @day_timeline[:all_day_events] %>
        <% day_timed_events = @day_timeline[:timed_events] %>
        <div class="notae-kalendarium-timeline"
             data-controller="kalendarium-timeline"
             data-kalendarium-timeline-start-hour-value="5"
             data-kalendarium-timeline-slot-height-value="<%= slot_height %>"
             data-kalendarium-timeline-all-day-offset-value="<%= @day_all_day_offset %>"
             data-kalendarium-timeline-time-zone-value="<%= current_user.time_zone %>">
          <div class="notae-kalendarium-timeline-scroller" data-kalendarium-timeline-target="scroller">
            <div class="notae-kalendarium-day-columns">
              <div class="notae-kalendarium-time-rail" aria-hidden="true">
                <% 24.times do |hour| %>
                  <div class="notae-kalendarium-time-hour" style="--kal-slot-height: <%= slot_height %>px;">
                    <span><%= format("%02d:00", hour) %></span>
                    <span class="notae-kalendarium-time-half"></span>
                  </div>
                <% end %>
              </div>
              <div class="notae-kalendarium-day-track"
                   style="--kal-slot-height: <%= slot_height %>px; --kal-slots-per-day: <%= slots_per_day %>; --kal-all-day-offset: <%= @day_all_day_offset %>px;">
                <% if @day_all_day_offset.positive? %>
                  <div class="notae-kalendarium-all-day-strip">
                    <% day_all_day_events.each do |event| %>
                      <%= render "kalendarium_event",
                                 event: event,
                                 workspace: @workspace,
                                 view: @view,
                                 date: @selected_date,
                                 calendars: @all_calendars,
                                 projects: @projects,
                                 compact: true,
                                 all_day: true %>
                    <% end %>
                  </div>
                <% end %>
                <div class="notae-kalendarium-slot-grid" aria-hidden="true">
                  <% slots_per_day.times do |slot| %>
                    <div class="notae-kalendarium-slot-line <%= "is-hour" if (slot % 2).zero? %>"></div>
                  <% end %>
                </div>
                <div class="notae-kalendarium-events-layer">
                  <div class="notae-kalendarium-now-line"
                       data-kalendarium-timeline-target="nowLine"
                       data-now-date="<%= @selected_date.strftime("%Y-%m-%d") %>"
                       aria-hidden="true"
                       hidden>
                    <span class="notae-kalendarium-now-line-label"
                          data-kalendarium-timeline-target="nowLineLabel"></span>
                  </div>
                  <% day_timed_events.each do |placement| %>
                    <%= render "kalendarium_event",
                               event: placement[:event],
                               workspace: @workspace,
                               view: @view,
                               date: @selected_date,
                               calendars: @all_calendars,
                               projects: @projects,
                               timeline: true,
                               timeline_style: placement[:timeline_style] %>
                  <% end %>
                </div>
                <% if day_timed_events.blank? && day_all_day_events.blank? %>
                  <p class="notae-page-subtle notae-kalendarium-empty-message">No events for this day.</p>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% elsif @view == "week" %>
        <h2>Week view</h2>
        <% slot_height = 28 %>
        <% slots_per_day = 48 %>
        <div class="notae-kalendarium-week-timeline"
             data-controller="kalendarium-timeline"
             data-kalendarium-timeline-start-hour-value="5"
             data-kalendarium-timeline-slot-height-value="<%= slot_height %>"
             data-kalendarium-timeline-all-day-offset-value="<%= @week_all_day_offset %>"
             data-kalendarium-timeline-time-zone-value="<%= current_user.time_zone %>">
          <div class="notae-kalendarium-week-header">
            <span class="notae-kalendarium-week-header-spacer" aria-hidden="true"></span>
            <div class="notae-kalendarium-week-header-days">
              <% @week_days.each do |day| %>
                <div>
                  <%= link_to kalendarium_path(workspace_slug: @workspace.slug,
                                               view: @view,
                                               date: day,
                                               project_id: @selected_project_id,
                                               calendar_ids: @selected_calendar_ids,
                                               year_daily_events: year_daily_events_param),
                              class: ["notae-kalendarium-day-focus-link", ("is-selected" if day == @selected_date)].compact.join(" "),
                              data: {
                                action: "click->kalendarium-focus#selectDay",
                                kalendarium_focus_target: "dayLink",
                                kalendarium_day_focus: true,
                                day_date: day.strftime("%Y-%m-%d")
                              } do %>
                    <strong><%= day.strftime("%a") %></strong>
                    <span><%= day.strftime("%-d %b") %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
          <div class="notae-kalendarium-timeline-scroller notae-kalendarium-timeline-scroller-week" data-kalendarium-timeline-target="scroller">
            <div class="notae-kalendarium-week-body">
              <div class="notae-kalendarium-time-rail" aria-hidden="true">
                <% 24.times do |hour| %>
                  <div class="notae-kalendarium-time-hour" style="--kal-slot-height: <%= slot_height %>px;">
                    <span><%= format("%02d:00", hour) %></span>
                    <span class="notae-kalendarium-time-half"></span>
                  </div>
                <% end %>
              </div>
              <div class="notae-kalendarium-week-columns">
                <% @week_days.each do |day| %>
                  <% day_timeline = @week_timelines[day] || { all_day_events: [], timed_events: [] } %>
                  <% day_all_day_events = day_timeline[:all_day_events] %>
                  <% day_timed_events = day_timeline[:timed_events] %>
                  <div class="<%= ["notae-kalendarium-week-day-track", ("is-selected" if day == @selected_date)].compact.join(" ") %>"
                       data-kalendarium-focus-target="weekTrack"
                       data-day-date="<%= day.strftime("%Y-%m-%d") %>"
                       style="--kal-slot-height: <%= slot_height %>px; --kal-slots-per-day: <%= slots_per_day %>; --kal-all-day-offset: <%= @week_all_day_offset %>px;">
                    <header class="notae-kalendarium-week-day-label">
                      <%= link_to kalendarium_path(workspace_slug: @workspace.slug,
                                                   view: @view,
                                                   date: day,
                                                   project_id: @selected_project_id,
                                                   calendar_ids: @selected_calendar_ids,
                                                   year_daily_events: year_daily_events_param),
                                  class: ["notae-kalendarium-day-focus-link", ("is-selected" if day == @selected_date)].compact.join(" "),
                                  data: {
                                    action: "click->kalendarium-focus#selectDay",
                                    kalendarium_focus_target: "dayLink",
                                    kalendarium_day_focus: true,
                                    day_date: day.strftime("%Y-%m-%d")
                                  } do %>
                        <strong><%= day.strftime("%a") %></strong>
                        <span><%= day.strftime("%-d %b") %></span>
                      <% end %>
                    </header>
                    <% if @week_all_day_offset.positive? %>
                      <div class="notae-kalendarium-all-day-strip">
                        <% day_all_day_events.each do |event| %>
                          <%= render "kalendarium_event",
                                     event: event,
                                     workspace: @workspace,
                                     view: @view,
                                     date: @selected_date,
                                     calendars: @all_calendars,
                                     projects: @projects,
                                     compact: true,
                                     all_day: true %>
                        <% end %>
                      </div>
                    <% end %>
                    <div class="notae-kalendarium-slot-grid" aria-hidden="true">
                      <% slots_per_day.times do |slot| %>
                        <div class="notae-kalendarium-slot-line <%= "is-hour" if (slot % 2).zero? %>"></div>
                      <% end %>
                    </div>
                    <div class="notae-kalendarium-events-layer">
                      <div class="notae-kalendarium-now-line"
                           data-kalendarium-timeline-target="nowLine"
                           data-now-date="<%= day.strftime("%Y-%m-%d") %>"
                           aria-hidden="true"
                           hidden>
                        <span class="notae-kalendarium-now-line-label"
                              data-kalendarium-timeline-target="nowLineLabel"></span>
                      </div>
                      <% day_timed_events.each do |placement| %>
                        <%= render "kalendarium_event",
                                   event: placement[:event],
                                   workspace: @workspace,
                                   view: @view,
                                   date: @selected_date,
                                   calendars: @all_calendars,
                                   projects: @projects,
                                   timeline: true,
                                   timeline_style: placement[:timeline_style] %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      <% elsif @view == "year" %>
        <h2><%= @selected_date.strftime("%Y") %></h2>
        <div class="notae-kalendarium-year-grid">
          <% @year_months.each do |month_date| %>
            <% month_count = @events.count { |event| event.starts_at_utc.in_time_zone(current_user.time_zone).month == month_date.month } %>
            <% month_grid_start = month_date.beginning_of_month.beginning_of_week(@week_start_day) %>
            <% month_grid_end = month_date.end_of_month.end_of_week(@week_start_day) %>
            <article class="notae-kalendarium-year-card">
              <header class="notae-kalendarium-year-card-header">
                <%= link_to month_date.strftime("%B"),
                            kalendarium_path(workspace_slug: @workspace.slug,
                                             view: "month",
                                             date: month_date,
                                             project_id: @selected_project_id,
                                             calendar_ids: @selected_calendar_ids,
                                             year_daily_events: year_daily_events_param),
                            class: "notae-kalendarium-year-month-link" %>
                <span><%= pluralize(month_count, "event") %></span>
              </header>
              <div class="notae-kalendarium-year-month-grid">
                <% @year_weekday_labels.each do |weekday| %>
                  <span class="notae-kalendarium-year-weekday"><%= weekday %></span>
                <% end %>
                <% (month_grid_start..month_grid_end).each do |day| %>
                  <% in_month = day.month == month_date.month %>
                  <% day_events = @show_year_daily_events ? (@events_by_day[day] || []) : [] %>
                  <% first_day_event = day_events.first %>
                  <% hidden_day_event_count = [day_events.size - 1, 0].max %>
                  <% first_event_color = first_day_event&.kalendarium_calendar&.color_hex.presence || "#3b82f6" %>
                  <%= link_to kalendarium_path(workspace_slug: @workspace.slug,
                                               view: "year",
                                               date: day,
                                               project_id: @selected_project_id,
                                               calendar_ids: @selected_calendar_ids,
                                               year_daily_events: year_daily_events_param),
                              class: [
                                "notae-kalendarium-year-day",
                                ("is-outside-month" unless in_month),
                                ("is-today" if day == today_local),
                                ("is-selected" if day == @selected_date),
                                ("has-event-label" if first_day_event.present?)
                              ].compact.join(" "),
                              data: {
                                action: "click->kalendarium-focus#selectDay",
                                kalendarium_focus_target: "dayLink",
                                kalendarium_day_focus: true,
                                day_date: day.strftime("%Y-%m-%d")
                              } do %>
                    <span class="notae-kalendarium-year-day-number"><%= day.day %></span>
                    <% if first_day_event.present? %>
                      <span class="notae-kalendarium-year-day-event-label" style="--kal-year-event-color: <%= first_event_color %>;">
                        <%= truncate(first_day_event.title.to_s, length: 18) %><%= hidden_day_event_count.positive? ? " +#{hidden_day_event_count}" : "" %>
                      </span>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
      <% elsif @view == "project" %>
        <h2>Project view</h2>
        <% if @projects.any? %>
          <div class="notae-kalendarium-project-grid">
            <% @projects.each do |project| %>
              <article class="notae-kalendarium-project-card">
                <header>
                  <div class="notae-kalendarium-project-card-title">
                    <span class="notae-kalendarium-dot" style="--kal-color: <%= project.color_hex %>"></span>
                    <strong><%= project.name %></strong>
                  </div>
                  <div class="notae-kalendarium-project-card-actions">
                    <%= button_to "Archive",
                                  archive_kalendarium_project_path(workspace_slug: @workspace.slug, id: project.id, view: @view, date: @selected_date, project_id: @selected_project_id, calendar_ids: @selected_calendar_ids),
                                  method: :patch,
                                  class: "notae-chip-button",
                                  form: { data: { turbo_confirm: "Archive #{project.name}?" } } %>
                    <%= button_to "Delete",
                                  kalendarium_project_path(workspace_slug: @workspace.slug, id: project.id, view: @view, date: @selected_date, project_id: @selected_project_id, calendar_ids: @selected_calendar_ids),
                                  method: :delete,
                                  class: "notae-chip-button notae-chip-danger",
                                  form: { data: { turbo_confirm: "Delete #{project.name}? This removes the project and unassigns its events." } } %>
                  </div>
                </header>
                <% project_events = @events.select { |event| event.kalendarium_project_id == project.id } %>
                <% if project.linked_page.present? %>
                  <p><%= link_to "Linked Nota", page_path(workspace_slug: @workspace.slug, id: project.linked_page_id), class: "notae-utility-link" %></p>
                <% end %>
                <% if project_events.any? %>
                  <% project_events.first(6).each do |event| %>
                    <%= render "kalendarium_event",
                               event: event,
                               workspace: @workspace,
                               view: @view,
                               date: @selected_date,
                               calendars: @all_calendars,
                               projects: @projects %>
                  <% end %>
                <% else %>
                  <p class="notae-page-subtle">No events yet.</p>
                <% end %>
              </article>
            <% end %>
          </div>
          <% if @archived_projects.any? %>
            <section class="notae-kalendarium-archived-projects">
              <h3>Archived projects</h3>
              <ul class="notae-kalendarium-archived-project-list">
                <% @archived_projects.each do |project| %>
                  <li>
                    <span><%= project.name %></span>
                    <div class="notae-kalendarium-project-card-actions">
                      <%= button_to "Restore",
                                    unarchive_kalendarium_project_path(workspace_slug: @workspace.slug, id: project.id, view: @view, date: @selected_date, calendar_ids: @selected_calendar_ids),
                                    method: :patch,
                                    class: "notae-chip-button" %>
                      <%= button_to "Delete",
                                    kalendarium_project_path(workspace_slug: @workspace.slug, id: project.id, view: @view, date: @selected_date, calendar_ids: @selected_calendar_ids),
                                    method: :delete,
                                    class: "notae-chip-button notae-chip-danger",
                                    form: { data: { turbo_confirm: "Delete archived project #{project.name}?" } } %>
                    </div>
                  </li>
                <% end %>
              </ul>
            </section>
          <% end %>
        <% else %>
          <p class="notae-page-subtle">No projects yet.</p>
          <% if @archived_projects.any? %>
            <section class="notae-kalendarium-archived-projects">
              <h3>Archived projects</h3>
              <ul class="notae-kalendarium-archived-project-list">
                <% @archived_projects.each do |project| %>
                  <li>
                    <span><%= project.name %></span>
                    <div class="notae-kalendarium-project-card-actions">
                      <%= button_to "Restore",
                                    unarchive_kalendarium_project_path(workspace_slug: @workspace.slug, id: project.id, view: @view, date: @selected_date, calendar_ids: @selected_calendar_ids),
                                    method: :patch,
                                    class: "notae-chip-button" %>
                      <%= button_to "Delete",
                                    kalendarium_project_path(workspace_slug: @workspace.slug, id: project.id, view: @view, date: @selected_date, calendar_ids: @selected_calendar_ids),
                                    method: :delete,
                                    class: "notae-chip-button notae-chip-danger",
                                    form: { data: { turbo_confirm: "Delete archived project #{project.name}?" } } %>
                    </div>
                  </li>
                <% end %>
              </ul>
            </section>
          <% end %>
        <% end %>
      <% else %>
        <h2>Month view · <%= @selected_date.strftime("%B %Y") %></h2>
        <div class="notae-kalendarium-month-grid">
          <% @weekday_labels.each do |label| %>
            <div class="notae-kalendarium-month-weekday"><%= label %></div>
          <% end %>
          <% @month_days.each do |day| %>
            <% day_events = @events_by_day[day] || [] %>
            <section class="<%= ["notae-kalendarium-month-cell", ("is-today" if day == today_local), ("is-selected" if day == @selected_date)].compact.join(" ") %>"
                     data-kalendarium-focus-target="monthCell"
                     data-day-date="<%= day.strftime("%Y-%m-%d") %>">
              <header>
                <strong>
                  <%= link_to day.day,
                              kalendarium_path(workspace_slug: @workspace.slug,
                                               view: @view,
                                               date: day,
                                               project_id: @selected_project_id,
                                               calendar_ids: @selected_calendar_ids,
                                               year_daily_events: year_daily_events_param),
                              class: ["notae-kalendarium-month-day-focus-link", ("is-today" if day == today_local), ("is-selected" if day == @selected_date)].compact.join(" "),
                              data: {
                                action: "click->kalendarium-focus#selectDay",
                                kalendarium_focus_target: "dayLink",
                                kalendarium_day_focus: true,
                                day_date: day.strftime("%Y-%m-%d")
                              } %>
                </strong>
                <% if day_events.size > 3 %>
                  <span class="notae-kalendarium-month-overflow-label">+<%= day_events.size - 3 %> more</span>
                <% end %>
              </header>
              <div class="notae-kalendarium-month-events">
                <% day_events.first(3).each do |event| %>
                  <%= render "kalendarium_event",
                             event: event,
                             workspace: @workspace,
                             view: @view,
                             date: @selected_date,
                             calendars: @all_calendars,
                             projects: @projects %>
                <% end %>
              </div>
            </section>
          <% end %>
        </div>
      <% end %>

      <% if @pending_write_proposals.any? %>
        <section class="notae-kalendarium-proposals">
          <h3>Pending agent write proposals</h3>
          <ul>
            <% @pending_write_proposals.each do |proposal| %>
              <li>
                <div>
                  <strong><%= proposal.operation.titleize %></strong>
                  <code><%= proposal.payload_json.to_json %></code>
                </div>
                <div class="notae-kalendarium-proposal-actions">
                  <%= button_to "Confirm",
                                confirm_kalendarium_write_proposal_path(workspace_slug: @workspace.slug, id: proposal.id, view: @view, date: @selected_date),
                                method: :post,
                                class: "notae-chip-button" %>
                  <%= button_to "Reject",
                                reject_kalendarium_write_proposal_path(workspace_slug: @workspace.slug, id: proposal.id, view: @view, date: @selected_date),
                                method: :post,
                                class: "notae-chip-button" %>
                </div>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  </section>
</section>
