<% content_for :title, "Notifications settings" %>
<% content_for :topbar_page_icon, "🔔" %>
<% content_for :topbar_privacy, "Account" %>
<% content_for :topbar_actions do %>
  <%= link_to "Close", workspace_path(@workspace.slug), class: "notae-chip-button" %>
<% end %>

<section class="notae-settings-shell" data-controller="auto-submit">
  <%= render "shared/settings_nav", workspace: @workspace, active_item: :notifications %>

  <div class="notae-settings-content">
    <section class="notae-settings-section">
      <h2>In-app notifications</h2>

      <div class="notae-pref-row notae-pref-row--stacked">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Push notifications on this device</p>
          <p class="notae-pref-description" data-pwa-target="pushSettingsStatus">
            Enable push notifications for reminders, mentions, approvals, and workflow failures on this device.
          </p>
        </div>
        <div class="notae-pref-control-form notae-pref-control-form--push">
          <button type="button"
                  class="notae-pref-device-switch"
                  role="switch"
                  aria-checked="false"
                  aria-label="Push notifications"
                  data-pwa-target="pushSettingsToggle"
                  data-action="pwa#togglePush">
            <span class="notae-pref-device-switch-track"></span>
          </button>
          <span class="notae-pref-device-switch-state"
                data-pwa-target="pushSettingsStateLabel">
            Off
          </span>
        </div>
      </div>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Join video conferencing and start transcribing <span class="notae-pref-future">Future implementation</span></p>
          <p class="notae-pref-description">Planned for meeting integrations. Preference is saved now.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <label class="notae-pref-toggle">
            <%= form.check_box :meeting_notify_join_transcribing,
                               { class: "notae-pref-toggle-input", data: { action: "change->auto-submit#submit" } },
                               "1",
                               "0" %>
            <span class="notae-pref-toggle-track"></span>
          </label>
        <% end %>
      </div>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Meeting is being transcribed <span class="notae-pref-future">Future implementation</span></p>
          <p class="notae-pref-description">Planned in-app meeting status events. Preference is saved now.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <label class="notae-pref-toggle">
            <%= form.check_box :meeting_notify_transcribed,
                               { class: "notae-pref-toggle-input", data: { action: "change->auto-submit#submit" } },
                               "1",
                               "0" %>
            <span class="notae-pref-toggle-track"></span>
          </label>
        <% end %>
      </div>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Meeting is being summarized <span class="notae-pref-future">Future implementation</span></p>
          <p class="notae-pref-description">Planned in-app summary lifecycle notifications. Preference is saved now.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <label class="notae-pref-toggle">
            <%= form.check_box :meeting_notify_summarized,
                               { class: "notae-pref-toggle-input", data: { action: "change->auto-submit#submit" } },
                               "1",
                               "0" %>
            <span class="notae-pref-toggle-track"></span>
          </label>
        <% end %>
      </div>
    </section>

    <section class="notae-settings-section">
      <h2>Slack notifications</h2>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Slack notifications <span class="notae-pref-future">Future implementation</span></p>
          <p class="notae-pref-description">Slack delivery is planned; your preference is persisted now.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <%= form.select :slack_notification_preference,
                          options_for_select(User::CHANNEL_NOTIFICATION_OPTIONS, @user.slack_notification_preference),
                          {},
                          class: "notae-pref-select",
                          data: { action: "change->auto-submit#submit" } %>
        <% end %>
      </div>
    </section>

    <section class="notae-settings-section">
      <h2>Discord notifications</h2>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Discord notifications <span class="notae-pref-future">Future implementation</span></p>
          <p class="notae-pref-description">Discord delivery is planned; your preference is persisted now.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <%= form.select :discord_notification_preference,
                          options_for_select(User::CHANNEL_NOTIFICATION_OPTIONS, @user.discord_notification_preference),
                          {},
                          class: "notae-pref-select",
                          data: { action: "change->auto-submit#submit" } %>
        <% end %>
      </div>
    </section>

    <section class="notae-settings-section">
      <h2>Email notifications</h2>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Activity in my workspace</p>
          <p class="notae-pref-description">Email notices for comments, mentions, invites, reminders, and access requests.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <label class="notae-pref-toggle">
            <%= form.check_box :email_notify_activity,
                               { class: "notae-pref-toggle-input", data: { action: "change->auto-submit#submit" } },
                               "1",
                               "0" %>
            <span class="notae-pref-toggle-track"></span>
          </label>
        <% end %>
      </div>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Always send email notifications</p>
          <p class="notae-pref-description">Send workspace emails even while active in Notae.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <label class="notae-pref-toggle">
            <%= form.check_box :email_notify_always_send,
                               { class: "notae-pref-toggle-input", data: { action: "change->auto-submit#submit" } },
                               "1",
                               "0" %>
            <span class="notae-pref-toggle-track"></span>
          </label>
        <% end %>
      </div>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Nota updates</p>
          <p class="notae-pref-description">Digest emails for followed and owned Notarum.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <label class="notae-pref-toggle">
            <%= form.check_box :email_notify_page_updates,
                               { class: "notae-pref-toggle-input", data: { action: "change->auto-submit#submit" } },
                               "1",
                               "0" %>
            <span class="notae-pref-toggle-track"></span>
          </label>
        <% end %>
      </div>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Workspace digest</p>
          <p class="notae-pref-description">Digest emails about workspace activity summaries.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <label class="notae-pref-toggle">
            <%= form.check_box :email_notify_workspace_digest,
                               { class: "notae-pref-toggle-input", data: { action: "change->auto-submit#submit" } },
                               "1",
                               "0" %>
            <span class="notae-pref-toggle-track"></span>
          </label>
        <% end %>
      </div>
    </section>
  </div>
</section>
