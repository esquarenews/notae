<% content_for :title, "Notifications settings" %>
<% content_for :topbar_page_icon, "🔔" %>
<% content_for :topbar_privacy, "Account" %>
<% content_for :topbar_actions do %>
  <%= link_to "Close", workspace_path(workspace_slug: @workspace.slug), class: "notae-chip-button" %>
<% end %>
<% content_for :suppress_layout_flash, true %>

<%= render "shared/settings_flash_messages" %>
<section class="notae-settings-shell" data-controller="auto-submit">
  <%= render "shared/settings_nav", workspace: @workspace, active_item: :notifications %>

  <div class="notae-settings-content">
    <section class="notae-settings-section">
      <h2>In-app notifications</h2>

      <div class="notae-pref-row notae-pref-row--stacked">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Push notifications on this device</p>
          <p class="notae-pref-description" data-pwa-target="pushSettingsStatus">
            Enable push notifications for reminders, mentions, AI suggestions, approvals, and workflow failures on this device.
          </p>
        </div>
        <div class="notae-pref-control-form notae-pref-control-form--push">
          <button type="button"
                  class="notae-pref-device-switch"
                  role="switch"
                  aria-checked="false"
                  aria-label="Push notifications"
                  data-pwa-target="pushSettingsToggle"
                  data-action="pwa#togglePush">
            <span class="notae-pref-device-switch-track"></span>
          </button>
          <span class="notae-pref-device-switch-state"
                data-pwa-target="pushSettingsStateLabel">
            Off
          </span>
          <span class="notae-operations-pill is-warn"
                data-pwa-target="pushSettingsReadinessBadge">
            Needs review
          </span>
          <button type="button"
                  class="notae-chip-button notae-chip-button-subtle"
                  data-pwa-target="pushSettingsTestButton"
                  data-push-test-path="<%= workspace_notification_settings_test_push_path(workspace_slug: @workspace.slug) %>"
                  data-default-label="Send test push"
                  data-action="pwa#sendTestPush">
            Send test push
          </button>
        </div>
        <p class="notae-pref-inline-feedback"
           data-pwa-target="pushSettingsFeedback"
           aria-live="polite"></p>

        <details class="notae-push-readiness-card" data-pwa-target="pushReadinessCard" data-action="toggle->pwa#toggleReadinessCenter" open>
          <summary class="notae-push-readiness-summary">
            <span class="notae-push-readiness-summary-copy">
              <span class="notae-push-readiness-summary-caret">▾</span>
              <span class="notae-push-readiness-header">
                <span class="notae-pref-label">Notification readiness</span>
                <span class="notae-pref-description">Collapse this once the device is fully configured.</span>
              </span>
            </span>
            <span class="notae-push-readiness-summary-meta">
              <span class="notae-operations-pill is-warn" data-pwa-target="pushSettingsReadinessBadge">Needs review</span>
            </span>
          </summary>

          <div class="notae-push-readiness-list">
            <div class="notae-push-readiness-item">
              <span class="notae-push-readiness-item-copy">
                <strong>Browser permission</strong>
                <span data-pwa-target="pushReadinessPermissionDetail">Waiting for permission.</span>
              </span>
              <span class="notae-operations-pill is-warn" data-pwa-target="pushReadinessPermissionPill">Pending</span>
            </div>
            <div class="notae-push-readiness-item">
              <span class="notae-push-readiness-item-copy">
                <strong>Device subscription</strong>
                <span data-pwa-target="pushReadinessSubscriptionDetail">This browser has not subscribed yet.</span>
              </span>
              <span class="notae-operations-pill is-warn" data-pwa-target="pushReadinessSubscriptionPill">Pending</span>
            </div>
            <div class="notae-push-readiness-item">
              <span class="notae-push-readiness-item-copy">
                <strong>Test push delivery</strong>
                <span data-pwa-target="pushReadinessDeliveryDetail">Run a test push to verify server-to-device delivery for this browser.</span>
              </span>
              <span class="notae-operations-pill is-warn" data-pwa-target="pushReadinessDeliveryPill">Pending</span>
            </div>
            <div class="notae-push-readiness-item">
              <span class="notae-push-readiness-item-copy">
                <strong>Banner seen on device</strong>
                <span data-pwa-target="pushReadinessBannerDetail">Confirm that the operating system actually showed a banner, not just a Notification Center entry.</span>
              </span>
              <span class="notae-operations-pill is-warn" data-pwa-target="pushReadinessBannerPill">Pending</span>
            </div>
          </div>

          <div class="notae-push-banner-actions" data-pwa-target="pushBannerActions">
            <span class="notae-pref-description">After sending a test push, confirm whether you saw the on-device banner.</span>
            <div class="notae-push-banner-action-buttons">
              <button type="button"
                      class="notae-chip-button notae-chip-button-subtle"
                      data-pwa-target="pushBannerSeenButton"
                      data-action="pwa#confirmPushBannerSeen">
                I saw the banner
              </button>
              <button type="button"
                      class="notae-chip-button notae-chip-button-subtle"
                      data-pwa-target="pushBannerMissedButton"
                      data-action="pwa#confirmPushBannerMissed">
                No banner appeared
              </button>
            </div>
          </div>
        </details>
      </div>

      <%= form_with model: @user,
                    url: workspace_notification_settings_path(workspace_slug: @workspace.slug),
                    method: :patch,
                    class: "notae-workspace-home-stack",
                    data: { controller: "notification-preferences" } do %>
        <div class="notae-pref-row notae-pref-row--stacked">
          <div class="notae-pref-copy">
            <p class="notae-pref-label">Push notification types</p>
            <p class="notae-pref-description">Choose which Notae events are allowed to interrupt this device. Workflow failures bypass quiet hours.</p>
          </div>

          <div class="notae-workspace-home-stack">
            <div class="notae-pref-row">
              <div class="notae-pref-copy">
                <p class="notae-pref-label">Master push switch</p>
                <p class="notae-pref-description">Enable or disable all Notae push notification categories at once.</p>
              </div>
              <div class="notae-pref-control-form">
                <label class="notae-pref-toggle">
                  <%= hidden_field_tag "user[push_notifications_master]", "0" %>
                  <%= check_box_tag "user[push_notifications_master]",
                                    "1",
                                    User.push_notification_types.all? { |type| @user.push_notification_enabled_for?(type) },
                                    class: "notae-pref-toggle-input",
                                    data: {
                                      action: "change->notification-preferences#toggleAll change->auto-submit#submit",
                                      notification_preferences_target: "masterToggle"
                                    } %>
                  <span class="notae-pref-toggle-track"></span>
                </label>
              </div>
            </div>

            <% User::PUSH_NOTIFICATION_OPTIONS.each do |option| %>
              <div class="notae-pref-row">
                <div class="notae-pref-copy">
                  <p class="notae-pref-label"><%= option[:label] %></p>
                  <p class="notae-pref-description"><%= option[:description] %></p>
                </div>
                <div class="notae-pref-control-form">
                  <label class="notae-pref-toggle">
                    <%= hidden_field_tag "user[#{option[:param_key]}]", "0" %>
                    <%= check_box_tag "user[#{option[:param_key]}]",
                                      "1",
                                      @user.push_notification_enabled_for?(option[:type]),
                                      class: "notae-pref-toggle-input",
                                      data: {
                                        action: "change->notification-preferences#syncMaster change->auto-submit#submit",
                                        notification_preferences_target: "itemToggle"
                                      } %>
                    <span class="notae-pref-toggle-track"></span>
                  </label>
                </div>
              </div>
            <% end %>
          </div>
        </div>

        <div class="notae-pref-row notae-pref-row--stacked">
          <div class="notae-pref-copy">
            <p class="notae-pref-label">Quiet hours</p>
            <p class="notae-pref-description">Suppress routine push notifications during your local quiet hours. Workflow failures still break through.</p>
          </div>

          <div class="notae-workspace-home-stack">
            <div class="notae-pref-row">
              <div class="notae-pref-copy">
                <p class="notae-pref-label">Enable quiet hours</p>
                <p class="notae-pref-description">Current Notae time zone: <strong><%= @user.time_zone %></strong>.</p>
              </div>
              <div class="notae-pref-control-form">
                <label class="notae-pref-toggle">
                  <%= hidden_field_tag "user[push_quiet_hours_enabled]", "0" %>
                  <%= check_box_tag "user[push_quiet_hours_enabled]",
                                    "1",
                                    @user.push_quiet_hours_enabled?,
                                    class: "notae-pref-toggle-input",
                                    data: { action: "change->auto-submit#submit" } %>
                  <span class="notae-pref-toggle-track"></span>
                </label>
              </div>
            </div>

            <div class="notae-pref-row notae-pref-row--quiet-hours-window">
              <div class="notae-pref-copy">
                <p class="notae-pref-label">Quiet hours window</p>
                <p class="notae-pref-description">Cross-midnight windows are supported, for example 22:00 to 07:00.</p>
              </div>
              <div class="notae-pref-control-form notae-pref-control-form--quiet-hours">
                <label class="notae-quiet-hours-field">
                  <span class="notae-quiet-hours-field-label">Start</span>
                  <%= time_field_tag "user[push_quiet_hours_starts_at]",
                                     @user.push_quiet_hours_starts_at,
                                     class: "notae-pref-select notae-pref-select--quiet-hours",
                                     data: { action: "change->auto-submit#submit" } %>
                </label>
                <label class="notae-quiet-hours-field">
                  <span class="notae-quiet-hours-field-label">End</span>
                  <%= time_field_tag "user[push_quiet_hours_ends_at]",
                                     @user.push_quiet_hours_ends_at,
                                     class: "notae-pref-select notae-pref-select--quiet-hours",
                                     data: { action: "change->auto-submit#submit" } %>
                </label>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </section>

    <section class="notae-settings-section">
      <h2>Push delivery state</h2>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Current workspace override</p>
          <p class="notae-pref-description">Override the global activity-email default for <strong><%= @workspace.name %></strong> when it makes sense to treat this workspace differently.</p>
        </div>
        <%= form_with url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do %>
          <label class="notae-pref-toggle">
            <%= hidden_field_tag "membership[email_notify_activity]", "0" %>
            <%= check_box_tag "membership[email_notify_activity]",
                              "1",
                              @workspace_membership&.workspace_email_notify_activity_enabled?(default: @user.email_notify_activity?),
                              class: "notae-pref-toggle-input",
                              data: { action: "change->auto-submit#submit" } %>
            <span class="notae-pref-toggle-track"></span>
          </label>
        <% end %>
      </div>

      <% if @push_subscriptions.any? %>
        <div class="notae-operations-list">
          <% @push_subscriptions.each do |subscription| %>
            <article class="notae-operations-item">
              <div class="notae-operations-item-copy">
                <p class="notae-operations-item-title"><%= subscription.endpoint_host %></p>
                <p class="notae-operations-item-subtitle">Subscribed <%= time_ago_in_words(subscription.created_at) %> ago</p>
                <p class="notae-operations-item-meta">
                  <span>Last delivered <%= subscription.last_delivered_at.present? ? "#{time_ago_in_words(subscription.last_delivered_at)} ago" : "Never" %></span>
                  <% if subscription.last_error_message.present? %>
                    <span>Last error: <%= subscription.last_error_message %></span>
                  <% end %>
                </p>
              </div>
              <div class="notae-operations-pills">
                <% status_class = subscription.delivery_status == :healthy ? "is-ok" : (subscription.delivery_status == :failing ? "is-error" : "is-warn") %>
                <span class="notae-operations-pill <%= status_class %>"><%= subscription.delivery_status.to_s.humanize %></span>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="notae-page-subtle">No push subscriptions are registered for this account yet.</p>
      <% end %>
    </section>


    <section class="notae-settings-section">
      <h2>Email notifications</h2>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Activity email default</p>
          <p class="notae-pref-description">Default email behaviour for comments, mentions, invites, reminders, and access requests across workspaces.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <label class="notae-pref-toggle">
            <%= form.check_box :email_notify_activity,
                               { class: "notae-pref-toggle-input", data: { action: "change->auto-submit#submit" } },
                               "1",
                               "0" %>
            <span class="notae-pref-toggle-track"></span>
          </label>
        <% end %>
      </div>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Always send email notifications</p>
          <p class="notae-pref-description">Send workspace emails even while active in Notae.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <label class="notae-pref-toggle">
            <%= form.check_box :email_notify_always_send,
                               { class: "notae-pref-toggle-input", data: { action: "change->auto-submit#submit" } },
                               "1",
                               "0" %>
            <span class="notae-pref-toggle-track"></span>
          </label>
        <% end %>
      </div>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Nota updates</p>
          <p class="notae-pref-description">Digest emails for followed and owned Notarum.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <label class="notae-pref-toggle">
            <%= form.check_box :email_notify_page_updates,
                               { class: "notae-pref-toggle-input", data: { action: "change->auto-submit#submit" } },
                               "1",
                               "0" %>
            <span class="notae-pref-toggle-track"></span>
          </label>
        <% end %>
      </div>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Workspace digest</p>
          <p class="notae-pref-description">Digest emails about workspace activity summaries.</p>
        </div>
        <%= form_with model: @user, url: workspace_notification_settings_path(workspace_slug: @workspace.slug), method: :patch, class: "notae-pref-control-form" do |form| %>
          <label class="notae-pref-toggle">
            <%= form.check_box :email_notify_workspace_digest,
                               { class: "notae-pref-toggle-input", data: { action: "change->auto-submit#submit" } },
                               "1",
                               "0" %>
            <span class="notae-pref-toggle-track"></span>
          </label>
        <% end %>
      </div>
    </section>
  </div>
</section>
