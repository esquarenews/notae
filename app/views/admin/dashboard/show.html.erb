<% content_for :title, "SaaS Admin" %>
<% content_for :topbar_page_icon, "🛡️" %>
<% content_for :topbar_privacy, "Platform" %>
<% content_for :topbar_actions do %>
  <%= link_to "Workspaces", admin_workspaces_path, class: "notae-chip-button" %>
  <%= link_to "Users", admin_users_path, class: "notae-chip-button notae-chip-button-subtle" %>
<% end %>

<section class="notae-settings-shell">
  <div class="notae-settings-content">
    <section class="notae-settings-section">
      <h2>SaaS admin dashboard</h2>
      <p class="notae-pref-description">Full-service platform controls for tenancy, billing state, limits, and support operations.</p>

      <div class="notae-ai-analytics-grid">
        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">Workspaces</p>
          <p class="notae-utility-title"><%= number_with_delimiter(@workspace_count) %></p>
          <p class="notae-pref-description"><%= number_with_delimiter(@active_workspace_count) %> active, <%= number_with_delimiter(@suspended_workspace_count) %> suspended.</p>
        </article>

        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">Users</p>
          <p class="notae-utility-title"><%= number_with_delimiter(@user_count) %></p>
          <p class="notae-pref-description">Registered Notae accounts.</p>
        </article>

        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">Billing provider</p>
          <p class="notae-utility-title">Fat Zebra</p>
          <p class="notae-pref-description"><%= @billing_provider_ready ? "Credentials configured." : "Credentials not configured yet." %></p>
        </article>

        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">Webhook endpoint</p>
          <p class="notae-utility-title"><%= @fat_zebra_webhook_path %></p>
          <p class="notae-pref-description"><%= @fat_zebra_webhook_auth_ready ? "Webhook token configured." : "Set FAT_ZEBRA_WEBHOOK_SECRET before registering in production." %></p>
        </article>
      </div>
    </section>

    <section class="notae-settings-section">
      <h2>Recent workspaces</h2>
      <div class="notae-general-backup-list">
        <% @recent_workspaces.each do |workspace| %>
          <% subscription = workspace.subscription_record %>
          <article class="notae-general-backup-item">
            <div class="notae-general-backup-item-copy">
              <p class="notae-general-backup-item-title"><%= link_to workspace.name, admin_workspace_path(workspace) %></p>
              <p class="notae-general-backup-item-meta"><%= workspace.slug %> · <%= subscription.display_plan %> · <%= subscription.display_status %></p>
            </div>
            <% if workspace.suspended? %>
              <span class="notae-general-backup-status is-failed">Suspended</span>
            <% else %>
              <span class="notae-general-backup-status is-ready">Active</span>
            <% end %>
          </article>
        <% end %>
      </div>
    </section>

    <section class="notae-settings-section">
      <h2>Admin audit trail</h2>
      <div class="notae-general-backup-list">
        <% @recent_admin_events.each do |event| %>
          <article class="notae-general-backup-item">
            <div class="notae-general-backup-item-copy">
              <p class="notae-general-backup-item-title"><%= event.action.humanize %></p>
              <p class="notae-general-backup-item-meta"><%= event.actor.email %><%= " · #{event.workspace.name}" if event.workspace.present? %> · <%= time_ago_in_words(event.created_at) %> ago</p>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  </div>
</section>
