<% content_for :title, "SaaS Admin" %>
<% content_for :topbar_page_icon, "🛡️" %>
<% content_for :topbar_privacy, "Platform" %>
<% content_for :content_class, "notae-admin-content" %>
<% content_for :topbar_actions do %>
  <%= link_to "Workspaces", admin_workspaces_path, class: "notae-chip-button" %>
  <%= link_to "Users", admin_users_path, class: "notae-chip-button notae-chip-button-subtle" %>
<% end %>

<section class="notae-admin-dashboard-shell">
  <header class="notae-admin-dashboard-head">
    <div>
      <h2>SaaS admin dashboard</h2>
      <p class="notae-pref-description">Platform controls for customers, billing state, limits, and support operations.</p>
    </div>
    <div class="notae-admin-summary-grid">
      <article>
        <span>Workspaces</span>
        <strong><%= number_with_delimiter(@workspace_count) %></strong>
        <em><%= number_with_delimiter(@active_workspace_count) %> active</em>
      </article>
      <article>
        <span>Users</span>
        <strong><%= number_with_delimiter(@user_count) %></strong>
        <em>registered</em>
      </article>
      <article>
        <span>MRR</span>
        <strong>$<%= number_with_precision(@mrr_aud_cents / 100.0, precision: 0) %></strong>
        <em><%= number_with_delimiter(@trial_count) %> trials</em>
      </article>
      <article>
        <span>AI cost</span>
        <strong>$<%= number_with_precision(@ai_cost_this_month_usd, precision: 2) %></strong>
        <em><%= number_with_delimiter(@failed_stripe_webhook_count) %> failed webhooks</em>
      </article>
    </div>
  </header>

  <section class="notae-admin-table-section">
    <div class="notae-admin-section-head">
      <div>
        <h3>Registered users and billing</h3>
        <p class="notae-pref-description">Review customer plans, workspace limits, AI operations, documents, spend, storage, and drill in for overrides.</p>
      </div>
      <span class="notae-general-backup-status is-ready"><%= Billing::StripeGateway.display_name %></span>
    </div>

    <div class="notae-admin-table-wrap">
      <table class="notae-admin-table">
        <thead>
          <tr>
            <th>User</th>
            <th>Tier</th>
            <th>Workspaces</th>
            <th>AI requests</th>
            <th>Documents</th>
            <th>Total spend</th>
            <th>Storage</th>
            <th>First signed</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @user_admin_rows.each do |row| %>
            <% user = row.fetch(:user) %>
            <% summary = row.fetch(:summary) %>
            <tr class="notae-admin-user-tier-row notae-admin-user-tier-<%= user.saas_plan_key %>">
              <td>
                <strong><%= link_to user.display_name, admin_user_path(user) %></strong>
                <span><%= user.email %><%= " · platform admin" if user.platform_admin? %></span>
              </td>
              <td>
                <strong><%= user.saas_plan_name %></strong>
                <span><%= Billing::PlanCatalog.monthly_price_label_for(user.saas_plan_key) %></span>
              </td>
              <td>
                <strong class="<%= "is-over-limit" if summary.fetch(:over_workspace_limit) %>"><%= pluralize(summary.fetch(:workspace_count), "workspace") %></strong>
                <span><%= user.workspace_limit_unlimited? ? "Unlimited workspace limit" : "#{number_with_delimiter(user.workspace_limit)} workspace limit" %></span>
              </td>
              <td>
                <strong><%= pluralize(summary.fetch(:total_ai_requests), "AI request") %></strong>
                <span><%= number_with_delimiter(summary.fetch(:monthly_ai_requests)) %> this month</span>
              </td>
              <td>
                <strong><%= number_with_delimiter(summary.fetch(:document_count)) %></strong>
                <span>Pages and databases</span>
              </td>
              <td>
                <strong>$<%= number_with_precision(summary.fetch(:total_spend_usd), precision: 2) %></strong>
                <span>$<%= number_with_precision(summary.fetch(:monthly_spend_usd), precision: 2) %> this month</span>
              </td>
              <td>
                <strong><%= number_to_human_size(summary.fetch(:storage_bytes)) %></strong>
                <span>Attached files</span>
              </td>
              <td>
                <strong><%= summary.fetch(:first_signed_at).to_date.to_fs(:long) %></strong>
                <span><%= time_ago_in_words(summary.fetch(:first_signed_at)) %> ago</span>
              </td>
              <td>
                <%= link_to "User", admin_user_path(user), class: "notae-chip-button" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</section>
