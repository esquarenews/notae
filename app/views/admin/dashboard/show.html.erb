<% content_for :title, "SaaS Admin" %>
<% content_for :topbar_page_icon, "🛡️" %>
<% content_for :topbar_privacy, "Platform" %>
<% content_for :content_class, "notae-admin-content" %>
<% content_for :topbar_actions do %>
  <%= link_to "Workspaces", admin_workspaces_path, class: "notae-chip-button" %>
  <%= link_to "Users", admin_users_path, class: "notae-chip-button notae-chip-button-subtle" %>
<% end %>

<section class="notae-admin-dashboard-shell">
  <header class="notae-admin-dashboard-head">
    <div>
      <h2>SaaS admin dashboard</h2>
      <p class="notae-pref-description">Platform controls for customers, billing state, limits, and support operations.</p>
    </div>
    <div class="notae-admin-summary-grid">
      <article>
        <span>Workspaces</span>
        <strong><%= number_with_delimiter(@workspace_count) %></strong>
        <em><%= number_with_delimiter(@active_workspace_count) %> active</em>
      </article>
      <article>
        <span>Users</span>
        <strong><%= number_with_delimiter(@user_count) %></strong>
        <em>registered</em>
      </article>
      <article>
        <span>MRR</span>
        <strong>$<%= number_with_precision(@mrr_aud_cents / 100.0, precision: 0) %></strong>
        <em><%= number_with_delimiter(@trial_count) %> trials</em>
      </article>
      <article>
        <span>AI cost</span>
        <strong>$<%= number_with_precision(@ai_cost_this_month_usd, precision: 2) %></strong>
        <em><%= number_with_delimiter(@failed_stripe_webhook_count) %> failed webhooks</em>
      </article>
    </div>
  </header>

  <section class="notae-admin-table-section">
    <div class="notae-admin-section-head">
      <div>
        <h3>Registered users and billing</h3>
        <p class="notae-pref-description">Review customer workspaces, owners, plan state, usage against limits, and drill in for overrides.</p>
      </div>
      <span class="notae-general-backup-status is-ready"><%= Billing::StripeGateway.display_name %></span>
    </div>

    <div class="notae-admin-table-wrap">
      <table class="notae-admin-table">
        <thead>
          <tr>
            <th>Workspace</th>
            <th>Registered users</th>
            <th>Plan</th>
            <th>Billing status</th>
            <th>Usage this month</th>
            <th>Limits</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @workspace_admin_rows.each do |row| %>
            <% workspace = row.fetch(:workspace) %>
            <% subscription = row.fetch(:subscription) %>
            <% usage = row.fetch(:usage) %>
            <% limits = row.fetch(:limits) %>
            <% exceeded = row.fetch(:exceeded) %>
            <% owner_emails = row.fetch(:owners).map(&:email) %>
            <% user_emails = row.fetch(:users).map(&:email) %>
            <tr>
              <td>
                <strong><%= link_to workspace.name, admin_workspace_path(workspace) %></strong>
                <span><%= workspace.slug %></span>
              </td>
              <td>
                <strong><%= pluralize(user_emails.size, "user") %></strong>
                <span><%= (owner_emails.presence || user_emails).first(3).join(", ") %></span>
              </td>
              <td>
                <strong><%= subscription.display_plan %></strong>
                <span><%= Billing::PlanCatalog.monthly_price_label_for(subscription.plan_key) %></span>
              </td>
              <td>
                <span class="notae-admin-status-pill <%= subscription.status %>"><%= subscription.display_status %></span>
                <span><%= workspace.suspended? ? "Workspace suspended" : subscription.billing_provider.humanize %></span>
              </td>
              <td>
                <span><%= number_with_delimiter(usage.fetch(:members)) %> members</span>
                <span class="<%= "is-over-limit" if exceeded.fetch(:ai_requests_per_month) %>"><%= pluralize(usage.fetch(:ai_requests_this_month), "AI request") %></span>
                <span class="<%= "is-over-limit" if exceeded.fetch(:ai_monthly_budget_usd) %>">$<%= number_with_precision(usage.fetch(:ai_cost_usd_this_month), precision: 2) %> AI cost</span>
              </td>
              <td>
                <span class="<%= "is-over-limit" if exceeded.fetch(:members) %>"><%= number_with_delimiter(limits.fetch(:members)) %> members</span>
                <span><%= number_with_delimiter(limits.fetch(:ai_requests_per_month)) %> AI req</span>
                <span>$<%= number_with_precision(limits.fetch(:ai_monthly_budget_usd), precision: 2) %> AI cap</span>
              </td>
              <td>
                <%= link_to "Workspace", admin_workspace_path(workspace), class: "notae-chip-button" %>
                <% row.fetch(:users).first(2).each do |user| %>
                  <%= link_to "User", admin_user_path(user), class: "notae-chip-button notae-chip-button-subtle" %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</section>
