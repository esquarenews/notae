<% content_for :title, @user.email %>
<% content_for :topbar_page_icon, "👤" %>
<% content_for :topbar_privacy, "Platform" %>
<% content_for :content_class, "notae-admin-content" %>
<% content_for :topbar_actions do %>
  <%= link_to "Users", admin_users_path, class: "notae-chip-button" %>
  <%= link_to "Dashboard", admin_root_path, class: "notae-chip-button notae-chip-button-subtle" %>
<% end %>

<section class="notae-settings-shell notae-admin-shell">
  <div class="notae-settings-content">
    <section class="notae-settings-section">
      <h2><%= @user.display_name %></h2>
      <p class="notae-pref-description"><%= @user.email %><%= " · platform admin" if @user.platform_admin? %></p>

      <div class="notae-ai-analytics-grid">
        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">Tier</p>
          <p class="notae-utility-title"><%= @user.saas_plan_name %></p>
          <p class="notae-pref-description">Manual account tier for Notae entitlements.</p>
        </article>

        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">Account status</p>
          <p class="notae-utility-title"><%= @user.admin_account_status %></p>
          <p class="notae-pref-description">
            <% if @user.removed? %>
              Cancelled <%= time_ago_in_words(@user.removed_at) %> ago.
            <% elsif @user.admin_suspended? %>
              Suspended until <%= l(@user.admin_suspended_until, format: :long) %>.
            <% elsif @user.admin_free_tier_ends_at.present? %>
              Free tier reinstatement ends <%= l(@user.admin_free_tier_ends_at, format: :long) %>.
            <% else %>
              Account access is active.
            <% end %>
          </p>
        </article>

        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">Documents</p>
          <p class="notae-utility-title"><%= number_with_delimiter(@usage_summary.fetch(:document_count)) %></p>
          <p class="notae-pref-description">Pages and databases available to this account.</p>
        </article>

        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">AI requests</p>
          <p class="notae-utility-title"><%= number_with_delimiter(@usage_summary.fetch(:total_ai_requests)) %></p>
          <p class="notae-pref-description"><%= number_with_delimiter(@usage_summary.fetch(:monthly_ai_requests)) %> this month, across chat, proactive summaries, meetings, and agentic actions.</p>
        </article>

        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">Total spend</p>
          <p class="notae-utility-title">$<%= number_with_precision(@usage_summary.fetch(:total_spend_usd), precision: 2) %></p>
          <p class="notae-pref-description">$<%= number_with_precision(@usage_summary.fetch(:monthly_spend_usd), precision: 2) %> this month.</p>
        </article>

        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">Storage used</p>
          <p class="notae-utility-title"><%= number_to_human_size(@usage_summary.fetch(:storage_bytes)) %></p>
          <p class="notae-pref-description">Attached files and account avatar.</p>
        </article>

        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">First signed</p>
          <p class="notae-utility-title"><%= @usage_summary.fetch(:first_signed_at).to_date.to_fs(:long) %></p>
          <p class="notae-pref-description"><%= time_ago_in_words(@usage_summary.fetch(:first_signed_at)) %> ago.</p>
        </article>

        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">API tokens</p>
          <p class="notae-utility-title"><%= @api_tokens.size %></p>
          <p class="notae-pref-description">Recent account tokens.</p>
        </article>
      </div>
    </section>

    <section class="notae-settings-section">
      <h2>Plan and limits</h2>
      <%= form_with model: @user, url: admin_user_path(@user), method: :patch, class: "notae-pref-form" do |form| %>
        <div class="notae-pref-row">
          <div class="notae-pref-copy">
            <p class="notae-pref-label">User tier</p>
            <p class="notae-pref-description">Manual admin tier changes update Notae entitlements only. They do not change the user's existing Stripe subscription price; self-service upgrades use Stripe and change the paid plan price.</p>
          </div>
          <div class="notae-pref-controls">
            <%= form.select :saas_plan_key, User::SAAS_PLAN_KEYS.map { |plan| [ User::SAAS_PLAN_NAMES.fetch(plan), plan ] }, {}, class: "notae-pref-select" %>
          </div>
        </div>

        <div class="notae-pref-row">
          <div class="notae-pref-copy">
            <p class="notae-pref-label">Workspace limit override</p>
            <p class="notae-pref-description">Leave blank to use the tier default: Free and Business unlimited, Team 50, Starter 10.</p>
          </div>
          <div class="notae-pref-controls">
            <%= form.number_field :workspace_limit_override, class: "notae-auth-input", min: 0, step: 1, placeholder: @user.workspace_limit_label %>
          </div>
        </div>

        <div class="notae-pref-row">
          <div class="notae-pref-copy">
            <p class="notae-pref-label">AI usage controls</p>
            <p class="notae-pref-description">These account-level controls apply to AI search budgets and rate limits.</p>
          </div>
          <div class="notae-pref-controls">
            <label class="notae-admin-limit-field">
              <span>Daily AI budget USD</span>
              <%= form.number_field :ai_search_daily_budget_usd, class: "notae-auth-input", min: 0, step: 0.01, placeholder: "Daily USD budget" %>
            </label>
            <label class="notae-admin-limit-field">
              <span>Semantic search requests / min</span>
              <%= form.number_field :ai_search_semantic_rate_limit_per_minute, class: "notae-auth-input", min: 1, step: 1, placeholder: "Semantic req/min" %>
            </label>
            <label class="notae-admin-limit-field">
              <span>Answer generation requests / min</span>
              <%= form.number_field :ai_search_answer_rate_limit_per_minute, class: "notae-auth-input", min: 1, step: 1, placeholder: "Answer req/min" %>
            </label>
          </div>
        </div>

        <%= form.submit "Save user limits", class: "notae-chip-button" %>
      <% end %>
    </section>

    <section class="notae-settings-section">
      <h2>Account controls</h2>
      <div class="notae-pref-form">
        <% unless @user.removed? %>
          <div class="notae-pref-row">
            <div class="notae-pref-copy">
              <p class="notae-pref-label">Suspend user</p>
              <p class="notae-pref-description">Blocks sign-in for one week. The account and data remain in place.</p>
            </div>
            <div class="notae-pref-controls">
              <%= button_to "Suspend for one week", suspend_admin_user_path(@user), method: :patch, class: "notae-chip-button notae-chip-button-subtle" %>
            </div>
          </div>

          <div class="notae-pref-row">
            <div class="notae-pref-copy">
              <p class="notae-pref-label">Cancel user account</p>
              <p class="notae-pref-description">Marks the account as removed and blocks sign-in. User data stays in the database for future reinstatement.</p>
            </div>
            <div class="notae-pref-controls">
              <%= button_to "Delete user", remove_admin_user_path(@user), method: :patch, class: "notae-account-delete-button" %>
            </div>
          </div>
        <% else %>
          <div class="notae-pref-row">
            <div class="notae-pref-copy">
              <p class="notae-pref-label">Reinstate user</p>
              <p class="notae-pref-description">Restores sign-in and places the removed user on the Free tier for one week.</p>
            </div>
            <div class="notae-pref-controls">
              <%= button_to "Reinstate on Free tier", reinstate_admin_user_path(@user), method: :patch, class: "notae-chip-button" %>
            </div>
          </div>
        <% end %>
      </div>
    </section>

  </div>
</section>
