<% content_for :title, @user.email %>
<% content_for :topbar_page_icon, "👤" %>
<% content_for :topbar_privacy, "Platform" %>
<% content_for :topbar_actions do %>
  <%= link_to "All users", admin_users_path, class: "notae-chip-button" %>
<% end %>

<section class="notae-settings-shell">
  <div class="notae-settings-content">
    <section class="notae-settings-section">
      <h2><%= @user.display_name %></h2>
      <p class="notae-pref-description"><%= @user.email %><%= " · platform admin" if @user.platform_admin? %></p>

      <div class="notae-ai-analytics-grid">
        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">Workspaces</p>
          <p class="notae-utility-title"><%= @user.memberships.size %></p>
          <p class="notae-pref-description">Memberships across the platform.</p>
        </article>

        <article class="notae-ai-analytics-card">
          <p class="notae-pref-label">API tokens</p>
          <p class="notae-utility-title"><%= @api_tokens.size %></p>
          <p class="notae-pref-description">Recent account tokens.</p>
        </article>
      </div>
    </section>

    <section class="notae-settings-section">
      <h2>Workspace memberships</h2>
      <div class="notae-general-backup-list">
        <% @user.memberships.each do |membership| %>
          <article class="notae-general-backup-item">
            <div class="notae-general-backup-item-copy">
              <p class="notae-general-backup-item-title"><%= link_to membership.workspace.name, admin_workspace_path(membership.workspace) %></p>
              <p class="notae-general-backup-item-meta"><%= membership.role.humanize %> · <%= membership.workspace.slug %></p>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  </div>
</section>
