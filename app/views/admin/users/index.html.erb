<% content_for :title, "Admin Users" %>
<% content_for :topbar_page_icon, "👥" %>
<% content_for :topbar_privacy, "Platform" %>
<% content_for :topbar_actions do %>
  <%= link_to "Dashboard", admin_root_path, class: "notae-chip-button" %>
  <%= link_to "Workspaces", admin_workspaces_path, class: "notae-chip-button notae-chip-button-subtle" %>
<% end %>

<section class="notae-settings-shell">
  <div class="notae-settings-content">
    <section class="notae-settings-section">
      <h2>Users</h2>
      <div class="notae-general-backup-list">
        <% @users.each do |user| %>
          <article class="notae-general-backup-item">
            <div class="notae-general-backup-item-copy">
              <p class="notae-general-backup-item-title"><%= link_to user.email, admin_user_path(user) %></p>
              <p class="notae-general-backup-item-meta"><%= pluralize(user.memberships.size, "workspace") %><%= " · platform admin" if user.platform_admin? %></p>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  </div>
</section>
