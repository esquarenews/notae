<% content_for :title, "Admin Users" %>
<% content_for :topbar_page_icon, "👥" %>
<% content_for :topbar_privacy, "Platform" %>
<% content_for :content_class, "notae-admin-content" %>
<% content_for :topbar_actions do %>
  <%= link_to "Dashboard", admin_root_path, class: "notae-chip-button" %>
<% end %>

<section class="notae-settings-shell notae-admin-shell">
  <div class="notae-settings-content">
    <section class="notae-settings-section">
      <h2>Users</h2>
      <nav class="notae-library-tabs" aria-label="User account filters">
        <% admin_user_filter_options.each do |filter_value, label| %>
          <%= link_to label,
                      admin_users_path(filter: filter_value),
                      class: [ "notae-library-tab", ("active" if @user_filter == filter_value) ].compact.join(" ") %>
        <% end %>
      </nav>

      <div class="notae-general-backup-list">
        <% @users.each do |user| %>
          <% account_tier = admin_user_account_tier(user) %>
          <article class="notae-general-backup-item notae-admin-user-list-item">
            <div class="notae-general-backup-item-copy">
              <p class="notae-general-backup-item-title"><%= link_to user.email, admin_user_path(user) %></p>
              <p class="notae-general-backup-item-meta">
                <%= account_tier.third %>
                <%= " · platform admin" if user.platform_admin? %>
              </p>
            </div>
            <span class="notae-admin-status-pill <%= account_tier.second %>"><%= account_tier.first %></span>
            <div class="notae-admin-user-list-actions">
              <% if user.removed? %>
                <span class="notae-general-backup-status is-failed">Deactivated</span>
              <% elsif user == current_user || user.platform_admin? %>
                <span class="notae-general-backup-status is-ready">Protected</span>
              <% else %>
                <% unless user.confirmed? %>
                  <%= button_to "Resend confirmation",
                                resend_confirmation_admin_user_path(user, filter: @user_filter),
                                method: :patch,
                                class: "notae-chip-button notae-chip-button-subtle" %>
                <% end %>
                <%= button_to "Archive",
                              archive_admin_user_path(user, filter: @user_filter),
                              method: :patch,
                              class: "notae-chip-button notae-chip-button-subtle",
                              form: { data: { turbo_confirm: "Archive and deactivate #{user.email}?" } } %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  </div>
</section>
