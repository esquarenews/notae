<% content_for :title, "Admin Workspaces" %>
<% content_for :topbar_page_icon, "🏢" %>
<% content_for :topbar_privacy, "Platform" %>
<% content_for :topbar_actions do %>
  <%= link_to "Dashboard", admin_root_path, class: "notae-chip-button" %>
  <%= link_to "Users", admin_users_path, class: "notae-chip-button notae-chip-button-subtle" %>
<% end %>

<section class="notae-settings-shell">
  <div class="notae-settings-content">
    <section class="notae-settings-section">
      <h2>Workspaces</h2>
      <div class="notae-general-backup-list">
        <% @workspaces.each do |workspace| %>
          <% subscription = workspace.subscription_record %>
          <article class="notae-general-backup-item">
            <div class="notae-general-backup-item-copy">
              <p class="notae-general-backup-item-title"><%= link_to workspace.name, admin_workspace_path(workspace) %></p>
              <p class="notae-general-backup-item-meta"><%= workspace.slug %> · <%= pluralize(workspace.memberships.size, "member") %> · <%= subscription.display_plan %> · <%= subscription.display_status %></p>
            </div>
            <% if workspace.suspended? %>
              <span class="notae-general-backup-status is-failed">Suspended</span>
            <% else %>
              <span class="notae-general-backup-status is-ready">Active</span>
            <% end %>
          </article>
        <% end %>
      </div>
    </section>
  </div>
</section>
