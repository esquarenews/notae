<% content_for :title, "Notae AI settings" %>
<% content_for :topbar_page_icon, "🤖" %>
<% content_for :topbar_privacy, "Account" %>
<% content_for :topbar_actions do %>
  <%= link_to "Close", workspace_path(@workspace.slug), class: "notae-chip-button" %>
<% end %>

<section class="notae-settings-shell" data-controller="auto-submit">
  <%= render "shared/settings_nav", workspace: @workspace, active_item: :notae_ai %>

  <div class="notae-settings-content">
    <section class="notae-settings-section">
      <h2>Notae AI loader</h2>

      <div class="notae-pref-row">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">Current style</p>
          <p class="notae-pref-description"><%= User.ai_loader_label_for(@user.ai_loader_style) %></p>
          <p class="notae-pref-description">Two states are available for each style: static while idle and animated while AI is fetching data.</p>
          <% if @user.reduce_ai_loader_motion? %>
            <p class="notae-pref-description">Reduced motion is enabled in Preferences, so loading previews are shown as static.</p>
          <% end %>
        </div>
      </div>

      <div class="notae-ai-loader-stage">
        <article class="notae-ai-loader-stage-card">
          <p class="notae-ai-loader-stage-label">Static state</p>
          <%= render "shared/ai_loader_icon",
                     variant: @user.ai_loader_style,
                     state: "static",
                     size: 128,
                     reduced_motion: @user.reduce_ai_loader_motion?,
                     hover_animate: true %>
        </article>
        <article class="notae-ai-loader-stage-card">
          <p class="notae-ai-loader-stage-label">Loading state</p>
          <%= render "shared/ai_loader_icon",
                     variant: @user.ai_loader_style,
                     state: "loading",
                     size: 128,
                     reduced_motion: @user.reduce_ai_loader_motion?,
                     hover_animate: true %>
          <p class="notae-ai-loader-stage-meta">Hover to preview animation.</p>
        </article>
      </div>

      <div class="notae-pref-row notae-pref-row--stacked">
        <div class="notae-pref-copy">
          <p class="notae-pref-label">AI guardrails</p>
          <p class="notae-pref-description">Set your daily spend cap and per-minute query limits for semantic search and AI answers.</p>
        </div>
        <%= form_with model: @user,
                      url: workspace_notae_ai_settings_path(workspace_slug: @workspace.slug),
                      method: :patch,
                      class: "notae-ai-guardrails-form" do |form| %>
          <div class="notae-ai-guardrails-grid">
            <label>
              <span>Daily budget (USD)</span>
              <%= form.number_field :ai_search_daily_budget_usd,
                                    min: 0,
                                    step: 0.01,
                                    class: "notae-pref-select" %>
            </label>
            <label>
              <span>Semantic / min</span>
              <%= form.number_field :ai_search_semantic_rate_limit_per_minute,
                                    min: 1,
                                    step: 1,
                                    class: "notae-pref-select" %>
            </label>
            <label>
              <span>Answer / min</span>
              <%= form.number_field :ai_search_answer_rate_limit_per_minute,
                                    min: 1,
                                    step: 1,
                                    class: "notae-pref-select" %>
            </label>
            <button type="submit" class="notae-chip-button">Save guardrails</button>
          </div>
        <% end %>
      </div>
    </section>

    <section class="notae-settings-section">
      <h2>Style library</h2>

      <%= form_with model: @user,
                    url: workspace_notae_ai_settings_path(workspace_slug: @workspace.slug),
                    method: :patch,
                    class: "notae-ai-loader-options-form" do |form| %>
        <div class="notae-ai-loader-options-grid is-two-column">
          <% User::AI_LOADER_STYLE_OPTIONS.each do |label, value| %>
            <% selected = @user.ai_loader_style == value %>
            <label class="notae-ai-loader-option <%= "is-active" if selected %>">
              <span class="notae-ai-loader-option-head">
                <%= form.radio_button :ai_loader_style,
                                      value,
                                      checked: selected,
                                      class: "notae-ai-loader-option-radio",
                                      data: { action: "change->auto-submit#submit" } %>
                <span class="notae-ai-loader-option-title"><%= label %></span>
              </span>
              <span class="notae-ai-loader-option-copy"><%= User::AI_LOADER_STYLE_DESCRIPTIONS[value] %></span>
              <span class="notae-ai-loader-option-previews">
                <%= render "shared/ai_loader_icon",
                           variant: value,
                           state: "static",
                           size: 40,
                           reduced_motion: @user.reduce_ai_loader_motion?,
                           hover_animate: true %>
                <%= render "shared/ai_loader_icon",
                           variant: value,
                           state: "loading",
                           size: 40,
                           reduced_motion: @user.reduce_ai_loader_motion?,
                           hover_animate: true %>
              </span>
            </label>
          <% end %>
        </div>
      <% end %>
    </section>
  </div>
</section>
