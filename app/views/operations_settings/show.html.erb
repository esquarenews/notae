<% content_for :title, "Operations settings" %>
<% content_for :topbar_page_icon, "📡" %>
<% content_for :topbar_privacy, "Admin" %>
<% content_for :topbar_actions do %>
  <%= link_to "Open workspace", workspace_path(@workspace.slug), class: "notae-chip-button" %>
<% end %>

<% background_jobs = @dashboard.fetch(:background_jobs) %>
<% scheduled_tasks = @dashboard.fetch(:scheduled_tasks) %>
<% request_performance = @dashboard.fetch(:request_performance) %>
<% session_authentication = @dashboard.fetch(:session_authentication) %>
<% api_token_activity = @dashboard.fetch(:api_token_activity) %>
<% integration_health = @dashboard.fetch(:integration_health) %>
<% epistularium = @dashboard.fetch(:epistularium_accounts) %>
<% kalendarium = @dashboard.fetch(:kalendarium_connections) %>
<% push_delivery = @dashboard.fetch(:push_delivery) %>
<% meeting_capture = @dashboard.fetch(:meeting_capture) %>
<% format_relative_time = ->(timestamp, fallback = "Not yet") { timestamp.present? ? "#{time_ago_in_words(timestamp)} ago" : fallback } %>

<section class="notae-settings-shell">
  <%= render "shared/settings_nav", workspace: @workspace, active_item: :operations %>

  <div class="notae-settings-content">
    <section class="notae-settings-section">
      <h2>Background jobs</h2>
      <p class="notae-pref-description">Queue depth, retries, scheduled work, and worker heartbeat for Sidekiq.</p>

      <% if background_jobs[:available] %>
        <div class="notae-operations-grid">
          <% background_jobs[:queues].each do |queue| %>
            <article class="notae-operations-card">
              <p class="notae-operations-card-label"><%= queue[:name].humanize %> queue</p>
              <p class="notae-operations-card-value"><%= queue[:size] %></p>
              <p class="notae-operations-card-meta">Latency <%= number_with_precision(queue[:latency], precision: 1) %>s</p>
            </article>
          <% end %>

          <article class="notae-operations-card">
            <p class="notae-operations-card-label">Retries</p>
            <p class="notae-operations-card-value"><%= background_jobs[:retry_count] %></p>
            <p class="notae-operations-card-meta">Jobs waiting for retry</p>
          </article>

          <article class="notae-operations-card">
            <p class="notae-operations-card-label">Scheduled</p>
            <p class="notae-operations-card-value"><%= background_jobs[:scheduled_count] %></p>
            <p class="notae-operations-card-meta">Future-dated jobs</p>
          </article>

          <article class="notae-operations-card">
            <p class="notae-operations-card-label">Dead</p>
            <p class="notae-operations-card-value"><%= background_jobs[:dead_count] %></p>
            <p class="notae-operations-card-meta">Jobs that exhausted retries</p>
          </article>

          <article class="notae-operations-card">
            <p class="notae-operations-card-label">Workers</p>
            <p class="notae-operations-card-value"><%= background_jobs[:process_count] %></p>
            <p class="notae-operations-card-meta"><%= background_jobs[:busy_threads] %> busy of <%= background_jobs[:concurrency] %> threads</p>
          </article>
        </div>

        <% if background_jobs[:processes].any? %>
          <ul class="notae-operations-inline-list">
            <% background_jobs[:processes].each do |process| %>
              <li>
                <strong><%= process[:hostname].presence || process[:identity] %></strong>
                · <%= process[:busy] %>/<%= process[:concurrency] %> busy
                · last beat <%= format_relative_time.call(process[:beat_at], "Unknown") %>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% else %>
        <p class="notae-page-subtle">Background worker telemetry is unavailable right now. <%= background_jobs[:error] %></p>
      <% end %>
    </section>

    <section class="notae-settings-section">
      <h2>Scheduled tasks</h2>
      <p class="notae-pref-description">Heartbeat state for timer-backed rake tasks and scheduler entrypoints. Drift indicates a task has missed its expected cadence.</p>

      <div class="notae-operations-grid">
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Tracked tasks</p>
          <p class="notae-operations-card-value"><%= scheduled_tasks.dig(:counts, :total) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Healthy</p>
          <p class="notae-operations-card-value"><%= scheduled_tasks.dig(:counts, :healthy) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Attention needed</p>
          <p class="notae-operations-card-value"><%= scheduled_tasks.dig(:counts, :attention_needed) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Never run</p>
          <p class="notae-operations-card-value"><%= scheduled_tasks.dig(:counts, :never_run) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Latest success</p>
          <p class="notae-operations-card-value"><%= scheduled_tasks[:latest_success_at].present? ? format_relative_time.call(scheduled_tasks[:latest_success_at]) : "Not yet" %></p>
        </article>
      </div>

      <div class="notae-operations-list">
        <% scheduled_tasks[:items].each do |task| %>
          <% status_label = case task[:status]
                           when :healthy then "Healthy"
                           when :drifted then "Drifted"
                           when :failed then "Failed"
                           else "Never run"
                           end %>
          <% status_class = case task[:status]
                           when :healthy then "is-ok"
                           when :drifted then "is-warn"
                           when :failed then "is-error"
                           else ""
                           end %>
          <article class="notae-operations-item">
            <div class="notae-operations-item-copy">
              <p class="notae-operations-item-title"><%= task[:label] %></p>
              <p class="notae-operations-item-subtitle"><%= task[:task_name] %> · <%= task[:cadence_label] %></p>
              <p class="notae-operations-item-meta">
                <span>Last start <%= format_relative_time.call(task[:last_started_at]) %></span>
                <span>Last success <%= format_relative_time.call(task[:last_succeeded_at]) %></span>
                <% if task[:last_failed_at].present? %>
                  <span>Last failure <%= format_relative_time.call(task[:last_failed_at]) %></span>
                <% end %>
                <% if task[:last_duration_ms].present? %>
                  <span>Duration <%= number_with_precision(task[:last_duration_ms], precision: 1) %>ms</span>
                <% end %>
                <% if task[:consecutive_failures].positive? %>
                  <span><%= pluralize(task[:consecutive_failures], "failure") %> since last success</span>
                <% end %>
              </p>
              <% if task[:last_error].present? %>
                <p class="notae-page-subtle"><%= task[:last_error_class].presence || "Error" %>: <%= task[:last_error] %></p>
              <% end %>
            </div>

            <div class="notae-operations-pills">
              <span class="notae-operations-pill <%= status_class %>"><%= status_label %></span>
            </div>
          </article>
        <% end %>
      </div>
    </section>

    <section class="notae-settings-section">
      <h2>Recent request performance</h2>
      <p class="notae-pref-description">Recent tracked page samples for this workspace. Server-Timing headers are emitted on tracked requests, and the latest samples appear here for slow-screen diagnosis.</p>

      <div class="notae-operations-grid">
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Captured samples</p>
          <p class="notae-operations-card-value"><%= request_performance[:sample_count] %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Slow samples</p>
          <p class="notae-operations-card-value"><%= request_performance[:slow_count] %></p>
          <p class="notae-operations-card-meta">Threshold <%= number_with_precision(Notae::RequestPerformanceStore::SLOW_REQUEST_THRESHOLD_MS, precision: 0) %>ms</p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Slowest request</p>
          <p class="notae-operations-card-value"><%= request_performance[:slowest_total_ms].present? ? "#{number_with_precision(request_performance[:slowest_total_ms], precision: 1)}ms" : "None" %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Budget breaches</p>
          <p class="notae-operations-card-value"><%= request_performance[:budget_breach_count] %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Highest query count</p>
          <p class="notae-operations-card-value"><%= request_performance[:highest_sql_queries].present? ? request_performance[:highest_sql_queries] : "None" %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Latest sample</p>
          <p class="notae-operations-card-value"><%= request_performance[:latest_recorded_at].present? ? format_relative_time.call(request_performance[:latest_recorded_at]) : "Not yet" %></p>
        </article>
      </div>

      <% if request_performance[:worst_actions].any? %>
        <div class="notae-operations-list">
          <% request_performance[:worst_actions].each do |action| %>
            <article class="notae-operations-item">
              <div class="notae-operations-item-copy">
                <p class="notae-operations-item-title"><%= action[:action] %></p>
                <p class="notae-operations-item-subtitle"><%= pluralize(action[:sample_count], "sample") %> captured</p>
                <p class="notae-operations-item-meta">
                  <span>Max total <%= number_with_precision(action[:max_total_ms], precision: 1) %>ms</span>
                  <span>Max queries <%= action[:max_sql_queries] %></span>
                  <span>Budget hits <%= action[:budget_breach_count] %></span>
                  <span>Latest sample <%= format_relative_time.call(action[:latest_recorded_at]) %></span>
                </p>
              </div>

              <div class="notae-operations-pills">
                <span class="notae-operations-pill <%= action[:budget_status] == :over_budget ? "is-warn" : "is-ok" %>">
                  <%= action[:budget_status] == :over_budget ? "Over budget" : "Within budget" %>
                </span>
              </div>
            </article>
          <% end %>
        </div>
      <% end %>

      <% if request_performance[:items].any? %>
        <div class="notae-operations-list">
          <% request_performance[:items].each do |sample| %>
            <article class="notae-operations-item">
              <div class="notae-operations-item-copy">
                <p class="notae-operations-item-title"><%= sample[:action] %></p>
                <p class="notae-operations-item-subtitle"><%= sample[:path] %></p>
                <p class="notae-operations-item-meta">
                  <span>Total <%= number_with_precision(sample[:total_ms], precision: 1) %>ms</span>
                  <span>SQL <%= number_with_precision(sample[:sql_ms], precision: 1) %>ms across <%= sample[:sql_queries] %> queries</span>
                  <span>Status <%= sample[:status] %></span>
                  <span>Budget <%= number_with_precision(sample[:budget][:total_ms], precision: 0) %>ms / <%= sample[:budget][:sql_queries] %> queries</span>
                  <span>Captured <%= format_relative_time.call(sample[:recorded_at]) %></span>
                </p>
                <% if sample[:budget_breaches].any? %>
                  <p class="notae-page-subtle">Over budget on <%= sample[:budget_breaches].join(", ") %>.</p>
                <% end %>
              </div>

              <div class="notae-operations-pills">
                <span class="notae-operations-pill <%= sample[:budget_status] == :over_budget ? "is-warn" : "is-ok" %>">
                  <%= sample[:budget_status] == :over_budget ? "Over budget" : "Within budget" %>
                </span>
                <span class="notae-operations-pill <%= sample[:total_ms] >= Notae::RequestPerformanceStore::SLOW_REQUEST_THRESHOLD_MS ? "is-warn" : "is-ok" %>">
                  <%= sample[:total_ms] >= Notae::RequestPerformanceStore::SLOW_REQUEST_THRESHOLD_MS ? "Slow" : "Healthy" %>
                </span>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="notae-page-subtle">No request samples have been captured for this workspace yet.</p>
      <% end %>
    </section>

    <section class="notae-settings-section">
      <h2>Session and authentication</h2>
      <p class="notae-pref-description">Recent sign-in, sign-out, failed-authentication, and session safety events captured for the current account.</p>

      <div class="notae-operations-grid">
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Recent events</p>
          <p class="notae-operations-card-value"><%= session_authentication[:event_count] %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Warnings</p>
          <p class="notae-operations-card-value"><%= session_authentication[:warning_count] %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Latest event</p>
          <p class="notae-operations-card-value"><%= session_authentication[:latest_event_at].present? ? format_relative_time.call(session_authentication[:latest_event_at]) : "Not yet" %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Latest warning</p>
          <p class="notae-operations-card-value"><%= session_authentication[:latest_warning_at].present? ? format_relative_time.call(session_authentication[:latest_warning_at]) : "None" %></p>
        </article>
      </div>

      <% if session_authentication[:items].any? %>
        <div class="notae-operations-list">
          <% session_authentication[:items].each do |event| %>
            <% warning = %w[cookie_session_near_limit cookie_overflow invalid_authenticity_token failed_authentication].include?(event[:reason].to_s) %>
            <article class="notae-operations-item">
              <div class="notae-operations-item-copy">
                <p class="notae-operations-item-title"><%= event[:reason].to_s.humanize %></p>
                <p class="notae-operations-item-subtitle"><%= event[:request_method].presence || "Session" %> <%= event[:path].presence || "No path captured" %></p>
                <p class="notae-operations-item-meta">
                  <span>Store <%= event[:session_store].presence || "Unknown" %></span>
                  <span>Payload <%= number_with_precision(event[:approximate_session_bytes], precision: 0) %> bytes</span>
                  <span><%= event[:session_key_count] %> keys</span>
                  <% if event[:error_class].present? %>
                    <span><%= event[:error_class] %></span>
                  <% end %>
                  <span>Captured <%= format_relative_time.call(event[:recorded_at]) %></span>
                </p>
              </div>

              <div class="notae-operations-pills">
                <span class="notae-operations-pill <%= warning ? "is-warn" : "is-ok" %>"><%= warning ? "Needs review" : "Healthy" %></span>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="notae-page-subtle">No session/authentication events have been captured for this account yet.</p>
      <% end %>
    </section>

    <section class="notae-settings-section">
      <h2>API token activity</h2>
      <p class="notae-pref-description">Recent scoped API token events for this workspace, including issued or revoked extension tokens and any scope-denied requests.</p>

      <div class="notae-operations-grid">
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Recent events</p>
          <p class="notae-operations-card-value"><%= api_token_activity[:event_count] %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Denied requests</p>
          <p class="notae-operations-card-value"><%= api_token_activity[:denied_count] %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Tokens seen</p>
          <p class="notae-operations-card-value"><%= api_token_activity[:token_count] %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Latest event</p>
          <p class="notae-operations-card-value"><%= api_token_activity[:latest_event_at].present? ? format_relative_time.call(api_token_activity[:latest_event_at]) : "Not yet" %></p>
        </article>
      </div>

      <% if api_token_activity[:items].any? %>
        <div class="notae-operations-list">
          <% api_token_activity[:items].each do |event| %>
            <article class="notae-operations-item">
              <div class="notae-operations-item-copy">
                <p class="notae-operations-item-title"><%= event[:token_name] %></p>
                <p class="notae-operations-item-subtitle"><%= event[:user_email] %> · <%= event[:event_type].humanize %></p>
                <p class="notae-operations-item-meta">
                  <% if event[:request_method].present? && event[:path].present? %>
                    <span><%= event[:request_method] %> <%= event[:path] %></span>
                  <% end %>
                  <% if event[:http_status].present? %>
                    <span>Status <%= event[:http_status] %></span>
                  <% end %>
                  <% if event[:required_scopes].any? %>
                    <span>Scopes <%= event[:required_scopes].join(", ") %></span>
                  <% end %>
                  <span>Captured <%= format_relative_time.call(event[:created_at]) %></span>
                </p>
              </div>

              <div class="notae-operations-pills">
                <span class="notae-operations-pill <%= event[:event_type] == "scope_denied" ? "is-error" : "is-ok" %>">
                  <%= event[:event_type].humanize %>
                </span>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="notae-page-subtle">No API token events have been recorded for this workspace yet.</p>
      <% end %>
    </section>

    <section class="notae-settings-section">
      <h2>Integration health</h2>
      <p class="notae-pref-description">High-level status for synced providers, including writable calendar capacity and active push subscriptions.</p>

      <div class="notae-operations-grid">
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Providers tracked</p>
          <p class="notae-operations-card-value"><%= integration_health.dig(:counts, :total) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Healthy</p>
          <p class="notae-operations-card-value"><%= integration_health.dig(:counts, :healthy) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Attention needed</p>
          <p class="notae-operations-card-value"><%= integration_health.dig(:counts, :attention_needed) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Not configured</p>
          <p class="notae-operations-card-value"><%= integration_health.dig(:counts, :missing) %></p>
        </article>
      </div>

      <div class="notae-operations-list">
        <% integration_health[:providers].each do |provider| %>
          <% status_label = case provider[:status]
                           when :healthy then "Healthy"
                           when :attention then "Attention"
                           else "Not configured"
                           end %>
          <% status_class = case provider[:status]
                           when :healthy then "is-ok"
                           when :attention then "is-warn"
                           else ""
                           end %>
          <article class="notae-operations-item">
            <div class="notae-operations-item-copy">
              <p class="notae-operations-item-title"><%= provider[:label] %></p>
              <p class="notae-operations-item-subtitle"><%= provider[:capability_summary] %></p>
              <p class="notae-operations-item-meta">
                <span><%= pluralize(provider[:connection_count], "connection") %></span>
                <span><%= pluralize(provider[:attention_count], "issue") %></span>
                <% if provider[:key] == :kalendarium %>
                  <span><%= pluralize(provider[:writable_target_count], "writable calendar") %></span>
                <% elsif provider[:key] == :push_delivery %>
                  <span><%= pluralize(provider[:connection_count], "push subscription") %></span>
                <% end %>
                <span>Latest activity <%= format_relative_time.call(provider[:latest_activity_at]) %></span>
              </p>
            </div>

            <div class="notae-operations-pills">
              <span class="notae-operations-pill <%= status_class %>"><%= status_label %></span>
            </div>
          </article>
        <% end %>
      </div>
    </section>

    <section class="notae-settings-section">
      <h2>Email sync</h2>
      <p class="notae-pref-description">Fresh-mail cadence, backfill state, and queue health for Epistularium accounts in this workspace.</p>

      <div class="notae-operations-grid">
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Accounts</p>
          <p class="notae-operations-card-value"><%= epistularium.dig(:counts, :total) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Connected</p>
          <p class="notae-operations-card-value"><%= epistularium.dig(:counts, :connected) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Attention needed</p>
          <p class="notae-operations-card-value"><%= epistularium.dig(:counts, :attention_needed) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Active syncs</p>
          <p class="notae-operations-card-value"><%= epistularium.dig(:counts, :active_or_queued) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Stalled</p>
          <p class="notae-operations-card-value"><%= epistularium.dig(:counts, :stalled) %></p>
        </article>
      </div>

      <% if epistularium[:items].any? %>
        <div class="notae-operations-list">
          <% epistularium[:items].each do |account| %>
            <article class="notae-operations-item">
              <div class="notae-operations-item-copy">
                <p class="notae-operations-item-title"><%= account[:label] %></p>
                <p class="notae-operations-item-subtitle"><%= account[:provider].to_s.humanize %> · <%= account[:enabled] ? "Enabled" : "Disabled" %> · status <%= account[:status] %></p>
                <p class="notae-operations-item-meta">
                  <span>Fresh mail <%= format_relative_time.call(account[:last_fresh_sync_at]) %></span>
                  <span>Backfill batch <%= format_relative_time.call(account[:last_backfill_sync_at], "Not yet") %></span>
                  <% if account[:last_error].present? %>
                    <span>Last error: <%= account[:last_error] %></span>
                  <% end %>
                </p>
              </div>

              <div class="notae-operations-pills">
                <span class="notae-operations-pill <%= account[:status] == "connected" ? "is-ok" : "is-error" %>"><%= account[:status] %></span>
                <span class="notae-operations-pill <%= account[:backfill_pending] ? "is-warn" : "is-ok" %>"><%= account[:backfill_pending] ? "Backfill in progress" : "Backfill complete" %></span>
                <% if account[:sync_active] %>
                  <span class="notae-operations-pill is-ok">Sync active</span>
                <% elsif account[:sync_stalled] %>
                  <span class="notae-operations-pill is-error">Queue stalled</span>
                <% elsif account[:fresh_sync_due] %>
                  <span class="notae-operations-pill is-warn">Fresh mail overdue</span>
                <% end %>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="notae-page-subtle">No Epistularium accounts are configured for this workspace yet.</p>
      <% end %>
    </section>

    <section class="notae-settings-section">
      <h2>Calendar connections</h2>
      <p class="notae-pref-description">Sync status and calendar counts for Kalendārium provider connections.</p>

      <div class="notae-operations-grid">
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Connections</p>
          <p class="notae-operations-card-value"><%= kalendarium.dig(:counts, :total) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Connected</p>
          <p class="notae-operations-card-value"><%= kalendarium.dig(:counts, :connected) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Attention needed</p>
          <p class="notae-operations-card-value"><%= kalendarium.dig(:counts, :attention_needed) %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Writable calendars</p>
          <p class="notae-operations-card-value"><%= kalendarium.dig(:counts, :writable_calendars) %></p>
        </article>
      </div>

      <% if kalendarium[:items].any? %>
        <div class="notae-operations-list">
          <% kalendarium[:items].each do |connection| %>
            <article class="notae-operations-item">
              <div class="notae-operations-item-copy">
                <p class="notae-operations-item-title"><%= connection[:label] %></p>
                <p class="notae-operations-item-subtitle"><%= connection[:provider].to_s.humanize %> · <%= connection[:calendar_count] %> calendars · <%= connection[:writable_calendar_count] %> writable · <%= connection[:enabled] ? "Enabled" : "Disabled" %></p>
                <p class="notae-operations-item-meta">
                  <span>Last sync <%= format_relative_time.call(connection[:last_synced_at]) %></span>
                  <% if connection[:last_error].present? %>
                    <span>Last error: <%= connection[:last_error] %></span>
                  <% end %>
                </p>
              </div>

              <div class="notae-operations-pills">
                <span class="notae-operations-pill <%= connection[:status] == "connected" ? "is-ok" : "is-error" %>"><%= connection[:status] %></span>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="notae-page-subtle">No Kalendārium connections are configured for this workspace yet.</p>
      <% end %>
    </section>

    <section class="notae-settings-section">
      <h2>Push delivery</h2>
      <p class="notae-pref-description">Current device subscription health for your account, plus unread in-app notification load.</p>

      <div class="notae-operations-grid">
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Subscribed devices</p>
          <p class="notae-operations-card-value"><%= push_delivery[:subscription_count] %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Failing devices</p>
          <p class="notae-operations-card-value"><%= push_delivery[:failing_count] %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Last push delivered</p>
          <p class="notae-operations-card-value"><%= push_delivery[:latest_delivery_at].present? ? format_relative_time.call(push_delivery[:latest_delivery_at]) : "Never" %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Unread in-app</p>
          <p class="notae-operations-card-value"><%= push_delivery[:unread_in_app_count] %></p>
        </article>
      </div>

      <% if push_delivery[:items].any? %>
        <div class="notae-operations-list">
          <% push_delivery[:items].each do |device| %>
            <article class="notae-operations-item">
              <div class="notae-operations-item-copy">
                <p class="notae-operations-item-title"><%= device[:host] %></p>
                <p class="notae-operations-item-subtitle">Subscribed <%= format_relative_time.call(device[:created_at]) %></p>
                <p class="notae-operations-item-meta">
                  <span>Last delivered <%= format_relative_time.call(device[:last_delivered_at], "Never") %></span>
                  <% if device[:last_error_message].present? %>
                    <span>Last error: <%= device[:last_error_message] %></span>
                  <% end %>
                </p>
              </div>

              <div class="notae-operations-pills">
                <% status_class = device[:status] == :healthy ? "is-ok" : (device[:status] == :failing ? "is-error" : "is-warn") %>
                <span class="notae-operations-pill <%= status_class %>"><%= device[:status].to_s.humanize %></span>
              </div>
            </article>
          <% end %>
        </div>
      <% else %>
        <p class="notae-page-subtle">This account has no push subscriptions yet.</p>
      <% end %>
    </section>

    <section class="notae-settings-section">
      <h2>Meeting capture</h2>
      <p class="notae-pref-description">Live session state, bot-run health, and the most recent failures for workspace meeting capture.</p>

      <div class="notae-operations-grid">
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Active sessions</p>
          <p class="notae-operations-card-value"><%= meeting_capture[:active_session_count] %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Failed sessions</p>
          <p class="notae-operations-card-value"><%= meeting_capture[:failed_session_count] %></p>
        </article>
        <article class="notae-operations-card">
          <p class="notae-operations-card-label">Active bot runs</p>
          <p class="notae-operations-card-value"><%= meeting_capture[:active_run_count] %></p>
        </article>
      </div>

      <% if meeting_capture[:active_sessions].any? %>
        <div class="notae-operations-list">
          <% meeting_capture[:active_sessions].each do |session| %>
            <article class="notae-operations-item">
              <div class="notae-operations-item-copy">
                <p class="notae-operations-item-title"><%= session[:title] %></p>
                <p class="notae-operations-item-subtitle"><%= session[:provider].to_s.humanize %> · <%= session[:capture_mode].to_s.humanize %></p>
                <p class="notae-operations-item-meta">
                  <span>Updated <%= format_relative_time.call(session[:updated_at]) %></span>
                  <% if session[:error_message].present? %>
                    <span>Error: <%= session[:error_message] %></span>
                  <% end %>
                </p>
              </div>

              <div class="notae-operations-pills">
                <span class="notae-operations-pill is-warn"><%= session[:status] %></span>
              </div>
            </article>
          <% end %>
        </div>
      <% elsif meeting_capture[:latest_failed_run].present? %>
        <p class="notae-page-subtle">
          Latest failed bot run: <strong><%= meeting_capture[:latest_failed_run][:title] %></strong>
          · <%= meeting_capture[:latest_failed_run][:provider].to_s.humanize %>
          · <%= format_relative_time.call(meeting_capture[:latest_failed_run][:updated_at]) %>
          <% if meeting_capture[:latest_failed_run][:error_message].present? %>
            · <%= meeting_capture[:latest_failed_run][:error_message] %>
          <% end %>
        </p>
      <% else %>
        <p class="notae-page-subtle">No active or failed meeting capture jobs are currently visible for this workspace.</p>
      <% end %>
    </section>
  </div>
</section>
