<% content_for :title, @agent_action.title %>
<% content_for :content_class, "notae-content-page" %>

<section class="notae-workspace-home notae-ai-history-page">
  <header class="notae-utility-page-head">
    <div>
      <p class="notae-page-subtle"><%= @agent_action.target_system.titleize %> · <%= @agent_action.draft_type.humanize %></p>
      <h1 class="notae-utility-title"><%= @agent_action.title %></h1>
      <p class="notae-page-subtle">
        Status: <%= agent_action_status_badge(@agent_action) %> ·
        Approval required: <%= @agent_action.approval_required? ? "Yes" : "No" %> ·
        Dry run: <%= @agent_action.dry_run? ? "Yes" : "No" %>
      </p>
    </div>
    <div class="notae-utility-page-actions">
      <%= link_to "All drafts", agent_actions_path(workspace_slug: @workspace.slug), class: "notae-chip-button" %>
    </div>
  </header>

  <div class="notae-workspace-home-grid">
    <section class="notae-auth-card notae-home-card">
      <div class="notae-home-card-head">
        <h2>Review panel</h2>
      </div>
      <%= render "preview", agent_action: @agent_action %>

      <% if @agent_action.changes_requested? %>
        <p class="notae-page-subtle">An approver requested revisions. Update the draft and save to resubmit it for approval.</p>
      <% end %>

      <% if policy(@agent_action).update? %>
        <%= render "form", agent_action: @agent_action, workspace: @workspace, submit_label: "Save draft changes" %>
      <% else %>
        <p class="notae-page-subtle">This draft is now read-only.</p>
      <% end %>

      <% if policy(@agent_action).approve? || policy(@agent_action).request_changes? || policy(@agent_action).reject? %>
        <div class="notae-workspace-home-stack">
          <% if policy(@agent_action).approve? %>
            <% approval_blocked = (@agent_action.draft_type == "task_ticket" && @approval_target_databases.empty?) || (@agent_action.draft_type == "calendar_hold" && @approval_target_calendars.empty?) %>
            <%= form_with url: approve_agent_action_path(workspace_slug: @workspace.slug, id: @agent_action.id), method: :post, class: "notae-workspace-home-stack" do %>
              <% if @agent_action.draft_type == "task_ticket" %>
                <label class="notae-page-subtle" for="destination_database_id">Save to task list</label>
                <%= select_tag :destination_database_id,
                               options_from_collection_for_select(@approval_target_databases, :id, :name, params[:destination_database_id]),
                               prompt: "Choose task list",
                               class: "notae-auth-input" %>
                <% if @approval_target_databases.empty? %>
                  <p class="notae-page-subtle">No visible task lists are available in this workspace yet.</p>
                <% end %>
              <% elsif @agent_action.draft_type == "calendar_hold" %>
                <label class="notae-page-subtle" for="destination_calendar_id">Save to calendar</label>
                <%= select_tag :destination_calendar_id,
                               options_from_collection_for_select(@approval_target_calendars, :id, :name, params[:destination_calendar_id]),
                               prompt: "Choose calendar",
                               class: "notae-auth-input" %>
                <% if @approval_target_calendars.empty? %>
                  <p class="notae-page-subtle">No writable calendars are available in this workspace yet.</p>
                <% end %>
              <% end %>

              <% unless @agent_action.draft_type.in?(%w[email_draft github_comment_draft]) %>
                <p class="notae-page-subtle">Approving this draft creates a real Notae record in the selected destination.</p>
              <% end %>

              <%= text_area_tag :decision_comment, params[:decision_comment], placeholder: "Approval note or revision guidance", class: "notae-auth-input", rows: 3 %>
              <%= submit_tag "Approve draft", class: "notae-chip-button", disabled: approval_blocked %>
            <% end %>
          <% end %>

          <% if policy(@agent_action).request_changes? %>
            <%= form_with url: request_changes_agent_action_path(workspace_slug: @workspace.slug, id: @agent_action.id), method: :post, class: "notae-workspace-home-stack" do |form| %>
              <%= form.text_area :decision_comment, placeholder: "What needs to change before approval?", class: "notae-auth-input", rows: 3 %>
              <%= form.submit "Request changes", class: "notae-chip-button notae-chip-button-subtle" %>
            <% end %>
          <% end %>

          <% if policy(@agent_action).reject? %>
            <%= form_with url: reject_agent_action_path(workspace_slug: @workspace.slug, id: @agent_action.id), method: :post, class: "notae-workspace-home-stack" do |form| %>
              <%= form.text_area :decision_comment, placeholder: "Why this draft is rejected or what should change", class: "notae-auth-input", rows: 3 %>
              <%= form.submit "Reject draft", class: "notae-chip-button notae-chip-button-subtle" %>
            <% end %>
          <% end %>
        </div>
      <% end %>
    </section>

    <section class="notae-auth-card notae-home-card">
      <div class="notae-home-card-head">
        <h2>Policy & execution</h2>
      </div>
      <p class="notae-page-subtle">Policy evaluation</p>
      <div class="notae-workspace-home-json"><%= @agent_action.policy_evaluation_json.to_json %></div>

      <% if @agent_action.metadata_json.present? %>
        <p class="notae-page-subtle">Draft metadata</p>
        <div class="notae-workspace-home-json"><%= @agent_action.metadata_json.to_json %></div>
      <% end %>

      <% if @agent_action.result_json.present? %>
        <p class="notae-page-subtle"><%= @agent_action.result_json["dry_run"] ? "Dry-run result" : "Execution result" %></p>
        <% if @agent_action.result_json["summary"].present? %>
          <p><%= @agent_action.result_json["summary"] %></p>
        <% end %>
        <% if @agent_action.result_json["url"].present? %>
          <p><%= link_to "Open created item", @agent_action.result_json["url"], class: "notae-chip-button notae-chip-button-subtle" %></p>
        <% end %>
        <div class="notae-workspace-home-json"><%= @agent_action.result_json.to_json %></div>
      <% else %>
        <p class="notae-page-subtle">No execution result yet.</p>
      <% end %>
    </section>
  </div>

  <section class="notae-auth-card notae-home-card">
    <div class="notae-home-card-head">
      <h2>Decision history</h2>
    </div>
    <% if @review_history.any? %>
      <ul class="notae-workspace-home-list">
        <% @review_history.each do |event| %>
          <li class="notae-workspace-home-list-item">
            <div class="font-medium"><%= agent_action_event_title(event) %> · #<%= event.sequence_number %></div>
            <div class="notae-page-subtle">
              <%= event.actor&.email || "system" %> · <%= time_ago_in_words(event.occurred_at) %> ago
            </div>
            <% if event.comment.present? %>
              <div><%= event.comment %></div>
            <% end %>
            <div class="notae-workspace-home-json"><%= event.details_json.to_json %></div>
            <div class="notae-page-subtle">Hash verified: <%= event.hash_verification_succeeds? ? "Yes" : "No" %></div>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="notae-page-subtle">No events yet.</p>
    <% end %>
  </section>
</section>
