<% row_params = {
  view_id: @current_view&.id,
  month: (@view_type == "calendar" ? @calendar_month&.to_s : nil),
  sort_property_id: params[:sort_property_id],
  sort_direction: params[:sort_direction],
  filter_property_id: params[:filter_property_id],
  filter_value: params[:filter_value],
  filter_operator: params[:filter_operator],
  highlight_row_id: params[:highlight_row_id],
  split_page_id: params[:split_page_id],
  split_source: params[:split_source],
  split_row_id: params[:split_row_id]
}.compact %>
<% linkable_pages = Array(@linkable_pages) %>
<% linkable_pages_by_id = @linkable_pages_by_id || linkable_pages.index_by(&:id) %>
<% visible_properties = @visible_db_properties || @db_properties %>
<% can_edit_grid = policy(@database).update? && !@database.locked? %>
<% can_persist_sort = @current_view.present? && policy(@current_view).update? && !@database.locked? %>
<% can_create_rows = policy(DbRow.new(database: @database, workspace: @workspace)).create? && !@database.locked? %>
<% new_row_form_id = "db_new_row_form_#{@database.id}" %>
<% column_widths = @view_config.fetch("column_widths", {}).to_h.transform_values { |value| value.to_i } %>
<% column_resize_enabled = can_edit_grid && @current_view.present? %>
<% column_resize_update_url = if @current_view.present?
  database_database_view_path(workspace_slug: @workspace.slug, database_id: @database.id, id: @current_view.id)
else
  ""
end %>
<% row_color_options = [
  ["Default", "default"],
  ["Gray", "gray"],
  ["Brown", "brown"],
  ["Orange", "orange"],
  ["Yellow", "yellow"],
  ["Green", "green"],
  ["Blue", "blue"],
  ["Purple", "purple"],
  ["Pink", "pink"],
  ["Red", "red"]
] %>
<% highlight_row_id = params[:highlight_row_id].presence %>

<div class="notae-db-grid-wrap"
     data-controller="db-column-resize"
     data-db-column-resize-enabled-value="<%= column_resize_enabled %>"
     data-db-column-resize-update-url-value="<%= column_resize_update_url %>"
     data-db-column-resize-widths-value="<%= column_widths.to_json %>">
  <table class="notae-db-grid">
    <colgroup>
      <% name_width = column_widths["name"].to_i %>
      <col data-db-column-resize-target="column"
           data-column-key="name"
           <% if name_width.positive? %>style="width: <%= name_width %>px; min-width: <%= name_width %>px;"<% end %>>
      <% visible_properties.each do |db_property| %>
        <% property_key = "property_#{db_property.id}" %>
        <% property_width = column_widths[property_key].to_i %>
        <col data-db-column-resize-target="column"
             data-column-key="<%= property_key %>"
             <% if property_width.positive? %>style="width: <%= property_width %>px; min-width: <%= property_width %>px;"<% end %>>
      <% end %>
      <col class="notae-db-grid-add-col-width">
    </colgroup>
    <thead>
      <tr>
        <% name_width = column_widths["name"].to_i %>
        <th class="notae-db-grid-name-col"
            data-db-column-resize-target="header"
            data-column-key="name"
            <% if name_width.positive? %>style="width: <%= name_width %>px; min-width: <%= name_width %>px;"<% end %>>
          <span class="notae-db-grid-heading"><span class="notae-db-grid-heading-icon">Aa</span> Name</span>
          <% if column_resize_enabled %>
            <button type="button"
                    class="notae-db-col-resize-handle"
                    data-action="pointerdown->db-column-resize#startResize"
                    aria-label="Resize Name column"
                    title="Drag to resize column"></button>
          <% end %>
        </th>
        <% visible_properties.each do |db_property| %>
          <% property_is_sorted = @sort_property&.id == db_property.id %>
          <% next_direction = property_is_sorted && @sort_direction == "asc" ? "desc" : "asc" %>
          <% property_key = "property_#{db_property.id}" %>
          <% property_width = column_widths[property_key].to_i %>
          <th data-db-column-resize-target="header"
              data-column-key="<%= property_key %>"
              <% if property_width.positive? %>style="width: <%= property_width %>px; min-width: <%= property_width %>px;"<% end %>>
            <div class="notae-db-grid-property-header">
              <% if can_persist_sort %>
                <%= button_to db_property.name,
                              database_database_view_path(
                                workspace_slug: @workspace.slug,
                                database_id: @database.id,
                                id: @current_view.id,
                                month: row_params[:month],
                                filter_property_id: row_params[:filter_property_id],
                                filter_value: row_params[:filter_value],
                                filter_operator: row_params[:filter_operator],
                                split_page_id: row_params[:split_page_id],
                                split_source: row_params[:split_source],
                                split_row_id: row_params[:split_row_id]
                              ),
                              method: :patch,
                              params: {
                                database_view: {
                                  sort_property_id: db_property.id,
                                  sort_direction: next_direction
                                }
                              },
                              form: {
                                data: { preserve_database_scroll: true }
                              },
                              form_class: "notae-db-grid-property-sort-form",
                              class: "notae-db-grid-property-link",
                              title: "Sort by #{db_property.name}" %>
              <% else %>
                <%= link_to db_property.name,
                            database_path(
                              workspace_slug: @workspace.slug,
                              id: @database.id,
                              view_id: @current_view&.id,
                              month: (@view_type == "calendar" ? @calendar_month&.to_s : nil),
                              sort_property_id: db_property.id,
                              sort_direction: next_direction,
                              filter_property_id: params[:filter_property_id],
                              filter_value: params[:filter_value],
                              filter_operator: params[:filter_operator]
                            ),
                            data: { preserve_database_scroll: true },
                            class: "notae-db-grid-property-link" %>
              <% end %>
              <% if property_is_sorted %>
                <span class="notae-db-sort-indicator"><%= @sort_direction == "asc" ? "↑" : "↓" %></span>
              <% end %>
            </div>
            <% if column_resize_enabled %>
              <button type="button"
                      class="notae-db-col-resize-handle"
                      data-action="pointerdown->db-column-resize#startResize"
                      aria-label="Resize <%= db_property.name %> column"
                      title="Drag to resize column"></button>
            <% end %>
          </th>
        <% end %>
        <th class="notae-db-grid-add-col">
          <% if policy(DbProperty.new(database: @database, workspace: @workspace)).create? && !@database.locked? %>
            <details class="notae-db-inline-details">
              <summary class="notae-db-grid-add-link">+ Add property</summary>
              <div class="notae-db-inline-panel">
                <%= form_with model: @new_property,
                              url: database_db_properties_path(
                                workspace_slug: @workspace.slug,
                                database_id: @database.id,
                                view_id: row_params[:view_id],
                                month: row_params[:month],
                                sort_property_id: row_params[:sort_property_id],
                                sort_direction: row_params[:sort_direction],
                                filter_property_id: row_params[:filter_property_id],
                                filter_value: row_params[:filter_value],
                                split_page_id: row_params[:split_page_id],
                                split_source: row_params[:split_source],
                                split_row_id: row_params[:split_row_id]
                              ),
                              class: "notae-db-inline-form" do |form| %>
                  <%= form.text_field :name, placeholder: "Property name", required: true, class: "notae-options-input" %>
                  <%= form.select :property_type,
                                  DbProperty.property_types.keys.map { |value| [value.titleize, value] },
                                  {},
                                  class: "notae-options-input" %>
                  <%= form.submit "Add", class: "notae-chip-button" %>
                <% end %>
              </div>
            </details>
          <% end %>
        </th>
      </tr>
    </thead>
    <tbody id="database_table_rows"
           data-controller="db-table-reorder"
           data-db-table-reorder-workspace-slug-value="<%= @workspace.slug %>"
           data-db-table-reorder-database-id-value="<%= @database.id %>"
           data-db-table-reorder-view-id-value="<%= @current_view&.id %>"
           data-db-table-reorder-month-value="<%= row_params[:month] %>">
      <% @rows.each do |row| %>
        <%= render "databases/table_row",
                   row: row,
                   workspace: @workspace,
                   database: @database,
                   row_params: row_params,
                   linkable_pages: linkable_pages,
                   linkable_pages_by_id: linkable_pages_by_id,
                   visible_properties: visible_properties,
                   cells_by_key: @cells_by_key,
                   can_create_rows: can_create_rows,
                   row_color_options: row_color_options,
                   highlight_row_id: highlight_row_id %>
      <% end %>
    </tbody>

    <tbody id="database_table_placeholders">
      <% placeholder_count = [6 - @rows.size, 0].max %>
      <%= render "databases/table_placeholders",
                 visible_properties: visible_properties,
                 placeholder_count: placeholder_count %>
    </tbody>

    <tbody id="database_table_controls">
      <% if can_create_rows %>
        <tr class="notae-db-grid-add-row-control">
          <td>
            <%= form_with model: @new_row,
                          url: database_db_rows_path(workspace_slug: @workspace.slug, database_id: @database.id),
                          id: new_row_form_id,
                          class: "notae-db-new-row-trigger-form" do |form| %>
              <%= hidden_field_tag :view_id, row_params[:view_id] %>
              <%= hidden_field_tag :month, row_params[:month] %>
              <%= hidden_field_tag :sort_property_id, row_params[:sort_property_id] %>
              <%= hidden_field_tag :sort_direction, row_params[:sort_direction] %>
              <%= hidden_field_tag :filter_property_id, row_params[:filter_property_id] %>
              <%= hidden_field_tag :filter_value, row_params[:filter_value] %>
              <%= hidden_field_tag :filter_operator, row_params[:filter_operator] %>
              <%= hidden_field_tag :highlight_row_id, row_params[:highlight_row_id] %>
              <%= hidden_field_tag :split_page_id, row_params[:split_page_id] %>
              <%= hidden_field_tag :split_source, row_params[:split_source] %>
              <%= hidden_field_tag :split_row_id, row_params[:split_row_id] %>
              <%= form.hidden_field :title, value: "Untitled row" %>
              <button type="submit" class="notae-db-new-row-trigger">+ New row</button>
            <% end %>
          </td>
          <% visible_properties.each do |_db_property| %>
            <td></td>
          <% end %>
          <td></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
