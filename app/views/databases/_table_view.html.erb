<% row_params = {
  view_id: @current_view&.id,
  month: (@view_type == "calendar" ? @calendar_month&.to_s : nil),
  sort_property_id: params[:sort_property_id],
  sort_direction: params[:sort_direction],
  filter_property_id: params[:filter_property_id],
  filter_value: params[:filter_value]
}.compact %>

<div class="notae-db-grid-wrap">
  <table class="notae-db-grid">
    <thead>
      <tr>
        <th class="notae-db-grid-name-col">
          <span class="notae-db-grid-heading"><span class="notae-db-grid-heading-icon">Aa</span> Name</span>
        </th>
        <% @db_properties.each do |db_property| %>
          <% property_is_sorted = @sort_property&.id == db_property.id %>
          <% next_direction = property_is_sorted && @sort_direction == "asc" ? "desc" : "asc" %>
          <th>
            <%= link_to db_property.name,
                        database_path(
                          workspace_slug: @workspace.slug,
                          id: @database.id,
                          view_id: @current_view&.id,
                          month: (@view_type == "calendar" ? @calendar_month&.to_s : nil),
                          sort_property_id: db_property.id,
                          sort_direction: next_direction,
                          filter_property_id: params[:filter_property_id],
                          filter_value: params[:filter_value]
                        ),
                        class: "notae-db-grid-property-link" %>
            <% if property_is_sorted %>
              <span class="notae-db-sort-indicator"><%= @sort_direction == "asc" ? "↑" : "↓" %></span>
            <% end %>
          </th>
        <% end %>
        <th class="notae-db-grid-add-col">
          <% if policy(DbProperty.new(database: @database, workspace: @workspace)).create? %>
            <details class="notae-db-inline-details">
              <summary class="notae-db-grid-add-link">+ Add property</summary>
              <div class="notae-db-inline-panel">
                <%= form_with model: @new_property,
                              url: database_db_properties_path(workspace_slug: @workspace.slug, database_id: @database.id),
                              class: "notae-db-inline-form" do |form| %>
                  <%= form.text_field :name, placeholder: "Property name", required: true, class: "notae-options-input" %>
                  <%= form.select :property_type,
                                  DbProperty.property_types.keys.map { |value| [value.titleize, value] },
                                  {},
                                  class: "notae-options-input" %>
                  <%= form.submit "Add", class: "notae-chip-button" %>
                <% end %>
              </div>
            </details>
          <% end %>
        </th>
      </tr>
    </thead>
    <tbody>
      <% if policy(DbRow.new(database: @database, workspace: @workspace)).create? %>
        <tr class="notae-db-grid-new-row">
          <td>
            <%= button_to database_db_rows_path(workspace_slug: @workspace.slug, database_id: @database.id),
                          params: row_params.merge(db_row: { title: "New page" }),
                          class: "notae-db-new-row-button" do %>
              <span class="notae-db-new-row-plus">+</span>
              <span>New page</span>
            <% end %>
          </td>
          <% @db_properties.each do |_db_property| %>
            <td></td>
          <% end %>
          <td></td>
        </tr>
      <% end %>

      <% @rows.each do |row| %>
        <tr id="row_<%= row.id %>" class="notae-db-grid-data-row">
          <td>
            <% if policy(row).update? %>
              <%= form_with model: row,
                            url: database_db_row_path(
                              {
                                workspace_slug: @workspace.slug,
                                database_id: @database.id,
                                id: row.id
                              }.merge(row_params)
                            ),
                            method: :patch,
                            class: "notae-db-title-form" do |form| %>
                <%= form.text_field :title,
                                    value: row.title,
                                    class: "notae-db-title-input",
                                    onchange: "this.form.requestSubmit()" %>
              <% end %>
            <% else %>
              <span class="notae-db-title-text"><%= row.title %></span>
            <% end %>
          </td>
          <% @db_properties.each do |db_property| %>
            <% db_cell = @cells_by_key[[row.id, db_property.id]] %>
            <td>
              <% if db_cell && policy(db_cell).update? %>
                <%= form_with model: db_cell,
                              url: database_db_cell_path(
                                {
                                  workspace_slug: @workspace.slug,
                                  database_id: @database.id,
                                  id: db_cell.id
                                }.merge(row_params)
                              ),
                              method: :patch do |form| %>
                  <% field_classes = "notae-db-cell-input" %>
                  <% if db_property.checkbox? %>
                    <label class="notae-db-checkbox-wrap">
                      <%= form.check_box :value_text,
                                         {
                                           checked: db_cell.value_text == "true",
                                           class: "h-4 w-4 rounded border-stone-300 text-stone-900 focus:ring-stone-400",
                                           onchange: "this.form.requestSubmit()"
                                         },
                                         "true",
                                         "false" %>
                    </label>
                  <% elsif db_property.number? %>
                    <%= form.number_field :value_text,
                                          value: db_cell.value_text,
                                          id: "db_cell_#{db_cell.id}_value_text",
                                          step: "any",
                                          class: field_classes,
                                          onchange: "this.form.requestSubmit()" %>
                  <% elsif db_property.date? %>
                    <%= form.date_field :value_text,
                                        value: db_cell.value_text,
                                        id: "db_cell_#{db_cell.id}_value_text",
                                        class: field_classes,
                                        onchange: "this.form.requestSubmit()" %>
                  <% else %>
                    <% input_options = {
                      value: db_cell.value_text,
                      id: "db_cell_#{db_cell.id}_value_text",
                      class: field_classes,
                      onchange: "this.form.requestSubmit()"
                    } %>
                    <% if db_property.select? %>
                      <% input_options[:list] = "db_property_#{db_property.id}_options" %>
                    <% end %>
                    <%= form.text_field :value_text, **input_options %>
                  <% end %>
                <% end %>
              <% else %>
                <span class="text-stone-400">-</span>
              <% end %>
            </td>
          <% end %>
          <td></td>
        </tr>
      <% end %>

      <% placeholder_count = [6 - @rows.size, 0].max %>
      <% placeholder_count.times do %>
        <tr class="notae-db-grid-placeholder-row">
          <td>&nbsp;</td>
          <% @db_properties.each do |_db_property| %>
            <td>&nbsp;</td>
          <% end %>
          <td>&nbsp;</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<% @db_properties.select(&:select?).each do |property| %>
  <% options = select_options_for(property) %>
  <% next if options.empty? %>

  <datalist id="db_property_<%= property.id %>_options">
    <% options.each do |option| %>
      <option value="<%= option %>"></option>
    <% end %>
  </datalist>
<% end %>
