<% if @board_group_property.blank? %>
  <p class="rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
    Board view requires a property with type <code>select</code>. Choose one in the view config.
  </p>
<% else %>
  <% can_edit_database ||= false %>
  <% row_params = {
    view_id: @current_view&.id,
    month: (@view_type == "calendar" ? @calendar_month&.to_s : nil),
    sort_property_id: params[:sort_property_id],
    sort_direction: params[:sort_direction],
    sort_mode: params[:sort_mode],
    filter_property_id: params[:filter_property_id],
    filter_value: params[:filter_value],
    filter_operator: params[:filter_operator],
    rows_page: params[:rows_page].presence,
    highlight_row_id: params[:highlight_row_id],
    split_panel: params[:split_panel],
    split_page_id: params[:split_page_id],
    split_source: params[:split_source],
    split_row_id: params[:split_row_id],
    task_row_id: params[:task_row_id]
  }.compact %>
  <% board_card_properties = @db_properties.reject { |property| property.id == @board_group_property.id } %>
  <% editor_properties = @db_properties %>
  <% row_color_options = [
    ["Default", "default"],
    ["Gray", "gray"],
    ["Brown", "brown"],
    ["Orange", "orange"],
    ["Yellow", "yellow"],
    ["Green", "green"],
    ["Blue", "blue"],
    ["Purple", "purple"],
    ["Pink", "pink"],
    ["Red", "red"]
  ] %>
  <div data-controller="database-drag"
       data-database-drag-workspace-slug-value="<%= @workspace.slug %>"
       data-database-drag-database-id-value="<%= @database.id %>"
       data-database-drag-view-id-value="<%= @current_view&.id %>"
       data-database-drag-property-id-value="<%= @board_group_property.id %>"
       class="notae-db-board-grid">
    <% @board_columns.each do |column| %>
      <% column_title_classes = task_status_badge_classes_for(@board_group_property, column[:label], base_class: "notae-db-board-column-title") %>
      <% unassigned_column = column[:value].blank? %>
      <section class="notae-db-board-column">
        <header class="notae-db-board-column-head">
          <div class="notae-db-board-column-head-main">
            <span class="<%= column_title_classes %>"><%= column[:label] %></span>
            <span class="notae-db-board-column-count"><%= column[:rows].size %></span>
          </div>
          <% if unassigned_column && can_edit_database %>
            <%= button_to database_db_rows_path(workspace_slug: @workspace.slug, database_id: @database.id),
                          params: row_params.merge(db_row: { title: "Untitled row" }),
                          class: "notae-db-board-column-add",
                          form: { class: "notae-db-board-column-add-form", data: { preserve_database_scroll: true } },
                          title: "add new unassigned card",
                          aria: { label: "add new unassigned card" } do %>
              <span aria-hidden="true">+</span>
            <% end %>
          <% end %>
        </header>
        <div class="notae-db-board-lane"
             data-database-drag-target-value="<%= column[:value].to_s %>"
             data-action="dragenter->database-drag#dragenter dragover->database-drag#dragover dragleave->database-drag#dragleave drop->database-drag#drop">
          <% if column[:rows].empty? %>
            <div class="notae-db-board-empty">
              No tasks
            </div>
          <% end %>
          <% column[:rows].each do |row| %>
            <% row_update_path = database_db_row_path(workspace_slug: @workspace.slug, database_id: @database.id, id: row.id) %>
            <%= render "databases/board_card",
                       row: row,
                       workspace: @workspace,
                       database: @database,
                       row_update_path: row_update_path,
                       row_params: row_params,
                       board_card_properties: board_card_properties,
                       editor_properties: editor_properties,
                       cells_by_key: @cells_by_key,
                       row_color_options: row_color_options %>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>
