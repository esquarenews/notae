<% if @board_group_property.blank? %>
  <p class="rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
    Board view requires a property with type <code>select</code>. Choose one in the view config.
  </p>
<% else %>
  <% board_card_properties = @db_properties.reject { |property| property.id == @board_group_property.id } %>
  <div data-controller="database-drag"
       data-database-drag-workspace-slug-value="<%= @workspace.slug %>"
       data-database-drag-database-id-value="<%= @database.id %>"
       data-database-drag-view-id-value="<%= @current_view&.id %>"
       data-database-drag-property-id-value="<%= @board_group_property.id %>"
       class="notae-db-board-grid">
    <% @board_columns.each do |column| %>
      <section class="notae-db-board-column">
        <header class="notae-db-board-column-head">
          <span class="notae-db-board-column-title"><%= column[:label] %></span>
          <span class="notae-db-board-column-count"><%= column[:rows].size %></span>
        </header>
        <div class="notae-db-board-lane"
             data-database-drag-target-value="<%= column[:value].to_s %>"
             data-action="dragenter->database-drag#dragenter dragover->database-drag#dragover dragleave->database-drag#dragleave drop->database-drag#drop">
          <% if column[:rows].empty? %>
            <div class="notae-db-board-empty">
              No tasks
            </div>
          <% end %>
          <% column[:rows].each do |row| %>
            <% row_update_path = database_db_row_path(workspace_slug: @workspace.slug, database_id: @database.id, id: row.id) %>
            <article id="board_row_<%= row.id %>"
                     class="notae-db-board-card"
                     draggable="true"
                     data-database-drag-row-id="<%= row.id %>"
                     data-database-drag-update-url="<%= row_update_path %>"
                     data-database-drag-title="<%= row.title %>"
                     data-action="dragstart->database-drag#dragstart dragend->database-drag#dragend dblclick->database-drag#beginEdit">
              <div class="notae-db-board-card-display" data-board-card-display>
                <div class="notae-db-board-card-title" data-board-card-title><%= row.title %></div>
                <div class="notae-db-board-card-meta">#<%= row.id.to_s.first(8) %></div>
                <% property_rows = board_card_properties.filter_map do |property| %>
                  <% value = cell_value_for(row, property).to_s.strip %>
                  <% next if value.blank? %>
                  <% [ property.name, value ] %>
                <% end %>
                <% if property_rows.any? %>
                  <dl class="notae-db-board-card-details">
                    <% property_rows.each do |property_name, property_value| %>
                      <div class="notae-db-board-card-detail-row">
                        <dt class="notae-db-board-card-detail-label"><%= property_name %></dt>
                        <dd class="notae-db-board-card-detail-value"><%= property_value %></dd>
                      </div>
                    <% end %>
                  </dl>
                <% end %>
              </div>
              <form class="notae-db-board-card-edit-form"
                    data-action="submit->database-drag#submitEdit"
                    hidden>
                <input type="text"
                       value="<%= row.title %>"
                       class="notae-db-board-card-edit-input"
                       placeholder="Enter task name"
                       data-action="keydown.enter->database-drag#submitEditFromKeydown keydown.esc->database-drag#cancelEdit blur->database-drag#submitEditOnBlur">
              </form>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>
