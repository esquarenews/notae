<% if @calendar_date_property.blank? %>
  <p class="rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">
    Calendar view requires a property with type <code>date</code>. Choose one in the view config.
  </p>
<% else %>
  <div class="mb-3 flex items-center justify-between">
    <%= link_to "← Previous",
                database_path(
                  workspace_slug: @workspace.slug,
                  id: @database.id,
                  view_id: @current_view&.id,
                  month: (@calendar_month - 1.month).to_s,
                  sort_property_id: params[:sort_property_id],
                  sort_direction: params[:sort_direction],
                  filter_property_id: params[:filter_property_id],
                  filter_value: params[:filter_value],
                  filter_operator: params[:filter_operator],
                  rows_page: params[:rows_page].presence,
                  view_settings: params[:view_settings]
                ),
                class: "notae-chip-button" %>
    <h3 class="text-base font-medium"><%= @calendar_month.strftime("%B %Y") %></h3>
    <%= link_to "Next →",
                database_path(
                  workspace_slug: @workspace.slug,
                  id: @database.id,
                  view_id: @current_view&.id,
                  month: (@calendar_month + 1.month).to_s,
                  sort_property_id: params[:sort_property_id],
                  sort_direction: params[:sort_direction],
                  filter_property_id: params[:filter_property_id],
                  filter_value: params[:filter_value],
                  filter_operator: params[:filter_operator],
                  rows_page: params[:rows_page].presence,
                  view_settings: params[:view_settings]
                ),
                class: "notae-chip-button" %>
  </div>

  <div data-controller="database-drag"
       data-database-drag-workspace-slug-value="<%= @workspace.slug %>"
       data-database-drag-database-id-value="<%= @database.id %>"
       data-database-drag-view-id-value="<%= @current_view&.id %>"
       data-database-drag-property-id-value="<%= @calendar_date_property.id %>"
       data-database-drag-month-value="<%= @calendar_month.to_s %>">
    <div class="mb-1 grid grid-cols-7 gap-1 text-center text-xs font-medium text-stone-600">
      <% %w[Sun Mon Tue Wed Thu Fri Sat].each do |label| %>
        <div class="rounded bg-stone-100 py-1"><%= label %></div>
      <% end %>
    </div>

    <div class="grid grid-cols-7 gap-1">
      <% @calendar_days.each do |day| %>
        <% rows = @calendar_rows_by_date[day] %>
        <section class="min-h-28 rounded border border-stone-200 bg-white p-1.5"
                 data-database-drag-target-value="<%= day.iso8601 %>"
                 data-action="dragover->database-drag#dragover drop->database-drag#drop">
          <div class="mb-1 flex items-center justify-between">
            <span class="text-xs <%= day.month == @calendar_month.month ? 'text-stone-800' : 'text-stone-400' %>"><%= day.day %></span>
            <% if policy(DbRow.new(database: @database, workspace: @workspace)).create? && !@database.locked? %>
              <%= form_with model: @new_row,
                            url: database_db_rows_path(workspace_slug: @workspace.slug, database_id: @database.id),
                            class: "inline",
                            data: { preserve_database_scroll: true } do |form| %>
                <%= hidden_field_tag :view_id, @current_view&.id %>
                <%= hidden_field_tag :month, @calendar_month.to_s %>
                <%= hidden_field_tag :sort_property_id, params[:sort_property_id] %>
                <%= hidden_field_tag :sort_direction, params[:sort_direction] %>
                <%= hidden_field_tag :filter_property_id, params[:filter_property_id] %>
                <%= hidden_field_tag :filter_value, params[:filter_value] %>
                <%= hidden_field_tag :filter_operator, params[:filter_operator] %>
                <%= hidden_field_tag :rows_page, params[:rows_page].presence %>
                <%= hidden_field_tag :view_settings, params[:view_settings] %>
                <%= hidden_field_tag :date_property_id, @calendar_date_property.id %>
                <%= hidden_field_tag :date_value, day.iso8601 %>
                <%= form.hidden_field :title, value: "Untitled row" %>
                <%= form.submit "+", class: "rounded border border-stone-300 px-1.5 py-0 text-xs text-stone-700" %>
              <% end %>
            <% end %>
          </div>

          <div class="space-y-1">
            <% rows.each do |row| %>
              <article class="cursor-grab rounded border border-stone-200 bg-stone-50 px-2 py-1 text-xs"
                       draggable="true"
                       data-database-drag-row-id="<%= row.id %>"
                       data-action="dragstart->database-drag#dragstart">
                <%= row.title %>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>
    </div>
  </div>
<% end %>
