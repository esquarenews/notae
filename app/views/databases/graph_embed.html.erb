<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>Graph · <%= @database.name %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body class="notae-theme <%= notae_theme_body_class %> notae-graph-embed-page">
    <main class="notae-graph-embed-shell">
      <%= render "databases/graph_split_view",
                 graph_split: @graph_split,
                 can_edit_database: false,
                 show_toolbar: false,
                 view_params: @graph_embed_view_params,
                 graph_title: @stats_graph_data&.title,
                 graph_details: (@stats_graph_data.present? ? [
                   { label: "Assigned to", value: @stats_graph_data.assigned_person },
                   { label: "Division", value: @stats_graph_data.division },
                   { label: "Description", value: @stats_graph_data.description }
                 ] : []) %>
    </main>
  </body>
</html>
