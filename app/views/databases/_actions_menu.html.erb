<details id="database-actions-menu"
         class="notae-actions-menu notae-db-actions-menu"
         data-controller="copy-text actions-menu lazy-panel"
         data-action="toggle->shell#syncTopbarMenus lazy-panel:loaded->actions-menu#refresh"
         data-shell-target="actionsMenu"
         data-shell-actions-menu
         data-lazy-panel-url-value="<%= panel_database_path(view_params.merge(panel: "actions")) %>"
         data-lazy-panel-loading-text-value="Loading actions…"
         data-lazy-panel-error-text-value="Could not load actions."
         <%= "open" if params[:actions_menu].to_s == "open" %>>
  <summary class="notae-db-toolbar-icon <%= "is-active" if params[:actions_menu].to_s == "open" %>" title="Actions">⚡</summary>
  <div class="notae-actions-panel <%= "is-page-locked" if database.locked? %>"
       data-shell-actions-panel
       data-actions-menu-target="panel"
       data-lazy-panel-target="container"></div>
</details>
