<% autofocus_title = local_assigns.fetch(:autofocus_title, false) %>
<% highlight_row_id = local_assigns[:highlight_row_id].presence %>
<% linked_page = row.linked_page %>
<% row_can_update = local_assigns.fetch(:can_update_rows) { policy(row).update? && !database.locked? } %>
<% row_can_destroy = local_assigns.fetch(:can_destroy_rows) { policy(row).destroy? && !database.locked? } %>
<% cell_can_update = local_assigns.fetch(:can_update_cells) { row_can_update } %>
<% row_is_bold = row.row_bold? %>
<% row_is_italic = row.row_italic? %>
<% row_text_color = row.row_text_color %>
<% row_background_color = row.row_background_color %>
<% row_style_classes = [] %>
<% row_style_classes << "is-new-row-highlight" if highlight_row_id.to_s == row.id.to_s && row.title.to_s == "Untitled row" %>
<% row_style_classes << "is-row-bold" if row_is_bold %>
<% row_style_classes << "is-row-italic" if row_is_italic %>
<% row_style_classes << "is-row-color-#{row_text_color}" unless row_text_color == "default" %>
<% row_style_classes << "is-row-bg-#{row_background_color}" unless row_background_color == "default" %>
<% page_search_url = local_assigns.fetch(:page_search_url) { workspace_document_targets_path(workspace_slug: workspace.slug, kind: "page") } %>
<% form_authenticity_token_value = local_assigns[:form_authenticity_token_value] || form_authenticity_token %>
<tr id="row_<%= row.id %>"
    class="notae-db-grid-data-row <%= conditional_color_class_for_row(row) %> <%= row_style_classes.join(" ") %>"
    data-scroll-preserve-key="row_<%= row.id %>"
    data-db-table-reorder-target="row"
    data-db-table-reorder-row-id="<%= row.id %>"
    data-action="dragover->db-table-reorder#dragover drop->db-table-reorder#drop dragleave->db-table-reorder#dragleave">
  <% name_column_style_classes = local_assigns.fetch(:name_column_style_classes) { name_column_style_classes_for(database) } %>
  <td class="<%= name_column_style_classes %>">
    <% row_update_path = database_db_row_path(
      {
        workspace_slug: workspace.slug,
        database_id: database.id,
        id: row.id
      }.merge(row_params)
    ) %>
    <div class="notae-db-row-shell">
      <% if row_can_update %>
        <div class="notae-db-row-hover-controls">
          <% if can_create_rows %>
            <form action="<%= database_db_rows_path(workspace_slug: workspace.slug, database_id: database.id) %>"
                  accept-charset="UTF-8"
                  method="post"
                  class="notae-db-row-hover-control-form"
                  data-preserve-database-scroll="true">
              <% row_params.each do |key, value| %>
                <input type="hidden" name="<%= key %>" value="<%= value %>" autocomplete="off">
              <% end %>
              <input type="hidden" name="insert_after_id" value="<%= row.id %>" autocomplete="off">
              <input type="hidden" name="db_row[title]" value="Untitled row" autocomplete="off">
              <button type="submit"
                      class="notae-db-row-hover-control"
                      title="Insert row below"
                      aria-label="Insert row below">+</button>
            </form>
          <% end %>
          <button type="button"
                  class="notae-db-row-hover-control is-drag-handle"
                  title="Drag to reorder"
                  aria-label="Drag to reorder"
                  draggable="true"
                  data-db-table-reorder-row-id="<%= row.id %>"
                  data-action="dragstart->db-table-reorder#dragstart dragend->db-table-reorder#dragend">
            ⠿
          </button>
          <%= render "databases/row_context_menu",
                     row: row,
                     workspace: workspace,
                     database: database,
                     row_update_path: row_update_path,
                     row_params: row_params,
                     row_color_options: row_color_options,
                     row_can_destroy: row_can_destroy,
                     linked_page: linked_page,
                     row_is_bold: row_is_bold,
                     row_is_italic: row_is_italic,
                     row_text_color: row_text_color,
                     row_background_color: row_background_color,
                     form_authenticity_token_value: form_authenticity_token_value %>
        </div>
      <% end %>

      <div class="notae-db-title-stack">
        <div class="notae-db-title-primary">
          <% if linked_page.present? %>
            <% row_split_params = row_params.merge(
              workspace_slug: workspace.slug,
              id: database.id,
              split_page_id: linked_page.id,
              split_source: "row",
              split_row_id: row.id
            ) %>
            <% if row_can_update %>
              <form action="<%= row_update_path %>"
                    accept-charset="UTF-8"
                    method="post"
                    class="notae-db-title-form notae-db-title-form-inline"
                    data-controller="auto-submit"
                    data-auto-submit-focus-on-connect-value="<%= autofocus_title ? "true" : "false" %>"
                    data-preserve-database-scroll="true">
                <input type="hidden" name="_method" value="patch" autocomplete="off">
                <input type="text"
                       name="db_row[title]"
                       value="<%= row.title %>"
                       class="notae-db-title-input"
                       placeholder="Enter name"
                       data-action="change->auto-submit#submit keydown.enter->auto-submit#submitOnEnter"
                       data-auto-submit-create-next-row-on-enter="true">
                <input type="hidden" name="db_row[autosave_title]" value="1" autocomplete="off">
                <button type="submit"
                        class="notae-db-enter-submitter"
                        name="db_row[create_next_row]"
                        value="1"
                        style="position:absolute;left:-9999px;width:1px;height:1px;padding:0;border:0;overflow:hidden;"
                        tabindex="-1"
                        aria-hidden="true"></button>
              </form>
            <% else %>
              <span class="notae-db-title-text"><%= row.title.presence || linked_page.title %></span>
            <% end %>
            <div class="notae-db-row-link-actions">
              <%= link_to database_path(row_split_params),
                          class: "notae-db-row-link-action",
                          title: "Open linked Nota",
                          aria: { label: "Open linked Nota" } do %>
                ↗
              <% end %>
            </div>
          <% elsif row_can_update %>
            <form action="<%= row_update_path %>"
                  accept-charset="UTF-8"
                  method="post"
                  class="notae-db-title-form notae-db-title-form-inline"
                  data-controller="auto-submit"
                  data-auto-submit-focus-on-connect-value="<%= autofocus_title ? "true" : "false" %>"
                  data-preserve-database-scroll="true">
              <input type="hidden" name="_method" value="patch" autocomplete="off">
              <input type="text"
                     name="db_row[title]"
                     value="<%= row.title %>"
                     class="notae-db-title-input"
                     placeholder="Enter name"
                     data-action="change->auto-submit#submit keydown.enter->auto-submit#submitOnEnter"
                     data-auto-submit-create-next-row-on-enter="true">
              <input type="hidden" name="db_row[autosave_title]" value="1" autocomplete="off">
              <button type="submit"
                      class="notae-db-enter-submitter"
                      name="db_row[create_next_row]"
                      value="1"
                      style="position:absolute;left:-9999px;width:1px;height:1px;padding:0;border:0;overflow:hidden;"
                      tabindex="-1"
                      aria-hidden="true"></button>
            </form>
            <form action="<%= row_update_path %>"
                  accept-charset="UTF-8"
                  method="post"
                  class="notae-db-row-link-create-form">
              <input type="hidden" name="_method" value="patch" autocomplete="off">
              <input type="hidden" name="db_row[link_action]" value="create_page" autocomplete="off">
              <button type="submit"
                      class="notae-db-row-link-action is-create"
                      title="Create linked Nota"
                      aria-label="Create linked Nota">+</button>
            </form>
            <details class="notae-db-inline-details notae-db-row-link-chooser">
              <summary class="notae-db-row-link-action is-choose" title="Choose linked Nota" aria-label="Choose linked Nota">🔗</summary>
              <div class="notae-db-inline-panel">
                <form action="<%= row_update_path %>"
                      accept-charset="UTF-8"
                      method="post"
                      class="notae-db-inline-form"
                      data-controller="document-picker"
                      data-document-picker-search-url-value="<%= page_search_url %>"
                      data-document-picker-empty-text-value="No matching notas.">
                  <input type="hidden" name="_method" value="patch" autocomplete="off">
                  <input type="hidden" name="db_row[linked_page_id]" value="<%= linked_page&.id %>" data-document-picker-target="hiddenInput" autocomplete="off">
                  <input type="search"
                         name="db_row_link_page_search_<%= row.id %>"
                         value=""
                         placeholder="Search notas"
                         autocomplete="off"
                         class="notae-options-input"
                         data-document-picker-target="searchInput"
                         data-action="focus->document-picker#ensureLoaded input->document-picker#queueSearch search->document-picker#queueSearch">
                  <p class="notae-document-picker-loading" hidden data-document-picker-target="loading">Searching…</p>
                  <div class="notae-document-picker-results" data-document-picker-target="results"></div>
                  <p class="notae-options-empty" hidden data-document-picker-target="emptyState">No matching notas.</p>
                </form>
              </div>
            </details>
          <% else %>
            <span class="notae-db-title-text"><%= row.title %></span>
          <% end %>
        </div>
      </div>
    </div>
  </td>
  <% visible_properties.each do |db_property| %>
    <% db_cell = cells_by_key[[row.id, db_property.id]] %>
    <% property_style_classes = local_assigns.fetch(:column_style_classes_by_property_id, {}).fetch(db_property.id) { column_style_classes_for(db_property) } %>
    <td class="<%= property_style_classes %>">
      <% if db_cell && cell_can_update %>
        <% cell_update_path = database_db_cell_path(
          ({
            workspace_slug: workspace.slug,
            database_id: database.id,
            id: db_cell.id
          }.merge(row_params)).merge(db_property.progress? ? { progress_inline_update: "1" } : {})
        ) %>
        <% field_id = "db_cell_#{db_cell.id}_value_text" %>
        <% field_classes = db_property.select? ? select_input_classes_for(db_property, db_cell.value_text) : "notae-db-cell-input" %>
        <% if db_property.progress? %>
          <%= form_with model: db_cell,
                        url: cell_update_path,
                        method: :patch,
                        authenticity_token: false,
                        data: {
                          turbo_stream: true,
                          preserve_database_scroll: true
                        } do |form| %>
            <%= render "databases/progress_cell",
                       form: form,
                       db_cell: db_cell,
                       field_id: field_id %>
          <% end %>
        <% else %>
          <form action="<%= cell_update_path %>"
                accept-charset="UTF-8"
                method="post"
                data-controller="auto-submit"
                data-turbo-stream="true"
                data-preserve-database-scroll="true">
            <input type="hidden" name="_method" value="patch" autocomplete="off">
            <% if db_property.checkbox? %>
              <label class="notae-db-checkbox-wrap">
                <input type="hidden" name="db_cell[value_text]" value="false" autocomplete="off">
                <input type="checkbox"
                       name="db_cell[value_text]"
                       id="<%= field_id %>"
                       value="true"
                       class="h-4 w-4 rounded border-stone-300 text-stone-900 focus:ring-stone-400"
                       data-action="change->auto-submit#submit"
                       <%= "checked" if db_cell.value_text == "true" %>>
              </label>
            <% elsif db_property.select? %>
              <% blank_label = db_property.name.to_s.strip.casecmp("status").zero? ? "Select status" : "Select option" %>
              <select name="db_cell[value_text]"
                      id="<%= field_id %>"
                      class="<%= field_classes %>"
                      data-action="change->auto-submit#submit">
                <%= options_for_select([[blank_label, ""]] + select_options_for(db_property).map { |option| [option, option] }, db_cell.value_text) %>
              </select>
            <% elsif db_property.number? %>
              <input type="number"
                     name="db_cell[value_text]"
                     id="<%= field_id %>"
                     value="<%= db_cell.value_text %>"
                     step="any"
                     class="<%= field_classes %>"
                     data-action="change->auto-submit#submit">
            <% elsif db_property.date? %>
              <input type="date"
                     name="db_cell[value_text]"
                     id="<%= field_id %>"
                     value="<%= db_cell.value_text %>"
                     class="<%= field_classes %>"
                     data-action="change->auto-submit#submit"
                     data-gantt-grid-row-id="<%= row.id %>"
                     data-gantt-grid-property-id="<%= db_property.id %>">
            <% else %>
              <input type="text"
                     name="db_cell[value_text]"
                     id="<%= field_id %>"
                     value="<%= db_cell.value_text %>"
                     class="<%= field_classes %>"
                     data-action="change->auto-submit#submit">
            <% end %>
          </form>
        <% end %>
      <% else %>
        <span class="text-stone-400">-</span>
      <% end %>
    </td>
  <% end %>
  <td></td>
</tr>
