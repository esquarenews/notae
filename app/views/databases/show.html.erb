<% display_title = @page_title_page&.title.presence || @database.name %>
<% embedded_preview = params[:embedded].to_s == "1" %>
<% content_for :suppress_layout_flash, true %>
<% content_for :title, display_title %>
<% content_for :topbar_page_icon do %>
  <%= render_notae_icon(@page_title_page&.icon.presence || @database.icon.presence, workspace: @workspace, fallback: "🗃️", css_class: "notae-topbar-page-icon-inner", label: "Grid icon") %>
<% end %>
<% database_privacy_label =
     case @database.permission_mode
     when "private_database"
       "Private"
     when "specific_users"
       "Specific users"
     else
       "Shared to workspace"
     end %>
<% content_for :topbar_privacy, database_privacy_label %>
<% content_for :content_class, [ "notae-content-page", "notae-content-overlay-page", ("is-embedded-preview" if embedded_preview) ].compact.join(" ") %>
<% can_update_database = policy(@database).update? %>
<% can_edit_database = can_update_database && !@database.locked? %>
<% can_create_database = policy(Database.new(workspace: @workspace, name: "Untitled grid")).create? %>
<% shell_page = @page_title_page %>
<% shell_page_route_params = shell_page.present? ? { workspace_slug: @workspace.slug, id: shell_page.id } : nil %>
<% can_edit_shell_page = shell_page.present? && @can_update_page_title_page && !shell_page.locked? %>
<% current_path = request.fullpath %>
<% header_icon_value = shell_page&.icon.presence || @database.icon.presence %>
<% has_display_cover = shell_page.present? ? shell_page.cover? : @database.cover? %>
<% icon_over_cover = has_display_cover && header_icon_value.present? %>
<% page_search_url = workspace_document_targets_path(workspace_slug: @workspace.slug, kind: "page") %>
<% topbar_view_params = {
  workspace_slug: @workspace.slug,
  id: @database.id,
  view_id: @current_view&.id,
  month: (@view_type == "calendar" ? @calendar_month&.to_s : nil),
  sort_property_id: params[:sort_property_id],
  sort_direction: params[:sort_direction],
  filter_property_id: params[:filter_property_id],
  filter_value: params[:filter_value],
  filter_operator: params[:filter_operator],
  rows_page: params[:rows_page].presence,
  view_settings: params[:view_settings],
  view_settings_section: params[:view_settings_section],
  actions_menu: params[:actions_menu],
  options_menu: params[:options_menu],
  split_page_id: params[:split_page_id],
  split_source: params[:split_source],
  split_row_id: params[:split_row_id]
}.compact %>
<% unless embedded_preview %>
  <% content_for :topbar_actions do %>
    <span id="database_topbar_edited_at">
      <%= render "databases/topbar_edited_meta", database: @database %>
    </span>
    <% if @database_favorite.present? %>
      <%= button_to database_favorite_path(workspace_slug: @workspace.slug, database_id: @database.id),
                    method: :delete,
                    class: "notae-inline-icon-button notae-favorite-toggle is-favorited",
                    title: "Remove from favorites",
                    aria: { label: "Remove from favorites" } do %>
        ★
      <% end %>
    <% else %>
      <%= button_to database_favorite_path(workspace_slug: @workspace.slug, database_id: @database.id),
                    method: :post,
                    class: "notae-inline-icon-button notae-favorite-toggle",
                    title: "Add to favorites",
                    aria: { label: "Add to favorites" } do %>
        ☆
      <% end %>
    <% end %>
    <% unless @database.locked? %>
      <%= render "databases/comments_menu",
                 workspace: @workspace,
                 database: @database,
                 view_params: topbar_view_params %>
    <% end %>

    <%= render "databases/options_menu",
               workspace: @workspace,
               database: @database,
               view_params: topbar_view_params %>
  <% end %>
<% end %>

<% view_params = topbar_view_params %>
<% db_layout_classes = [ "notae-db-split-layout" ] %>
<% db_layout_classes << "has-side-peek" if @split_page.present? %>
<% db_layout_classes << "is-small-text" if @database.small_text? %>
<% db_layout_classes << "is-font-serif" if @database.font_style == "serif" %>
<% db_layout_classes << "is-font-mono" if @database.font_style == "mono" %>
<% db_layout_classes << "is-embedded-preview" if embedded_preview %>

<section class="<%= db_layout_classes.join(" ") %>"
         data-controller="database-view-state"
         data-action="turbo:submit-start->database-view-state#capture turbo:submit-end->database-view-state#restoreAfterSubmit click->database-view-state#captureLink"
         data-database-view-state-storage-key-value="database-view-scroll:<%= @database.id %>">
<section class="notae-db-canvas">
  <%= render "shared/flash_messages",
             flash_dom_id: "database_flash_messages",
             flash_host_class: "notae-db-inline-flash-host" %>
  <% if (shell_page.present? ? shell_page.cover? : @database.cover?) && !embedded_preview %>
    <section class="notae-page-cover">
      <div class="notae-page-cover-frame">
        <% if shell_page.present? && (cover_image = cover_display_image(shell_page)).present? %>
          <%= image_tag cover_image,
                        class: "notae-page-cover-image",
                        style: "object-position: center #{shell_page.cover_focal_y}%" %>
        <% elsif shell_page.blank? && (cover_image = cover_display_image(@database)).present? %>
          <%= image_tag cover_image,
                        class: "notae-page-cover-image",
                        style: "object-position: center #{@database.cover_focal_y}%" %>
        <% elsif (cover_style =
                    if shell_page.present?
                      page_cover_preset_style(shell_page.cover_preset_key, focal_y: shell_page.cover_focal_y)
                    else
                      page_cover_preset_style(@database.cover_preset_key, focal_y: @database.cover_focal_y)
                    end).present? %>
          <div class="notae-page-cover-preset"
               style="<%= cover_style %>">
          </div>
        <% end %>
        <%= render "shared/cover_attribution", attribution: cover_attribution(shell_page || @database) %>

        <% if can_edit_shell_page || (shell_page.blank? && can_edit_database) %>
          <div class="notae-page-cover-controls">
            <details class="notae-cover-picker">
              <summary class="notae-chip-button notae-cover-chip">Change</summary>
              <% if shell_page.present? %>
                <%= render "shared/cover_picker_panel",
                           update_url: page_path(shell_page_route_params),
                           param_key: :page,
                           selected_cover_key: shell_page.cover_preset_key,
                           workspace: @workspace,
                           cover_record: shell_page,
                           unsplash_url: workspace_cover_unsplash_path(workspace_slug: @workspace.slug),
                           return_to: current_path %>
              <% else %>
                <%= render "shared/cover_picker_panel",
                           update_url: database_path(workspace_slug: @workspace.slug, id: @database.id, view_id: @current_view&.id),
                           param_key: :database,
                           selected_cover_key: @database.cover_preset_key,
                           workspace: @workspace,
                           cover_record: @database,
                           unsplash_url: workspace_cover_unsplash_path(workspace_slug: @workspace.slug) %>
              <% end %>
            </details>

            <% if shell_page.present? %>
              <%= button_to "↑",
                            page_path(shell_page_route_params),
                            method: :patch,
                            params: { return_to: current_path, page: { cover_shift: "up" } },
                            class: "notae-chip-button notae-cover-chip",
                            title: "Move cover up",
                            aria: { label: "Move cover up" } %>
              <%= button_to "↓",
                            page_path(shell_page_route_params),
                            method: :patch,
                            params: { return_to: current_path, page: { cover_shift: "down" } },
                            class: "notae-chip-button notae-cover-chip",
                            title: "Move cover down",
                            aria: { label: "Move cover down" } %>
            <% else %>
              <%= button_to "↑",
                            database_path(workspace_slug: @workspace.slug, id: @database.id, view_id: @current_view&.id),
                            method: :patch,
                            params: { database: { cover_shift: "up" } },
                            class: "notae-chip-button notae-cover-chip",
                            title: "Move cover up",
                            aria: { label: "Move cover up" } %>
              <%= button_to "↓",
                            database_path(workspace_slug: @workspace.slug, id: @database.id, view_id: @current_view&.id),
                            method: :patch,
                            params: { database: { cover_shift: "down" } },
                            class: "notae-chip-button notae-cover-chip",
                            title: "Move cover down",
                            aria: { label: "Move cover down" } %>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <% unless embedded_preview %>
  <header class="notae-db-header <%= "has-overlapping-icon" if icon_over_cover %>">
    <% if header_icon_value.present? %>
      <div class="notae-page-icon-display <%= "is-over-cover" if icon_over_cover %>">
        <%= render_notae_icon(header_icon_value, workspace: @workspace, fallback: "🗃️", css_class: "notae-page-title-icon", label: "Grid icon") %>
      </div>
    <% end %>

    <% if can_edit_shell_page || (shell_page.blank? && can_edit_database) %>
      <div class="notae-db-header-tools">
        <% if shell_page.present? %>
          <details class="notae-page-header-action">
            <summary aria-label="<%= shell_page.icon.present? ? "Change icon" : "Add icon" %>">
              <span class="notae-page-header-action-icon">◌</span>
              <span class="notae-page-header-action-label"><%= shell_page.icon.present? ? "Change icon" : "Add icon" %></span>
            </summary>
            <%= render "shared/icon_picker_panel",
                       update_url: page_path(shell_page_route_params),
                       workspace: @workspace,
                       param_key: :page,
                       current_icon: shell_page.icon,
                       placeholder: "Type an emoji",
                       fallback: "🗃️",
                       return_to: current_path %>
          </details>

          <details class="notae-page-header-action">
            <summary aria-label="<%= shell_page.cover? ? "Change cover" : "Add cover" %>">
              <span class="notae-page-header-action-icon">▭</span>
              <span class="notae-page-header-action-label"><%= shell_page.cover? ? "Change cover" : "Add cover" %></span>
            </summary>
            <div class="notae-page-header-panel notae-page-header-cover-panel">
              <div class="notae-page-cover-panel-actions">
                <%= button_to "Move up",
                              page_path(shell_page_route_params),
                              method: :patch,
                              params: { return_to: current_path, page: { cover_shift: "up" } },
                              class: "notae-chip-button" %>
                <%= button_to "Move down",
                              page_path(shell_page_route_params),
                              method: :patch,
                              params: { return_to: current_path, page: { cover_shift: "down" } },
                              class: "notae-chip-button" %>
              </div>
              <%= render "shared/cover_picker_panel",
                         update_url: page_path(shell_page_route_params),
                         param_key: :page,
                         selected_cover_key: shell_page.cover_preset_key,
                         workspace: @workspace,
                         cover_record: shell_page,
                         unsplash_url: workspace_cover_unsplash_path(workspace_slug: @workspace.slug),
                         embedded: true,
                         allow_remove: shell_page.cover?,
                         remove_label: "Remove cover",
                         return_to: current_path %>
            </div>
          </details>
        <% else %>
          <details class="notae-page-header-action">
            <summary aria-label="<%= @database.icon.present? ? "Change icon" : "Add icon" %>">
              <span class="notae-page-header-action-icon">◌</span>
              <span class="notae-page-header-action-label"><%= @database.icon.present? ? "Change icon" : "Add icon" %></span>
            </summary>
            <%= render "shared/icon_picker_panel",
                       update_url: database_path(workspace_slug: @workspace.slug, id: @database.id, view_id: @current_view&.id),
                       workspace: @workspace,
                       param_key: :database,
                       current_icon: @database.icon,
                       placeholder: "Type an emoji",
                       fallback: "🗃️" %>
          </details>

          <details class="notae-page-header-action">
            <summary aria-label="<%= @database.cover? ? "Change cover" : "Add cover" %>">
              <span class="notae-page-header-action-icon">▭</span>
              <span class="notae-page-header-action-label"><%= @database.cover? ? "Change cover" : "Add cover" %></span>
            </summary>
            <div class="notae-page-header-panel notae-page-header-cover-panel">
              <div class="notae-page-cover-panel-actions">
                <%= button_to "Move up",
                              database_path(workspace_slug: @workspace.slug, id: @database.id, view_id: @current_view&.id),
                              method: :patch,
                              params: { database: { cover_shift: "up" } },
                              class: "notae-chip-button" %>
                <%= button_to "Move down",
                              database_path(workspace_slug: @workspace.slug, id: @database.id, view_id: @current_view&.id),
                              method: :patch,
                              params: { database: { cover_shift: "down" } },
                              class: "notae-chip-button" %>
              </div>
              <%= render "shared/cover_picker_panel",
                         update_url: database_path(workspace_slug: @workspace.slug, id: @database.id, view_id: @current_view&.id),
                         param_key: :database,
                         selected_cover_key: @database.cover_preset_key,
                         workspace: @workspace,
                         cover_record: @database,
                         unsplash_url: workspace_cover_unsplash_path(workspace_slug: @workspace.slug),
                         embedded: true,
                         allow_remove: @database.cover?,
                         remove_label: "Remove cover" %>
            </div>
          </details>

          <details class="notae-page-header-action">
            <summary aria-label="<%= @database.description.present? ? "Edit description" : "Add description" %>">
              <span class="notae-page-header-action-icon">ℹ</span>
              <span class="notae-page-header-action-label"><%= @database.description.present? ? "Edit description" : "Add description" %></span>
            </summary>
            <div class="notae-page-header-panel">
              <%= form_with model: @database,
                            url: database_path(workspace_slug: @workspace.slug, id: @database.id, view_id: @current_view&.id),
                            method: :patch,
                            class: "notae-page-header-panel-form" do |form| %>
                <%= hidden_field_tag "database[description_action]", "set" %>
                <%= form.text_area :description, rows: 3, class: "notae-options-input", placeholder: "Describe this grid..." %>
                <%= form.submit "Save description", class: "notae-chip-button" %>
              <% end %>
              <% if @database.description.present? %>
                <%= button_to "Remove description",
                              database_path(workspace_slug: @workspace.slug, id: @database.id, view_id: @current_view&.id),
                              method: :patch,
                              params: { database: { description_action: "clear" } },
                              class: "notae-page-header-link-button" %>
              <% end %>
            </div>
          </details>
        <% end %>
      </div>
      <% end %>

    <% if shell_page.present? %>
      <% if can_edit_shell_page %>
        <%= form_with model: shell_page,
                      url: page_path(shell_page_route_params),
                      method: :patch,
                      class: "notae-page-title-form",
                      data: {
                        controller: "page-title",
                        page_title_url_value: page_path(shell_page_route_params)
                      } do |form| %>
          <%= hidden_field_tag :return_to, current_path %>
          <%= form.text_area :title,
                             value: shell_page.title,
                             rows: 1,
                             class: "notae-page-title-input",
                             required: true,
                             aria: { label: "Parent title" },
                             data: {
                               page_title_target: "input",
                               action: "input->page-title#queueSave blur->page-title#flushSave change->page-title#flushSave keydown.enter->page-title#preventSubmit"
                             } %>
          <span class="notae-doc-muted" data-page-title-target="status" aria-live="polite">Saved</span>
        <% end %>
      <% else %>
        <h1 class="notae-db-title"><%= shell_page.title %></h1>
      <% end %>
    <% elsif can_edit_database %>
      <%= form_with model: @database,
                    url: database_path(view_params),
                    method: :patch,
                    class: "notae-page-title-form",
                    data: {
                      controller: "page-title",
                      page_title_url_value: database_path(view_params),
                      page_title_resource_value: "database",
                      page_title_field_value: "name"
                    } do |form| %>
        <%= form.text_area :name,
                           value: @database.name,
                           rows: 1,
                           class: "notae-page-title-input",
                           required: true,
                           aria: { label: "Grid title" },
                           data: {
                             page_title_target: "input",
                             action: "input->page-title#queueSave blur->page-title#flushSave change->page-title#flushSave keydown.enter->page-title#preventSubmit"
                           } %>
        <span class="notae-doc-muted" data-page-title-target="status" aria-live="polite">Saved</span>
      <% end %>
    <% else %>
      <h1 class="notae-db-title"><%= @database.name %></h1>
    <% end %>
    <% if shell_page.blank? && @database.description.present? %>
      <p class="notae-db-description"><%= @database.description %></p>
    <% end %>

    <%= render "shared/page_tabs",
               workspace: @workspace,
               navigation: @page_tabs,
               can_create_tab_page: @can_create_tab_page,
               create_tab_as_database: true,
               current_path: request.fullpath %>
  </header>

  <div class="notae-db-viewbar">
    <div class="notae-db-viewbar-left">
      <% if @database_views.empty? %>
        <span class="notae-db-view-pill is-active"><span class="notae-db-view-pill-icon">⊞</span> Table</span>
      <% else %>
        <% @database_views.each do |view| %>
          <%= link_to database_path(view_params.merge(view_id: view.id)),
                      class: [ "notae-db-view-pill", ("is-active" if @current_view&.id == view.id) ].compact.join(" ") do %>
            <span class="notae-db-view-pill-icon">⊞</span> <%= view.name %>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div class="notae-db-viewbar-right">
      <div class="notae-db-template-actions">
        <% if can_create_database %>
          <%= form_with model: Database.new, url: databases_path(workspace_slug: @workspace.slug), class: "notae-db-template-form" do |form| %>
            <%= hidden_field_tag :quick_create, "1" %>
            <%= form.hidden_field :name, value: "Untitled grid" %>
            <%= form.submit "Grid", class: "notae-chip-button notae-db-template-button" %>
          <% end %>
        <% end %>
        <%= form_with url: taskify_database_path(workspace_slug: @workspace.slug, id: @database.id),
                      method: :post,
                      class: "notae-db-template-form" do %>
          <%= button_tag "Tasks",
                         type: "submit",
                         class: [ "notae-chip-button", "notae-db-template-button", ("is-active" if @tasks_template_ready && @view_type == "table") ].compact.join(" "),
                         disabled: !can_edit_database || !@can_apply_tasks_template,
                         title: (!can_edit_database || @can_apply_tasks_template) ? nil : "Open a blank grid or new tab before using the Tasks template." %>
        <% end %>
        <%= form_with url: kanbanize_database_path(workspace_slug: @workspace.slug, id: @database.id),
                      method: :post,
                      class: "notae-db-template-form" do %>
          <%= button_tag "Kanban",
                         type: "submit",
                         class: "notae-chip-button notae-db-template-button",
                         disabled: !can_edit_database %>
        <% end %>
      </div>
      <% if @current_view.present? %>
        <%= render "databases/actions_menu",
                   workspace: @workspace,
                   database: @database,
                   view_params: view_params %>
      <% else %>
        <button type="button" class="notae-db-toolbar-icon is-muted" disabled title="Actions">⚡</button>
      <% end %>

      <% if @current_view.present? %>
        <%= render "databases/view_settings_menu",
                   database: @database,
                   view_params: view_params %>
      <% end %>

      <% unless @view_type == "table" %>
        <% if can_edit_database %>
          <%= button_to database_db_rows_path(workspace_slug: @workspace.slug, database_id: @database.id),
                        params: view_params.except(:workspace_slug, :id).merge(db_row: { title: "Untitled row" }),
                        class: "notae-db-toolbar-new",
                        form: { data: { preserve_database_scroll: true } } do %>
            <span>New</span>
          <% end %>
        <% else %>
          <button type="button" class="notae-db-toolbar-new" disabled>New</button>
        <% end %>
      <% end %>
    </div>
  </div>

  <% linked_page = @database.linked_page %>
  <p id="database_row_count" class="notae-db-meta"><%= render "databases/row_count_meta", row_count: @row_count %></p>
  <div class="notae-db-linked-page-controls">
    <% if linked_page.present? %>
      <%= link_to linked_page.title,
                  database_path(view_params.merge(split_page_id: linked_page.id, split_source: "database", split_row_id: nil)),
                  class: "notae-db-linked-page-name" %>
      <% if can_edit_database %>
        <%= button_to database_path(view_params),
                      method: :patch,
                      params: { database: { linked_page_action: "clear" } },
                      class: "notae-db-link-clear-button" do %>
          Unlink
        <% end %>
      <% end %>
    <% elsif can_edit_database %>
      <%= button_to database_path(view_params),
                    method: :patch,
                    params: { database: { linked_page_action: "create_page" } },
                    class: "notae-db-link-create-button" do %>
        <span class="notae-db-link-create-plus">+</span>
        <span>Create page</span>
      <% end %>
    <% else %>
      <span class="notae-db-linked-page-muted">No linked page</span>
    <% end %>

    <% if can_edit_database && linked_page.blank? %>
      <details class="notae-db-inline-details">
        <summary class="notae-db-grid-add-link">Choose page</summary>
        <div class="notae-db-inline-panel">
          <%= form_with model: @database,
                        url: database_path(view_params),
                        method: :patch,
                        class: "notae-db-inline-form",
                        data: {
                          controller: "document-picker",
                          document_picker_search_url_value: page_search_url,
                          document_picker_empty_text_value: "No matching notas."
                        } do |form| %>
            <%= form.hidden_field :linked_page_id, value: linked_page&.id, data: { document_picker_target: "hiddenInput" } %>
            <%= search_field_tag :database_link_page_search,
                                 "",
                                 placeholder: "Search notas",
                                 autocomplete: "off",
                                 class: "notae-options-input",
                                 data: {
                                   document_picker_target: "searchInput",
                                   action: "focus->document-picker#ensureLoaded input->document-picker#queueSearch search->document-picker#queueSearch"
                                 } %>
            <p class="notae-document-picker-loading" hidden data-document-picker-target="loading">Searching…</p>
            <div class="notae-document-picker-results" data-document-picker-target="results"></div>
            <p class="notae-options-empty" hidden data-document-picker-target="emptyState">No matching notas.</p>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>
  <% end %>

  <% if @view_type == "board" %>
    <%= render "databases/board_view" %>
  <% elsif @view_type == "calendar" %>
    <%= render "databases/calendar_view" %>
  <% elsif @view_type == "list" %>
    <%= render "databases/list_view" %>
  <% elsif @view_type == "gallery" %>
    <%= render "databases/gallery_view" %>
  <% else %>
    <%= render "databases/table_view" %>
  <% end %>

  <section class="notae-doc-backlinks">
    <h2>Backlinks</h2>
    <% backlink_pages = @backlinks.map(&:source_page).compact.uniq { |source_page| source_page.id } %>
    <% if backlink_pages.any? %>
      <ul>
        <% backlink_pages.each do |source_page| %>
          <li>
            <%= link_to linked_document_label(source_page),
                        linked_document_path(
                          source_page,
                          workspace: @workspace,
                          embedded: embedded_preview
                        ),
                        data: { backlink_source: source_page.id } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>No backlinks yet.</p>
    <% end %>
  </section>
</section>

<% if @split_page.present? %>
  <% split_record = @split_page.linked_database || @split_page %>
  <% split_label = linked_document_label(split_record) %>
  <aside class="notae-db-split-pane">
    <div class="notae-db-split-pane-head">
      <p class="notae-db-split-pane-title" title="<%= split_label %>">
        <%= render_notae_icon(linked_document_icon(split_record), workspace: @workspace, fallback: "📄", css_class: "notae-inline-linked-icon", label: split_label) %>
        <%= truncate(split_label, length: 30) %>
      </p>
      <div class="notae-db-split-pane-actions">
        <%= link_to "Open full",
                    linked_document_path(split_record, workspace: @workspace),
                    class: "notae-chip-button" %>
        <%= link_to "✕",
                    database_path(view_params.except(:split_page_id, :split_source, :split_row_id)),
                    class: "notae-inline-icon-button",
                    aria: { label: "Close side peek" },
                    title: "Close side peek" %>
      </div>
    </div>
    <iframe src="<%= linked_document_path(split_record, workspace: @workspace, embedded: true) %>"
            title="Linked page side peek"
            class="notae-db-split-frame"
            loading="lazy"></iframe>
  </aside>
<% end %>
</section>
