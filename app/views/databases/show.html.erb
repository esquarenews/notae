                                method: :post,
                                class: "notae-actions-inline-form" do %>
                    <button type="submit" class="notae-actions-row-button">
                      <span class="notae-actions-row-icon">⧉</span>
                      <span class="notae-actions-row-label">Duplicate</span>
                      <span class="notae-actions-row-meta">⌘D</span>
                    </button>
                  <% end %>
                <% else %>
                  <button type="button" class="notae-actions-row-button" disabled>
                    <span class="notae-actions-row-icon">⧉</span>
                    <span class="notae-actions-row-label">Duplicate</span>
                    <span class="notae-actions-row-meta">⌘D</span>
                  </button>
                <% end %>
              </div>

              <div class="notae-actions-row <%= "is-disabled" unless can_edit_database %>"
                   data-shell-action-item
                   data-shell-action-terms="kanban board status">
                <% if can_edit_database %>
                  <%= form_with url: kanbanize_database_path(workspace_slug: @workspace.slug, id: @database.id),
                                method: :post,
                                class: "notae-actions-inline-form" do %>
                    <button type="submit" class="notae-actions-row-button">
                      <span class="notae-actions-row-icon">☷</span>
                      <span class="notae-actions-row-label">Open as Kanban</span>
                    </button>
                  <% end %>
                <% else %>
                  <button type="button" class="notae-actions-row-button" disabled>
                    <span class="notae-actions-row-icon">☷</span>
                    <span class="notae-actions-row-label">Open as Kanban</span>
                  </button>
                <% end %>
              </div>

              <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="move to page">
                <% if @linkable_pages.any? && can_edit_database %>
                  <%= form_with model: @database,
                                url: database_path(view_params.merge(actions_menu: "open")),
                                method: :patch,
                                class: "notae-actions-move-form" do |form| %>
                    <%= form.select :linked_page_id,
                                    options_for_select([ [ "Move to...", "" ] ] + @linkable_pages.map { |candidate| [ candidate.title, candidate.id ] }, @database.linked_page_id),
                                    {},
                                    class: "notae-options-input notae-actions-move-select" %>
                    <%= form.submit "Move", class: "notae-chip-button" %>
                  <% end %>
                <% elsif @linkable_pages.any? %>
                  <button type="button" class="notae-actions-row-button" disabled>
                    <span class="notae-actions-row-icon">↗</span>
                    <span class="notae-actions-row-label">Move to</span>
                    <span class="notae-actions-row-meta">Read only</span>
                  </button>
                <% else %>
                  <button type="button" class="notae-actions-row-button" disabled>
                    <span class="notae-actions-row-icon">↗</span>
                    <span class="notae-actions-row-label">Move to</span>
                    <span class="notae-actions-row-meta">No Notarum</span>
                  </button>
                <% end %>
              </div>

              <div class="notae-actions-row <%= "is-disabled" unless can_archive_database %>"
                   data-shell-action-item
                   data-shell-action-terms="trash archive delete">
                <% if can_archive_database %>
                  <%= button_to archive_database_path(workspace_slug: @workspace.slug, id: @database.id),
                                method: :patch,
                                class: "notae-actions-row-button is-danger",
                                form: { data: { turbo_confirm: "Move this grid to Trash?" } } do %>
                    <span class="notae-actions-row-icon">🗑</span>
                    <span class="notae-actions-row-label">Move to Trash</span>
                  <% end %>
                <% else %>
                  <button type="button" class="notae-actions-row-button is-danger" disabled>
                    <span class="notae-actions-row-icon">🗑</span>
                    <span class="notae-actions-row-label">Move to Trash</span>
                  </button>
                <% end %>
              </div>

              <% if @current_view.present? && can_update_view %>
                <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="duplicate view copy">
                  <%= form_with model: @new_database_view,
                                url: database_database_views_path(workspace_slug: @workspace.slug, database_id: @database.id, actions_menu: "open"),
                                class: "notae-actions-inline-form" do |form| %>
                    <%= form.hidden_field :name, value: "#{@current_view.name} copy" %>
                    <%= form.hidden_field :view_type, value: @current_view.view_type %>
                    <%= form.hidden_field :sort_property_id, value: @view_config["sort_property_id"] %>
                    <%= form.hidden_field :sort_direction, value: @view_config["sort_direction"] %>
                    <%= form.hidden_field :filter_property_id, value: @view_config["filter_property_id"] %>
                    <%= form.hidden_field :filter_value, value: @view_config["filter_value"] %>
                    <%= form.hidden_field :filter_operator, value: @view_config["filter_operator"] %>
                    <%= form.hidden_field :group_property_id, value: @view_config["group_property_id"] %>
                    <%= form.hidden_field :date_property_id, value: @view_config["date_property_id"] %>
                    <% Array(@view_config["visible_property_ids"]).each do |property_id| %>
                      <%= hidden_field_tag "database_view[visible_property_ids][]", property_id %>
                    <% end %>
                    <%= form.hidden_field :conditional_color_mode, value: @view_config["conditional_color_mode"] %>
                    <%= form.hidden_field :conditional_color_property_id, value: @view_config["conditional_color_property_id"] %>
                    <button type="submit" class="notae-actions-row-button">
                      <span class="notae-actions-row-icon">⧉</span>
                      <span class="notae-actions-row-label">Duplicate view</span>
                    </button>
                  <% end %>
                </div>
              <% end %>
                </section>

                <section class="notae-actions-section"
                         data-shell-actions-section
                         data-actions-menu-target="section"
                         data-actions-menu-label="Tools">
              <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="small text">
                <%= form_with model: @database,
                              url: database_path(view_params.merge(actions_menu: "open")),
                              method: :patch,
                              class: "notae-actions-inline-form" do |form| %>
                  <%= form.hidden_field :small_text, value: (!@database.small_text?).to_s %>
                  <button type="submit" class="notae-actions-row-button">
                    <span class="notae-actions-row-icon">A</span>
                    <span class="notae-actions-row-label">Small text</span>
                    <span class="notae-actions-switch <%= "is-on" if @database.small_text? %>"><span></span></span>
                  </button>
                <% end %>
              </div>

              <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="undo">
                <button type="button" class="notae-actions-row-button" data-action="click->shell#undo">
                  <span class="notae-actions-row-icon">↶</span>
                  <span class="notae-actions-row-label">Undo</span>
                  <span class="notae-actions-row-meta">⌘Z</span>
                </button>
              </div>

              <div class="notae-actions-row <%= "is-disabled" unless can_edit_database %>"
                   data-shell-action-item
                   data-shell-action-terms="new row add row">
                <% if can_edit_database %>
                  <%= button_to database_db_rows_path(workspace_slug: @workspace.slug, database_id: @database.id),
                                params: view_params.except(:workspace_slug, :id).merge(actions_menu: "open", db_row: { title: "Untitled row" }),
                                class: "notae-actions-row-button" do %>
                    <span class="notae-actions-row-icon">＋</span>
                    <span class="notae-actions-row-label">New row</span>
                  <% end %>
                <% else %>
                  <button type="button" class="notae-actions-row-button" disabled>
                    <span class="notae-actions-row-icon">＋</span>
                    <span class="notae-actions-row-label">New row</span>
                  </button>
                <% end %>
              </div>

              <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="export csv">
                <a class="notae-actions-row-link" href="<%= export_csv_database_path(workspace_slug: @workspace.slug, id: @database.id) %>">
                  <span class="notae-actions-row-icon">↑</span>
                  <span class="notae-actions-row-label">Export</span>
                  <span class="notae-actions-row-meta">CSV</span>
                </a>
              </div>

              <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="view settings customize">
                <%= link_to database_path(view_params.merge(view_settings: "open")),
                            class: "notae-actions-row-link" do %>
                  <span class="notae-actions-row-icon">⚙</span>
                  <span class="notae-actions-row-label">Open view settings</span>
                <% end %>
              </div>

              <details class="notae-actions-submenu" data-shell-action-item data-shell-action-terms="updates analytics audit">
                <summary class="notae-actions-row-button">
                  <span class="notae-actions-row-icon">◷</span>
                  <span class="notae-actions-row-label">Updates &amp; analytics</span>
                </summary>
                <ul class="notae-actions-version-list">
                  <% if @recent_database_audit_events.any? %>
                    <% @recent_database_audit_events.each do |audit_event| %>
                      <li><strong><%= audit_event.action.humanize %></strong> · <%= time_ago_in_words(audit_event.created_at) %> ago</li>
                    <% end %>
                  <% else %>
                    <li>No audit events yet.</li>
                  <% end %>
                </ul>
              </details>

              <details class="notae-actions-submenu" data-shell-action-item data-shell-action-terms="version history">
                <summary class="notae-actions-row-button">
                  <span class="notae-actions-row-icon">🕘</span>
                  <span class="notae-actions-row-label">Version history</span>
                </summary>
                <ul class="notae-actions-version-list">
                  <% if @database_versions.any? %>
                    <% @database_versions.each do |version| %>
                      <li><strong><%= version.event.to_s.titleize %></strong> · <%= time_ago_in_words(version.created_at) %> ago</li>
                    <% end %>
                  <% else %>
                    <li>No previous versions yet.</li>
                  <% end %>
                </ul>
              </details>
                </section>
              </div>
            </div>
          </div>
        </details>
      <% else %>
        <button type="button" class="notae-db-toolbar-icon is-muted" disabled title="Actions">⚡</button>
      <% end %>

      <% if @current_view.present? %>
        <details class="notae-db-settings-menu" data-controller="copy-text" <%= "open" if params[:view_settings].to_s == "open" %>>
          <summary class="notae-db-toolbar-icon <%= "is-active" if params[:view_settings].to_s == "open" %>" title="View settings">⚙</summary>
          <div class="notae-db-settings-panel <%= "is-grid-locked" if @database.locked? %>">
            <% if @database.locked? %>
              <p class="notae-actions-locked-note notae-db-settings-locked-note">Grid is locked. Unlock to edit settings.</p>
            <% end %>

            <section class="notae-db-settings-section" data-grid-settings-section>
              <p class="notae-db-settings-title">View settings</p>

              <div class="notae-db-settings-view-name-row">
                <% if can_edit_database %>
                  <%= form_with model: @database,
                                url: database_path(view_params.merge(view_settings: "open")),
                                method: :patch,
                                class: "notae-db-settings-inline-form" do |form| %>
                    <span class="notae-db-settings-icon">⊞</span>
                    <%= form.text_field :name,
                                        value: @database.name,
                                        class: "notae-options-input",
                                        required: true,
                                        aria: { label: "Grid name" } %>
                    <%= form.submit "Save", class: "notae-chip-button" %>
                  <% end %>
                <% else %>
                  <div class="notae-db-settings-readonly-line">
                    <span class="notae-db-settings-icon">⊞</span>
                    <span><%= @database.name %></span>
                  </div>
                <% end %>

                <details class="notae-db-settings-mini-details">
                  <summary class="notae-db-settings-mini-trigger" title="Edit grid description">i</summary>
                  <div class="notae-db-settings-mini-panel">
                    <% if can_edit_database %>
                      <%= form_with model: @database,
                                    url: database_path(view_params.merge(view_settings: "open")),
                                    method: :patch,
                                    class: "notae-db-settings-description-form" do |form| %>
                        <%= hidden_field_tag "database[description_action]", "set" %>
                        <%= form.text_area :description,
                                           value: @database.description,
                                           rows: 3,
                                           class: "notae-options-input",
                                           placeholder: "Short description..." %>
                        <div class="notae-db-settings-description-actions">
                          <%= form.submit "Save", class: "notae-chip-button" %>
                        </div>
                      <% end %>
                    <% else %>
                      <p class="notae-db-settings-muted"><%= @database.description.presence || "No description set." %></p>
                    <% end %>
                  </div>
                </details>
              </div>

              <details class="notae-db-settings-submenu">
                <summary class="notae-db-settings-row-button">
                  <span><span class="notae-db-settings-icon">⊞</span> Layout</span>
                  <span class="notae-db-settings-meta"><%= @current_view.view_type.titleize %></span>
                </summary>
                <div class="notae-db-settings-subpanel">
                  <% layout_labels = {
                    "table" => "Table",
                    "board" => "Kanban board",
                    "timeline" => "Timeline",
                    "calendar" => "Calendar",
                    "list" => "List",
                    "gallery" => "Gallery",
                    "chart" => "Chart",
                    "feed" => "Feed",
                    "map" => "Map"
                  } %>
                  <% supported_layout_types.each do |layout_type| %>
                    <% label = layout_labels.fetch(layout_type, layout_type.titleize) %>
                    <% enabled_layout = enabled_layout_types.include?(layout_type) %>
                    <% active_layout = @current_view.view_type == layout_type %>
                    <% if enabled_layout && can_update_view %>
                      <%= form_with model: @current_view,
                                    url: database_database_view_path(
                                      workspace_slug: @workspace.slug,
                                      database_id: @database.id,
                                      id: @current_view.id,
                                      view_settings: "open"
                                    ),
                                    method: :patch,
                                    data: { preserve_database_scroll: true },
                                    class: "notae-db-settings-layout-form" do |form| %>
                        <%= form.hidden_field :view_type, value: layout_type %>
                        <button type="submit"
                                class="notae-db-settings-layout-option <%= "is-active" if active_layout %>">
                          <span><%= label %></span>
                          <% if active_layout %>
                            <span class="notae-db-settings-meta">Current</span>
                          <% end %>
                        </button>
                      <% end %>
                    <% else %>
                      <div class="notae-db-settings-layout-option is-disabled">
                        <span><%= label %></span>
                        <span class="notae-db-settings-meta"><%= enabled_layout ? "Read only" : "Coming soon" %></span>
                      </div>
                    <% end %>
                  <% end %>
                </div>
              </details>

              <details class="notae-db-settings-submenu" <%= "open" if params[:view_settings_section].to_s == "visibility" %>>
                <summary class="notae-db-settings-row-button">
                  <span><span class="notae-db-settings-icon">◌</span> Property visibility</span>
                  <span class="notae-db-settings-meta"><%= @visible_db_properties.size %></span>
                </summary>
                <div class="notae-db-settings-subpanel">
                  <% if can_update_view %>
                    <% filter_operator_options = [
                      ["Equals", "eq"],
                      ["Does not equal", "neq"],
                      ["Before / less than", "before"],
                      ["After / greater than", "after"]
                    ] %>
                    <%= form_with model: @current_view,
                                  url: database_database_view_path(
                                    workspace_slug: @workspace.slug,
                                    database_id: @database.id,
                                    id: @current_view.id,
                                    view_settings: "open"
                                  ),
                                  method: :patch,
                                  data: { preserve_database_scroll: true },
                                  class: "notae-db-settings-checkbox-list" do |form| %>
                      <%= hidden_field_tag "database_view[visible_property_ids][]", "" %>
                      <% @db_properties.each do |property| %>
                        <% checked = @visible_property_ids.blank? || @visible_property_ids.include?(property.id.to_s) %>
                        <label class="notae-options-checkbox">
                          <%= check_box_tag "database_view[visible_property_ids][]", property.id, checked %>
                          <span><%= property.name %></span>
                        </label>
                      <% end %>
                      <%= form.submit "Apply", class: "notae-chip-button" %>
                    <% end %>
                  <% else %>
                    <p class="notae-db-settings-muted">Property visibility is read-only while this grid is locked.</p>
                  <% end %>
                </div>
              </details>

              <details class="notae-db-settings-submenu">
                <summary class="notae-db-settings-row-button">
                  <span><span class="notae-db-settings-icon">⌕</span> Filter</span>
                  <span class="notae-db-settings-meta"><%= @filter_property.present? ? @filter_property.name : "None" %></span>
                </summary>
                <div class="notae-db-settings-subpanel">
                  <% if can_update_view %>
                    <%= form_with model: @current_view,
                                  url: database_database_view_path(
                                    workspace_slug: @workspace.slug,
                                    database_id: @database.id,
                                    id: @current_view.id,
                                    view_settings: "open"
                                  ),
                                  method: :patch,
                                  data: { preserve_database_scroll: true },
                                  class: "notae-db-view-submenu-form" do |form| %>
                      <%= form.select :filter_property_id,
                                      @db_properties.map { |property| [property.name, property.id] },
                                      { include_blank: "No filter", selected: @view_config["filter_property_id"] },
                                      class: "notae-options-input" %>
                      <%= form.select :filter_operator,
                                      filter_operator_options,
                                      { selected: @view_config["filter_operator"].presence || "eq" },
                                      class: "notae-options-input" %>
                      <%= form.text_field :filter_value,
                                          value: @view_config["filter_value"],
                                          placeholder: "Value",
                                          class: "notae-options-input" %>
                      <p class="notae-db-settings-muted">For dates, before/after means earlier or later. For numbers, it means less than or greater than.</p>
                      <%= form.submit "Apply", class: "notae-chip-button" %>
                    <% end %>
                  <% else %>
                    <p class="notae-db-settings-muted">Filtering is read-only while this grid is locked.</p>
                  <% end %>
                </div>
              </details>

              <details class="notae-db-settings-submenu">
                <summary class="notae-db-settings-row-button">
                  <span><span class="notae-db-settings-icon">↕</span> Sort</span>
                  <span class="notae-db-settings-meta"><%= @sort_property.present? ? @sort_property.name : "None" %></span>
                </summary>
                <div class="notae-db-settings-subpanel">
                  <% if can_update_view %>
                    <%= form_with model: @current_view,
                                  url: database_database_view_path(
                                    workspace_slug: @workspace.slug,
                                    database_id: @database.id,
                                    id: @current_view.id,
                                    view_settings: "open"
                                  ),
                                  method: :patch,
                                  data: { preserve_database_scroll: true },
                                  class: "notae-db-view-submenu-form" do |form| %>
                      <%= form.select :sort_property_id,
                                      @db_properties.map { |property| [property.name, property.id] },
                                      { include_blank: "No sort", selected: @view_config["sort_property_id"] },
                                      class: "notae-options-input" %>
                      <%= form.select :sort_direction,
                                      [["Ascending", "asc"], ["Descending", "desc"]],
                                      { selected: @view_config["sort_direction"].presence || "asc" },
                                      class: "notae-options-input" %>
                      <%= form.submit "Apply", class: "notae-chip-button" %>
                    <% end %>
                  <% else %>
                    <p class="notae-db-settings-muted">Sorting is read-only while this grid is locked.</p>
                  <% end %>
                </div>
              </details>

              <div class="notae-db-settings-row-button is-disabled">
                <span><span class="notae-db-settings-icon">☷</span> Group</span>
              </div>

              <details class="notae-db-settings-submenu">
                <summary class="notae-db-settings-row-button">
                  <span><span class="notae-db-settings-icon">◍</span> Conditional color</span>
                  <span class="notae-db-settings-meta"><%= @conditional_color_mode == "overdue" ? "Overdue" : "Off" %></span>
                </summary>
                <div class="notae-db-settings-subpanel">
                  <p class="notae-db-settings-muted">
                    Customize page colors to easily distinguish categories, highlight overdue events, and bring clarity to your work.
                  </p>
                  <% if can_update_view %>
                    <%= form_with model: @current_view,
                                  url: database_database_view_path(
                                    workspace_slug: @workspace.slug,
                                    database_id: @database.id,
                                    id: @current_view.id,
                                    view_settings: "open"
                                  ),
                                  method: :patch,
                                  data: { preserve_database_scroll: true },
                                  class: "notae-db-view-submenu-form" do |form| %>
                      <%= form.select :conditional_color_mode,
                                      [["Off", ""], ["Highlight overdue", "overdue"]],
                                      { selected: @view_config["conditional_color_mode"] },
                                      class: "notae-options-input" %>
                      <%= form.select :conditional_color_property_id,
                                      @db_properties.select(&:date?).map { |property| [property.name, property.id] },
                                      { include_blank: "Choose date column", selected: @view_config["conditional_color_property_id"] },
                                      class: "notae-options-input" %>
                      <%= form.submit "Apply", class: "notae-chip-button" %>
                    <% end %>
                  <% else %>
                    <p class="notae-db-settings-muted">Conditional color is read-only while this grid is locked.</p>
                  <% end %>
                </div>
              </details>

              <button type="button"
                      class="notae-db-settings-row-button"
                      data-action="click->copy-text#copy"
                      data-copy-text-value="<%= view_link %>">
                <span><span class="notae-db-settings-icon">🔗</span> Copy link to view</span>
                <span class="notae-db-settings-meta" data-copy-text-feedback>Copy</span>
              </button>
            </section>

            <section class="notae-db-settings-section" data-grid-settings-section>
              <p class="notae-db-settings-title">Data source settings</p>

              <div class="notae-db-settings-row-button is-disabled">
                <span><span class="notae-db-settings-icon">⇄</span> Source</span>
                <span class="notae-db-settings-meta">Coming soon</span>
              </div>

              <div class="notae-db-settings-row-button is-disabled">
                <span><span class="notae-db-settings-icon">☷</span> Edit properties</span>
                <span class="notae-db-settings-meta">Coming soon</span>
              </div>

              <div class="notae-db-settings-row-button is-disabled">
                <span><span class="notae-db-settings-icon">…</span> More settings</span>
                <span class="notae-db-settings-meta">Coming soon</span>
              </div>

              <div class="notae-db-settings-row-button is-disabled">
                <span><span class="notae-db-settings-icon">⎘</span> Manage data sources</span>
                <span class="notae-db-settings-meta">Coming soon</span>
              </div>
            </section>

            <section class="notae-db-settings-section">
              <p class="notae-db-settings-title">Access</p>
              <div class="notae-db-settings-lock-row <%= "is-disabled" unless can_manage_database_permissions %>">
                <% if can_manage_database_permissions %>
                  <%= form_with model: @database,
                                url: database_path(view_params.merge(view_settings: "open")),
                                method: :patch,
                                class: "notae-db-settings-inline-form" do |form| %>
                    <%= form.hidden_field :locked, value: (!@database.locked?).to_s %>
                    <button type="submit" class="notae-db-settings-row-button">
                      <span><span class="notae-db-settings-icon"><%= @database.locked? ? "🔓" : "🔒" %></span> <%= @database.locked? ? "Unlock grid" : "Lock grid" %></span>
                      <span class="notae-actions-switch <%= "is-on" if @database.locked? %>"><span></span></span>
                    </button>
                  <% end %>
                <% else %>
                  <button type="button" class="notae-db-settings-row-button" disabled>
                    <span><span class="notae-db-settings-icon">🔒</span> Lock grid</span>
                  </button>
                <% end %>
              </div>
            </section>
          </div>
        </details>
      <% end %>

      <% unless @view_type == "table" %>
        <% if can_edit_database %>
          <%= button_to database_db_rows_path(workspace_slug: @workspace.slug, database_id: @database.id),
                        params: view_params.except(:workspace_slug, :id).merge(db_row: { title: "Untitled row" }),
                        class: "notae-db-toolbar-new" do %>
            <span>New</span>
          <% end %>
        <% else %>
          <button type="button" class="notae-db-toolbar-new" disabled>New</button>
        <% end %>
      <% end %>
    </div>
  </div>

  <% linked_page = @linkable_pages_by_id[@database.linked_page_id] %>
  <p id="database_row_count" class="notae-db-meta"><%= render "databases/row_count_meta", row_count: @rows.size %></p>
  <div class="notae-db-linked-page-controls">
    <% if linked_page.present? %>
      <%= link_to linked_page.title,
                  database_path(view_params.merge(split_page_id: linked_page.id, split_source: "database", split_row_id: nil)),
                  class: "notae-db-linked-page-name" %>
      <% if can_edit_database %>
        <%= button_to database_path(view_params),
                      method: :patch,
                      params: { database: { linked_page_action: "clear" } },
                      class: "notae-db-link-clear-button" do %>
          Unlink
        <% end %>
      <% end %>
    <% elsif can_edit_database %>
      <%= button_to database_path(view_params),
                    method: :patch,
                    params: { database: { linked_page_action: "create_page" } },
                    class: "notae-db-link-create-button" do %>
        <span class="notae-db-link-create-plus">+</span>
        <span>Create page</span>
      <% end %>
    <% else %>
      <span class="notae-db-linked-page-muted">No linked page</span>
    <% end %>

    <% if can_edit_database && linked_page.blank? %>
      <details class="notae-db-inline-details">
        <summary class="notae-db-grid-add-link">Choose page</summary>
        <div class="notae-db-inline-panel">
          <%= form_with model: @database,
                        url: database_path(view_params),
                        method: :patch,
                        class: "notae-db-inline-form" do |form| %>
            <%= form.select :linked_page_id,
                            options_for_select(@linkable_pages.map { |page| [page.title, page.id] }, linked_page&.id),
                            { include_blank: "No linked page" },
                            class: "notae-options-input" %>
            <%= form.submit "Save", class: "notae-chip-button" %>
          <% end %>
        </div>
      </details>
    <% end %>
  </div>

  <% if @view_type == "board" %>
    <%= render "databases/board_view" %>
  <% elsif @view_type == "calendar" %>
    <%= render "databases/calendar_view" %>
  <% elsif @view_type == "list" %>
    <%= render "databases/list_view" %>
  <% elsif @view_type == "gallery" %>
    <%= render "databases/gallery_view" %>
  <% else %>
    <%= render "databases/table_view" %>
  <% end %>

  <section class="notae-doc-backlinks">
    <h2>Backlinks</h2>
    <% backlink_pages = @backlinks.map(&:source_page).compact.uniq { |source_page| source_page.id } %>
    <% if backlink_pages.any? %>
      <ul>
        <% backlink_pages.each do |source_page| %>
          <li>
            <%= link_to linked_document_label(source_page),
                        linked_document_path(
                          source_page,
                          workspace: @workspace,
                          embedded: params[:embedded].to_s == "1"
                        ),
                        data: { backlink_source: source_page.id } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>No backlinks yet.</p>
    <% end %>
  </section>
</section>

<% if @split_page.present? %>
  <% split_record = @split_page.linked_database || @split_page %>
  <aside class="notae-db-split-pane">
    <div class="notae-db-split-pane-head">
      <p class="notae-db-split-pane-title">
        <%= render_notae_icon(linked_document_icon(split_record), workspace: @workspace, fallback: "📄", css_class: "notae-inline-linked-icon", label: linked_document_label(split_record)) %>
        <%= linked_document_label(split_record) %>
      </p>
      <div class="notae-db-split-pane-actions">
        <%= link_to "Open full",
                    linked_document_path(split_record, workspace: @workspace),
                    class: "notae-chip-button",
                    target: "_blank",
                    rel: "noopener" %>
        <%= link_to "✕",
                    database_path(view_params.except(:split_page_id, :split_source, :split_row_id)),
                    class: "notae-inline-icon-button",
                    aria: { label: "Close side peek" },
                    title: "Close side peek" %>
      </div>
    </div>
    <iframe src="<%= linked_document_path(split_record, workspace: @workspace, embedded: true) %>"
            title="Linked page side peek"
            class="notae-db-split-frame"
            loading="lazy"></iframe>
  </aside>
<% end %>
</section>
