<% wrapper_class = local_assigns.fetch(:wrapper_class, "notae-db-inline-details notae-db-row-more-menu") %>
<% button_class = local_assigns.fetch(:button_class, "notae-db-row-hover-control") %>
<% button_title = local_assigns.fetch(:button_title, "Row options") %>
<% defer_body = local_assigns.fetch(:defer_body, true) %>
<% panel_url = local_assigns.fetch(:panel_url) do
  panel_database_path({ workspace_slug: workspace.slug, id: database.id, panel: "row_menu", row_id: row.id }.merge(row_params))
end %>

<div class="<%= wrapper_class %>"
     data-controller="row-menu"
     data-row-menu-gap-value="6"
     data-row-menu-margin-value="12"
     data-row-menu-url-value="<%= panel_url if defer_body %>"
     <%= 'data-row-menu-loaded-value="true"' unless defer_body %>
     data-row-menu-loading-text-value="Loading row actions…"
     data-row-menu-error-text-value="Could not load row actions.">
  <button type="button"
          class="<%= button_class %>"
          title="<%= button_title %>"
          aria-label="<%= button_title %>"
          aria-expanded="false"
          data-row-menu-target="button"
          data-action="click->row-menu#toggle">⋯</button>
  <div class="notae-db-inline-panel notae-db-row-more-panel" data-row-menu-target="panel" hidden>
    <div data-row-menu-target="content">
      <% unless defer_body %>
        <%= render "databases/row_context_menu_body",
                   row: row,
                   workspace: workspace,
                   database: database,
                   row_update_path: row_update_path,
                   row_params: row_params,
                   row_color_options: row_color_options,
                   row_can_destroy: local_assigns.fetch(:row_can_destroy) { policy(row).destroy? && !database.locked? },
                   linked_page: local_assigns[:linked_page],
                   row_is_bold: local_assigns.fetch(:row_is_bold) { row.row_bold? },
                   row_is_italic: local_assigns.fetch(:row_is_italic) { row.row_italic? },
                   row_text_color: local_assigns.fetch(:row_text_color) { row.row_text_color },
                   row_background_color: local_assigns.fetch(:row_background_color) { row.row_background_color },
                   form_authenticity_token_value: local_assigns[:form_authenticity_token_value] || form_authenticity_token %>
      <% end %>
    </div>
  </div>
</div>
