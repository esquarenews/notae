<% defer_body = local_assigns.fetch(:defer_body, true) %>
<% panel_url = local_assigns.fetch(:panel_url) do
  panel_database_path({ workspace_slug: workspace.slug, id: database.id, panel: "name_column_menu" }.merge(row_params))
end %>

<div class="notae-db-column-hover-controls"
     data-controller="row-menu"
     data-row-menu-gap-value="6"
     data-row-menu-margin-value="12"
     data-row-menu-url-value="<%= panel_url if defer_body %>"
     <%= 'data-row-menu-loaded-value="true"' unless defer_body %>
     data-row-menu-loading-text-value="Loading column actions..."
     data-row-menu-error-text-value="Could not load column actions.">
  <button type="button"
          class="notae-db-row-hover-control notae-db-column-hover-control"
          title="Column options"
          aria-label="Column options for Name"
          aria-expanded="false"
          data-row-menu-target="button"
          data-action="click->row-menu#toggle">⋯</button>
  <div class="notae-db-inline-panel notae-db-row-more-panel notae-db-column-more-panel"
       data-row-menu-target="panel"
       hidden>
    <div data-row-menu-target="content">
      <% unless defer_body %>
        <%= render "databases/name_column_context_menu_body",
                   workspace: workspace,
                   database: database,
                   row_params: row_params,
                   row_color_options: row_color_options %>
      <% end %>
    </div>
  </div>
</div>
