<details id="database-options-menu"
         class="notae-options-menu"
         data-controller="copy-text options-menu lazy-panel"
         data-action="toggle->shell#syncTopbarMenus lazy-panel:loaded->options-menu#refresh"
         data-shell-options-menu
         data-shell-target="optionsMenu"
         data-lazy-panel-url-value="<%= panel_database_path(view_params.merge(panel: "options")) %>"
         data-lazy-panel-loading-text-value="Loading options…"
         data-lazy-panel-error-text-value="Could not load options."
         <%= "open" if params[:options_menu].to_s == "open" %>>
  <summary class="notae-chip-button notae-actions-trigger" aria-label="Options">
    <span class="notae-actions-trigger-icon" aria-hidden="true">⚙</span>
    <span class="notae-actions-trigger-label">Options</span>
  </summary>
  <div class="notae-options-panel" data-options-menu-target="panel" data-lazy-panel-target="container"></div>
</details>
