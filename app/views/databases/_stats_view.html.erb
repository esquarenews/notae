<% stats_date = @stats_date || Time.zone.today %>
<% stats_mode = @stats_mode || "report" %>
<% stats_view_params = view_params.except(:workspace_slug, :id, :stats_date, :stats_mode).compact %>
<% stats_setup_form_id = "stats_setup_form_#{@database.id}" %>
<% row_color_options = [
  ["Default", "default"],
  ["Gray", "gray"],
  ["Brown", "brown"],
  ["Orange", "orange"],
  ["Yellow", "yellow"],
  ["Green", "green"],
  ["Blue", "blue"],
  ["Purple", "purple"],
  ["Pink", "pink"],
  ["Red", "red"]
] %>

<div class="notae-db-stats-view">
  <%= form_with url: database_path(workspace_slug: @workspace.slug, id: @database.id),
                method: :get,
                class: "notae-db-inline-form notae-db-stats-toolbar" do %>
    <% stats_view_params.each do |key, value| %>
      <%= hidden_field_tag key, value %>
    <% end %>
    <%= date_field_tag :stats_date,
                       stats_date.iso8601,
                       class: "notae-options-input",
                       aria: { label: "Stats date" },
                       onchange: "this.form.requestSubmit()" %>
    <%= select_tag :stats_mode,
                   options_for_select([ [ "Report", "report" ], [ "Set up", "setup" ] ], stats_mode),
                   class: "notae-options-select",
                   aria: { label: "Stats mode" },
                   onchange: "this.form.requestSubmit()" %>
    <%= button_tag "Open", type: "submit", class: "notae-chip-button" %>
  <% end %>

  <% if stats_mode == "setup" %>
    <div class="notae-db-stats-form" data-controller="stats-setup">
      <%= form_with url: stats_setup_database_path(workspace_slug: @workspace.slug, id: @database.id),
                    method: :patch,
                    id: stats_setup_form_id,
                    data: { stats_setup_target: "form" } do %>
      <% stats_view_params.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <%= hidden_field_tag :stats_date, stats_date.iso8601 %>
      <% end %>
      <div class="notae-db-grid-wrap">
        <table class="notae-db-grid">
          <thead>
            <tr>
              <th class="notae-db-grid-name-col">Stat</th>
              <th>Frequency</th>
              <th>Assigned person</th>
              <th>Post</th>
              <th>Division</th>
              <th>Description</th>
              <th>Archive</th>
            </tr>
          </thead>
          <tbody id="stats_setup_rows"
                 data-controller="db-table-reorder"
                 data-db-table-reorder-workspace-slug-value="<%= @workspace.slug %>"
                 data-db-table-reorder-database-id-value="<%= @database.id %>"
                 data-db-table-reorder-view-id-value="<%= @current_view&.id %>"
                 data-db-table-reorder-stats-date-value="<%= stats_date.iso8601 %>"
                 data-db-table-reorder-stats-mode-value="setup">
            <% @stats_definitions.each do |definition| %>
              <% row_is_bold = definition.row_bold? %>
              <% row_is_italic = definition.row_italic? %>
              <% row_text_color = definition.row_text_color %>
              <% row_background_color = definition.row_background_color %>
              <% row_style_classes = [] %>
              <% row_style_classes << "is-row-bold" if row_is_bold %>
              <% row_style_classes << "is-row-italic" if row_is_italic %>
              <% row_style_classes << "is-row-color-#{row_text_color}" unless row_text_color == "default" %>
              <% row_style_classes << "is-row-bg-#{row_background_color}" unless row_background_color == "default" %>
              <% row_update_path = database_db_row_path(
                {
                  workspace_slug: @workspace.slug,
                  database_id: @database.id,
                  id: definition.id,
                  stats_date: stats_date.iso8601,
                  stats_mode: "setup",
                  view_id: @current_view&.id
                }.merge(stats_view_params)
              ) %>
              <tr id="stats_definition_<%= definition.id %>"
                  class="notae-db-grid-data-row <%= row_style_classes.join(" ") %>"
                  data-db-table-reorder-target="row"
                  data-db-table-reorder-row-id="<%= definition.id %>"
                  data-stats-setup-row-id="<%= definition.id %>"
                  data-action="dragover->db-table-reorder#dragover drop->db-table-reorder#drop dragleave->db-table-reorder#dragleave">
                <td class="notae-db-grid-name-col">
                  <div class="notae-db-row-shell">
                    <% if can_edit_database %>
                      <div class="notae-db-row-hover-controls">
                        <button type="button"
                                class="notae-db-row-hover-control is-drag-handle"
                                title="Drag to reorder"
                                aria-label="Drag to reorder"
                                draggable="true"
                                data-db-table-reorder-row-id="<%= definition.id %>"
                                data-action="dragstart->db-table-reorder#dragstart dragend->db-table-reorder#dragend">⠿</button>
                        <%= render "databases/row_context_menu",
                                   row: definition,
                                   workspace: @workspace,
                                   database: @database,
                                   row_update_path: row_update_path,
                                   row_params: stats_view_params.merge(view_id: @current_view&.id, stats_date: stats_date.iso8601, stats_mode: "setup"),
                                   row_color_options: row_color_options,
                                   row_can_destroy: false,
                                   linked_page: nil,
                                   row_is_bold: row_is_bold,
                                   row_is_italic: row_is_italic,
                                   row_text_color: row_text_color,
                                   row_background_color: row_background_color,
                                   row_menu_form_turbo: false,
                                   defer_body: false %>
                      </div>
                    <% end %>
                  <%= text_field_tag "stats[definitions][#{definition.id}][title]",
                                     definition.title,
                                     class: "notae-db-cell-input",
                                     form: stats_setup_form_id,
                                     data: { action: "change->stats-setup#save keydown.enter->stats-setup#insertAfter" },
                                     disabled: !can_edit_database %>
                  </div>
                </td>
                <td>
                  <%= select_tag "stats[definitions][#{definition.id}][frequency]",
                                 options_for_select(@stats_frequency_options, Databases::StatsTemplateService.frequency_for(definition)),
                                 class: "notae-db-cell-select",
                                 form: stats_setup_form_id,
                                 data: { action: "change->stats-setup#save" },
                                 disabled: !can_edit_database %>
                </td>
                <td>
                  <%= text_field_tag "stats[definitions][#{definition.id}][assigned_person]",
                                     Databases::StatsTemplateService.cell_value(definition, "Assigned person"),
                                     class: "notae-db-cell-input",
                                     form: stats_setup_form_id,
                                     data: { action: "change->stats-setup#save" },
                                     disabled: !can_edit_database %>
                </td>
                <td>
                  <%= text_field_tag "stats[definitions][#{definition.id}][post]",
                                     Databases::StatsTemplateService.cell_value(definition, "Post"),
                                     class: "notae-db-cell-input",
                                     form: stats_setup_form_id,
                                     data: { action: "change->stats-setup#save" },
                                     disabled: !can_edit_database %>
                </td>
                <td>
                  <%= text_field_tag "stats[definitions][#{definition.id}][division]",
                                     Databases::StatsTemplateService.cell_value(definition, "Division"),
                                     class: "notae-db-cell-input",
                                     form: stats_setup_form_id,
                                     data: { action: "change->stats-setup#save" },
                                     disabled: !can_edit_database %>
                </td>
                <td>
                  <%= text_field_tag "stats[definitions][#{definition.id}][description]",
                                     Databases::StatsTemplateService.cell_value(definition, "Description"),
                                     class: "notae-db-cell-input",
                                     form: stats_setup_form_id,
                                     data: { action: "change->stats-setup#save" },
                                     disabled: !can_edit_database %>
                </td>
                <td>
                  <%= button_tag "Archive",
                                 type: "submit",
                                 name: "archive_stat_id",
                                 value: definition.id,
                                 class: "notae-db-grid-add-link",
                                 form: stats_setup_form_id,
                                 disabled: !can_edit_database %>
                </td>
              </tr>
            <% end %>
          </tbody>
          <tbody>
            <tr class="notae-db-grid-add-row-control">
              <td>
                <%= button_tag "+ New row",
                               type: "submit",
                               name: "add_definition",
                               value: "1",
                               class: "notae-db-new-row-trigger",
                               form: stats_setup_form_id,
                               disabled: !can_edit_database %>
              </td>
              <td colspan="6"></td>
            </tr>
          </tbody>
        </table>
      </div>
      <div class="notae-db-toolbar notae-db-stats-savebar">
        <%= button_tag "Save setup", type: "submit", class: "notae-db-toolbar-new", form: stats_setup_form_id, disabled: !can_edit_database %>
      </div>
    </div>
  <% else %>
    <%= form_with url: stats_entries_database_path(workspace_slug: @workspace.slug, id: @database.id),
                  method: :patch,
                  class: "notae-db-stats-form" do %>
      <% stats_view_params.each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
      <%= hidden_field_tag :stats_date, stats_date.iso8601 %>
      <div class="notae-db-grid-wrap">
        <table class="notae-db-grid">
          <thead>
            <tr>
              <th class="notae-db-grid-name-col">Stat</th>
              <th>Report period dates</th>
              <th>Value</th>
            </tr>
          </thead>
          <tbody>
            <% if @stats_report_rows.blank? %>
              <tr>
                <td colspan="3">No stats have been set up yet.</td>
              </tr>
            <% end %>
            <% @stats_report_rows.each do |report_row| %>
              <% definition = report_row.definition %>
              <% row_is_bold = definition.row_bold? %>
              <% row_is_italic = definition.row_italic? %>
              <% row_text_color = definition.row_text_color %>
              <% row_background_color = definition.row_background_color %>
              <% row_style_classes = [] %>
              <% row_style_classes << "is-row-bold" if row_is_bold %>
              <% row_style_classes << "is-row-italic" if row_is_italic %>
              <% row_style_classes << "is-row-color-#{row_text_color}" unless row_text_color == "default" %>
              <% row_style_classes << "is-row-bg-#{row_background_color}" unless row_background_color == "default" %>
              <% stats_graph_params = stats_view_params.merge(
                workspace_slug: @workspace.slug,
                id: @database.id,
                stats_date: stats_date.iso8601,
                stats_mode: "report",
                split_panel: "stats_graph",
                stats_graph_definition_id: definition.id,
                stats_graph_period: "weekly",
                stats_graph_periods: Databases::StatsGraphDataBuilder::DEFAULT_PERIOD_COUNT
              ) %>
              <tr id="stats_report_<%= definition.id %>" class="notae-db-grid-data-row <%= row_style_classes.join(" ") %>">
                <td class="notae-db-grid-name-col">
                  <div class="notae-db-stats-report-name">
                    <span><%= definition.title %></span>
                    <%= link_to "Show graph",
                                database_path(stats_graph_params),
                                class: "notae-chip-button notae-db-stats-graph-link",
                                data: { preserve_database_scroll: true } %>
                  </div>
                </td>
                <td><%= report_row.period.label %></td>
                <td>
                  <%= number_field_tag "stats[entries][#{definition.id}][value]",
                                       Databases::StatsTemplateService.cell_value(report_row.entry, "Value"),
                                       step: "any",
                                       class: "notae-db-cell-input",
                                       disabled: !can_edit_database %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="notae-db-toolbar">
        <%= button_tag "Save stats", type: "submit", class: "notae-db-toolbar-new", disabled: !can_edit_database %>
      </div>
    <% end %>
  <% end %>
</div>
