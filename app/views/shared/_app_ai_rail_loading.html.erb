<div class="notae-ai-rail-shell is-deferred"
     aria-live="polite">
  <button type="button"
          class="notae-ai-floating-toggle"
          data-action="click->ai-rail-loader#openOverlay"
          aria-label="Open AI assistant">
    <%= render "shared/ai_loader_icon",
               variant: current_user.ai_loader_style,
               state: "loading",
               size: 18,
               reduced_motion: current_user.reduce_ai_loader_motion? %>
  </button>

  <aside class="notae-ai-rail is-loading">
    <button type="button"
            class="notae-ai-rail-reopen"
            data-action="click->ai-rail-loader#openRail"
            aria-label="Open AI assistant rail">
      <%= render "shared/ai_loader_icon",
                 variant: current_user.ai_loader_style,
                 state: "loading",
                 size: 18,
                 reduced_motion: current_user.reduce_ai_loader_motion? %>
    </button>

    <div class="notae-ai-head">
      <span>New AI chat</span>
    </div>

    <div class="notae-ai-card notae-ai-card-loading">
      <p class="notae-ai-title">Open AI assistant</p>
      <p class="notae-ai-copy">The page is ready. AI context loads on demand so navigation stays fast.</p>
    </div>
  </aside>
</div>
