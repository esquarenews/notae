<% selected_cover_key = selected_cover_key.to_s.presence %>
<% panel_classes = [ "notae-cover-picker-panel" ] %>
<% panel_classes << "is-embedded" if local_assigns[:embedded] %>
<% workspace = local_assigns[:workspace] %>
<% cover_record = local_assigns[:cover_record] %>
<% cover_groups = page_cover_picker_groups(workspace:) %>
<% initial_group_index = page_cover_preset_group_index(selected_cover_key) %>
<% initial_group = cover_groups.fetch(initial_group_index) %>
<% return_path = local_assigns[:return_to].to_s.presence %>
<% base_params = return_path.present? ? { return_to: return_path } : {} %>
<% unsplash_url = local_assigns[:unsplash_url].to_s.presence %>

<div class="<%= panel_classes.join(" ") %>"
     data-controller="cover-carousel"
     data-cover-carousel-initial-index-value="<%= initial_group_index %>"
     data-cover-carousel-unsplash-url-value="<%= unsplash_url %>"
     data-cover-carousel-per-page-value="12">
  <div class="notae-cover-picker-toolbar">
    <button type="button"
            class="notae-cover-picker-nav"
            data-action="cover-carousel#previous"
            aria-label="Previous cover set">
      ‹
    </button>
    <div class="notae-cover-picker-toolbar-copy">
      <strong data-cover-carousel-target="label"><%= initial_group.fetch(:label) %></strong>
      <span><%= initial_group.fetch(:presets).size %> options</span>
    </div>
    <button type="button"
            class="notae-cover-picker-nav"
            data-action="cover-carousel#next"
            aria-label="Next cover set">
      ›
    </button>
  </div>

  <div class="notae-cover-picker-screens">
    <% cover_groups.each_with_index do |group, group_index| %>
      <section class="notae-cover-picker-screen<%= " is-active" if group_index == initial_group_index %>"
               data-cover-carousel-target="screen"
               data-cover-carousel-label="<%= group.fetch(:label) %>"
               <%= "hidden" unless group_index == initial_group_index %>>
        <% if group.fetch(:kind, nil) == :recent %>
          <div class="notae-cover-picker-grid notae-cover-picker-grid-recent">
            <% group.fetch(:presets).each do |asset| %>
              <div class="notae-cover-picker-recent-card">
                <%= button_to update_url,
                              method: :patch,
                              params: base_params.merge(param_key.to_sym => { cover_action: "recent", cover_asset_id: asset.id }),
                              class: [ "notae-cover-picker-tile-button", ("is-active" if cover_asset_selected?(asset, cover_record)) ].compact.join(" "),
                              title: asset.label,
                              aria: { label: "Use #{asset.label} cover" },
                              form: { data: { action: "submit->cover-carousel#startInlineSubmit" } } do %>
                  <% if asset.preview_url.present? %>
                    <%= image_tag asset.preview_url,
                                  class: "notae-cover-picker-tile-image",
                                  alt: asset.label,
                                  loading: "lazy",
                                  decoding: "async" %>
                  <% elsif asset.image.attached? %>
                    <%= image_tag asset.image,
                                  class: "notae-cover-picker-tile-image",
                                  alt: asset.label,
                                  loading: "lazy",
                                  decoding: "async" %>
                  <% end %>
                <% end %>
                <div class="notae-cover-picker-recent-meta">
                  <strong><%= truncate(asset.label, length: 24) %></strong>
                  <% if (attribution = cover_asset_attribution(asset)).present? %>
                    <%= render "shared/cover_attribution",
                               attribution: attribution,
                               wrapper_class: "notae-cover-picker-credit" %>
                  <% else %>
                    <span class="notae-cover-picker-credit is-muted">Recent upload</span>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="notae-cover-picker-grid">
            <% group.fetch(:presets).each do |preset| %>
              <%= button_to update_url,
                            method: :patch,
                            params: base_params.merge(param_key.to_sym => { cover_action: "preset", cover_preset_key: preset.fetch(:key) }),
                            class: [ "notae-cover-picker-tile-button", ("is-active" if selected_cover_key == preset.fetch(:key)) ].compact.join(" "),
                            title: preset.fetch(:label),
                            aria: { label: "Use #{preset.fetch(:label)} cover" },
                            form: { data: { action: "submit->cover-carousel#startInlineSubmit" } } do %>
                <span class="notae-cover-picker-tile"
                      style="<%= page_cover_preset_style(preset.fetch(:key)) %>"></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </section>
    <% end %>
  </div>

  <div class="notae-cover-picker-pagination">
    <% cover_groups.each_with_index do |group, group_index| %>
      <button type="button"
              class="notae-cover-picker-dot<%= " is-active" if group_index == initial_group_index %>"
              data-cover-carousel-target="dot"
              data-action="cover-carousel#select"
              data-cover-carousel-index-param="<%= group_index %>"
              aria-label="Show <%= group.fetch(:label) %> covers"
              aria-current="<%= group_index == initial_group_index %>">
      </button>
    <% end %>
  </div>

  <div class="notae-cover-picker-quick-actions">
    <%= button_to "Random",
                  update_url,
                  method: :patch,
                  params: base_params.merge(param_key.to_sym => { cover_action: "random" }),
                  class: "notae-cover-picker-action",
                  form: { data: { action: "submit->cover-carousel#startInlineSubmit" } } %>
    <% if local_assigns.fetch(:allow_remove, true) %>
      <%= button_to local_assigns.fetch(:remove_label, "Remove"),
                    update_url,
                    method: :patch,
                    params: base_params.merge(param_key.to_sym => { cover_action: "clear" }),
                    class: "notae-cover-picker-action is-danger",
                    form: { data: { action: "submit->cover-carousel#startInlineSubmit" } } %>
    <% end %>
  </div>

  <button type="button"
          class="notae-cover-picker-action notae-cover-picker-browse-button"
          data-action="cover-carousel#openUnsplash">
    Browse Unsplash
  </button>

  <%= form_with url: update_url,
                method: :patch,
                class: "notae-cover-picker-upload-form",
                html: { multipart: true },
                data: {
                  cover_carousel_target: "uploadForm",
                  action: "submit->cover-carousel#startUploadSubmit"
                } do %>
    <% if return_path.present? %>
      <%= hidden_field_tag :return_to, return_path %>
    <% end %>
    <%= hidden_field_tag "#{param_key}[cover_action]", "upload" %>
    <%= file_field_tag "#{param_key}[cover_image]", accept: "image/*", class: "notae-cover-picker-upload-input" %>
    <button type="submit"
            class="notae-cover-picker-action notae-cover-picker-submit-button"
            data-cover-carousel-target="uploadSubmit">
      <span>Upload</span>
      <span class="notae-cover-picker-spinner" hidden data-cover-carousel-target="uploadSpinner"></span>
    </button>
  <% end %>

  <%= form_with url: update_url,
                method: :patch,
                class: "notae-cover-picker-hidden-form",
                data: {
                  cover_carousel_target: "applyForm"
                } do %>
    <% if return_path.present? %>
      <%= hidden_field_tag :return_to, return_path %>
    <% end %>
    <%= hidden_field_tag "#{param_key}[cover_action]", "", data: { cover_carousel_target: "applyAction" } %>
    <%= hidden_field_tag "#{param_key}[cover_asset_id]", "", data: { cover_carousel_target: "applyAssetId" } %>
    <%= hidden_field_tag "#{param_key}[cover_remote_id]", "", data: { cover_carousel_target: "applyRemoteId" } %>
  <% end %>

  <dialog class="notae-cover-unsplash-modal"
          data-cover-carousel-target="unsplashDialog"
          data-action="click->cover-carousel#backdropClose">
    <div class="notae-cover-unsplash-modal-panel">
      <header class="notae-cover-unsplash-header">
        <div>
          <p class="notae-cover-unsplash-kicker">Unsplash</p>
          <h2>Browse cover photos</h2>
        </div>
        <button type="button"
                class="notae-cover-unsplash-close"
                aria-label="Close Unsplash browser"
                data-action="cover-carousel#closeUnsplash">
          ×
        </button>
      </header>

      <div class="notae-cover-unsplash-search">
        <%= search_field_tag :cover_unsplash_search,
                             "",
                             placeholder: "Search Unsplash",
                             autocomplete: "off",
                             class: "notae-options-input",
                             data: {
                               cover_carousel_target: "unsplashSearchInput",
                               action: "input->cover-carousel#queueUnsplashSearch search->cover-carousel#queueUnsplashSearch"
                             } %>
      </div>

      <div class="notae-cover-unsplash-status"
           data-cover-carousel-target="unsplashStatus"
           aria-live="polite">
        <span class="notae-cover-picker-spinner"></span>
        <span data-cover-carousel-target="unsplashStatusLabel">Loading covers…</span>
      </div>

      <div class="notae-cover-unsplash-grid"
           data-cover-carousel-target="unsplashGrid"
           hidden></div>
      <p class="notae-options-empty"
         hidden
         data-cover-carousel-target="unsplashEmptyState">No Unsplash results match that search.</p>

      <div class="notae-cover-unsplash-pagination">
        <button type="button"
                class="notae-cover-picker-action"
                data-cover-carousel-target="unsplashPreviousButton"
                data-action="cover-carousel#previousUnsplashPage">
          Previous
        </button>
        <span class="notae-cover-unsplash-page-label"
              data-cover-carousel-target="unsplashPageLabel">Page 1 of 1</span>
        <button type="button"
                class="notae-cover-picker-action"
                data-cover-carousel-target="unsplashNextButton"
                data-action="cover-carousel#nextUnsplashPage">
          Next
        </button>
      </div>
    </div>
  </dialog>
</div>
