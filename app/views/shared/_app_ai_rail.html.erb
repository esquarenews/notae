<% ai_rail_workspace = @ai_rail_workspace || (defined?(@workspace) ? @workspace : nil) %>
<% ai_rail_workspace_slug = ai_rail_workspace&.slug.to_s.strip.presence %>
<% ai_rail_workspace_ready = ai_rail_workspace_slug.present? %>
<% ai_scope_options = Search::AssistantQueryService::SCOPE_OPTIONS %>
<% ai_scope_value = @ai_assistant_scope.presence || Search::AssistantQueryService::SCOPE_AUTO %>
<% ai_intent_value = @ai_assistant_intent.to_s %>
<% ai_target_block_value = @ai_assistant_target_block_id.to_s %>
<% ai_prompt_value = "" %>
<% ai_rail_conversations = Array(@ai_rail_conversations) %>
<% ai_agent_updates = Array(@ai_agent_updates) %>

<div class="notae-ai-rail-shell"
     data-controller="ai-rail"
     <% if ai_rail_workspace_ready %>
       data-ai-rail-agent-updates-path-value="<%= workspace_ai_assistant_updates_path(workspace_slug: ai_rail_workspace_slug) %>"
       data-ai-rail-workspace-key-value="<%= ai_rail_workspace.id %>"
     <% end %>>
  <button type="button"
          class="notae-ai-floating-toggle"
          data-ai-rail-target="floatingToggle"
          data-action="click->ai-rail#toggleFloatingRail"
          aria-label="Open AI assistant"
          aria-expanded="false">
    <%= render "shared/ai_loader_icon",
               variant: current_user.ai_loader_style,
               state: "static",
               size: 18,
               reduced_motion: current_user.reduce_ai_loader_motion? %>
  </button>

  <button type="button"
          class="notae-ai-rail-overlay"
          data-ai-rail-target="overlay"
          data-action="click->ai-rail#closeFloatingRail"
          aria-label="Close AI assistant panel"
          hidden></button>

  <section class="notae-ai-agent-toast"
           data-ai-rail-target="agentToast"
           hidden
           aria-live="polite"
           aria-atomic="true">
    <button type="button"
            class="notae-ai-agent-toast-main"
            data-action="click->ai-rail#openAgentToast">
      <span class="notae-ai-agent-toast-title">AI Agent</span>
      <span class="notae-ai-agent-toast-body" data-ai-rail-target="agentToastBody"></span>
    </button>
    <button type="button"
            class="notae-ai-agent-toast-dismiss"
            data-action="click->ai-rail#dismissAgentToast"
            aria-label="Dismiss AI agent updates">×</button>
  </section>

  <aside class="notae-ai-rail">
  <button type="button"
          class="notae-ai-rail-reopen"
          data-action="click->ai-rail#toggleRail"
          aria-label="Reopen AI assistant rail">
    <%= render "shared/ai_loader_icon",
               variant: current_user.ai_loader_style,
               state: "static",
               size: 18,
               reduced_motion: current_user.reduce_ai_loader_motion? %>
  </button>

  <div class="notae-ai-head">
    <span>New AI chat</span>
    <div class="notae-ai-head-controls">
      <% if ai_rail_workspace_ready %>
        <%= select_tag "ai_assistant[scope]",
                       options_for_select(ai_scope_options, ai_scope_value),
                       class: "notae-ai-scope-select",
                       form: "notae_ai_assistant_form" %>
      <% else %>
        <span class="notae-ai-kicker">Auto</span>
      <% end %>
      <button type="button"
              class="notae-ai-rail-toggle"
              data-action="click->ai-rail#toggleRail"
              aria-label="Minimize AI assistant rail">
        ▸
      </button>
    </div>
  </div>

  <div class="notae-ai-card">
    <p class="notae-ai-title">Notae AI assistant</p>
    <p class="notae-ai-copy">Ask search questions, summary requests, or request reviewable draft actions for email, GitHub, tasks, and calendar holds.</p>
  </div>

  <section class="notae-ai-thread" data-ai-rail-target="thread">
    <% ai_rail_conversations.each do |conversation| %>
      <% safe_sources = ai_safe_sources(conversation.sources) %>
      <% draft_action_sources = safe_sources.select { |source| source[:kind].to_s == "Draft action" } %>
      <% evidence_sources = safe_sources.reject { |source| source[:kind].to_s == "Draft action" } %>
      <article class="notae-ai-message is-user is-compact">
        <p class="notae-ai-message-body"><%= conversation.prompt %></p>
      </article>
      <article class="notae-ai-message is-assistant">
        <p class="notae-ai-message-label">
          Notae AI · <%= conversation.scope.to_s.humanize %>
          <% if conversation.workspace.present? %>
            · <%= conversation.workspace.name %>
          <% end %>
          <% if Rails.env.development? %>
            <% if conversation.respond_to?(:model) && conversation.model.present? %>
              <span class="notae-ai-model-indicator">Model: <%= conversation.model %></span>
            <% end %>
            <% if conversation.live_web? %>
              <span class="notae-ai-model-indicator">Live web</span>
            <% end %>
          <% end %>
        </p>
        <p class="notae-ai-result-text"><%= conversation.answer %></p>
        <% if draft_action_sources.any? %>
          <div class="notae-ai-compose-actions">
            <% draft_action_sources.each do |source| %>
              <%= link_to source[:title],
                          source[:url],
                          class: "notae-chip-button",
                          data: { turbo_frame: "_top" } %>
            <% end %>
          </div>
        <% end %>
        <% if evidence_sources.any? %>
          <details class="notae-ai-sources-panel">
            <summary class="notae-chip-button notae-ai-sources-toggle">
              <span class="notae-ai-sources-when-closed">Sources</span>
              <span class="notae-ai-sources-when-open">Hide</span>
            </summary>
            <ul class="notae-ai-assistant-sources">
              <% evidence_sources.each do |source| %>
                <% external_source = ai_external_source_url?(source[:url]) %>
                <li>
                  <% source_label = source[:index].present? ? "[#{source[:index]}] #{source[:title]}" : source[:title] %>
                  <%= link_to source_label,
                              source[:url],
                              class: "notae-utility-link",
                              data: { turbo_frame: "_top" },
                              target: external_source ? "_blank" : nil,
                              rel: external_source ? "noopener noreferrer nofollow" : nil %>
                  <% if source[:workspace_name].present? %>
                    <span class="notae-ai-copy"><%= source[:workspace_name] %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          </details>
        <% end %>
        <p class="notae-ai-message-meta"><%= time_ago_in_words(conversation.created_at) %> ago</p>
        <div class="notae-ai-compose-actions">
          <button type="button" class="notae-chip-button" data-action="click->ai-rail#copyResult">Copy result</button>
        </div>
      </article>
    <% end %>

    <%= render partial: "shared/app_ai_agent_update", collection: ai_agent_updates, as: :update %>

    <% if ai_rail_conversations.empty? && ai_agent_updates.empty? && @ai_assistant_notice.present? %>
      <article class="notae-ai-message is-assistant">
        <p class="notae-ai-message-label">Notae AI</p>
        <p class="notae-ai-copy notae-ai-assistant-notice"><%= @ai_assistant_notice %></p>
      </article>
    <% end %>
  </section>

  <% if @ai_insert_payload.present? %>
    <%= tag.div "",
                hidden: true,
                data: {
                  ai_rail_target: "insertPayload",
                  ai_insert_text: @ai_insert_payload[:text],
                  ai_insert_target_block_id: @ai_insert_payload[:target_block_id],
                  ai_insert_intent: @ai_insert_payload[:intent]
                } %>
  <% end %>

  <% if ai_rail_workspace_ready %>
    <%= form_with scope: :ai_assistant,
                  url: workspace_ai_assistant_path(workspace_slug: ai_rail_workspace_slug),
                  method: :post,
                  id: "notae_ai_assistant_form",
                  class: "notae-ai-compose",
                  data: {
                    turbo_frame: "ai_rail_panel",
                    action: "turbo:submit-start->ai-rail#submitStart turbo:submit-end->ai-rail#submitEnd"
                  } do |form| %>
      <%= form.hidden_field :current_page_id, value: @ai_rail_current_page_id %>
      <%= form.hidden_field :intent, value: ai_intent_value, id: "ai_intent", data: { ai_rail_target: "intentInput" } %>
      <%= form.hidden_field :target_block_id,
                            value: ai_target_block_value,
                            id: "ai_target_block_id",
                            data: { ai_rail_target: "targetBlockInput" } %>
      <label for="ai_prompt" class="notae-ai-label">Prompt</label>
      <div class="notae-ai-compose-input-wrap">
        <%= form.text_area :prompt,
                           value: ai_prompt_value,
                           id: "ai_prompt",
                           class: "notae-ai-prompt-input",
                           rows: 5,
                           data: {
                             ai_rail_target: "promptInput",
                             action: "keydown->ai-rail#submitOnShortcut"
                           },
                           placeholder: "Ask a question or request a draft action for review." %>
        <div class="notae-ai-compose-loading" data-ai-rail-target="loading">
          <span class="notae-ai-compose-swirl" aria-hidden="true"></span>
          <%= render "shared/ai_loader_icon",
                     variant: current_user.ai_loader_style,
                     state: "loading",
                     size: 56,
                     reduced_motion: current_user.reduce_ai_loader_motion? %>
        </div>
      </div>
      <div class="notae-ai-compose-actions">
        <button type="submit" data-ai-rail-target="submitButton">Send</button>
      </div>
    <% end %>
  <% else %>
    <div class="notae-ai-compose">
      <p class="notae-ai-copy">Join a workspace to use Notae AI assistant prompts.</p>
    </div>
  <% end %>

  <% if @ai_usage_panel.present? %>
    <div class="notae-ai-usage-drawer-wrap">
      <button type="button"
              class="notae-chip-button notae-ai-usage-toggle"
              data-ai-rail-target="usageToggle"
              data-action="click->ai-rail#toggleUsage"
              aria-expanded="false">
        Usage
      </button>
      <div class="notae-ai-card notae-ai-usage-card notae-ai-usage-drawer" data-ai-rail-target="usageDrawer" hidden>
        <div class="notae-ai-usage-head">
          <p class="notae-ai-title">Today usage</p>
          <div class="notae-ai-usage-head-actions">
            <span class="notae-ai-kicker"><%= @ai_usage_panel[:day_label] %></span>
            <button type="button"
                    class="notae-ai-usage-close"
                    data-action="click->ai-rail#closeUsage"
                    aria-label="Minimize usage panel">×</button>
          </div>
        </div>
        <dl class="notae-ai-usage-grid">
          <div>
            <dt>Tokens</dt>
            <dd><%= number_with_delimiter(@ai_usage_panel[:total_tokens]) %></dd>
          </div>
          <div>
            <dt>Cost</dt>
            <dd><%= number_to_currency(@ai_usage_panel[:estimated_cost_usd]) %></dd>
          </div>
          <div>
            <dt>Requests</dt>
            <dd><%= number_with_delimiter(@ai_usage_panel[:request_count]) %></dd>
          </div>
        </dl>
        <div class="notae-ai-usage-guardrails">
          <p class="notae-ai-copy">Guardrails</p>
          <p class="notae-ai-copy">
            Budget:
            <strong><%= @ai_usage_panel[:budget_status] ? "Available" : "Reached" %></strong>
            (<%= number_to_currency(@ai_usage_panel[:budget_remaining_usd]) %> left)
          </p>
          <p class="notae-ai-copy">
            Rate:
            <strong><%= @ai_usage_panel[:semantic_rate_limit_per_minute] %>/min semantic</strong>,
            <strong><%= @ai_usage_panel[:answer_rate_limit_per_minute] %>/min answers</strong>
            (window <%= @ai_usage_panel[:rate_limit_window_seconds] %>s)
          </p>
        </div>
      </div>
    </div>
  <% end %>
  </aside>
</div>
