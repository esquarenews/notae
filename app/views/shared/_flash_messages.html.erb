<%
provided_flash_messages = local_assigns[:flash_messages]
flash_dom_id = local_assigns[:flash_dom_id].presence || "notae_flash_messages"
flash_host_class = local_assigns[:flash_host_class].to_s.strip
flash_messages =
  if local_assigns.key?(:flash_messages)
    Array(provided_flash_messages).filter_map do |entry|
      type, raw_message = Array(entry)
      text = raw_message.to_s.strip
      next if text.blank?

      [ type.to_s, text ]
    end
  else
    flash.to_hash.each_with_object([]) do |(type, raw_message), messages|
      Array(raw_message).each do |message|
        text = message.to_s.strip
        messages << [ type.to_s, text ] if text.present?
      end
    end
  end
flash_messages.sort_by! { |(type, _message)| type == "alert" ? 0 : 1 }
host_classes = [ "notae-flash-host", flash_host_class.presence, ("is-empty" if flash_messages.empty?) ].compact.join(" ")
%><div id="<%= flash_dom_id %>" class="<%= host_classes %>"><% if flash_messages.any? %><div class="notae-flash-stack"><% flash_messages.each do |type, message| %><% palette = type == "alert" ? "notae-flash alert" : "notae-flash notice" %><p class="<%= palette %>"><%= message %></p><% end %></div><% end %></div>
