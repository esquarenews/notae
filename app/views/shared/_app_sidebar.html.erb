<aside class="notae-sidebar">
  <% workspace = ui_current_workspace %>
  <% recent_pages = workspace ? ui_sidebar_recent_pages : [] %>
  <% recent_databases = workspace ? ui_sidebar_recent_databases : [] %>
  <% recent_meetings = workspace ? ui_sidebar_recent_meetings : [] %>
  <% recent_favorites = workspace ? ui_sidebar_recent_favorites : [] %>
  <% recent_workspaces = ui_sidebar_recent_workspaces(limit: 6) %>
  <% nav_workspace = workspace || recent_workspaces.first %>
  <% can_create_workspace = policy(Workspace.new).create? %>
  <div class="notae-sidebar-dock" aria-hidden="true">
    <button type="button"
            class="notae-sidebar-dock-toggle"
            data-action="click->shell#toggleSidebarCollapse"
            aria-label="Expand sidebar">☰</button>
    <div class="notae-sidebar-dock-icons"></div>
  </div>

  <div class="notae-sidebar-main">
  <div class="notae-sidebar-header">
    <div class="notae-user-chip notae-workspace-chip">
      <span class="notae-user-avatar"><%= workspace ? workspace.display_icon : current_user.email.first.upcase %></span>
      <span class="notae-user-label"><%= workspace&.name || current_user.email %></span>
    </div>
    <div class="notae-sidebar-header-actions">
      <% if workspace %>
        <div class="notae-create-menu-wrap">
          <button type="button"
                  class="notae-icon-link"
                  title="Create new"
                  aria-haspopup="true"
                  data-shell-create-toggle
                  data-action="click->shell#toggleCreateMenu">＋</button>
          <div class="notae-create-menu is-hidden" data-shell-target="createMenu" data-action="click->shell#noop">
            <ul class="notae-create-menu-list">
              <% if policy(Page.new(workspace: workspace)).create? %>
                <li class="notae-create-menu-item">
                  <%= form_with model: Page.new, url: pages_path(workspace_slug: workspace.slug), class: "notae-create-menu-form" do |form| %>
                    <%= form.hidden_field :title, value: "Untitled" %>
                    <button type="submit" class="notae-create-menu-button" data-action="click->shell#closeCreateMenu">
                      <span class="notae-create-menu-icon notae-create-menu-icon-page" aria-hidden="true">
                        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <path d="M4 1.5h5L12.5 5v9.5H4V1.5Z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                          <path d="M9 1.5V5h3.5" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
                          <path d="M5.7 8h5M5.7 10.5h5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                        </svg>
                      </span>
                      <span>New Nota</span>
                    </button>
                  <% end %>
                </li>
                <li class="notae-create-menu-item">
                  <%= form_with model: Page.new, url: pages_path(workspace_slug: workspace.slug), class: "notae-create-menu-form" do |form| %>
                    <%= form.hidden_field :title, value: "Meeting notes" %>
                    <button type="submit" class="notae-create-menu-button" data-action="click->shell#closeCreateMenu">
                      <span class="notae-create-menu-icon notae-create-menu-icon-meeting" aria-hidden="true">
                        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <rect x="6" y="2.3" width="4" height="7.2" rx="2" stroke="currentColor" stroke-width="1.4"/>
                          <path d="M4 7.6a4 4 0 0 0 8 0M8 11.6v2.1M5.8 13.7h4.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                        </svg>
                      </span>
                      <span>New meeting</span>
                    </button>
                  <% end %>
                </li>
              <% end %>
              <% if policy(Database.new(workspace: workspace)).create? %>
                <li class="notae-create-menu-item">
                  <%= form_with model: Database.new, url: databases_path(workspace_slug: workspace.slug), class: "notae-create-menu-form" do |form| %>
                    <%= form.hidden_field :name, value: "Untitled grid" %>
                    <button type="submit" class="notae-create-menu-button" data-action="click->shell#closeCreateMenu">
                      <span class="notae-create-menu-icon notae-create-menu-icon-database" aria-hidden="true">
                        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                          <rect x="2.2" y="2.2" width="11.6" height="11.6" rx="2" stroke="currentColor" stroke-width="1.3"/>
                          <path d="M2.8 6h10.4M2.8 9.3h10.4M6 2.8v10.4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
                        </svg>
                      </span>
                      <span>New grid</span>
                    </button>
                  <% end %>
                </li>
              <% end %>
              <% if can_create_workspace %>
                <li class="notae-create-menu-item">
                  <button type="button" class="notae-create-menu-button" data-action="click->shell#openWorkspaceDialog">
                    <span class="notae-create-menu-icon notae-create-menu-icon-workspace" aria-hidden="true">
                      <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M2.2 5.2 8 2.2l5.8 3v6.6L8 14.8l-5.8-3Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
                        <path d="M8 2.2v12.6M2.2 5.2 8 8.1l5.8-2.9" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/>
                      </svg>
                    </span>
                    <span>New Workspace</span>
                  </button>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% else %>
        <%= link_to "＋", new_workspace_path, class: "notae-icon-link", title: "New workspace", data: { action: "click->shell#close" } %>
      <% end %>
      <button type="button"
              class="notae-sidebar-collapse-toggle"
              data-action="click->shell#toggleSidebarCollapse"
              aria-label="Minimize sidebar"
              title="Minimize sidebar">◂</button>
      <button type="button" class="notae-sidebar-close" data-action="click->shell#close" aria-label="Close sidebar">✕</button>
    </div>
  </div>

  <div class="notae-sidebar-scroll">
    <nav class="notae-sidebar-nav">
      <%= link_to "Home",
                  (workspace ? workspace_path(workspace.slug) : root_path),
                  class: notae_sidebar_link_classes(workspace ? workspace_path(workspace.slug) : root_path),
                  data: { action: "click->shell#close" } %>
      <%= link_to "Search",
                  (workspace ? workspace_search_path(workspace_slug: workspace.slug) : root_path),
                  class: notae_sidebar_link_classes(workspace ? workspace_search_path(workspace_slug: workspace.slug) : root_path),
                  data: { action: "click->shell#close" } %>
      <% if nav_workspace %>
        <%= link_to "Notifications",
                    workspace_notifications_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_notifications_path(workspace_slug: nav_workspace.slug)),
                    data: { action: "click->shell#close" } %>
        <%= link_to "Library",
                    workspace_library_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_library_path(workspace_slug: nav_workspace.slug)),
                    data: { action: "click->shell#close" } %>
        <%= link_to "Kalendārium",
                    kalendarium_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(kalendarium_path(workspace_slug: nav_workspace.slug)),
                    data: { action: "click->shell#close" } %>
        <%= link_to "AI Conversation History",
                    workspace_ai_conversation_history_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_ai_conversation_history_path(workspace_slug: nav_workspace.slug)),
                    data: { action: "click->shell#close" } %>
      <% end %>
    </nav>

    <% if workspace %>
      <section class="notae-sidebar-section">
        <p class="notae-sidebar-label">Workspaces</p>
        <% if recent_workspaces.any? %>
          <ul class="notae-sidebar-list is-indented">
            <% recent_workspaces.each do |sidebar_workspace| %>
              <% sidebar_workspace_slug = sidebar_workspace.slug.to_s.strip %>
              <% next if sidebar_workspace_slug.blank? %>
              <li>
                <%= link_to workspace_path(sidebar_workspace_slug),
                            class: notae_sidebar_link_classes(workspace_path(sidebar_workspace_slug)),
                            data: { action: "click->shell#close" } do %>
                  <span class="notae-sidebar-page-title"><%= sidebar_workspace.display_icon %> <%= sidebar_workspace.name %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="notae-sidebar-empty">No workspaces yet.</p>
        <% end %>
      </section>

      <section class="notae-sidebar-section">
        <p class="notae-sidebar-label">Notarum</p>
        <% if recent_pages.any? %>
          <ul class="notae-sidebar-list is-indented">
            <% recent_pages.each do |page| %>
              <li>
                <%= link_to page_path(workspace_slug: workspace.slug, id: page.id),
                            class: notae_sidebar_link_classes(page_path(workspace_slug: workspace.slug, id: page.id)),
                            data: { action: "click->shell#close" } do %>
                  <span class="notae-sidebar-page-title"><%= page.icon.presence || "📄" %> <%= page.title %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="notae-sidebar-empty">No Notarum yet.</p>
        <% end %>
      </section>

      <section class="notae-sidebar-section">
        <p class="notae-sidebar-label">Grids</p>
        <% if recent_databases.any? %>
          <ul class="notae-sidebar-list is-indented">
            <% recent_databases.each do |db| %>
              <li>
                <%= link_to database_path(workspace_slug: workspace.slug, id: db.id),
                            class: notae_sidebar_link_classes(database_path(workspace_slug: workspace.slug, id: db.id)),
                            data: { action: "click->shell#close" } do %>
                  <span class="notae-sidebar-page-title"><%= db.icon.presence || "🗃️" %> <%= db.name %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="notae-sidebar-empty">No grids yet.</p>
        <% end %>
      </section>

      <section class="notae-sidebar-section">
        <p class="notae-sidebar-label">Meetings</p>
        <% if recent_meetings.any? %>
          <ul class="notae-sidebar-list is-indented">
            <% recent_meetings.each do |page| %>
              <li>
                <%= link_to page_path(workspace_slug: workspace.slug, id: page.id),
                            class: notae_sidebar_link_classes(page_path(workspace_slug: workspace.slug, id: page.id)),
                            data: { action: "click->shell#close" } do %>
                  <span class="notae-sidebar-page-title">🗒️ <%= page.title %></span>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="notae-sidebar-empty">No meetings yet.</p>
        <% end %>
      </section>

      <section class="notae-sidebar-section">
        <p class="notae-sidebar-label">Favorites</p>
        <% if recent_favorites.any? %>
          <ul class="notae-sidebar-list is-indented">
            <% recent_favorites.each do |item| %>
              <li>
                <% if item[:type] == :page %>
                  <% page = item[:record] %>
                  <%= link_to page_path(workspace_slug: workspace.slug, id: page.id),
                              class: notae_sidebar_link_classes(page_path(workspace_slug: workspace.slug, id: page.id)),
                              data: { action: "click->shell#close" } do %>
                    <span class="notae-sidebar-page-title">⭐ <%= page.title %></span>
                  <% end %>
                <% else %>
                  <% database = item[:record] %>
                  <%= link_to database_path(workspace_slug: workspace.slug, id: database.id),
                              class: notae_sidebar_link_classes(database_path(workspace_slug: workspace.slug, id: database.id)),
                              data: { action: "click->shell#close" } do %>
                    <span class="notae-sidebar-page-title">⭐ <%= database.icon.presence || "🗃️" %> <%= database.name %></span>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="notae-sidebar-empty">No favorites yet.</p>
        <% end %>
      </section>
    <% end %>
  </div>

  <% if workspace && can_create_workspace %>
    <div class="notae-modal is-hidden"
         data-shell-target="workspaceDialog"
         data-action="click->shell#closeWorkspaceDialog">
      <div class="notae-modal-panel notae-workspace-modal-panel" data-action="click->shell#noop">
        <div class="notae-modal-header">
          <h2>Create Workspace</h2>
          <button type="button"
                  class="notae-inline-icon-button"
                  data-action="click->shell#closeWorkspaceDialog"
                  aria-label="Close create workspace dialog">✕</button>
        </div>
        <p class="notae-pref-description">Start a new workspace and become its owner.</p>
        <%= form_with model: Workspace.new, url: workspaces_path, class: "notae-workspace-modal-form" do |form| %>
          <label class="notae-workspace-modal-label" for="new_workspace_name">Workspace name</label>
          <%= form.text_field :name,
                              id: "new_workspace_name",
                              required: true,
                              class: "notae-auth-input",
                              data: {
                                shell_target: "workspaceNameInput",
                                action: "input->shell#syncWorkspaceSlug"
                              } %>

          <label class="notae-workspace-modal-label" for="new_workspace_slug">Workspace URL slug</label>
          <%= form.text_field :slug,
                              id: "new_workspace_slug",
                              required: true,
                              class: "notae-auth-input",
                              data: {
                                shell_target: "workspaceSlugInput",
                                action: "input->shell#markWorkspaceSlugEdited"
                              } %>

          <div class="notae-workspace-modal-actions">
            <button type="button" class="notae-chip-button" data-action="click->shell#closeWorkspaceDialog">Cancel</button>
            <%= form.submit "Create workspace", class: "notae-chip-button" %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="notae-sidebar-footer">
    <%= link_to "Settings",
                (workspace ? workspace_preferences_path(workspace_slug: workspace.slug) : root_path),
                class: "notae-sidebar-link",
                data: { action: "click->shell#close" } %>
    <%= link_to "Trash",
                (workspace ? workspace_trash_path(workspace_slug: workspace.slug) : root_path),
                class: notae_sidebar_link_classes(workspace ? workspace_trash_path(workspace_slug: workspace.slug) : root_path),
                data: { action: "click->shell#close" } %>
    <%= button_to "Sign out",
                  destroy_user_session_path,
                  method: :delete,
                  class: "notae-sidebar-link notae-sidebar-signout" %>
  </div>
  </div>
</aside>
