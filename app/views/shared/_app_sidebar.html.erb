<aside class="notae-sidebar">
  <% workspace = ui_current_workspace %>
  <% recent_pages = workspace ? ui_sidebar_recent_pages : [] %>
  <% recent_databases = workspace ? ui_sidebar_recent_databases : [] %>
  <% recent_meetings = workspace ? ui_sidebar_recent_meetings : [] %>
  <% recent_favorites = workspace ? ui_sidebar_recent_favorites : [] %>
  <% recent_workspaces = ui_sidebar_recent_workspaces(limit: 6) %>
  <% nav_workspace = workspace || recent_workspaces.first %>
  <% current_database_id = (controller_name == "databases" && action_name == "show") ? params[:id].presence : nil %>
  <% can_create_workspace = policy(Workspace.new).create? %>
  <% can_create_page = workspace && policy(Page.new(workspace: workspace)).create? %>
  <% can_create_database = workspace && policy(Database.new(workspace: workspace)).create? %>
  <div class="notae-sidebar-dock" aria-hidden="true">
    <button type="button"
            class="notae-sidebar-dock-toggle"
            data-action="click->shell#toggleSidebarCollapse"
            aria-label="Expand sidebar">☰</button>
    <nav class="notae-sidebar-dock-icons" aria-label="Sidebar quick links">
      <%= link_to (workspace ? workspace_path(workspace.slug) : root_path),
                  class: notae_sidebar_link_classes(workspace ? workspace_path(workspace.slug) : root_path, active: false).sub("notae-sidebar-link", "notae-sidebar-dock-link"),
                  title: "Home",
                  data: notae_shell_link_data do %>
        <%= notae_icon_svg(:home, css_class: "notae-sidebar-nav-icon") %>
      <% end %>
      <%= link_to (workspace ? workspace_search_path(workspace_slug: workspace.slug) : root_path),
                  class: notae_sidebar_link_classes(workspace ? workspace_search_path(workspace_slug: workspace.slug) : root_path, active: false).sub("notae-sidebar-link", "notae-sidebar-dock-link"),
                  title: "Search",
                  data: notae_shell_link_data do %>
        <%= notae_icon_svg(:search, css_class: "notae-sidebar-nav-icon") %>
      <% end %>
      <% if nav_workspace %>
        <%= link_to workspace_notifications_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_notifications_path(workspace_slug: nav_workspace.slug), active: false).sub("notae-sidebar-link", "notae-sidebar-dock-link"),
                    title: "Notifications",
                    data: notae_shell_link_data do %>
          <%= notae_icon_svg(:notifications, css_class: "notae-sidebar-nav-icon") %>
        <% end %>
        <%= link_to workspace_library_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_library_path(workspace_slug: nav_workspace.slug), active: false).sub("notae-sidebar-link", "notae-sidebar-dock-link"),
                    title: "Library",
                    data: notae_shell_link_data do %>
          <%= notae_icon_svg(:library, css_class: "notae-sidebar-nav-icon") %>
        <% end %>
        <%= link_to kalendarium_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(kalendarium_path(workspace_slug: nav_workspace.slug), active: false).sub("notae-sidebar-link", "notae-sidebar-dock-link"),
                    title: "Kalendārium",
                    data: notae_shell_link_data do %>
          <%= notae_icon_svg(:kalendarium, css_class: "notae-sidebar-nav-icon") %>
        <% end %>
        <%= link_to workspace_epistularium_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_epistularium_path(workspace_slug: nav_workspace.slug), active: false).sub("notae-sidebar-link", "notae-sidebar-dock-link"),
                    title: "Epistularium",
                    data: notae_shell_link_data do %>
          <%= notae_icon_svg(:epistularium, css_class: "notae-sidebar-nav-icon") %>
        <% end %>
        <%= link_to workspace_meetings_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_meetings_path(workspace_slug: nav_workspace.slug), active: false).sub("notae-sidebar-link", "notae-sidebar-dock-link"),
                    title: "Meetings",
                    data: notae_shell_link_data do %>
          <%= notae_icon_svg(:meeting, css_class: "notae-sidebar-nav-icon") %>
        <% end %>
        <%= link_to workspace_ai_conversation_history_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_ai_conversation_history_path(workspace_slug: nav_workspace.slug), active: false).sub("notae-sidebar-link", "notae-sidebar-dock-link"),
                    title: "AI Conversation History",
                    data: notae_shell_link_data do %>
          <%= notae_icon_svg(:ai_history, css_class: "notae-sidebar-nav-icon") %>
        <% end %>
      <% end %>
      <%= link_to (workspace ? workspace_preferences_path(workspace_slug: workspace.slug) : root_path),
                  class: notae_sidebar_link_classes(workspace ? workspace_preferences_path(workspace_slug: workspace.slug) : root_path, active: false).sub("notae-sidebar-link", "notae-sidebar-dock-link"),
                  title: "Settings",
                  data: notae_shell_link_data do %>
        <%= notae_icon_svg(:settings, css_class: "notae-sidebar-nav-icon") %>
      <% end %>
    </nav>
  </div>

  <div class="notae-sidebar-main">
  <div class="notae-sidebar-header">
    <div class="notae-user-chip notae-workspace-chip">
      <% if workspace %>
        <%= render_workspace_color_marker(workspace, css_class: "notae-workspace-color-dot-lg") %>
      <% else %>
        <span class="notae-user-avatar"><%= current_user.email.first.upcase %></span>
      <% end %>
      <span class="notae-user-label"><%= workspace&.name || current_user.email %></span>
    </div>
    <div class="notae-sidebar-header-actions">
      <% if workspace %>
        <div class="notae-create-menu-wrap">
          <button type="button"
                  class="notae-icon-link"
                  title="Create new"
                  aria-haspopup="true"
                  data-shell-create-toggle
                  data-action="click->shell#toggleCreateMenu">＋</button>
          <div class="notae-create-menu is-hidden" data-shell-target="createMenu" data-action="click->shell#noop">
            <ul class="notae-create-menu-list">
              <% if can_create_page %>
                <li class="notae-create-menu-item">
                  <%= form_with model: Page.new, url: pages_path(workspace_slug: workspace.slug), class: "notae-create-menu-form" do |form| %>
                    <%= form.hidden_field :title, value: "Untitled" %>
                    <button type="submit" class="notae-create-menu-button" data-action="click->shell#closeCreateMenu">
                      <%= notae_icon_svg(:nota, css_class: "notae-create-menu-icon notae-create-menu-icon-page") %>
                      <span>New Nota</span>
                    </button>
                  <% end %>
                </li>
                <li class="notae-create-menu-item">
                  <%= form_with model: Page.new, url: pages_path(workspace_slug: workspace.slug), class: "notae-create-menu-form" do |form| %>
                    <%= form.hidden_field :title, value: "Meeting notes" %>
                    <%= form.hidden_field :page_kind, value: "meeting_note" %>
                    <button type="submit" class="notae-create-menu-button" data-action="click->shell#closeCreateMenu">
                      <%= notae_icon_svg(:meeting, css_class: "notae-create-menu-icon notae-create-menu-icon-meeting") %>
                      <span>New meeting</span>
                    </button>
                  <% end %>
                </li>
              <% end %>
              <% if can_create_database %>
                <li class="notae-create-menu-item">
                  <%= form_with model: Database.new, url: databases_path(workspace_slug: workspace.slug), class: "notae-create-menu-form" do |form| %>
                    <%= hidden_field_tag :quick_create, "1" %>
                    <%= form.hidden_field :name, value: "Untitled grid" %>
                    <button type="submit" class="notae-create-menu-button" data-action="click->shell#closeCreateMenu">
                      <%= notae_icon_svg(:grid, css_class: "notae-create-menu-icon notae-create-menu-icon-database") %>
                      <span>Grid</span>
                    </button>
                  <% end %>
                </li>
                <li class="notae-create-menu-item">
                  <%= form_with model: Database.new, url: databases_path(workspace_slug: workspace.slug), class: "notae-create-menu-form" do |form| %>
                    <%= hidden_field_tag :quick_create, "1" %>
                    <%= hidden_field_tag :template, "tasks" %>
                    <%= form.hidden_field :name, value: "Tasks grid" %>
                    <button type="submit" class="notae-create-menu-button" data-action="click->shell#closeCreateMenu">
                      <%= notae_icon_svg(:grid, css_class: "notae-create-menu-icon notae-create-menu-icon-database") %>
                      <span>Tasks template</span>
                    </button>
                  <% end %>
                </li>
                <% if current_database_id.present? %>
                  <li class="notae-create-menu-item">
                    <%= form_with url: kanbanize_database_path(workspace_slug: workspace.slug, id: current_database_id),
                                  method: :post,
                                  class: "notae-create-menu-form" do %>
                      <button type="submit" class="notae-create-menu-button" data-action="click->shell#closeCreateMenu">
                        <%= notae_icon_svg(:grid, css_class: "notae-create-menu-icon notae-create-menu-icon-database") %>
                        <span>Kanban</span>
                      </button>
                    <% end %>
                  </li>
                <% end %>
              <% end %>
              <% if can_create_workspace %>
                <li class="notae-create-menu-item">
                  <button type="button" class="notae-create-menu-button" data-action="click->shell#openWorkspaceDialog">
                    <%= notae_icon_svg(:workspace, css_class: "notae-create-menu-icon notae-create-menu-icon-workspace") %>
                    <span>New Workspace</span>
                  </button>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      <% else %>
        <%= link_to "＋", new_workspace_path, class: "notae-icon-link", title: "New workspace", data: notae_shell_link_data %>
      <% end %>
      <button type="button"
              class="notae-sidebar-collapse-toggle"
              data-action="click->shell#toggleSidebarCollapse"
              aria-label="Minimize sidebar"
              title="Minimize sidebar">◂</button>
      <button type="button" class="notae-sidebar-close" data-action="click->shell#close" aria-label="Close sidebar">✕</button>
    </div>
  </div>

  <div class="notae-sidebar-scroll">
    <nav class="notae-sidebar-nav">
      <%= link_to (workspace ? workspace_path(workspace.slug) : root_path),
                  class: notae_sidebar_link_classes(workspace ? workspace_path(workspace.slug) : root_path),
                  data: notae_shell_link_data do %>
        <span class="notae-sidebar-link-content">
          <%= notae_icon_svg(:home, css_class: "notae-sidebar-nav-icon") %>
          <span class="notae-sidebar-link-label">Home</span>
        </span>
      <% end %>
      <%= link_to (workspace ? workspace_search_path(workspace_slug: workspace.slug) : root_path),
                  class: notae_sidebar_link_classes(workspace ? workspace_search_path(workspace_slug: workspace.slug) : root_path),
                  data: notae_shell_link_data do %>
        <span class="notae-sidebar-link-content">
          <%= notae_icon_svg(:search, css_class: "notae-sidebar-nav-icon") %>
          <span class="notae-sidebar-link-label">Search</span>
        </span>
      <% end %>
      <% if nav_workspace %>
        <%= link_to workspace_notifications_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_notifications_path(workspace_slug: nav_workspace.slug)),
                    data: notae_shell_link_data do %>
          <span class="notae-sidebar-link-content">
            <%= notae_icon_svg(:notifications, css_class: "notae-sidebar-nav-icon") %>
            <span class="notae-sidebar-link-label">Notifications</span>
          </span>
        <% end %>
        <%= link_to workspace_library_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_library_path(workspace_slug: nav_workspace.slug)),
                    data: notae_shell_link_data do %>
          <span class="notae-sidebar-link-content">
            <%= notae_icon_svg(:library, css_class: "notae-sidebar-nav-icon") %>
            <span class="notae-sidebar-link-label">Library</span>
          </span>
        <% end %>
        <%= link_to kalendarium_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(kalendarium_path(workspace_slug: nav_workspace.slug)),
                    data: notae_shell_link_data do %>
          <span class="notae-sidebar-link-content">
            <%= notae_icon_svg(:kalendarium, css_class: "notae-sidebar-nav-icon") %>
            <span class="notae-sidebar-link-label">Kalendārium</span>
          </span>
        <% end %>
        <%= link_to workspace_epistularium_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_epistularium_path(workspace_slug: nav_workspace.slug)),
                    data: notae_shell_link_data do %>
          <span class="notae-sidebar-link-content">
            <%= notae_icon_svg(:epistularium, css_class: "notae-sidebar-nav-icon") %>
            <span class="notae-sidebar-link-label">Epistularium</span>
          </span>
        <% end %>
        <%= link_to workspace_meetings_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_meetings_path(workspace_slug: nav_workspace.slug)),
                    data: notae_shell_link_data do %>
          <span class="notae-sidebar-link-content">
            <%= notae_icon_svg(:meeting, css_class: "notae-sidebar-nav-icon") %>
            <span class="notae-sidebar-link-label">Meetings</span>
          </span>
        <% end %>
        <%= link_to workspace_ai_conversation_history_path(workspace_slug: nav_workspace.slug),
                    class: notae_sidebar_link_classes(workspace_ai_conversation_history_path(workspace_slug: nav_workspace.slug)),
                    data: notae_shell_link_data do %>
          <span class="notae-sidebar-link-content">
            <%= notae_icon_svg(:ai_history, css_class: "notae-sidebar-nav-icon") %>
            <span class="notae-sidebar-link-label">AI Conversation History</span>
          </span>
        <% end %>
      <% end %>
    </nav>

    <% if workspace %>
      <section class="notae-sidebar-section notae-sidebar-section-collapsible"
               data-controller="sidebar-section"
               data-sidebar-section-key-value="<%= "#{workspace.slug}:workspaces" %>"
               data-sidebar-section-default-open-value="true">
        <div class="notae-sidebar-section-head">
          <button type="button"
                  class="notae-sidebar-section-toggle"
                  data-sidebar-section-target="toggle"
                  data-action="sidebar-section#toggle"
                  aria-expanded="true">
            <span class="notae-sidebar-section-chevron" aria-hidden="true">▾</span>
            <span class="notae-sidebar-label">Workspaces</span>
          </button>
          <% if can_create_workspace %>
            <button type="button"
                    class="notae-sidebar-section-create"
                    data-action="click->shell#openWorkspaceDialog"
                    aria-label="Create new Workspace"
                    title="Create new Workspace">[+]</button>
          <% end %>
        </div>
        <div class="notae-sidebar-section-body" data-sidebar-section-target="content">
          <% if recent_workspaces.any? %>
            <ul class="notae-sidebar-list is-indented">
              <% recent_workspaces.each do |sidebar_workspace| %>
                <% sidebar_workspace_slug = sidebar_workspace.slug.to_s.strip %>
                <% next if sidebar_workspace_slug.blank? %>
                <li>
                  <%= link_to workspace_path(sidebar_workspace_slug),
                              class: notae_sidebar_link_classes(workspace_path(sidebar_workspace_slug)),
                              data: notae_shell_link_data do %>
                    <span class="notae-sidebar-page-title">
                      <%= render_workspace_color_marker(sidebar_workspace) %>
                      <%= sidebar_workspace.name %>
                    </span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="notae-sidebar-empty">No workspaces yet.</p>
          <% end %>
        </div>
      </section>

      <section class="notae-sidebar-section notae-sidebar-section-collapsible"
               data-controller="sidebar-section"
               data-sidebar-section-key-value="<%= "#{workspace.slug}:notarum" %>"
               data-sidebar-section-default-open-value="true">
        <div class="notae-sidebar-section-head">
          <button type="button"
                  class="notae-sidebar-section-toggle"
                  data-sidebar-section-target="toggle"
                  data-action="sidebar-section#toggle"
                  aria-expanded="true">
            <span class="notae-sidebar-section-chevron" aria-hidden="true">▾</span>
            <span class="notae-sidebar-label">Notarum</span>
          </button>
          <% if can_create_page %>
            <%= form_with model: Page.new,
                          url: pages_path(workspace_slug: workspace.slug),
                          class: "notae-sidebar-section-create-form" do |form| %>
              <%= form.hidden_field :title, value: "Untitled" %>
              <button type="submit"
                      class="notae-sidebar-section-create"
                      aria-label="Create new Nota"
                      title="Create new Nota">[+]</button>
            <% end %>
          <% end %>
        </div>
        <div class="notae-sidebar-section-body" data-sidebar-section-target="content">
          <% if recent_pages.any? %>
            <ul class="notae-sidebar-list is-indented">
              <% recent_pages.each do |page| %>
                <li>
                  <%= link_to page_path(workspace_slug: workspace.slug, id: page.id),
                              class: notae_sidebar_link_classes(page_path(workspace_slug: workspace.slug, id: page.id)),
                              data: notae_shell_link_data do %>
                    <span class="notae-sidebar-page-title">
                      <%= render_notae_icon(page.icon, workspace: workspace, fallback: "📄", css_class: "notae-sidebar-page-icon", label: page.title) %>
                      <%= page.title %>
                    </span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="notae-sidebar-empty">No Notarum yet.</p>
          <% end %>
        </div>
      </section>

      <section class="notae-sidebar-section notae-sidebar-section-collapsible"
               data-controller="sidebar-section"
               data-sidebar-section-key-value="<%= "#{workspace.slug}:grids" %>"
               data-sidebar-section-default-open-value="true">
        <div class="notae-sidebar-section-head">
          <button type="button"
                  class="notae-sidebar-section-toggle"
                  data-sidebar-section-target="toggle"
                  data-action="sidebar-section#toggle"
                  aria-expanded="true">
            <span class="notae-sidebar-section-chevron" aria-hidden="true">▾</span>
            <span class="notae-sidebar-label">Grids</span>
          </button>
          <% if can_create_database %>
            <%= form_with model: Database.new,
                          url: databases_path(workspace_slug: workspace.slug),
                          class: "notae-sidebar-section-create-form" do |form| %>
              <%= hidden_field_tag :quick_create, "1" %>
              <%= form.hidden_field :name, value: "Untitled grid" %>
              <button type="submit"
                      class="notae-sidebar-section-create"
                      aria-label="Create new Grid"
                      title="Create new Grid">[+]</button>
            <% end %>
          <% end %>
        </div>
        <div class="notae-sidebar-section-body" data-sidebar-section-target="content">
          <% if recent_databases.any? %>
            <ul class="notae-sidebar-list is-indented">
              <% recent_databases.each do |db| %>
                <li>
                  <%= link_to database_path(workspace_slug: workspace.slug, id: db.id),
                              class: notae_sidebar_link_classes(database_path(workspace_slug: workspace.slug, id: db.id)),
                              data: notae_shell_link_data do %>
                    <span class="notae-sidebar-page-title">
                      <%= render_notae_icon(db.icon, workspace: workspace, fallback: "🗃️", css_class: "notae-sidebar-page-icon", label: db.name) %>
                      <%= db.name %>
                    </span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="notae-sidebar-empty">No grids yet.</p>
          <% end %>
        </div>
      </section>

      <section class="notae-sidebar-section notae-sidebar-section-collapsible"
               data-controller="sidebar-section"
               data-sidebar-section-key-value="<%= "#{workspace.slug}:meetings" %>"
               data-sidebar-section-default-open-value="true">
        <div class="notae-sidebar-section-head">
          <button type="button"
                  class="notae-sidebar-section-toggle"
                  data-sidebar-section-target="toggle"
                  data-action="sidebar-section#toggle"
                  aria-expanded="true">
            <span class="notae-sidebar-section-chevron" aria-hidden="true">▾</span>
            <span class="notae-sidebar-label">Meetings</span>
          </button>
          <% if can_create_page %>
            <%= form_with model: Page.new,
                          url: pages_path(workspace_slug: workspace.slug),
                          class: "notae-sidebar-section-create-form" do |form| %>
              <%= form.hidden_field :title, value: "Meeting notes" %>
              <%= form.hidden_field :page_kind, value: "meeting_note" %>
              <button type="submit"
                      class="notae-sidebar-section-create"
                      aria-label="Create new Meeting"
                      title="Create new Meeting">[+]</button>
            <% end %>
          <% end %>
        </div>
        <div class="notae-sidebar-section-body" data-sidebar-section-target="content">
          <% if recent_meetings.any? %>
            <ul class="notae-sidebar-list is-indented">
              <% recent_meetings.each do |page| %>
                <li>
                  <%= link_to page_path(workspace_slug: workspace.slug, id: page.id),
                              class: notae_sidebar_link_classes(page_path(workspace_slug: workspace.slug, id: page.id)),
                              data: notae_shell_link_data do %>
                    <span class="notae-sidebar-page-title">🗒️ <%= page.title %></span>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="notae-sidebar-empty">No meetings yet.</p>
          <% end %>
        </div>
      </section>

      <section class="notae-sidebar-section notae-sidebar-section-collapsible"
               data-controller="sidebar-section"
               data-sidebar-section-key-value="<%= "#{workspace.slug}:favorites" %>"
               data-sidebar-section-default-open-value="true">
        <div class="notae-sidebar-section-head">
          <button type="button"
                  class="notae-sidebar-section-toggle"
                  data-sidebar-section-target="toggle"
                  data-action="sidebar-section#toggle"
                  aria-expanded="true">
            <span class="notae-sidebar-section-chevron" aria-hidden="true">▾</span>
            <span class="notae-sidebar-label">Favorites</span>
          </button>
        </div>
        <div class="notae-sidebar-section-body" data-sidebar-section-target="content">
          <% if recent_favorites.any? %>
            <ul class="notae-sidebar-list is-indented">
              <% recent_favorites.each do |item| %>
                <li>
                  <% if item[:type] == :page %>
                    <% page = item[:record] %>
                    <%= link_to page_path(workspace_slug: workspace.slug, id: page.id),
                                class: notae_sidebar_link_classes(page_path(workspace_slug: workspace.slug, id: page.id)),
                                data: notae_shell_link_data do %>
                      <span class="notae-sidebar-page-title">⭐ <%= page.title %></span>
                    <% end %>
                  <% else %>
                    <% database = item[:record] %>
                    <%= link_to database_path(workspace_slug: workspace.slug, id: database.id),
                                class: notae_sidebar_link_classes(database_path(workspace_slug: workspace.slug, id: database.id)),
                                data: notae_shell_link_data do %>
                      <span class="notae-sidebar-page-title">
                        ⭐
                        <%= render_notae_icon(database.icon, workspace: workspace, fallback: "🗃️", css_class: "notae-sidebar-page-icon", label: database.name) %>
                        <%= database.name %>
                      </span>
                    <% end %>
                  <% end %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="notae-sidebar-empty">No favorites yet.</p>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>

  <div class="notae-sidebar-footer">
    <%= link_to (workspace ? workspace_preferences_path(workspace_slug: workspace.slug) : root_path),
                class: notae_sidebar_link_classes(workspace ? workspace_preferences_path(workspace_slug: workspace.slug) : root_path),
                data: notae_shell_link_data do %>
      <span class="notae-sidebar-link-content">
        <%= notae_icon_svg(:settings, css_class: "notae-sidebar-nav-icon") %>
        <span class="notae-sidebar-link-label">Settings</span>
      </span>
    <% end %>
    <%= link_to (workspace ? workspace_trash_path(workspace_slug: workspace.slug) : root_path),
                class: notae_sidebar_link_classes(workspace ? workspace_trash_path(workspace_slug: workspace.slug) : root_path),
                data: notae_shell_link_data do %>
      <span class="notae-sidebar-link-content">
        <%= notae_icon_svg(:trash, css_class: "notae-sidebar-nav-icon") %>
        <span class="notae-sidebar-link-label">Trash</span>
      </span>
    <% end %>
    <%= button_to destroy_user_session_path,
                  method: :delete,
                  class: "notae-sidebar-link notae-sidebar-signout",
                  form: { data: { pwa_clear_private_cache: "true" } } do %>
      <span class="notae-sidebar-link-content">
        <%= notae_icon_svg(:sign_out, css_class: "notae-sidebar-nav-icon") %>
        <span class="notae-sidebar-link-label">Sign out</span>
      </span>
    <% end %>
  </div>
  </div>
</aside>

<% if workspace && can_create_workspace %>
  <div class="notae-modal is-hidden"
       data-shell-target="workspaceDialog"
       data-action="click->shell#closeWorkspaceDialog">
    <div class="notae-modal-panel notae-workspace-modal-panel" data-action="click->shell#noop">
      <div class="notae-modal-header">
        <h2>Create Workspace</h2>
        <button type="button"
                class="notae-inline-icon-button"
                data-action="click->shell#closeWorkspaceDialog"
                aria-label="Close create workspace dialog">✕</button>
      </div>
      <p class="notae-pref-description">Start a new workspace and become its owner.</p>
      <%= form_with model: Workspace.new, url: workspaces_path, class: "notae-workspace-modal-form" do |form| %>
        <label class="notae-workspace-modal-label" for="new_workspace_name">Workspace name</label>
        <%= form.text_field :name,
                            id: "new_workspace_name",
                            required: true,
                            class: "notae-auth-input",
                            data: {
                              shell_target: "workspaceNameInput",
                              action: "input->shell#syncWorkspaceSlug"
                            } %>

        <label class="notae-workspace-modal-label" for="new_workspace_slug">Workspace URL slug</label>
        <%= form.text_field :slug,
                            id: "new_workspace_slug",
                            required: true,
                            class: "notae-auth-input",
                            data: {
                              shell_target: "workspaceSlugInput",
                              action: "input->shell#markWorkspaceSlugEdited"
                            } %>

        <label class="notae-workspace-modal-label">Workspace colour</label>
        <p class="notae-pref-description">Required. This becomes the workspace marker and the page-top border.</p>
        <%= render "shared/workspace_color_picker",
                   form: form,
                   selected_value: form.object.display_color,
                   grid_class: "notae-workspace-color-grid-compact" %>

        <div class="notae-workspace-modal-actions">
          <button type="button" class="notae-chip-button" data-action="click->shell#closeWorkspaceDialog">Cancel</button>
          <%= form.submit "Create workspace", class: "notae-chip-button" %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
