<%
  lazy = local_assigns.fetch(:lazy, false)
  workspace = local_assigns[:workspace] || @ai_rail_workspace || (defined?(@workspace) ? @workspace : nil)
  workspace_slug = local_assigns[:workspace_slug].presence || workspace&.slug.to_s.strip.presence || params[:workspace_slug].to_s.strip.presence
  workspace_ready = workspace_slug.present?
  current_page_id = local_assigns[:current_page_id] || @ai_rail_current_page_id
%>

<% if lazy && workspace_ready %>
  <%= turbo_frame_tag "ai_rail_panel",
                      data: {
                        controller: "ai-rail-loader",
                        ai_rail_loader_src_value: workspace_ai_assistant_panel_path(
                          workspace_slug: workspace_slug,
                          current_page_id: current_page_id
                        )
                      } do %>
    <%= render "shared/app_ai_rail_loading" %>
  <% end %>
<% else %>
  <%= turbo_frame_tag "ai_rail_panel" do %>
    <%= render "shared/app_ai_rail" %>
  <% end %>
<% end %>
