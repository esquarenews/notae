<% compact = local_assigns.fetch(:compact, false) %>

<div class="notae-knowledge-pending-card<%= " is-compact" if compact %>">
  <%= render "shared/ai_loader_icon",
             variant: current_user.ai_loader_style,
             state: "loading",
             size: compact ? 36 : 48,
             reduced_motion: current_user.reduce_ai_loader_motion? %>
  <div class="notae-knowledge-pending-copy">
    <p class="notae-knowledge-pending-title">Preparing daily workspace brief</p>
    <p class="notae-page-subtle">The page is ready. Your daily brief is still generating in the background and will appear when it finishes.</p>
  </div>
</div>
