<% pages = pages_by_parent[parent_id] || [] %>

<% if pages.any? %>
  <ul class="<%= parent_id.nil? ? "notae-sidebar-list" : "ml-3 mt-1 space-y-1 border-l border-stone-300/70 pl-2" %>">
    <% pages.each do |page| %>
      <li>
        <%= link_to page_path(workspace_slug: workspace.slug, id: page.id),
                    class: notae_sidebar_link_classes(
                      page_path(workspace_slug: workspace.slug, id: page.id)
                    ),
                    data: { action: "click->shell#close" } do %>
          <span class="notae-sidebar-page-link-content">
            <% if page.icon.present? %>
              <span class="notae-sidebar-page-icon"><%= page.icon %></span>
            <% end %>
            <span class="notae-sidebar-page-title"><%= page.title %></span>
          </span>
        <% end %>
        <%= render partial: "shared/page_tree", locals: { pages_by_parent: pages_by_parent, parent_id: page.id, workspace: workspace } %>
      </li>
    <% end %>
  </ul>
<% elsif parent_id.nil? %>
  <p class="notae-sidebar-empty">No Notarum yet.</p>
<% end %>
