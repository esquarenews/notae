<section class="notae-pwa-shell">
  <div class="notae-pwa-offline-banner" data-pwa-target="offlineBanner" hidden>
    <strong>Offline mode</strong>
    <span>Cached screens remain available. Changes, sync, and live updates need a connection.</span>
  </div>

  <div class="notae-pwa-install-card" data-pwa-target="installPrompt" hidden>
    <div class="notae-pwa-install-copy">
      <strong>Install Notae</strong>
      <span>Add Notae to your home screen for a cleaner, app-like experience.</span>
    </div>
    <div class="notae-pwa-install-actions">
      <button type="button" class="notae-chip-button" data-action="pwa#install">Install</button>
      <button type="button" class="notae-chip-button notae-chip-button-subtle" data-action="pwa#dismissInstall">Not now</button>
    </div>
  </div>

  <div class="notae-pwa-install-card notae-pwa-install-card-ios" data-pwa-target="iosPrompt" hidden>
    <div class="notae-pwa-install-copy">
      <strong>Add Notae to Home Screen</strong>
      <span>On iPhone or iPad, tap Share, then choose Add to Home Screen.</span>
    </div>
    <div class="notae-pwa-install-actions">
      <button type="button" class="notae-chip-button notae-chip-button-subtle" data-action="pwa#dismissIosPrompt">Dismiss</button>
    </div>
  </div>

  <div class="notae-pwa-push-card" data-pwa-target="pushPrompt" hidden>
    <div class="notae-pwa-install-copy">
      <strong>Enable push notifications</strong>
      <span>Get important Notae alerts on this device, including mentions, approvals, reminders, and workflow failures.</span>
    </div>
    <div class="notae-pwa-install-actions">
      <button type="button" class="notae-chip-button" data-action="pwa#enablePush">Enable</button>
      <button type="button" class="notae-chip-button notae-chip-button-subtle" data-action="pwa#dismissPush">Not now</button>
    </div>
  </div>

  <div class="notae-pwa-live-banner" data-pwa-target="pushLiveBanner" data-state="neutral" hidden>
    <div class="notae-pwa-install-copy">
      <strong data-pwa-target="pushLiveBannerTitle">Notae</strong>
      <span data-pwa-target="pushLiveBannerBody">A live notification reached this app.</span>
    </div>
    <div class="notae-pwa-install-actions">
      <a href="/app" class="notae-chip-button" data-pwa-target="pushLiveBannerOpen">Open</a>
      <button type="button" class="notae-chip-button notae-chip-button-subtle" data-action="pwa#dismissPushLiveBanner">Dismiss</button>
    </div>
  </div>

  <div class="notae-pwa-network-toast" data-pwa-target="networkToast" hidden></div>
</section>
