<aside class="notae-settings-nav" data-controller="auto-submit">
  <% settings_workspace_slug = params[:settings_workspace_slug].to_s %>
  <% workspace_section_item = %i[general people import emoji].include?(active_item) ? active_item : :general %>
  <% workspace_options = policy_scope(Workspace)
       .where.not(slug: [ nil, "" ])
       .to_a
       .sort_by { |candidate_workspace| [ candidate_workspace.name.to_s.downcase, candidate_workspace.created_at || Time.at(0) ] } %>
  <% selected_workspace = workspace_options.find { |candidate_workspace| candidate_workspace.slug == settings_workspace_slug } || workspace %>
  <% active_item_labels = {
       account: "Account",
       preferences: "Preferences",
       notifications: "Notifications",
       subscription: "Subscription",
       operations: "Operations",
        connections: "Connections",
       general: "General",
       people: "People",
       import: "Import",
       notae_ai: "Notae AI",
       ai_analytics: "AI Analytics",
       kalendarium: "Kalendarium",
       epistularium: "Epistularium",
       emoji: "Emoji",
       favicon: "Favicon Lab"
     } %>
  <% active_nav_key = active_item.respond_to?(:to_sym) ? active_item.to_sym : nil %>
  <% active_nav_label = active_item_labels[active_nav_key] || "Settings" %>
  <% workspace_route_for = lambda do |candidate_workspace|
       case workspace_section_item
       when :people
         workspace_people_settings_path(workspace_slug: candidate_workspace.slug, settings_workspace_slug: candidate_workspace.slug)
       when :import
         workspace_import_settings_path(workspace_slug: candidate_workspace.slug, settings_workspace_slug: candidate_workspace.slug)
       when :emoji
         workspace_emoji_settings_path(workspace_slug: candidate_workspace.slug, settings_workspace_slug: candidate_workspace.slug)
       else
         workspace_general_settings_path(workspace_slug: candidate_workspace.slug, settings_workspace_slug: candidate_workspace.slug)
       end
     end %>
  <% workspace_nav_options = workspace_options
       .map { |candidate_workspace| [candidate_workspace.name, workspace_route_for.call(candidate_workspace)] } %>

  <details class="notae-settings-mobile-accordion"
           data-controller="settings-nav"
           open>
    <summary class="notae-settings-mobile-trigger">
      <span class="notae-settings-mobile-trigger-label"><%= active_nav_label %></span>
      <span class="notae-settings-mobile-trigger-caret">▾</span>
    </summary>
    <div class="notae-settings-mobile-accordion-panel">
      <div class="notae-settings-nav-body">

  <p class="notae-settings-nav-group">Account</p>
  <%= link_to workspace_account_settings_path(workspace_slug: workspace.slug),
              class: [ "notae-settings-nav-user", ("active" if active_item == :account) ].compact.join(" ") do %>
    <% if current_user.avatar.attached? %>
      <%= image_tag current_user.avatar, alt: current_user.display_name, class: "notae-settings-nav-avatar-image" %>
    <% else %>
      <span class="notae-settings-nav-avatar"><%= current_user.avatar_initials %></span>
    <% end %>
    <span class="notae-settings-nav-name"><%= current_user.email %></span>
  <% end %>
  <%= link_to workspace_preferences_path(workspace_slug: workspace.slug),
              class: [ "notae-settings-nav-item", ("active" if active_item == :preferences) ].compact.join(" ") do %>
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
      <span>Preferences</span>
    </span>
  <% end %>
  <%= link_to workspace_notification_settings_path(workspace_slug: workspace.slug),
              class: [ "notae-settings-nav-item", ("active" if active_item == :notifications) ].compact.join(" ") do %>
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M15 17h5l-1.4-1.4M19 17l-1.4 1.4"/><path d="M9 17H4l1.4-1.4M5 17l1.4 1.4"/><path d="M12 3v18"/></svg>
      <span>Notifications</span>
    </span>
  <% end %>
  <%= link_to workspace_connection_settings_path(workspace_slug: workspace.slug),
              class: [ "notae-settings-nav-item", ("active" if active_item == :connections) ].compact.join(" ") do %>
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 8a3 3 0 0 1 0 6l-2 2a3 3 0 1 1-4-4l2-2"/><path d="M15 16a3 3 0 0 1 0-6l2-2a3 3 0 1 1 4 4l-2 2"/><path d="M8 12h8"/></svg>
      <span>Connections</span>
    </span>
  <% end %>

  <p class="notae-settings-nav-group">Workspace</p>
  <div class="notae-settings-workspace-picker">
    <%= label_tag :workspace_nav_picker, "Active workspace", class: "notae-settings-workspace-picker-label" %>
    <%= select_tag :workspace_nav_picker,
                   options_for_select(workspace_nav_options, workspace_route_for.call(selected_workspace)),
                   class: "notae-options-input",
                   data: { action: "change->auto-submit#navigate" } %>
  </div>
  <%= link_to workspace_general_settings_path(workspace_slug: selected_workspace.slug, settings_workspace_slug: selected_workspace.slug),
              class: [ "notae-settings-nav-item", ("active" if active_item == :general) ].compact.join(" ") do %>
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M19.4 15a1 1 0 0 0 .2 1.1l.1.1a1 1 0 0 1 0 1.4l-1 1a1 1 0 0 1-1.4 0l-.1-.1a1 1 0 0 0-1.1-.2 1 1 0 0 0-.6.9V20a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-.2a1 1 0 0 0-.6-.9 1 1 0 0 0-1.1.2l-.1.1a1 1 0 0 1-1.4 0l-1-1a1 1 0 0 1 0-1.4l.1-.1a1 1 0 0 0 .2-1.1 1 1 0 0 0-.9-.6H4a1 1 0 0 1-1-1v-2a1 1 0 0 1 1-1h.2a1 1 0 0 0 .9-.6 1 1 0 0 0-.2-1.1l-.1-.1a1 1 0 0 1 0-1.4l1-1a1 1 0 0 1 1.4 0l.1.1a1 1 0 0 0 1.1.2 1 1 0 0 0 .6-.9V4a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v.2a1 1 0 0 0 .6.9 1 1 0 0 0 1.1-.2l.1-.1a1 1 0 0 1 1.4 0l1 1a1 1 0 0 1 0 1.4l-.1.1a1 1 0 0 0-.2 1.1 1 1 0 0 0 .9.6H20a1 1 0 0 1 1 1v2a1 1 0 0 1-1 1h-.2a1 1 0 0 0-.4 1z"/></svg>
      <span>General</span>
    </span>
  <% end %>
  <%= link_to workspace_people_settings_path(workspace_slug: selected_workspace.slug, settings_workspace_slug: selected_workspace.slug),
              class: [ "notae-settings-nav-item", ("active" if active_item == :people) ].compact.join(" ") do %>
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="10" r="2.5"/><path d="M15 20a5 5 0 0 1 6 0"/></svg>
      <span>People</span>
    </span>
  <% end %>
  <%= link_to workspace_import_settings_path(workspace_slug: selected_workspace.slug, settings_workspace_slug: selected_workspace.slug),
              class: [ "notae-settings-nav-item", ("active" if active_item == :import) ].compact.join(" ") do %>
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><rect x="4" y="17" width="16" height="4" rx="1"/></svg>
      <span>Import</span>
    </span>
  <% end %>

  <p class="notae-settings-nav-group">Features</p>
  <%= link_to workspace_notae_ai_settings_path(workspace_slug: selected_workspace.slug, settings_workspace_slug: selected_workspace.slug),
              class: [ "notae-settings-nav-item", ("active" if active_item == :notae_ai) ].compact.join(" ") do %>
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 1.9 4.8L19 9.7l-4 3.5 1.2 5L12 15.8 7.8 18.2 9 13.2 5 9.7l5.1-1.9z"/></svg>
      <span>Notae AI</span>
    </span>
  <% end %>
  <%= link_to workspace_ai_analytics_settings_path(workspace_slug: selected_workspace.slug, settings_workspace_slug: selected_workspace.slug),
              class: [ "notae-settings-nav-item", ("active" if active_item == :ai_analytics) ].compact.join(" ") do %>
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19h16"/><path d="M6 16v-5"/><path d="M10 16V8"/><path d="M14 16v-2"/><path d="M18 16V5"/></svg>
      <span>AI Analytics</span>
    </span>
  <% end %>
  <%= link_to workspace_kalendarium_settings_path(workspace_slug: selected_workspace.slug, settings_workspace_slug: selected_workspace.slug),
              class: [ "notae-settings-nav-item", ("active" if active_item == :kalendarium) ].compact.join(" ") do %>
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg>
      <span>Kalendārium</span>
    </span>
  <% end %>
  <%= link_to workspace_epistularium_settings_path(workspace_slug: selected_workspace.slug, settings_workspace_slug: selected_workspace.slug),
              class: [ "notae-settings-nav-item", ("active" if active_item == :epistularium) ].compact.join(" ") do %>
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3z"/><path d="m4 7 8 6 8-6"/></svg>
      <span>Epistularium</span>
    </span>
  <% end %>
  <span class="<%= [ "notae-settings-nav-item", "is-disabled", ("active" if active_item == :favicon) ].compact.join(" ") %>">
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.2"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/></svg>
      <span>Favicon Lab</span>
    </span>
    <em>Internal</em>
  </span>
  <%= link_to workspace_emoji_settings_path(workspace_slug: selected_workspace.slug, settings_workspace_slug: selected_workspace.slug),
              class: [ "notae-settings-nav-item", ("active" if active_item == :emoji) ].compact.join(" ") do %>
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M8.5 10h.01M15.5 10h.01"/><path d="M8 15c1 .8 2.3 1.2 4 1.2s3-.4 4-1.2"/></svg>
      <span>Emoji</span>
    </span>
  <% end %>

  <% unless Rails.env.production? %>
    <p class="notae-settings-nav-group">Admin</p>
    <%= link_to workspace_operations_settings_path(workspace_slug: selected_workspace.slug, settings_workspace_slug: selected_workspace.slug),
                class: [ "notae-settings-nav-item", ("active" if active_item == :operations) ].compact.join(" ") do %>
      <span class="notae-settings-nav-item-label">
        <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"/><path d="M12 5v14"/><circle cx="12" cy="12" r="8"/></svg>
        <span>Operations</span>
      </span>
    <% end %>
  <% end %>

  <p class="notae-settings-nav-group">Subscription</p>
  <%= link_to workspace_subscription_settings_path(workspace_slug: workspace.slug),
              class: [ "notae-settings-nav-item", ("active" if active_item == :subscription) ].compact.join(" ") do %>
    <span class="notae-settings-nav-item-label">
      <svg class="notae-settings-nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16v10H4z"/><path d="M4 11h16"/><path d="M8 15h3"/></svg>
      <span>Subscription</span>
    </span>
  <% end %>
      </div>
    </div>
  </details>
</aside>
