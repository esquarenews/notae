<%
  workspace = local_assigns[:workspace] || (defined?(@workspace) ? @workspace : nil)
  loading = local_assigns.fetch(:loading, false)
  sidebar_link_data = notae_shell_link_data.merge(turbo_frame: "_top")
  sidebar_form_data = { turbo_frame: "_top" }
%>

<% if workspace.present? %>
  <% can_create_workspace = policy(Workspace.new).create? %>
  <% can_create_page = policy(Page.new(workspace: workspace)).create? %>
  <% can_create_database = policy(Database.new(workspace: workspace)).create? %>
  <% recent_workspaces = loading ? [] : ui_sidebar_recent_workspaces(limit: 6) %>
  <% recent_pages = loading ? [] : ui_sidebar_recent_pages %>
  <% recent_databases = loading ? [] : ui_sidebar_recent_databases %>
  <% recent_meetings = loading ? [] : ui_sidebar_recent_meetings %>
  <% recent_favorites = loading ? [] : ui_sidebar_recent_favorites %>

  <section class="notae-sidebar-section notae-sidebar-section-collapsible"
           data-controller="sidebar-section"
           data-sidebar-section-key-value="<%= "#{workspace.slug}:workspaces" %>"
           data-sidebar-section-default-open-value="true">
    <div class="notae-sidebar-section-head">
      <button type="button"
              class="notae-sidebar-section-toggle"
              data-sidebar-section-target="toggle"
              data-action="sidebar-section#toggle"
              aria-expanded="true">
        <span class="notae-sidebar-section-chevron" aria-hidden="true">▾</span>
        <span class="notae-sidebar-label">Workspaces</span>
      </button>
      <% if can_create_workspace %>
        <button type="button"
                class="notae-sidebar-section-create"
                data-action="click->shell#openWorkspaceDialog"
                aria-label="Create new Workspace"
                title="Create new Workspace">[+]</button>
      <% end %>
    </div>
    <div class="notae-sidebar-section-body" data-sidebar-section-target="content">
      <% if loading %>
        <ul class="notae-sidebar-list is-indented"><li><p class="notae-sidebar-empty">Loading workspaces…</p></li></ul>
      <% elsif recent_workspaces.any? %>
        <ul class="notae-sidebar-list is-indented">
          <% recent_workspaces.each do |sidebar_workspace| %>
            <% sidebar_workspace_slug = sidebar_workspace.slug.to_s.strip %>
            <% next if sidebar_workspace_slug.blank? %>
            <li>
              <%= link_to workspace_path(sidebar_workspace_slug),
                          class: notae_sidebar_link_classes(workspace_path(sidebar_workspace_slug)),
                          data: sidebar_link_data do %>
                <span class="notae-sidebar-page-title">
                  <%= render_workspace_color_marker(sidebar_workspace) %>
                  <%= sidebar_workspace.name %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="notae-sidebar-empty">No workspaces yet.</p>
      <% end %>
    </div>
  </section>

  <section class="notae-sidebar-section notae-sidebar-section-collapsible"
           data-controller="sidebar-section"
           data-sidebar-section-key-value="<%= "#{workspace.slug}:notarum" %>"
           data-sidebar-section-default-open-value="true">
    <div class="notae-sidebar-section-head">
      <button type="button"
              class="notae-sidebar-section-toggle"
              data-sidebar-section-target="toggle"
              data-action="sidebar-section#toggle"
              aria-expanded="true">
        <span class="notae-sidebar-section-chevron" aria-hidden="true">▾</span>
        <span class="notae-sidebar-label">Notarum</span>
      </button>
      <% if can_create_page %>
        <%= form_with model: Page.new,
                      url: pages_path(workspace_slug: workspace.slug),
                      data: sidebar_form_data,
                      class: "notae-sidebar-section-create-form" do |form| %>
          <%= form.hidden_field :title, value: "Untitled" %>
          <button type="submit"
                  class="notae-sidebar-section-create"
                  aria-label="Create new Nota"
                  title="Create new Nota">[+]</button>
        <% end %>
      <% end %>
    </div>
    <div class="notae-sidebar-section-body" data-sidebar-section-target="content">
      <% if loading %>
        <ul class="notae-sidebar-list is-indented"><li><p class="notae-sidebar-empty">Loading Notarum…</p></li></ul>
      <% elsif recent_pages.any? %>
        <ul class="notae-sidebar-list is-indented">
          <% recent_pages.each do |page| %>
            <li>
              <%= link_to page_path(workspace_slug: workspace.slug, id: page.id),
                          class: notae_sidebar_link_classes(page_path(workspace_slug: workspace.slug, id: page.id)),
                          data: sidebar_link_data do %>
                <span class="notae-sidebar-page-title">
                  <%= render_notae_icon(page.icon, workspace: workspace, fallback: "📄", css_class: "notae-sidebar-page-icon", label: page.title) %>
                  <%= page.title %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="notae-sidebar-empty">No Notarum yet.</p>
      <% end %>
    </div>
  </section>

  <section class="notae-sidebar-section notae-sidebar-section-collapsible"
           data-controller="sidebar-section"
           data-sidebar-section-key-value="<%= "#{workspace.slug}:grids" %>"
           data-sidebar-section-default-open-value="true">
    <div class="notae-sidebar-section-head">
      <button type="button"
              class="notae-sidebar-section-toggle"
              data-sidebar-section-target="toggle"
              data-action="sidebar-section#toggle"
              aria-expanded="true">
        <span class="notae-sidebar-section-chevron" aria-hidden="true">▾</span>
        <span class="notae-sidebar-label">Grids</span>
      </button>
      <% if can_create_database %>
        <%= form_with model: Database.new,
                      url: databases_path(workspace_slug: workspace.slug),
                      data: sidebar_form_data,
                      class: "notae-sidebar-section-create-form" do |form| %>
          <%= hidden_field_tag :quick_create, "1" %>
          <%= form.hidden_field :name, value: "Untitled grid" %>
          <button type="submit"
                  class="notae-sidebar-section-create"
                  aria-label="Create new Grid"
                  title="Create new Grid">[+]</button>
        <% end %>
      <% end %>
    </div>
    <div class="notae-sidebar-section-body" data-sidebar-section-target="content">
      <% if loading %>
        <ul class="notae-sidebar-list is-indented"><li><p class="notae-sidebar-empty">Loading grids…</p></li></ul>
      <% elsif recent_databases.any? %>
        <ul class="notae-sidebar-list is-indented">
          <% recent_databases.each do |db| %>
            <li>
              <%= link_to database_path(workspace_slug: workspace.slug, id: db.id),
                          class: notae_sidebar_link_classes(database_path(workspace_slug: workspace.slug, id: db.id)),
                          data: sidebar_link_data do %>
                <span class="notae-sidebar-page-title">
                  <%= render_notae_icon(db.icon, workspace: workspace, fallback: "🗃️", css_class: "notae-sidebar-page-icon", label: db.name) %>
                  <%= db.name %>
                </span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="notae-sidebar-empty">No grids yet.</p>
      <% end %>
    </div>
  </section>

  <section class="notae-sidebar-section notae-sidebar-section-collapsible"
           data-controller="sidebar-section"
           data-sidebar-section-key-value="<%= "#{workspace.slug}:meetings" %>"
           data-sidebar-section-default-open-value="true">
    <div class="notae-sidebar-section-head">
      <button type="button"
              class="notae-sidebar-section-toggle"
              data-sidebar-section-target="toggle"
              data-action="sidebar-section#toggle"
              aria-expanded="true">
        <span class="notae-sidebar-section-chevron" aria-hidden="true">▾</span>
        <span class="notae-sidebar-label">Meetings</span>
      </button>
      <% if can_create_page %>
        <%= form_with model: Page.new,
                      url: pages_path(workspace_slug: workspace.slug),
                      data: sidebar_form_data,
                      class: "notae-sidebar-section-create-form" do |form| %>
          <%= form.hidden_field :title, value: "Meeting notes" %>
          <%= form.hidden_field :page_kind, value: "meeting_note" %>
          <button type="submit"
                  class="notae-sidebar-section-create"
                  aria-label="Create new Meeting"
                  title="Create new Meeting">[+]</button>
        <% end %>
      <% end %>
    </div>
    <div class="notae-sidebar-section-body" data-sidebar-section-target="content">
      <% if loading %>
        <ul class="notae-sidebar-list is-indented"><li><p class="notae-sidebar-empty">Loading meetings…</p></li></ul>
      <% elsif recent_meetings.any? %>
        <ul class="notae-sidebar-list is-indented">
          <% recent_meetings.each do |page| %>
            <li>
              <%= link_to page_path(workspace_slug: workspace.slug, id: page.id),
                          class: notae_sidebar_link_classes(page_path(workspace_slug: workspace.slug, id: page.id)),
                          data: sidebar_link_data do %>
                <span class="notae-sidebar-page-title">🗒️ <%= page.title %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="notae-sidebar-empty">No meetings yet.</p>
      <% end %>
    </div>
  </section>

  <section class="notae-sidebar-section notae-sidebar-section-collapsible"
           data-controller="sidebar-section"
           data-sidebar-section-key-value="<%= "#{workspace.slug}:favorites" %>"
           data-sidebar-section-default-open-value="true">
    <div class="notae-sidebar-section-head">
      <button type="button"
              class="notae-sidebar-section-toggle"
              data-sidebar-section-target="toggle"
              data-action="sidebar-section#toggle"
              aria-expanded="true">
        <span class="notae-sidebar-section-chevron" aria-hidden="true">▾</span>
        <span class="notae-sidebar-label">Favorites</span>
      </button>
    </div>
    <div class="notae-sidebar-section-body" data-sidebar-section-target="content">
      <% if loading %>
        <ul class="notae-sidebar-list is-indented"><li><p class="notae-sidebar-empty">Loading favorites…</p></li></ul>
      <% elsif recent_favorites.any? %>
        <ul class="notae-sidebar-list is-indented">
          <% recent_favorites.each do |item| %>
            <li>
              <% if item[:type] == :page %>
                <% page = item[:record] %>
                <%= link_to page_path(workspace_slug: workspace.slug, id: page.id),
                            class: notae_sidebar_link_classes(page_path(workspace_slug: workspace.slug, id: page.id)),
                            data: sidebar_link_data do %>
                  <span class="notae-sidebar-page-title">⭐ <%= page.title %></span>
                <% end %>
              <% else %>
                <% database = item[:record] %>
                <%= link_to database_path(workspace_slug: workspace.slug, id: database.id),
                            class: notae_sidebar_link_classes(database_path(workspace_slug: workspace.slug, id: database.id)),
                            data: sidebar_link_data do %>
                  <span class="notae-sidebar-page-title">
                    ⭐
                    <%= render_notae_icon(database.icon, workspace: workspace, fallback: "🗃️", css_class: "notae-sidebar-page-icon", label: database.name) %>
                    <%= database.name %>
                  </span>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="notae-sidebar-empty">No favorites yet.</p>
      <% end %>
    </div>
  </section>
<% end %>
