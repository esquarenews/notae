<% if presenter.event_alert.present? %>
  <article class="notae-shell-status-bar-item"
           data-notification-bar-target="alert"
           data-notification-bar-alert-key="<%= presenter.event_alert_key %>">
    <div class="notae-shell-status-bar-item-top">
      <span class="notae-shell-status-bar-item-kind">Calendar</span>
      <div class="notae-shell-status-bar-item-controls">
        <button type="button"
                class="notae-shell-status-bar-control"
                aria-label="Snooze this alert for one hour"
                title="Snooze for one hour"
                data-action="notification-bar#snoozeAlert">
          <%= notae_icon_svg(:clock, css_class: "notae-shell-status-bar-control-icon") %>
        </button>
        <button type="button"
                class="notae-shell-status-bar-control"
                aria-label="Dismiss this alert"
                title="Dismiss"
                data-action="notification-bar#dismissAlert">
          <%= notae_icon_svg(:close_small, css_class: "notae-shell-status-bar-control-icon") %>
        </button>
      </div>
    </div>
    <%= link_to kalendarium_path(workspace_slug: workspace.slug), class: "notae-shell-status-bar-link" do %>
      <strong><%= truncate(presenter.event_alert.title.presence || "Untitled event", length: 56) %></strong>
      <span><%= presenter.event_timing_label %></span>
    <% end %>
  </article>
<% end %>

