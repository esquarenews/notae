<% content_for :title, "New Workspace" %>

<section class="space-y-5">
  <header class="space-y-1">
    <h1 class="text-3xl font-semibold tracking-tight">Create Workspace</h1>
    <p class="text-slate-600">Start a new workspace and begin a 7-day Stripe trial.</p>
  </header>

  <%= form_with model: @workspace, class: "space-y-4 rounded border border-slate-200 bg-white p-5" do |form| %>
    <% if @workspace.errors.any? %>
      <div class="rounded border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-700">
        <%= @workspace.errors.full_messages.to_sentence %>
      </div>
    <% end %>

    <div class="space-y-1">
      <%= form.label :name, class: "block text-sm font-medium text-slate-800" %>
      <%= form.text_field :name, class: "w-full rounded border border-slate-300 px-3 py-2 text-sm", required: true %>
    </div>

    <div class="space-y-1">
      <%= form.label :slug, class: "block text-sm font-medium text-slate-800" %>
      <%= form.text_field :slug, class: "w-full rounded border border-slate-300 px-3 py-2 text-sm", required: true %>
    </div>

    <div class="space-y-2">
      <%= form.label :workspace_color, "Workspace colour", class: "block text-sm font-medium text-slate-800" %>
      <p class="text-sm text-slate-600">Required. Used for the workspace marker and the page-top border.</p>
      <%= render "shared/workspace_color_picker",
                 form: form,
                 selected_value: @workspace.display_color,
                 grid_class: "notae-workspace-color-grid-compact" %>
    </div>

    <div class="space-y-1">
      <%= form.label :plan_key, "Plan", class: "block text-sm font-medium text-slate-800" %>
      <%= form.select :plan_key,
                      Billing::PlanCatalog.public_plan_keys.map { |plan| [ "#{Billing::PlanCatalog.name_for(plan)} · #{Billing::PlanCatalog.monthly_price_label_for(plan)}", plan ] },
                      { selected: @selected_plan_key },
                      class: "w-full rounded border border-slate-300 px-3 py-2 text-sm" %>
      <p class="text-sm text-slate-600">Stripe will collect a card now and start billing after the 7-day trial unless you cancel.</p>
    </div>

    <%= form.submit "Continue to Stripe", class: "rounded bg-slate-900 px-3 py-2 text-sm font-medium text-white" %>
  <% end %>
</section>
