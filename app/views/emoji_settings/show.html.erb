<% content_for :title, "Emoji" %>
<% content_for :topbar_page_icon, "😀" %>
<% content_for :topbar_privacy, "Workspace" %>
<% content_for :topbar_actions do %>
  <%= link_to "Close", workspace_path(@workspace.slug), class: "notae-chip-button" %>
<% end %>

<section class="notae-settings-shell">
  <%= render "shared/settings_nav", workspace: @workspace, active_item: :emoji %>

  <div class="notae-settings-content">
    <section class="notae-settings-section">
      <h2>Emoji</h2>
      <p class="notae-pref-description">
        Upload custom emoji for this workspace. They will appear in the icon picker for notas and grids.
        Give each one a short name so it is easy to search from the icon picker.
      </p>

      <% if flash[:notice].present? %>
        <div class="notae-emoji-settings-status is-success">
          <strong>Upload complete</strong>
          <span><%= flash[:notice] %></span>
        </div>
      <% elsif flash[:alert].present? %>
        <div class="notae-emoji-settings-status is-error">
          <strong>Upload incomplete</strong>
          <span><%= flash[:alert] %></span>
        </div>
      <% end %>

      <div class="notae-emoji-settings-layout">
        <article class="notae-emoji-settings-card">
          <h3>1. Upload an image</h3>
          <p class="notae-pref-description">
            Transparent PNG, WebP, GIF, JPEG, or SVG works best. Square artwork gives the cleanest icon result.
          </p>

          <%= form_with model: @workspace_emoji,
                        url: workspace_emoji_settings_path(workspace_slug: @workspace.slug),
                        method: :post,
                        multipart: true,
                        class: "notae-emoji-upload-form" do |form| %>
            <label class="notae-emoji-upload-dropzone">
              <span class="notae-emoji-upload-dropzone-icon">🖼️</span>
              <span class="notae-emoji-upload-dropzone-copy">
                <strong>Select an image</strong>
                <span>Your upload will appear below and in the icon picker's custom emoji section.</span>
              </span>
              <%= form.file_field :image, accept: "image/png,image/jpeg,image/gif,image/webp,image/svg+xml", class: "notae-emoji-upload-input" %>
            </label>
            <div class="notae-emoji-upload-fields">
              <%= form.label :name, "2. Name it", class: "notae-pref-label" %>
              <%= form.text_field :name,
                                  required: true,
                                  placeholder: "Party avocado",
                                  class: "notae-auth-input" %>
              <p class="notae-pref-description">This is what appears in search when you add an icon to a nota or grid.</p>
            </div>
            <%= form.submit "Upload emoji", class: "notae-chip-button" %>
          <% end %>
        </article>

        <article class="notae-emoji-settings-card">
          <h3>Workspace custom emoji</h3>
          <% if @custom_emojis.any? %>
            <div class="notae-emoji-settings-grid">
              <% @custom_emojis.each do |emoji| %>
                <div class="notae-emoji-settings-item <%= "is-highlighted" if emoji.id.to_s == @highlight_emoji_id.to_s %>">
                  <div class="notae-emoji-settings-item-preview">
                    <%= image_tag emoji.image, alt: emoji.display_name, class: "notae-emoji-settings-item-image" %>
                  </div>
                  <div class="notae-emoji-settings-item-copy">
                    <strong><%= emoji.display_name %></strong>
                    <span>Available in the custom emoji results of the icon picker.</span>
                    <% if emoji.id.to_s == @highlight_emoji_id.to_s %>
                      <em class="notae-emoji-settings-item-status">Ready to use now</em>
                    <% end %>
                  </div>
                  <%= button_to "Remove",
                                workspace_emoji_setting_path(workspace_slug: @workspace.slug, id: emoji.id),
                                method: :delete,
                                class: "notae-page-header-link-button" %>
                </div>
              <% end %>
            </div>
          <% else %>
            <p class="notae-options-empty">No custom emoji yet.</p>
          <% end %>
        </article>
      </div>
    </section>
  </div>
</section>
