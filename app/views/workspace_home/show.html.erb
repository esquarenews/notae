<% content_for :title, @workspace.name %>

<section class="space-y-6">
  <header class="space-y-1">
    <h1 class="text-3xl font-semibold tracking-tight"><%= @workspace.name %></h1>
    <p class="text-sm text-slate-600">Slug: <%= @workspace.slug %></p>
    <p class="text-sm">
      <%= link_to "Notifications (#{@unread_notifications_count})",
                  workspace_notifications_path(workspace_slug: @workspace.slug),
                  class: "underline" %>
    </p>
  </header>

  <section class="rounded border border-slate-200 bg-white p-4">
    <%= form_with url: workspace_search_path(workspace_slug: @workspace.slug), method: :get, class: "flex gap-2" do |form| %>
      <%= form.text_field :q, placeholder: "Search pages, blocks, and rows", class: "w-full rounded border border-slate-300 px-3 py-2 text-sm" %>
      <%= form.submit "Search", class: "rounded bg-slate-900 px-3 py-2 text-sm font-medium text-white" %>
    <% end %>
  </section>

  <div class="grid gap-6 lg:grid-cols-[280px_1fr]">
    <aside class="space-y-4 rounded border border-slate-200 bg-white p-4">
      <h2 class="text-base font-medium">Pages</h2>
      <%= render partial: "shared/page_tree", locals: { pages_by_parent: @pages_by_parent, parent_id: nil, workspace: @workspace } %>

      <% if policy(Page.new(workspace: @workspace)).create? %>
        <%= form_with model: @new_page, url: pages_path(workspace_slug: @workspace.slug), class: "space-y-2 pt-2" do |form| %>
          <%= form.text_field :title, placeholder: "New page title", required: true, class: "w-full rounded border border-slate-300 px-3 py-2 text-sm" %>
          <%= form.hidden_field :parent_page_id %>
          <%= form.submit "Create page", class: "w-full rounded bg-slate-900 px-3 py-2 text-sm font-medium text-white" %>
        <% end %>
      <% end %>
    </aside>

    <div class="space-y-6">
      <section class="space-y-3">
        <h2 class="text-xl font-medium">Members</h2>
        <ul class="space-y-2">
          <% @memberships.each do |membership| %>
            <li class="rounded border border-slate-200 bg-white px-3 py-2 text-sm">
              <div class="flex items-center justify-between gap-3">
                <div>
                  <strong><%= membership.user.email %></strong>
                  <span class="ml-2 rounded bg-slate-100 px-2 py-0.5 text-xs uppercase tracking-wide text-slate-700"><%= membership.role %></span>
                </div>

                <% if policy(membership).update? %>
                  <%= form_with model: membership, url: membership_path(workspace_slug: @workspace.slug, id: membership.id), method: :patch, class: "inline-flex items-center gap-2" do |form| %>
                    <%= form.select :role, Membership.roles.keys.map { |role| [role.titleize, role] }, {}, class: "rounded border border-slate-300 px-2 py-1 text-xs" %>
                    <%= form.submit "Change", class: "rounded border border-slate-300 px-2 py-1 text-xs" %>
                  <% end %>
                <% end %>
              </div>
            </li>
          <% end %>
        </ul>
      </section>

      <% if @can_invite %>
        <section class="space-y-3">
          <h2 class="text-xl font-medium">Invite People</h2>
          <%= form_with model: @invitation, url: workspace_invitations_path(workspace_slug: @workspace.slug), class: "grid gap-3 rounded border border-slate-200 bg-white p-4 md:grid-cols-[1fr_auto_auto]" do |form| %>
            <%= form.email_field :email, placeholder: "teammate@example.com", required: true, class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
            <%= form.select :role, Invitation.roles.keys.map { |role| [role.titleize, role] }, { selected: "guest" }, class: "rounded border border-slate-300 px-3 py-2 text-sm" %>
            <%= form.submit "Send invite", class: "rounded bg-slate-900 px-3 py-2 text-sm font-medium text-white" %>
          <% end %>
        </section>
      <% end %>

      <% if @audit_events.any? %>
        <section class="space-y-3">
          <h2 class="text-xl font-medium">Recent Audit Events</h2>
          <ul class="space-y-2">
            <% @audit_events.each do |event| %>
              <li class="rounded border border-slate-200 bg-white px-3 py-2 text-sm">
                <div class="font-medium"><%= event.action.humanize %> by <%= event.actor.email %></div>
                <div class="text-xs text-slate-600"><%= event.metadata.to_json %></div>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </div>
  </div>
</section>
