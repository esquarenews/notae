<% content_for :title, @workspace.name %>
<% content_for :content_class, "notae-content-page notae-content-home" %>

<section class="notae-workspace-home notae-workspace-home--landing">
  <div class="notae-workspace-home-hero-shell">
    <div class="notae-workspace-home-banner-inner">
      <header class="notae-workspace-home-hero">
        <p class="notae-page-subtle">Workspace home</p>
        <h1><%= @time_greeting %></h1>
        <% workspace_name = @workspace.name.to_s.strip %>
        <% workspace_slug = @workspace.slug.to_s.strip %>
        <% slug_duplicates_name = workspace_slug.casecmp?(workspace_name) || workspace_slug == workspace_name.parameterize %>
        <% workspace_meta = slug_duplicates_name ? workspace_name : "#{workspace_name} · #{workspace_slug}" %>
        <% unless slug_duplicates_name %>
          <p class="notae-page-subtle"><%= workspace_meta %></p>
        <% end %>
      </header>

      <section class="notae-auth-card notae-home-card">
        <%= form_with url: workspace_search_path(workspace_slug: @workspace.slug), method: :get, class: "notae-workspace-home-search" do |form| %>
          <%= form.text_field :q, placeholder: "Search Notarum, blocks, and rows", class: "notae-auth-input" %>
          <%= form.submit "Search", class: "notae-chip-button" %>
          <%= link_to "Notifications (#{@unread_notifications_count})",
                      workspace_notifications_path(workspace_slug: @workspace.slug),
                      class: "notae-chip-button" %>
        <% end %>
      </section>
    </div>
  </div>

  <div class="notae-workspace-home-body">
    <section class="notae-auth-card notae-home-card"<%= %( id="knowledge-suggestion-#{@display_daily_knowledge_suggestion.id}") if @display_daily_knowledge_suggestion.present? %>>
      <div class="notae-home-card-head">
        <div class="notae-workspace-home-section-copy">
          <h2>Daily workspace brief</h2>
          <% if @display_daily_knowledge_suggestion.present? %>
            <% brief_generated_date = @display_daily_knowledge_suggestion.generated_for_date || @display_daily_knowledge_suggestion.generated_at&.to_date %>
            <% if @show_latest_daily_knowledge_suggestion %>
              <p class="notae-page-subtle">
                Showing the latest available brief from
                <%= brief_generated_date.present? ? l(brief_generated_date, format: :long) : time_ago_in_words(@display_daily_knowledge_suggestion.generated_at) + " ago" %>.
              </p>
            <% else %>
              <p class="notae-page-subtle">Updated <%= time_ago_in_words(@display_daily_knowledge_suggestion.generated_at) %> ago.</p>
            <% end %>
          <% else %>
            <p class="notae-page-subtle">Your next daily brief window is <%= @next_daily_brief_at.strftime("%a %-I:%M %p") %>.</p>
          <% end %>
        </div>
        <div class="notae-workspace-home-meta">
          <span class="notae-workspace-home-meta-pill">
            Next brief
            <strong><%= @next_daily_brief_at.strftime("%a %-I:%M %p") %></strong>
          </span>
          <% if @display_daily_knowledge_suggestion.present? %>
            <span class="notae-workspace-home-meta-pill">
              Last brief
              <strong><%= (@display_daily_knowledge_suggestion.generated_for_date || @display_daily_knowledge_suggestion.generated_at&.to_date)&.strftime("%b %-d") || "Today" %></strong>
            </span>
          <% end %>
        </div>
      </div>
      <% if @daily_knowledge_suggestion_pending %>
        <%= render "shared/knowledge_suggestion_pending_card",
                   kind: KnowledgeSuggestion::KIND_DAILY_SUMMARY,
                   compact: @display_daily_knowledge_suggestion.present? %>
      <% end %>
      <% if @display_daily_knowledge_suggestion.present? %>
        <% if @show_latest_daily_knowledge_suggestion %>
          <span class="notae-workspace-home-badge">Latest available brief</span>
        <% end %>
        <%= render "shared/knowledge_suggestion_card",
                   suggestion: @display_daily_knowledge_suggestion,
                   workspace: @workspace,
                   task_databases: @knowledge_task_databases %>
      <% elsif !@daily_knowledge_suggestion_pending %>
        <div class="notae-workspace-home-empty-state">
          <p class="notae-workspace-home-empty-title">No daily brief yet.</p>
          <p class="notae-page-subtle">Your first workspace brief appears once Notae has enough indexed activity to summarise.</p>
        </div>
      <% end %>
    </section>

    <section class="notae-auth-card notae-home-card">
      <div class="notae-home-card-head">
        <div class="notae-workspace-home-section-copy">
          <h2>Important updates</h2>
          <p class="notae-page-subtle">Review AI suggestions, draft actions, and jump back into planning from here.</p>
        </div>
        <div class="notae-utility-page-actions">
          <%= link_to "Create Nota", "#{workspace_path(@workspace.slug)}#workspace-home-create-nota", class: "notae-chip-button" %>
          <%= link_to "Open Kalendārium", kalendarium_path(workspace_slug: @workspace.slug), class: "notae-chip-button notae-chip-button-subtle" %>
          <%= link_to "Review drafts", agent_actions_path(workspace_slug: @workspace.slug), class: "notae-chip-button" %>
          <%= link_to "New draft", new_agent_action_path(workspace_slug: @workspace.slug), class: "notae-chip-button notae-chip-button-subtle" %>
        </div>
      </div>
      <div class="notae-workspace-home-update-stack">
        <% if @active_proactive_knowledge_suggestion.present? %>
          <div class="notae-workspace-home-update-block" id="knowledge-suggestion-<%= @active_proactive_knowledge_suggestion.id %>">
            <div class="notae-workspace-home-update-head">
              <h3>AI suggestion</h3>
              <span class="notae-page-subtle">Actionable now</span>
            </div>
            <%= render "shared/knowledge_suggestion_card",
                       suggestion: @active_proactive_knowledge_suggestion,
                       workspace: @workspace,
                       task_databases: @knowledge_task_databases %>
          </div>
        <% elsif @active_proactive_knowledge_suggestion_pending %>
          <div class="notae-workspace-home-update-block">
            <div class="notae-workspace-home-update-head">
              <h3>AI suggestion</h3>
              <span class="notae-page-subtle">Refreshing</span>
            </div>
            <%= render "shared/knowledge_suggestion_pending_card",
                       kind: KnowledgeSuggestion::KIND_PROACTIVE,
                       compact: true %>
          </div>
        <% end %>

        <div class="notae-workspace-home-update-block">
          <div class="notae-workspace-home-update-head">
            <h3>Agent draft actions</h3>
            <span class="notae-page-subtle"><%= pluralize(@pending_agent_actions.count, "draft") %> pending</span>
          </div>
          <% if @pending_agent_actions.any? %>
            <ul class="notae-workspace-home-list">
              <% @pending_agent_actions.each do |agent_action| %>
                <li class="notae-workspace-home-list-item">
                  <div class="notae-workspace-home-list-row">
                    <div>
                      <strong><%= agent_action.title %></strong>
                      <div class="notae-page-subtle"><%= agent_action.target_system.titleize %> · <%= agent_action.draft_type.humanize %></div>
                    </div>
                    <%= link_to "Review", agent_action_path(workspace_slug: @workspace.slug, id: agent_action.id), class: "notae-chip-button" %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <div class="notae-workspace-home-empty-state">
              <p class="notae-workspace-home-empty-title">No pending draft actions.</p>
              <p class="notae-page-subtle">Use draft actions for calendar holds, task tickets, and reviewable outbound work.</p>
            </div>
          <% end %>
        </div>
      </div>
    </section>

  <section class="notae-workspace-home-grid">
    <% if policy(Page.new(workspace: @workspace)).create? %>
      <div class="notae-auth-card notae-home-card" id="workspace-home-create-nota">
        <div class="notae-home-card-head">
          <h2>Create Nota</h2>
        </div>
        <%= form_with model: @new_page, url: pages_path(workspace_slug: @workspace.slug), class: "notae-workspace-home-stack" do |form| %>
          <%= form.text_field :title, placeholder: "New Nota title", required: true, class: "notae-auth-input" %>
          <%= form.hidden_field :parent_page_id %>
          <%= form.submit "Create Nota", class: "notae-chip-button" %>
        <% end %>
      </div>
    <% end %>

    <% if policy(Database.new(workspace: @workspace)).create? %>
      <div class="notae-auth-card notae-home-card">
        <div class="notae-home-card-head">
          <h2>Create Grid</h2>
        </div>
        <%= form_with model: @new_database, url: databases_path(workspace_slug: @workspace.slug), class: "notae-workspace-home-stack" do |form| %>
          <%= form.text_field :name, placeholder: "New grid name", required: true, class: "notae-auth-input" %>
          <%= form.submit "Create Grid", class: "notae-chip-button" %>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="notae-auth-card notae-home-card">
    <div class="notae-home-card-head">
      <h2>Notarum</h2>
    </div>
    <% if @recent_pages.any? %>
      <div class="notae-workspace-page-grid">
        <% @recent_pages.each do |page| %>
          <%= link_to page_path(workspace_slug: @workspace.slug, id: page.id), class: "notae-workspace-page-card" do %>
            <div class="notae-workspace-page-card-cover">
              <% if page.cover_image.attached? %>
                <%= image_tag page.cover_image,
                              class: "notae-workspace-page-card-cover-image",
                              loading: "lazy",
                              decoding: "async" %>
              <% elsif (cover_style = page_cover_preset_style(page.cover_preset_key)).present? %>
                <div class="notae-workspace-page-card-cover-preset"
                     style="<%= cover_style %>"></div>
              <% else %>
                <div class="notae-workspace-page-card-cover-fallback"></div>
              <% end %>
            </div>
            <div class="notae-workspace-page-card-body">
              <%= render_notae_icon(page.icon, workspace: @workspace, fallback: "📄", css_class: "notae-workspace-page-card-icon", label: page.title) %>
              <div class="notae-workspace-page-card-text">
                <strong><%= page.title %></strong>
                <span>Nota</span>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="notae-page-subtle">No Notarum yet.</p>
    <% end %>
  </section>

  <section class="notae-auth-card notae-home-card">
    <div class="notae-home-card-head">
      <h2>Grids</h2>
    </div>
    <% if @recent_databases.any? %>
      <div class="notae-workspace-home-link-grid">
        <% @recent_databases.each do |database| %>
          <%= link_to database_path(workspace_slug: @workspace.slug, id: database.id), class: "notae-home-workspace-item" do %>
            <strong>
              <%= render_notae_icon(database.icon, workspace: @workspace, fallback: "🗃️", css_class: "notae-inline-linked-icon", label: database.name) %>
              <%= database.name %>
            </strong>
            <span>Grid view</span>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="notae-page-subtle">No grids yet.</p>
    <% end %>
  </section>

  <section class="notae-auth-card notae-home-card">
    <div class="notae-home-card-head">
      <h2>Members</h2>
    </div>
    <ul class="notae-workspace-home-list">
      <% @memberships.each do |membership| %>
        <li class="notae-workspace-home-list-item">
          <div class="notae-workspace-home-list-row">
            <div>
              <strong><%= membership.user.email %></strong>
              <span class="notae-workspace-home-role-badge"><%= membership.role %></span>
            </div>

            <% if policy(membership).update? %>
              <%= form_with model: membership, url: membership_path(workspace_slug: @workspace.slug, id: membership.id), method: :patch, class: "notae-workspace-home-inline-form" do |form| %>
                <%= form.select :role, Membership.roles.keys.map { |role| [role.titleize, role] }, {}, class: "notae-auth-input notae-workspace-home-select" %>
                <%= form.submit "Change", class: "notae-chip-button" %>
              <% end %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  </section>

  <% if @can_invite %>
    <section class="notae-auth-card notae-home-card">
      <div class="notae-home-card-head">
        <h2>Invite people</h2>
      </div>
      <%= form_with model: @invitation, url: workspace_invitations_path(workspace_slug: @workspace.slug), class: "notae-workspace-home-invite-form" do |form| %>
        <%= form.email_field :email, placeholder: "teammate@example.com", required: true, class: "notae-auth-input" %>
        <%= form.select :role, Invitation.roles.keys.map { |role| [role.titleize, role] }, { selected: "guest" }, class: "notae-auth-input notae-workspace-home-select" %>
        <%= form.submit "Send invite", class: "notae-chip-button" %>
      <% end %>
    </section>
  <% end %>

  <% if @audit_events.any? %>
    <section class="notae-auth-card notae-home-card">
      <div class="notae-home-card-head">
        <h2>Recent audit events</h2>
      </div>
      <ul class="notae-workspace-home-list">
        <% @audit_events.each do |event| %>
          <li class="notae-workspace-home-list-item">
            <div class="font-medium"><%= event.action.humanize %> by <%= event.actor.email %></div>
            <div class="notae-workspace-home-json"><%= event.metadata.to_json %></div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
  </div>
</section>
