<%
  importmap_imports = JSON.parse(Rails.application.importmap.to_json(resolver: self)).fetch("imports", {})
  core_importmap_names = [
    "application",
    "@hotwired/turbo-rails",
    "@hotwired/stimulus",
    "@hotwired/stimulus-loading",
    "controllers",
    "controllers/application"
  ]
  core_importmap_urls = core_importmap_names.filter_map { |name| importmap_imports[name] }.grep(/\A\//)
  font_urls = [
    asset_path("notae_sans/notae-sans-variable.woff2"),
    asset_path("notae_sans/notae-sans-italic-variable.woff2")
  ]
  precache_urls = (
    core_importmap_urls +
    [
      asset_path("application.css"),
      "/icon-192-v5.png",
      "/icon-512-v5.png",
      "/icon-maskable-512-v5.png",
      pwa_manifest_path,
      pwa_offline_path
    ]
  ).uniq
  service_worker_behavior_version = "documents-network-only-v3-notae-fonts"
  cache_version = "pwa-#{Digest::SHA256.hexdigest((precache_urls + font_urls + [ service_worker_behavior_version ]).join("|")).first(12)}"
%>
const CACHE_VERSION = "<%= cache_version %>"
const SHELL_CACHE = `notae-shell-${CACHE_VERSION}`
const ASSET_CACHE = `notae-assets-${CACHE_VERSION}`
const FONT_CACHE = `notae-fonts-${CACHE_VERSION}`
const PRIVATE_CACHE_PREFIXES = ["notae-documents-"]
const ACTIVE_CACHES = [SHELL_CACHE, ASSET_CACHE, FONT_CACHE]
const OFFLINE_FALLBACK_URL = "<%= pwa_offline_path %>"
const NOTIFICATION_LAUNCH_TEMPLATE = "<%= pwa_notification_launch_path(id: "__NOTIFICATION_ID__") %>"
const PRECACHE_URLS = <%= raw(precache_urls.to_json) %>
const PRECACHE_FONT_URLS = <%= raw(font_urls.to_json) %>

self.addEventListener("install", (event) => {
  event.waitUntil(
    (async () => {
      const [shellCache, fontCache] = await Promise.all([
        caches.open(SHELL_CACHE),
        caches.open(FONT_CACHE)
      ])
      await Promise.all([
        shellCache.addAll(PRECACHE_URLS),
        fontCache.addAll(PRECACHE_FONT_URLS)
      ])
      await self.skipWaiting()
    })()
  )
})

self.addEventListener("activate", (event) => {
  event.waitUntil(
    (async () => {
      const cacheNames = await caches.keys()
      await Promise.all(
        cacheNames.map((cacheName) => {
          if (ACTIVE_CACHES.includes(cacheName)) return Promise.resolve(false)
          if (!cacheName.startsWith("notae-")) return Promise.resolve(false)

          return caches.delete(cacheName)
        })
      )
      await self.clients.claim()
    })()
  )
})

self.addEventListener("message", (event) => {
  if (event.data?.type !== "CLEAR_PRIVATE_CACHES") return

  event.waitUntil(clearPrivateCaches())
})

self.addEventListener("push", (event) => {
  event.waitUntil(showPushNotification(event))
})

self.addEventListener("notificationclick", (event) => {
  event.notification.close()

  const url = notificationLaunchUrl(event.notification.data)
  event.waitUntil(openNotificationDestination(url))
})

self.addEventListener("fetch", (event) => {
  const { request } = event
  if (request.method !== "GET") return
  if (request.cache === "only-if-cached" && request.mode !== "same-origin") return

  const url = new URL(request.url)
  if (!cacheableRequestUrl(url)) return

  if (isTopLevelDocumentRequest(request, url)) {
    event.respondWith(networkFirstDocument(request))
    return
  }

  if (isFontRequest(url)) {
    event.respondWith(staleWhileRevalidate(request, FONT_CACHE))
    return
  }

  if (isSameOriginAsset(url)) {
    event.respondWith(staleWhileRevalidate(request, ASSET_CACHE))
    return
  }

  if (isImageRequest(request, url)) {
    event.respondWith(cacheFirst(request, ASSET_CACHE))
    return
  }

})

function isTopLevelDocumentRequest(request, url) {
  if (request.mode !== "navigate") return false
  if (url.origin !== self.location.origin) return false

  const path = url.pathname
  if (path === "/app" || path === OFFLINE_FALLBACK_URL) return true
  if (!path.startsWith("/w/")) return false

  return /^\/w\/[^/]+(?:\/(?:search|library|kalendarium|epistularium|meetings|settings(?:\/[^/]+)?))?$/.test(path)
}

function isSameOriginAsset(url) {
  return url.origin === self.location.origin && (url.pathname.startsWith("/assets/") || url.pathname === "/icon-192-v5.png" || url.pathname === "/icon-512-v5.png" || url.pathname === "/icon-maskable-512-v5.png" || url.pathname === "/icon-v5.png" || url.pathname === "/icon-v5.svg" || url.pathname === "/icon-light-v5.svg" || url.pathname === "/icon-dark-v5.svg" || url.pathname === "/apple-touch-icon-v5.png")
}

function cacheableRequestUrl(url) {
  return url.protocol === "http:" || url.protocol === "https:"
}

function isImageRequest(request, url) {
  if (request.destination === "image") return true

  return url.origin === self.location.origin && /\.(?:png|svg|jpg|jpeg|gif|webp|avif)$/i.test(url.pathname)
}

function isFontRequest(url) {
  return url.origin === self.location.origin && /\.(?:woff2?|ttf|otf)$/i.test(url.pathname)
}

async function networkFirstDocument(request) {
  try {
    return await fetch(request)
  } catch (_error) {
    return offlineFallbackResponse()
  }
}

async function staleWhileRevalidate(request, cacheName) {
  if (!cacheableRequestUrl(new URL(request.url))) return fetch(request)

  const cache = await caches.open(cacheName)
  const cached = await cache.match(request)
  const networkRequest = fetch(request)
    .then(async (response) => {
      if (response && response.ok) {
        await cache.put(request, response.clone())
      }

      return response
    })

  if (cached) {
    networkRequest.catch(() => {})
    return cached
  }

  return networkRequest
}

async function cacheFirst(request, cacheName) {
  if (!cacheableRequestUrl(new URL(request.url))) return fetch(request)

  const cache = await caches.open(cacheName)
  const cached = await cache.match(request)
  if (cached) return cached

  const response = await fetch(request)
  if (response && response.ok) {
    await cache.put(request, response.clone())
  }

  return response
}

async function offlineFallbackResponse() {
  const cache = await caches.open(SHELL_CACHE)
  const cached = await cache.match(OFFLINE_FALLBACK_URL)
  return cached || Response.error()
}

async function clearPrivateCaches() {
  const cacheNames = await caches.keys()

  await Promise.all(
    cacheNames.map((cacheName) => {
      if (!PRIVATE_CACHE_PREFIXES.some((prefix) => cacheName.startsWith(prefix))) return Promise.resolve(false)

      return caches.delete(cacheName)
    })
  )
}

async function showPushNotification(event) {
  const payload = parsePushPayload(event.data)
  const title = payload.title || "Notae"
  const notificationSuppressedInForeground = await hasVisibleWindowClient()
  let notificationDisplayed = false
  let notificationError = ""

  if (notificationSuppressedInForeground) {
    await notifyPushReceipt(payload, { notificationSuppressedInForeground })
    return
  }

  try {
    await self.registration.showNotification(title, {
      body: payload.body || "",
      icon: payload.icon || "/icon-192-v5.png",
      badge: payload.badge || "/icon-192-v5.png",
      tag: payload.tag || "notae-notification",
      requireInteraction: Boolean(payload.require_interaction),
      renotify: false,
      data: {
        url: payload.url || "/app",
        notificationId: payload.notification_id || null
      }
    })
    notificationDisplayed = true
  } catch (error) {
    notificationError = error?.message || String(error)
  } finally {
    await notifyPushReceipt(payload, { notificationDisplayed, notificationError, notificationSuppressedInForeground })
  }
}

async function hasVisibleWindowClient() {
  const clientsList = await self.clients.matchAll({ type: "window", includeUncontrolled: true })

  return clientsList.some((client) => client.visibilityState === "visible")
}

function parsePushPayload(data) {
  if (!data) return {}

  try {
    return data.json()
  } catch (_error) {
    return { body: data.text() }
  }
}

function notificationLaunchUrl(data) {
  const notificationId = data?.notificationId || data?.notification_id
  if (notificationId) {
    return NOTIFICATION_LAUNCH_TEMPLATE.replace("__NOTIFICATION_ID__", notificationId)
  }

  return data?.url || "/app"
}

async function openNotificationDestination(rawUrl) {
  const destinationUrl = new URL(rawUrl, self.location.origin).toString()
  const clientsList = await self.clients.matchAll({ type: "window", includeUncontrolled: true })

  for (const client of clientsList) {
    if (!("focus" in client)) continue

    if ("navigate" in client) {
      await client.navigate(destinationUrl)
    }

    await client.focus()
    return
  }

  if (self.clients.openWindow) {
    await self.clients.openWindow(destinationUrl)
  }
}

async function notifyPushReceipt(payload, { notificationDisplayed = false, notificationError = "", notificationSuppressedInForeground = false } = {}) {
  const clientsList = await self.clients.matchAll({ type: "window", includeUncontrolled: true })
  const receiptPayload = pushReceiptPayload(payload, { notificationDisplayed, notificationError, notificationSuppressedInForeground })

  await Promise.all(
    clientsList.map((client) => {
      if (typeof client.postMessage !== "function") return Promise.resolve()

      client.postMessage({
        type: "notae:push-received",
        payload: receiptPayload
      })

      return Promise.resolve()
    })
  )
}

function pushReceiptPayload(payload, { notificationDisplayed = false, notificationError = "", notificationSuppressedInForeground = false } = {}) {
  return {
    notificationId: payload.notification_id || null,
    notificationType: payload.type || payload.notification_type || null,
    title: payload.title || "Notae",
    body: payload.body || "",
    url: payload.url || "/app",
    tag: payload.tag || "",
    icon: payload.icon || "/icon-192-v5.png",
    requireInteraction: Boolean(payload.require_interaction),
    notificationDisplayed,
    notificationSuppressedInForeground,
    notificationError
  }
}
