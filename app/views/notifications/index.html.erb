<% content_for :title, "Notifications #{@workspace.name}" %>

<section class="notae-workspace-home notae-utility-page">
  <% unread_count = @notifications.count { |notification| notification.read_at.nil? } %>
  <header class="notae-utility-header">
    <p class="notae-utility-workspace">
      <%= link_to @workspace.name, workspace_path(@workspace.slug), class: "notae-utility-workspace-link" %>
    </p>
    <h1 class="notae-utility-title">Notifications</h1>
    <p class="notae-utility-meta">Unread: <%= unread_count %></p>
  </header>

  <% if @notifications.any? %>
    <ul class="notae-workspace-home-list">
      <% @notifications.each do |notification| %>
        <li class="notae-workspace-home-list-item notae-utility-notification-item">
          <div class="notae-utility-result-head">
            <span class="notae-utility-link">
              <% if notification.notification_type == Notification::TYPE_CALENDAR_REMINDER %>
                Reminder from <%= notification.workspace.name %>
              <% elsif notification.notification_type == Notification::TYPE_AGENT_ACTION_APPROVAL_REQUESTED %>
                Agent draft awaiting approval
              <% elsif notification.notification_type == Notification::TYPE_AGENT_ACTION_RESUBMITTED %>
                Agent draft resubmitted
              <% elsif notification.notification_type == Notification::TYPE_AGENT_ACTION_CHANGES_REQUESTED %>
                Changes requested on a draft
              <% elsif notification.notification_type == Notification::TYPE_AGENT_ACTION_APPROVED %>
                Draft approved
              <% elsif notification.notification_type == Notification::TYPE_AGENT_ACTION_REJECTED %>
                Draft rejected
              <% elsif notification.notification_type == Notification::TYPE_WORKFLOW_FAILED %>
                Workflow failed
              <% elsif notification.notification_type == Notification::TYPE_CODEX_REQUEST_COMPLETED %>
                <%= notification.codex_completion_title %>
              <% elsif notification.notification_type == Notification::TYPE_TEST_PUSH %>
                <%= notification.metadata["title"].presence || "Notae test notification" %>
              <% elsif notification.knowledge_suggestion_notification? %>
                <%= notification.metadata["kind"] == KnowledgeSuggestion::KIND_DAILY_SUMMARY ? "Daily workspace brief ready" : "New AI suggestion" %>
              <% else %>
                <%= notification.actor.email %> mentioned you
              <% end %>
            </span>
            <% if notification.read_at.nil? %>
              <span class="notae-utility-kind">Unread</span>
            <% end %>
          </div>
          <p class="notae-utility-meta">
            <%= notification.created_at.in_time_zone(current_user.time_zone).strftime("%a %-d %b %Y · %-I:%M %p") %>
          </p>

          <% if notification.notification_type == Notification::TYPE_CALENDAR_REMINDER && notification.notifiable.is_a?(KalendariumEvent) %>
            <% event = notification.notifiable %>
            <p class="notae-utility-copy">
              <strong><%= event.title %></strong>
              · <%= event.starts_at_utc.in_time_zone(current_user.time_zone).strftime("%b %-d %H:%M") %>
            </p>
            <%= link_to "Open Kalendārium",
                        kalendarium_path(workspace_slug: @workspace.slug, view: "day", date: event.starts_at_utc.to_date, anchor: "kalendarium_event_#{event.id}"),
                        class: "notae-utility-link notae-utility-mini-link" %>
          <% elsif notification.notifiable.is_a?(Comment) %>
            <p class="notae-utility-copy"><%= notification.notifiable.body %></p>
            <% commentable = notification.notifiable.commentable %>
            <% if commentable.is_a?(Page) %>
              <%= link_to "Open page",
                          page_path(workspace_slug: @workspace.slug, id: commentable.id),
                          class: "notae-utility-link notae-utility-mini-link" %>
            <% elsif commentable.is_a?(Block) %>
              <%= link_to "Open block",
                          page_path(workspace_slug: @workspace.slug, id: commentable.page_id, anchor: "block_#{commentable.id}"),
                          class: "notae-utility-link notae-utility-mini-link" %>
            <% elsif commentable.is_a?(Database) %>
              <%= link_to "Open grid",
                          database_path(workspace_slug: @workspace.slug, id: commentable.id, anchor: "database-comments-menu"),
                          class: "notae-utility-link notae-utility-mini-link" %>
            <% end %>
          <% elsif notification.agent_action_notification? && notification.notifiable.is_a?(AgentAction) %>
            <% agent_action = notification.notifiable %>
            <p class="notae-utility-copy">
              <strong><%= agent_action.title %></strong>
              · <%= agent_action.target_system.titleize %>
              · <%= agent_action.draft_type.humanize %>
            </p>
            <% if notification.metadata["comment"].present? %>
              <p class="notae-utility-copy"><%= notification.metadata["comment"] %></p>
            <% end %>
            <%= link_to "Open draft",
                        agent_action_path(workspace_slug: @workspace.slug, id: agent_action.id),
                        class: "notae-utility-link notae-utility-mini-link" %>
          <% elsif notification.knowledge_suggestion_notification? && notification.notifiable.is_a?(KnowledgeSuggestion) %>
            <% suggestion = notification.notifiable %>
            <% daily_agenda_items = Array(notification.metadata["daily_agenda_items"]) %>
            <p class="notae-utility-copy">
              <strong><%= suggestion.title %></strong>
              · <%= suggestion.kind == KnowledgeSuggestion::KIND_DAILY_SUMMARY ? "Daily workspace brief" : "Suggested next step" %>
            </p>
            <p class="notae-utility-copy"><%= suggestion.summary %></p>
            <% if suggestion.kind == KnowledgeSuggestion::KIND_DAILY_SUMMARY %>
              <% if daily_agenda_items.any? %>
                <ul class="notae-utility-agenda-list">
                  <% daily_agenda_items.each do |item| %>
                    <li>
                      <span class="notae-utility-agenda-time"><%= item["time"] %></span>
                      <span><%= item["title"] %></span>
                    </li>
                  <% end %>
                </ul>
                <% remaining_items = notification.metadata["daily_agenda_total_count"].to_i - daily_agenda_items.length %>
                <% if remaining_items.positive? %>
                  <p class="notae-utility-copy">+<%= remaining_items %> more events today</p>
                <% end %>
              <% elsif ActiveModel::Type::Boolean.new.cast(notification.metadata["daily_agenda_empty"]) %>
                <p class="notae-utility-copy">No events scheduled today.</p>
              <% end %>
            <% end %>
            <%= link_to "Open suggestion",
                        Notifications::DestinationResolver.new(notification: notification).call,
                        class: "notae-utility-link notae-utility-mini-link" %>
          <% elsif notification.notification_type == Notification::TYPE_WORKFLOW_FAILED && notification.notifiable.is_a?(WorkflowRun) %>
            <% workflow_run = notification.notifiable %>
            <p class="notae-utility-copy">
              <strong><%= workflow_run.workflow_kind.humanize %></strong>
              · <%= workflow_run.error_message.presence || "The workflow did not complete." %>
            </p>
            <%= link_to "Open workflow",
                        workflow_run_path(workspace_slug: @workspace.slug, id: workflow_run.id),
                        class: "notae-utility-link notae-utility-mini-link" %>
          <% elsif notification.notification_type == Notification::TYPE_CODEX_REQUEST_COMPLETED %>
            <% destination = Notifications::DestinationResolver.new(notification: notification).call %>
            <% requested_destination = notification.metadata["path"].to_s.strip %>
            <% destination_available = requested_destination.present? && destination == requested_destination %>
            <% if notification.metadata["body"].present? %>
              <p class="notae-utility-copy"><%= notification.metadata["body"] %></p>
            <% end %>
            <% unless destination_available %>
              <p class="notae-utility-meta">The original destination is not available in Notae.</p>
            <% end %>
            <%= link_to(destination_available ? "Open destination" : "Open workspace",
                        destination,
                        class: "notae-utility-link notae-utility-mini-link") %>
          <% elsif notification.notification_type == Notification::TYPE_TEST_PUSH %>
            <% destination = Notifications::DestinationResolver.new(notification: notification).call %>
            <% requested_destination = notification.metadata["path"].to_s.strip %>
            <% destination_available = requested_destination.present? && destination == requested_destination %>
            <% if notification.metadata["body"].present? %>
              <p class="notae-utility-copy"><%= notification.metadata["body"] %></p>
            <% end %>
            <% unless destination_available %>
              <p class="notae-utility-meta">The original destination is not available in Notae.</p>
            <% end %>
            <%= link_to(destination_available ? "Open destination" : "Open workspace",
                        destination,
                        class: "notae-utility-link notae-utility-mini-link") %>
          <% end %>

          <% if notification.read_at.nil? %>
            <div class="notae-utility-action-row">
              <%= button_to "Mark as read",
                            read_workspace_notification_path(workspace_slug: @workspace.slug, id: notification.id),
                            method: :patch,
                            class: "notae-chip-button notae-utility-mini-button" %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="notae-utility-empty">No notifications yet.</p>
  <% end %>
</section>
