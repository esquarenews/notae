<% content_for :title, "Search #{@workspace.name}" %>

<section class="notae-workspace-home notae-utility-page">
  <header class="notae-utility-header">
    <p class="notae-utility-workspace">
      <%= link_to @workspace.name, workspace_path(@workspace.slug), class: "notae-utility-workspace-link" %>
    </p>
    <h1 class="notae-utility-title">Search</h1>
  </header>

  <%= form_with url: workspace_search_path(workspace_slug: @workspace.slug),
                method: :get,
                class: "notae-workspace-home-search notae-utility-search-form",
                data: { controller: "search-feedback", action: "submit->search-feedback#start" } do |form| %>
    <%= form.text_field :q,
                        value: @query,
                        placeholder: "Find Notarum, blocks, rows",
                        class: "notae-auth-input notae-utility-input" %>
    <%= form.submit "Search", class: "notae-auth-submit notae-utility-submit", data: { search_feedback_target: "submit" } %>
    <span class="notae-search-feedback-status" role="status" aria-live="polite" hidden data-search-feedback-target="status">
      <span class="notae-search-feedback-spinner" aria-hidden="true"></span>
      <span>Searching...</span>
    </span>
  <% end %>

  <% if @query.present? %>
    <section class="notae-utility-section">
      <% if @ai_answer.present? %>
        <article class="notae-utility-ai-answer">
          <h2 class="notae-utility-subtitle">AI summary</h2>
          <p class="notae-utility-copy"><%= simple_format(h(@ai_answer.summary)) %></p>
          <p class="notae-utility-meta">Sources</p>
          <ol class="notae-utility-ai-sources">
            <% @ai_answer.sources.each do |source| %>
              <li>
                <%= link_to "[#{source[:index]}] #{source[:title]}", source[:url], class: "notae-utility-link" %>
                <span class="notae-utility-kind"><%= source[:kind] %></span>
              </li>
            <% end %>
          </ol>
        </article>
      <% elsif @ai_answer_notice.present? %>
        <p class="notae-utility-meta notae-utility-ai-notice"><%= @ai_answer_notice %></p>
      <% end %>

      <p class="notae-utility-meta"><%= pluralize(@search_results.length, "result") %> for "<%= @query %>"</p>
      <% if @search_results.any? %>
        <ul class="notae-workspace-home-list">
          <% @search_results.each do |result| %>
            <li class="notae-workspace-home-list-item notae-utility-result-item">
              <div class="notae-utility-result-head">
                <span class="notae-utility-kind"><%= result.kind %></span>
                <%= link_to result.title, result.url, class: "notae-utility-link" %>
              </div>
              <p class="notae-utility-copy"><%= result.excerpt %></p>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="notae-utility-empty">No results found.</p>
      <% end %>
    </section>
  <% end %>
</section>
