<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Notae" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Notae">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path %>

    <link rel="icon" href="/icon-v2.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon-192-v2.png">
    <meta name="apple-mobile-web-app-title" content="Notae">
    <meta name="theme-color" content="<%= notae_pwa_light_theme_color %>">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="<%= notae_pwa_light_theme_color %>">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="<%= notae_pwa_dark_theme_color %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <%= javascript_importmap_tags %>
  </head>

  <body class="notae-theme <%= notae_theme_body_class %>"
        data-controller="<%= [("pwa"), ("link-preferences" if user_signed_in?)].compact.join(" ") %>"
        data-pwa-authenticated-value="<%= user_signed_in? ? "true" : "false" %>"
        data-pwa-web-push-public-key-value="<%= notae_web_push_public_key %>"
        data-link-preferences-open-links-in-new-window-value="<%= user_signed_in? ? current_user.open_links_in_desktop_app? : false %>">
    <% if user_signed_in? %>
      <% embedded_shell = params[:embedded].to_s == "1" %>
      <div class="notae-shell is-layout-hydrating <%= "notae-shell-embedded" if embedded_shell %>" data-controller="<%= embedded_shell ? "shell" : "shell global-shortcuts" %>">
        <% unless embedded_shell %>
          <button type="button" class="notae-mobile-overlay" data-action="click->shell#close" aria-label="Close sidebar"></button>
          <%= render "shared/app_sidebar" %>
        <% end %>

        <div class="notae-main">
          <% unless embedded_shell %>
            <header class="notae-topbar">
              <div class="notae-topbar-leading">
                <button type="button" class="notae-mobile-toggle" data-action="shell#toggle" aria-label="Toggle sidebar">☰</button>
                <div class="notae-topbar-title">
                  <span class="notae-topbar-page-icon"><%= content_for?(:topbar_page_icon) ? yield(:topbar_page_icon) : "📄" %></span>
                  <span><%= content_for(:title) || "New page" %></span>
                  <span class="notae-topbar-privacy"><%= content_for?(:topbar_privacy) ? yield(:topbar_privacy) : "Private" %></span>
                </div>
              </div>
              <div class="notae-topbar-actions">
                <% if content_for?(:topbar_actions) %>
                  <%= yield :topbar_actions %>
                <% elsif content_for?(:topbar_meta) %>
                  <span class="notae-topbar-meta"><%= yield :topbar_meta %></span>
                <% end %>
              </div>
            </header>
          <% end %>

          <main class="notae-content notae-content-scroll <%= content_for?(:content_class) ? yield(:content_class) : "" %>">
            <%= render "shared/flash_messages" %>
            <%= yield %>
          </main>
        </div>

        <% unless embedded_shell %>
          <%= render "shared/app_mobile_tabbar" %>
          <%= render "shared/app_ai_rail_panel",
                     lazy: true,
                     workspace: @ai_rail_workspace,
                     current_page_id: @ai_rail_current_page_id %>

          <div class="notae-modal is-hidden" data-global-shortcuts-target="quickSwitcher" data-action="click->global-shortcuts#closeAll">
            <div class="notae-modal-panel" data-action="click->global-shortcuts#noop">
              <div class="notae-modal-header">
                <h2>Quick switcher</h2>
                <button type="button" class="notae-inline-icon-button" data-action="global-shortcuts#closeAll" aria-label="Close quick switcher">✕</button>
              </div>
              <input type="search"
                    class="notae-modal-input"
                    placeholder="Search Notarum..."
                    data-global-shortcuts-target="quickInput"
                    data-action="input->global-shortcuts#filterQuickResults keydown->global-shortcuts#handleQuickInputKeydown">
              <div class="notae-quick-results" data-global-shortcuts-target="quickResults"></div>
            </div>
          </div>

          <div class="notae-modal is-hidden" data-global-shortcuts-target="shortcutGuide" data-action="click->global-shortcuts#closeAll">
            <div class="notae-modal-panel notae-shortcut-panel" data-action="click->global-shortcuts#noop">
              <div class="notae-modal-header">
                <h2>Keyboard shortcuts</h2>
                <button type="button" class="notae-inline-icon-button" data-action="global-shortcuts#closeAll" aria-label="Close shortcut guide">✕</button>
              </div>
              <ul class="notae-shortcut-list">
                <li><span>Quick switcher</span><kbd>Cmd/Ctrl + K</kbd></li>
                <li><span>Shortcut guide</span><kbd>Cmd/Ctrl + /</kbd></li>
                <li><span>Close dialogs</span><kbd>Esc</kbd></li>
              </ul>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <main class="notae-auth-shell">
        <%= render "shared/flash_messages" %>
        <%= yield %>
      </main>
    <% end %>

    <%= render "shared/pwa_shell", authenticated: user_signed_in? %>
  </body>
</html>
