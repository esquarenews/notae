<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Notae" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Notae">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path %>

    <link rel="icon" href="/icon-light-v5.svg" type="image/svg+xml" media="(prefers-color-scheme: light)">
    <link rel="icon" href="/icon-dark-v5.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)">
    <link rel="icon" href="/icon-v5.png" type="image/png">
    <link rel="icon" href="/icon-v5.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-v5.png">
    <meta name="apple-mobile-web-app-title" content="Notae">
    <meta name="theme-color" content="<%= notae_pwa_light_theme_color %>">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="<%= notae_pwa_light_theme_color %>">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="<%= notae_pwa_dark_theme_color %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= tag.link rel: "preload",
                 href: asset_path("notae_sans/notae-sans-variable.woff2"),
                 as: "font",
                 type: "font/woff2",
                 crossorigin: "anonymous" %>
    <%= javascript_importmap_tags %>
</head>

  <% layout_workspace_slug = params[:workspace_slug].to_s.strip.presence %>
  <% layout_reuse_workspace_shell = same_workspace_turbo_navigation?(layout_workspace_slug) %>
  <% layout_admin_shell = controller_path.start_with?("admin/") %>
  <% layout_ai_rail_current_page_id = controller_name == "pages" && action_name == "show" ? params[:id].to_s.presence : nil %>
  <% layout_ai_rail_panel_src = if layout_workspace_slug.present?
                                  workspace_ai_assistant_panel_path(
                                    workspace_slug: layout_workspace_slug,
                                    current_page_id: layout_ai_rail_current_page_id
                                  )
                                end %>
  <% layout_ai_rail_shell_id = "notae_ai_rail_shell_#{layout_workspace_slug.to_s.gsub(/[^a-zA-Z0-9_-]/, "_")}" %>
  <% layout_analytics_workspace = layout_workspace_slug.present? ? ui_current_workspace : nil %>
  <% layout_global_analytics_enabled = user_signed_in? && ui_workspaces.any?(&:analytics_enabled?) %>
  <% layout_analytics_enabled = user_signed_in? && if layout_analytics_workspace.present?
                                                     layout_analytics_workspace.analytics_enabled?
                                                   else
                                                     layout_global_analytics_enabled
                                                   end %>
  <body class="notae-theme <%= notae_theme_body_class %>"
        data-controller="<%= [("pwa"), ("link-preferences" if user_signed_in?), ("analytics-tracker" if layout_analytics_enabled)].compact.join(" ") %>"
        data-pwa-authenticated-value="<%= user_signed_in? ? "true" : "false" %>"
        data-pwa-web-push-public-key-value="<%= notae_web_push_public_key %>"
        data-link-preferences-open-links-in-new-window-value="<%= user_signed_in? ? current_user.open_links_in_desktop_app? : false %>"
        data-analytics-tracker-endpoint-value="<%= analytics_activity_path if layout_analytics_enabled %>"
        data-analytics-tracker-workspace-slug-value="<%= layout_workspace_slug %>"
        data-analytics-tracker-surface-value="<%= analytics_surface_for_request %>"
        data-ai-rail-workspace-slug-value="<%= layout_workspace_slug %>"
        data-ai-rail-current-page-id-value="<%= layout_ai_rail_current_page_id %>"
        data-ai-rail-panel-src-value="<%= layout_ai_rail_panel_src %>">
    <% if user_signed_in? %>
      <% embedded_shell = params[:embedded].to_s == "1" %>
      <div class="notae-shell is-layout-hydrating <%= "notae-shell-embedded" if embedded_shell %> <%= "notae-shell-admin" if layout_admin_shell %>"
           style="<%= "--notae-workspace-color: #{current_workspace_color};" if current_workspace_color.present? && !embedded_shell %>"
           data-controller="<%= embedded_shell ? "shell" : "shell global-shortcuts" %>">
        <% unless embedded_shell %>
          <button type="button" class="notae-mobile-overlay" data-action="click->shell#close" aria-label="Close sidebar"></button>
          <% if layout_reuse_workspace_shell %>
            <%= render "shared/app_sidebar_shell_placeholder", workspace_slug: layout_workspace_slug %>
          <% else %>
            <%= render "shared/app_sidebar" %>
          <% end %>
        <% end %>

        <div class="notae-main">
          <% unless embedded_shell %>
            <header class="notae-topbar">
              <div class="notae-topbar-leading">
                <button type="button" class="notae-mobile-toggle" data-action="shell#toggle" aria-label="Toggle sidebar">☰</button>
                <div class="notae-topbar-title">
                  <span class="notae-topbar-page-icon"><%= content_for?(:topbar_page_icon) ? yield(:topbar_page_icon) : "📄" %></span>
                  <span><%= content_for(:title) || "New page" %></span>
                  <span class="notae-topbar-privacy"><%= content_for?(:topbar_privacy) ? yield(:topbar_privacy) : "Private" %></span>
                </div>
              </div>
              <div class="notae-topbar-actions">
                <% if content_for?(:topbar_actions) %>
                  <%= yield :topbar_actions %>
                <% elsif content_for?(:topbar_meta) %>
                  <span class="notae-topbar-meta"><%= yield :topbar_meta %></span>
                <% end %>
              </div>
            </header>
          <% end %>

          <main class="notae-content notae-content-scroll <%= content_for?(:content_class) ? yield(:content_class) : "" %>">
            <% unless content_for?(:suppress_layout_flash) %>
              <%= render "shared/flash_messages" %>
            <% end %>
            <%= yield %>
          </main>
        </div>

        <% unless embedded_shell %>
          <% if layout_reuse_workspace_shell %>
            <%= render "shared/workspace_notification_bar_placeholder", workspace_slug: layout_workspace_slug %>
          <% elsif (notification_bar = workspace_notification_bar_presenter)&.shell_enabled? %>
            <%= render "shared/workspace_notification_bar", presenter: notification_bar, workspace: notification_bar.workspace, defer_alerts: true %>
          <% end %>
          <%= render "shared/app_mobile_tabbar" %>
          <% if layout_admin_shell %>
            <%# Admin screens use dense operational tables and should not reserve AI rail space. %>
          <% elsif layout_workspace_slug.present? %>
            <% if layout_reuse_workspace_shell %>
              <%= render "shared/app_ai_rail_shell_placeholder", workspace_slug: layout_workspace_slug %>
            <% else %>
              <div id="<%= layout_ai_rail_shell_id %>"
                   data-turbo-permanent
                   data-ai-rail-workspace-slug="<%= layout_workspace_slug %>">
                <%= render "shared/app_ai_rail_panel",
                           lazy: true,
                           workspace_slug: layout_workspace_slug,
                           current_page_id: layout_ai_rail_current_page_id %>
              </div>
            <% end %>
          <% else %>
            <%= render "shared/app_ai_rail_panel",
                       lazy: true,
                       workspace_slug: layout_workspace_slug,
                       current_page_id: layout_ai_rail_current_page_id %>
          <% end %>

          <div class="notae-modal is-hidden" data-global-shortcuts-target="quickSwitcher" data-action="click->global-shortcuts#closeAll">
            <div class="notae-modal-panel" data-action="click->global-shortcuts#noop">
              <div class="notae-modal-header">
                <h2>Quick switcher</h2>
                <button type="button" class="notae-inline-icon-button" data-action="global-shortcuts#closeAll" aria-label="Close quick switcher">✕</button>
              </div>
              <input type="search"
                    class="notae-modal-input"
                    placeholder="Search Notarum..."
                    data-global-shortcuts-target="quickInput"
                    data-action="input->global-shortcuts#filterQuickResults keydown->global-shortcuts#handleQuickInputKeydown">
              <div class="notae-quick-results" data-global-shortcuts-target="quickResults"></div>
            </div>
          </div>

          <div class="notae-modal is-hidden" data-global-shortcuts-target="shortcutGuide" data-action="click->global-shortcuts#closeAll">
            <div class="notae-modal-panel notae-shortcut-panel" data-action="click->global-shortcuts#noop">
              <div class="notae-modal-header">
                <h2>Keyboard shortcuts</h2>
                <button type="button" class="notae-inline-icon-button" data-action="global-shortcuts#closeAll" aria-label="Close shortcut guide">✕</button>
              </div>
              <ul class="notae-shortcut-list">
                <li><span>Quick switcher</span><kbd>Cmd/Ctrl + K</kbd></li>
                <li><span>Shortcut guide</span><kbd>Cmd/Ctrl + /</kbd></li>
                <li><span>Close dialogs</span><kbd>Esc</kbd></li>
              </ul>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <main class="notae-auth-shell">
        <%= render "shared/flash_messages", flash_host_class: "notae-auth-flash-host" %>
        <%= yield %>
      </main>
    <% end %>

    <%= render "shared/pwa_shell", authenticated: user_signed_in? %>
  </body>
</html>
