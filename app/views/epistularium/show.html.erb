<% content_for :title, "Epistularium" %>
<% content_for :content_class, "notae-content-page" %>
<% content_for :topbar_page_icon, "✉️" %>
<% content_for :topbar_actions do %>
  <%= link_to "Manage Epistula", workspace_epistularium_settings_path(workspace_slug: @workspace.slug), class: "notae-chip-button" %>
<% end %>

<section class="notae-epistularium-shell">
  <header class="notae-utility-page-head">
    <div>
      <p class="notae-page-subtle">Read-only email feed for AI grounding</p>
      <h1 class="notae-utility-title">Epistularium</h1>
    </div>
  </header>

  <div data-controller="epistularium-poller"
       data-epistularium-poller-endpoint-value="<%= request.fullpath %>"
       data-epistularium-poller-cursor-value="<%= @epistularium_poll_cursor %>"
       >
    <%= turbo_frame_tag "epistularium_grid",
                        data: {
                          epistularium_poller_target: "sections",
                          action: "turbo:frame-load->epistularium-poller#syncEndpoint"
                        } do %>
      <%= render "grid" %>
    <% end %>
  </div>
</section>
