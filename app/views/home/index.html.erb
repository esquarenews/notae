<% content_for :title, "Notae" %>

<% if user_signed_in? %>
  <section class="notae-home-page">
    <header class="notae-auth-brand notae-home-brand">
      <%= image_tag "/icon.svg", alt: "Notae icon", class: "notae-auth-brand-icon" %>
      <div>
        <h1>Notae</h1>
        <p>Welcome back, <%= current_user.email %>.</p>
      </div>
    </header>

    <section class="notae-auth-card notae-home-card">
      <div class="notae-home-card-head">
        <h2>Your workspaces</h2>
        <%= link_to "New workspace", new_workspace_path, class: "notae-chip-button" %>
      </div>

      <% if @workspaces.any? %>
        <div class="notae-home-workspace-list">
          <% @workspaces.each do |workspace| %>
            <%= link_to workspace_path(workspace.slug), class: "notae-home-workspace-item" do %>
              <strong><%= workspace.name %></strong>
              <span><%= workspace.slug %></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="notae-page-subtle">No workspaces yet.</p>
      <% end %>
    </section>
  </section>
<% else %>
  <section class="notae-home-page">
    <header class="notae-auth-brand notae-home-brand">
      <%= image_tag "/icon.svg", alt: "Notae icon", class: "notae-auth-brand-icon" %>
      <div>
        <h1>Notae</h1>
        <p>Sign in to continue to your workspace.</p>
      </div>
    </header>
    <section class="notae-auth-card notae-home-card">
      <p class="notae-page-subtle">Capture ideas, keep docs nested, and manage tables in one calm workspace.</p>
      <%= link_to "Sign in", new_user_session_path, class: "notae-chip-button notae-auth-submit" %>
    </section>
  </section>
<% end %>
