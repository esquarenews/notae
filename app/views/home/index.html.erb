<% content_for :title, "Notae" %>

<section class="notae-stack-lg">
  <header class="notae-page-header">
    <p class="notae-page-subtle">Workspace starter</p>
    <h1>Welcome to Notae</h1>
    <p class="notae-page-subtle">Capture ideas, keep docs nested, and manage tables in one calm workspace.</p>
  </header>

  <% if user_signed_in? %>
    <section class="notae-surface">
      <div class="mb-4 flex items-center justify-between gap-3">
        <h2 class="text-xl font-semibold">Your workspaces</h2>
        <%= link_to "New Workspace", new_workspace_path, class: "notae-chip-button" %>
      </div>
      <p class="mb-3 text-sm text-stone-600">Signed in as <%= current_user.email %></p>

      <% if @workspaces.any? %>
        <div class="notae-card-grid">
          <% @workspaces.each do |workspace| %>
            <%= link_to workspace_path(workspace.slug), class: "notae-card" do %>
              <strong><%= workspace.name %></strong>
              <span class="text-xs text-stone-500"><%= workspace.slug %></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-stone-500">No workspaces yet.</p>
      <% end %>
    </section>
  <% else %>
    <section class="notae-surface">
      <p class="mb-3 text-stone-700">Sign in to access your workspace.</p>
      <%= link_to "Sign in", new_user_session_path, class: "notae-chip-button" %>
    </section>
  <% end %>
</section>
