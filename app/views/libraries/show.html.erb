<% content_for :title, "Library" %>
<% content_for :topbar_page_icon do %>
  <%= notae_icon_svg(:library, css_class: "notae-topbar-page-icon-glyph") %>
<% end %>
<% content_for :topbar_privacy, "Workspace" %>
<% content_for :content_class, "notae-content-wide" %>

<% query = request.query_parameters.to_h.symbolize_keys %>
<% tab_query = query.except(:page) %>
<% pagination_query = query.except(:page) %>
<% view_query = query.except(:page) %>
<% visible_columns = @visible_columns %>
<% shown_columns = @column_options.select { |key, _label| visible_columns.include?(key) } %>
<% hidden_columns = @column_options.reject { |key, _label| visible_columns.include?(key) } %>

<section class="notae-library-shell">
  <header class="notae-library-header">
    <h1 class="notae-tool-page-title">Library</h1>
    <% if policy(Page.new(workspace: @workspace)).create? %>
      <%= form_with model: Page.new, url: pages_path(workspace_slug: @workspace.slug), class: "notae-library-new-page-form" do |form| %>
        <%= form.hidden_field :title, value: "New Nota" %>
        <%= form.submit "New Nota", class: "notae-chip-button" %>
      <% end %>
    <% end %>
  </header>

  <nav class="notae-library-tabs">
    <% {
      "all_documents" => "All documents",
      "recents" => "Recents",
      "favorites" => "Favorites",
      "shared" => "Shared",
      "private" => "Private"
    }.each do |tab_value, label| %>
      <% tab_params = tab_query.merge(tab: tab_value) %>
      <%= link_to label,
                  workspace_library_path(tab_params.merge(workspace_slug: @workspace.slug)),
                  class: [ "notae-library-tab", ("active" if @tab == tab_value) ].compact.join(" ") %>
    <% end %>
  </nav>

  <%= form_with url: workspace_library_path(workspace_slug: @workspace.slug),
                method: :get,
                class: "notae-library-toolbar" do %>
	    <%= hidden_field_tag :tab, @tab %>
	    <%= hidden_field_tag :view_mode, @view_mode %>

	    <div class="notae-library-search-wrap">
      <span class="notae-library-search-icon" aria-hidden="true">⌕</span>
      <%= text_field_tag :q, @search_query, placeholder: "Type to search...", class: "notae-library-search-input" %>
    </div>

    <div class="notae-library-workspace-filter">
      <%= label_tag :workspace_filter, "Workspace", class: "notae-library-inline-label" %>
      <%= select_tag :workspace_filter,
                     options_for_select(@workspace_filter_options, @workspace_filter),
                     class: "notae-options-input",
                     onchange: "this.form.requestSubmit()" %>
    </div>

	    <div class="notae-library-toolbar-actions">
	      <nav class="notae-library-view-toggle" aria-label="Library view">
	        <% { "list" => "List", "thumbnails" => "Thumbnails" }.each do |view_mode, label| %>
	          <%= link_to label,
	                      workspace_library_path(view_query.merge(workspace_slug: @workspace.slug, view_mode: view_mode)),
	                      class: [ "notae-library-view-button", ("active" if @view_mode == view_mode) ].compact.join(" ") %>
	        <% end %>
	      </nav>

	      <details class="notae-library-popover">
	        <summary class="notae-chip-button notae-library-action-button">Filters</summary>
        <div class="notae-library-popover-panel">
          <p class="notae-library-popover-title">Filter by</p>
          <%= select_tag :source,
                         options_for_select([
                           ["All sources", "all"],
                           ["Notarum", "page"],
                           ["Meetings", "meeting"],
                           ["Grids", "database"]
                         ], @source_filter),
                         class: "notae-options-input" %>
          <%= select_tag :visibility,
                         options_for_select([
                           ["All visibility", "all"],
                           ["Shared", "shared"],
                           ["Private", "private"]
                         ], @visibility_filter),
                         class: "notae-options-input" %>
          <%= select_tag :sort,
                         options_for_select([
                           ["Last edited (newest first)", "last_edited_desc"],
                           ["Last edited (oldest first)", "last_edited_asc"],
                           ["Created (newest first)", "created_desc"],
                           ["Created (oldest first)", "created_asc"],
                           ["Nota name (A-Z)", "page_name_asc"],
                           ["Nota name (Z-A)", "page_name_desc"]
                         ], @sort),
                         class: "notae-options-input" %>
          <%= select_tag :filter_property,
                         options_for_select([["Property filter", ""]] + @column_options.map { |key, label| [label, key] }, @property_filter),
                         class: "notae-options-input" %>
          <%= text_field_tag :filter_value, @property_filter_value, placeholder: "Property value...", class: "notae-options-input" %>
          <label class="notae-options-checkbox">
            <%= check_box_tag :favorites_only, "1", @favorites_only %>
            <span>Favorites only</span>
          </label>
          <p class="notae-library-advanced-filter">+ Add advanced filter</p>
        </div>
      </details>

	      <% if @view_mode == "list" %>
	        <details class="notae-library-popover">
	          <summary class="notae-chip-button notae-library-action-button">Columns</summary>
	          <div class="notae-library-popover-panel">
	            <p class="notae-library-popover-title">Property visibility</p>
	            <input type="search" class="notae-options-input" placeholder="Search for a property..." disabled>
	            <%= hidden_field_tag "visible_columns[]", "page_name" %>
	            <div class="notae-library-property-group">
	              <p>Shown in table</p>
	              <% shown_columns.each do |key, label| %>
	                <label class="notae-options-checkbox">
	                  <%= check_box_tag "visible_columns[]", key, true, disabled: key == "page_name" %>
	                  <span><%= label %></span>
	                </label>
	              <% end %>
	            </div>
	            <div class="notae-library-property-group">
	              <p>Hidden in table</p>
	              <% hidden_columns.each do |key, label| %>
	                <label class="notae-options-checkbox">
	                  <%= check_box_tag "visible_columns[]", key, false %>
	                  <span><%= label %></span>
	                </label>
	              <% end %>
	            </div>
	          </div>
	        </details>
	      <% else %>
	        <% visible_columns.each do |column| %>
	          <%= hidden_field_tag "visible_columns[]", column %>
	        <% end %>
	      <% end %>

	      <%= submit_tag "Apply", class: "notae-chip-button" %>
	    </div>
	  <% end %>

	  <% if @view_mode == "thumbnails" %>
	    <%= render "thumbnail_view", library_rows: @library_rows %>
	  <% else %>
	    <%= render "table_view", library_rows: @library_rows, visible_columns: visible_columns %>
	  <% end %>

  <section class="notae-library-pagination" aria-label="Library pagination">
    <p class="notae-library-pagination-meta">Showing <%= @page_start %>-<%= @page_end %> of <%= @total_rows %></p>
    <div class="notae-library-pagination-actions">
      <% if @current_page > 1 %>
        <%= link_to "Previous",
                    workspace_library_path(pagination_query.merge(workspace_slug: @workspace.slug, page: @current_page - 1)),
                    class: "notae-chip-button notae-library-pagination-button" %>
      <% else %>
        <span class="notae-chip-button notae-library-pagination-button is-disabled" aria-disabled="true">Previous</span>
      <% end %>
      <span class="notae-library-pagination-page">Page <%= @current_page %> of <%= @total_pages %></span>
      <% if @current_page < @total_pages %>
        <%= link_to "Next",
                    workspace_library_path(pagination_query.merge(workspace_slug: @workspace.slug, page: @current_page + 1)),
                    class: "notae-chip-button notae-library-pagination-button" %>
      <% else %>
        <span class="notae-chip-button notae-library-pagination-button is-disabled" aria-disabled="true">Next</span>
      <% end %>
    </div>
  </section>
</section>
