<section class="notae-library-table-wrap">
  <table class="notae-library-table">
    <thead>
      <tr>
        <% if visible_columns.include?("page_name") %>
          <th class="notae-library-col notae-library-col-page-name">Nota name</th>
        <% end %>
        <% if visible_columns.include?("workspace") %>
          <th class="notae-library-col notae-library-col-workspace">Workspace</th>
        <% end %>
        <% if visible_columns.include?("created_by") %>
          <th class="notae-library-col notae-library-col-created-by">Created by</th>
        <% end %>
        <% if visible_columns.include?("source") %>
          <th class="notae-library-col notae-library-col-source">Source</th>
        <% end %>
        <% if visible_columns.include?("created_time") %>
          <th class="notae-library-col notae-library-col-created-time">Created time</th>
        <% end %>
        <% if visible_columns.include?("last_edited_by") %>
          <th class="notae-library-col notae-library-col-last-edited-by">Last edited by</th>
        <% end %>
        <% if visible_columns.include?("last_edited_time") %>
          <th class="notae-library-col notae-library-col-last-edited-time">Last edited time</th>
        <% end %>
        <% if visible_columns.include?("last_visited_time") %>
          <th class="notae-library-col notae-library-col-last-visited-time">Last visited time</th>
        <% end %>
      </tr>
    </thead>
    <tbody>
      <% if library_rows.any? %>
        <% library_rows.each do |row| %>
          <tr class="notae-library-row">
            <% if visible_columns.include?("page_name") %>
              <td class="notae-library-col notae-library-col-page-name">
                <%= link_to row[:path], class: "notae-library-name-link" do %>
                  <% if row[:kind] == "database" %>
                    <span class="notae-library-row-title">
                      <%= render_notae_icon(row[:icon], workspace: row[:workspace], fallback: "🗃️", css_class: "notae-inline-linked-icon", label: row[:title]) %>
                      <%= row[:title] %>
                    </span>
                  <% else %>
                    <span class="notae-library-row-icon">
                      <%= render_notae_icon(row[:icon], workspace: row[:workspace], fallback: "📄", css_class: "notae-inline-linked-icon", label: row[:title]) %>
                    </span>
                    <span class="notae-library-row-title"><%= row[:title] %></span>
                  <% end %>
                  <% if row[:favorited] %>
                    <span class="notae-library-row-favorite" aria-label="Favorited">★</span>
                  <% end %>
                <% end %>
              </td>
            <% end %>
            <% if visible_columns.include?("workspace") %>
              <td class="notae-library-col notae-library-col-workspace"><%= row[:workspace_name] %></td>
            <% end %>
            <% if visible_columns.include?("created_by") %>
              <td class="notae-library-col notae-library-col-created-by"><%= row[:created_by] %></td>
            <% end %>
            <% if visible_columns.include?("source") %>
              <td class="notae-library-col notae-library-col-source">
                <span class="notae-library-source-pill is-<%= row[:visibility] %>"><%= row[:visibility].titleize %></span>
                <span class="notae-library-source-label"><%= row[:document_type_label] %></span>
              </td>
            <% end %>
            <% if visible_columns.include?("created_time") %>
              <td class="notae-library-col notae-library-col-created-time"><%= row[:created_time].present? ? time_ago_in_words(row[:created_time]) + " ago" : "—" %></td>
            <% end %>
            <% if visible_columns.include?("last_edited_by") %>
              <td class="notae-library-col notae-library-col-last-edited-by"><%= row[:last_edited_by] %></td>
            <% end %>
            <% if visible_columns.include?("last_edited_time") %>
              <td class="notae-library-col notae-library-col-last-edited-time"><%= row[:last_edited_time].present? ? time_ago_in_words(row[:last_edited_time]) + " ago" : "—" %></td>
            <% end %>
            <% if visible_columns.include?("last_visited_time") %>
              <td class="notae-library-col notae-library-col-last-visited-time"><%= row[:last_visited_time].present? ? time_ago_in_words(row[:last_visited_time]) + " ago" : "—" %></td>
            <% end %>
          </tr>
        <% end %>
      <% else %>
        <tr>
          <td class="notae-library-empty" colspan="<%= visible_columns.count %>">No results.</td>
        </tr>
      <% end %>
    </tbody>
  </table>
</section>
