<div class="notae-actions-mobile-panes">
  <div class="notae-actions-mobile-pane is-nav">
    <div class="notae-actions-mobile-nav" data-actions-menu-target="nav" hidden>
      <p class="notae-actions-mobile-nav-title">Actions</p>
      <div class="notae-actions-mobile-nav-list" data-actions-menu-target="navList"></div>
    </div>
  </div>

  <div class="notae-actions-mobile-pane is-detail">
    <div class="notae-actions-mobile-detail-head" data-actions-menu-target="detailHead" hidden>
      <button type="button"
              class="notae-chip-button notae-actions-mobile-back"
              data-action="actions-menu#showList">
        ← Back
      </button>
      <p class="notae-actions-mobile-detail-title" data-actions-menu-target="detailTitle">Actions</p>
    </div>

    <input type="search"
           class="notae-options-input notae-actions-search"
           placeholder="Search actions..."
           autocomplete="off"
           data-actions-menu-target="search"
           data-action="input->shell#filterActionsMenu">

    <textarea class="notae-actions-copy-buffer" data-shell-page-content><%= page_plain_text.presence || page.title %></textarea>

    <section class="notae-actions-section is-lock-controls"
             data-actions-menu-target="section"
             data-actions-menu-label="Access">
      <% if page.locked? %>
        <p class="notae-actions-locked-note">Page is locked. Other actions are unavailable.</p>
      <% end %>
      <div class="notae-actions-row <%= "is-disabled" unless can_manage_permissions %>"
           data-shell-action-item
           data-shell-action-terms="lock page unlock">
        <% if can_manage_permissions %>
          <%= form_with model: page,
                        url: page_path(workspace_slug: workspace.slug, id: page.id, actions_menu: "open"),
                        method: :patch,
                        class: "notae-actions-inline-form" do |form| %>
            <%= form.hidden_field :locked, value: (!page.locked?).to_s %>
            <button type="submit" class="notae-actions-row-button">
              <span class="notae-actions-row-icon"><%= page.locked? ? "🔓" : "🔒" %></span>
              <span class="notae-actions-row-label"><%= page.locked? ? "Unlock page" : "Lock page" %></span>
              <span class="notae-actions-switch <%= "is-on" if page.locked? %>"><span></span></span>
            </button>
          <% end %>
        <% else %>
          <button type="button" class="notae-actions-row-button" disabled>
            <span class="notae-actions-row-icon"><%= page.locked? ? "🔓" : "🔒" %></span>
            <span class="notae-actions-row-label"><%= page.locked? ? "Unlock page" : "Lock page" %></span>
            <span class="notae-actions-switch <%= "is-on" if page.locked? %>"><span></span></span>
          </button>
        <% end %>
      </div>
    </section>

    <section class="notae-actions-section"
             data-shell-actions-section
             data-actions-menu-target="section"
             data-actions-menu-label="Style">
      <div class="notae-actions-font-grid">
        <% [
          [ "default", "Default", "Ag" ],
          [ "serif", "Serif", "Ag" ],
          [ "mono", "Mono", "Ag" ]
        ].each do |key, label, preview| %>
          <%= form_with model: page,
                        url: page_path(workspace_slug: workspace.slug, id: page.id, actions_menu: "open"),
                        method: :patch,
                        class: "notae-actions-inline-form",
                        data: { shell_action_item: true, shell_action_terms: "font #{label.downcase}" } do |form| %>
            <%= form.hidden_field :font_style, value: key %>
            <button type="submit"
                    class="notae-actions-font-button <%= "is-active" if page.font_style == key %>"
                    aria-pressed="<%= page.font_style == key %>">
              <span class="notae-actions-font-preview"><%= preview %></span>
              <span class="notae-actions-font-label"><%= label %></span>
            </button>
          <% end %>
        <% end %>
      </div>
    </section>

    <section class="notae-actions-section"
             data-shell-actions-section
             data-actions-menu-target="section"
             data-actions-menu-label="Page actions">
      <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="copy link">
        <button type="button" class="notae-actions-row-button" data-action="click->shell#copyPageLink">
          <span class="notae-actions-row-icon">🔗</span>
          <span class="notae-actions-row-label">Copy link</span>
          <span class="notae-actions-row-meta">⌘⇧L</span>
        </button>
      </div>

      <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="copy page contents text">
        <button type="button" class="notae-actions-row-button" data-action="click->shell#copyPageContents">
          <span class="notae-actions-row-icon">📋</span>
          <span class="notae-actions-row-label">Copy page contents</span>
        </button>
      </div>

      <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="duplicate page">
        <%= form_with url: duplicate_page_path(workspace_slug: workspace.slug, id: page.id, actions_menu: "open"),
                      method: :post,
                      class: "notae-actions-inline-form" do %>
          <button type="submit" class="notae-actions-row-button">
            <span class="notae-actions-row-icon">⧉</span>
            <span class="notae-actions-row-label">Duplicate</span>
            <span class="notae-actions-row-meta">⌘D</span>
          </button>
        <% end %>
      </div>

      <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="move page parent">
        <% if move_target_pages.any? %>
          <%= form_with model: page,
                        url: page_path(workspace_slug: workspace.slug, id: page.id, actions_menu: "open"),
                        method: :patch,
                        class: "notae-actions-move-form" do |form| %>
            <%= form.select :parent_page_id,
                            options_for_select([ [ "Move to...", "" ] ] + move_target_pages.map { |candidate| [ candidate.title, candidate.id ] }, page.parent_page_id),
                            {},
                            class: "notae-options-input notae-actions-move-select" %>
            <%= form.submit "Move", class: "notae-chip-button" %>
          <% end %>
        <% else %>
          <button type="button" class="notae-actions-row-button" disabled>
            <span class="notae-actions-row-icon">↗</span>
            <span class="notae-actions-row-label">Move to</span>
            <span class="notae-actions-row-meta">No Notarum</span>
          </button>
        <% end %>
      </div>

      <div class="notae-actions-row <%= "is-disabled" unless can_archive_page %>"
           data-shell-action-item
           data-shell-action-terms="trash archive delete">
        <% if can_archive_page %>
          <%= button_to archive_page_path(workspace_slug: workspace.slug, id: page.id),
                        method: :patch,
                        class: "notae-actions-row-button is-danger" do %>
            <span class="notae-actions-row-icon">🗑</span>
            <span class="notae-actions-row-label">Move to Trash</span>
          <% end %>
        <% else %>
          <button type="button" class="notae-actions-row-button is-danger" disabled>
            <span class="notae-actions-row-icon">🗑</span>
            <span class="notae-actions-row-label">Move to Trash</span>
          </button>
        <% end %>
      </div>
    </section>

    <section class="notae-actions-section"
             data-shell-actions-section
             data-actions-menu-target="section"
             data-actions-menu-label="View and editing">
      <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="small text">
        <%= form_with model: page,
                      url: page_path(workspace_slug: workspace.slug, id: page.id, actions_menu: "open"),
                      method: :patch,
                      class: "notae-actions-inline-form",
                      data: {
                        controller: "page-appearance-toggle",
                        action: "submit->page-appearance-toggle#submit",
                        page_appearance_toggle_class_value: "is-small-text"
                      } do |form| %>
          <%= form.hidden_field :small_text, value: (!page.small_text?).to_s %>
          <button type="submit" class="notae-actions-row-button">
            <span class="notae-actions-row-icon">A</span>
            <span class="notae-actions-row-label">Small text</span>
            <span class="notae-actions-switch <%= "is-on" if page.small_text? %>"><span></span></span>
          </button>
        <% end %>
      </div>

      <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="full width">
        <%= form_with model: page,
                      url: page_path(workspace_slug: workspace.slug, id: page.id, actions_menu: "open"),
                      method: :patch,
                      class: "notae-actions-inline-form",
                      data: {
                        controller: "page-appearance-toggle",
                        action: "submit->page-appearance-toggle#submit",
                        page_appearance_toggle_class_value: "is-full-width"
                      } do |form| %>
          <%= form.hidden_field :full_width, value: (!page.full_width?).to_s %>
          <button type="submit" class="notae-actions-row-button">
            <span class="notae-actions-row-icon">↔</span>
            <span class="notae-actions-row-label">Full width</span>
            <span class="notae-actions-switch <%= "is-on" if page.full_width? %>"><span></span></span>
          </button>
        <% end %>
      </div>

      <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="hide blocks reader mode">
        <%= form_with model: page,
                      url: page_path(workspace_slug: workspace.slug, id: page.id, actions_menu: "open"),
                      method: :patch,
                      class: "notae-actions-inline-form",
                      data: {
                        controller: "page-appearance-toggle",
                        action: "submit->page-appearance-toggle#submit",
                        page_appearance_toggle_class_value: "is-reader-mode"
                      } do |form| %>
          <%= form.hidden_field :remove_blocks, value: (!page.remove_blocks?).to_s %>
          <button type="submit" class="notae-actions-row-button">
            <span class="notae-actions-row-icon">◫</span>
            <span class="notae-actions-row-label">Hide blocks</span>
            <span class="notae-actions-switch <%= "is-on" if page.remove_blocks? || page.locked? %>"><span></span></span>
          </button>
        <% end %>
      </div>

      <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="suggest edits">
        <%= form_with model: page,
                      url: page_path(workspace_slug: workspace.slug, id: page.id, actions_menu: "open"),
                      method: :patch,
                      class: "notae-actions-inline-form" do |form| %>
          <%= form.hidden_field :suggest_edits, value: (!page.suggest_edits?).to_s %>
          <button type="submit" class="notae-actions-row-button">
            <span class="notae-actions-row-icon">✎</span>
            <span class="notae-actions-row-label">Suggest edits</span>
            <span class="notae-actions-switch <%= "is-on" if page.suggest_edits? %>"><span></span></span>
          </button>
        <% end %>
      </div>

      <div class="notae-actions-row is-disabled" data-shell-action-item data-shell-action-terms="translate">
        <button type="button" class="notae-actions-row-button" disabled>
          <span class="notae-actions-row-icon">A↔</span>
          <span class="notae-actions-row-label">Translate</span>
          <span class="notae-actions-row-meta">Needs provider setup</span>
        </button>
      </div>

      <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="undo">
        <button type="button" class="notae-actions-row-button" data-action="click->shell#undo">
          <span class="notae-actions-row-icon">↶</span>
          <span class="notae-actions-row-label">Undo</span>
          <span class="notae-actions-row-meta">⌘Z</span>
        </button>
      </div>
    </section>

    <section class="notae-actions-section"
             data-shell-actions-section
             data-actions-menu-target="section"
             data-actions-menu-label="Advanced">
      <div class="notae-actions-row <%= "is-disabled" unless can_import_page %>" data-shell-action-item data-shell-action-terms="import files upload media text">
        <button type="button"
                class="notae-actions-row-button"
                <%= "disabled" unless can_import_page %>
                data-action="click->page-import#open">
          <span class="notae-actions-row-icon">↓</span>
          <span class="notae-actions-row-label">Import</span>
          <span class="notae-actions-row-meta">into Nota</span>
        </button>
      </div>

      <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="export markdown block clipboard">
        <button type="button"
                class="notae-actions-row-button"
                data-block-markdown-url-template="<%= export_markdown_page_block_path(workspace_slug: workspace.slug, page_id: page.id, id: "__BLOCK_ID__") %>"
                data-action="click->shell#copyCurrentBlockMarkdown">
          <span class="notae-actions-row-icon">↑</span>
          <span class="notae-actions-row-label">Export</span>
          <span class="notae-actions-row-meta">Current block as MD</span>
        </button>
      </div>

      <details class="notae-actions-submenu" data-shell-action-item data-shell-action-terms="updates analytics audit">
        <summary class="notae-actions-row-button">
          <span class="notae-actions-row-icon">◷</span>
          <span class="notae-actions-row-label">Updates &amp; analytics</span>
        </summary>
        <ul class="notae-actions-version-list">
          <% if recent_audit_events.any? %>
            <% recent_audit_events.each do |audit_event| %>
              <li><strong><%= audit_event.action.humanize %></strong> · <%= time_ago_in_words(audit_event.created_at) %> ago</li>
            <% end %>
          <% else %>
            <li>No audit events yet.</li>
          <% end %>
        </ul>
      </details>

      <details class="notae-actions-submenu" data-shell-action-item data-shell-action-terms="version history">
        <summary class="notae-actions-row-button">
          <span class="notae-actions-row-icon">🕘</span>
          <span class="notae-actions-row-label">Version history</span>
        </summary>
        <ul class="notae-actions-version-list">
          <% if page_versions.any? %>
            <% page_versions.each do |version| %>
              <li><strong><%= version.event.to_s.titleize %></strong> · <%= time_ago_in_words(version.created_at) %> ago</li>
            <% end %>
          <% else %>
            <li>No previous versions yet.</li>
          <% end %>
        </ul>
      </details>

      <div class="notae-actions-row" data-shell-action-item data-shell-action-terms="notify comments">
        <a class="notae-actions-row-link" href="<%= workspace_notifications_path(workspace_slug: workspace.slug) %>">
          <span class="notae-actions-row-icon">🔔</span>
          <span class="notae-actions-row-label">Notify me</span>
          <span class="notae-actions-row-meta">Comments</span>
        </a>
      </div>

      <div class="notae-actions-row is-disabled" data-shell-action-item data-shell-action-terms="connections">
        <button type="button" class="notae-actions-row-button" disabled>
          <span class="notae-actions-row-icon">⌘</span>
          <span class="notae-actions-row-label">Connections</span>
          <span class="notae-actions-row-meta">None</span>
        </button>
      </div>
    </section>

    <footer class="notae-actions-footer" data-actions-menu-target="footer">
      <p>Word count: <%= page_word_count %> words</p>
      <p>Last edited by <%= page.created_by.email %></p>
      <p><%= page.updated_at.strftime("%b %-d at %-I:%M %p") %></p>
    </footer>
  </div>
</div>

<%= render "pages/import_modal",
           workspace: workspace,
           page: page,
           current_path: current_path %>
