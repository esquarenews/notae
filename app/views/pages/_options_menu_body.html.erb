<div class="notae-options-mobile-panes">
  <div class="notae-options-mobile-pane is-nav">
    <div class="notae-options-mobile-nav" data-options-menu-target="nav" hidden>
      <p class="notae-options-mobile-nav-title">Options</p>
      <div class="notae-options-mobile-nav-list" data-options-menu-target="navList"></div>
    </div>
  </div>

  <div class="notae-options-mobile-pane is-detail">
    <div class="notae-options-mobile-detail-head" data-options-menu-target="detailHead" hidden>
      <button type="button"
              class="notae-chip-button notae-options-mobile-back"
              data-action="options-menu#showList">
        ← Back
      </button>
      <p class="notae-options-mobile-detail-title" data-options-menu-target="detailTitle">Options</p>
    </div>

    <% if can_manage_permissions %>
      <section class="notae-options-section"
               data-options-menu-target="section"
               data-options-menu-label="Permissions">
        <h3>Permissions</h3>
        <%= form_with model: page,
                      url: permissions_page_path(workspace_slug: workspace.slug, id: page.id, options_menu: "open"),
                      method: :patch,
                      class: "notae-options-form" do |form| %>
          <div class="notae-options-field">
            <%= form.label :permission_mode, "Visibility" %>
            <%= form.select :permission_mode,
                            [["Shared to workspace", "shared_to_workspace"], ["Private", "private_page"], ["Specific users", "specific_users"]],
                            {},
                            class: "notae-options-input" %>
          </div>
          <div class="notae-options-field">
            <label>Specific users</label>
            <div class="notae-options-user-list">
              <% memberships.each do |membership| %>
                <label class="notae-options-checkbox">
                  <%= check_box_tag "page[shared_user_ids][]",
                                    membership.user_id,
                                    shared_user_ids.include?(membership.user_id) %>
                  <span><%= membership.user.email %></span>
                </label>
              <% end %>
            </div>
          </div>
          <%= form.submit "Save", class: "notae-chip-button" %>
        <% end %>
      </section>

      <section class="notae-options-section"
               data-options-menu-target="section"
               data-options-menu-label="Public share links">
        <h3>Public share links</h3>
        <%= form_with model: ShareLink.new,
                      url: page_share_links_path(workspace_slug: workspace.slug, page_id: page.id, options_menu: "open"),
                      class: "notae-options-form-inline" do |form| %>
          <%= form.datetime_local_field :expires_at, class: "notae-options-input" %>
          <%= form.submit "Create link", class: "notae-chip-button" %>
        <% end %>
        <% active_share_links = share_links.select(&:active?) %>
        <% if active_share_links.any? %>
          <ul class="notae-options-list">
            <% active_share_links.each do |share_link| %>
              <li class="notae-options-list-item">
                <%= link_to public_share_url(token: share_link.token),
                            public_share_path(token: share_link.token),
                            target: "_blank",
                            rel: "noopener" %>
                <%= button_to "Revoke",
                              page_share_link_path(workspace_slug: workspace.slug, page_id: page.id, id: share_link.id, options_menu: "open"),
                              method: :delete,
                              class: "notae-chip-button" %>
              </li>
            <% end %>
          </ul>
        <% else %>
          <p class="notae-options-empty">No active links.</p>
        <% end %>
      </section>
    <% end %>

    <section class="notae-options-section"
             data-options-menu-target="section"
             data-options-menu-label="Export">
      <h3>Export</h3>
      <div class="notae-options-inline-actions">
        <%= link_to "Markdown",
                    export_markdown_page_path(workspace_slug: workspace.slug, id: page.id, options_menu: "open"),
                    class: "notae-chip-button" %>
        <%= link_to "PDF",
                    export_pdf_page_path(workspace_slug: workspace.slug, id: page.id, options_menu: "open"),
                    class: "notae-chip-button" %>
      </div>
      <% if page_exports.any? %>
        <ul class="notae-options-list">
          <% page_exports.each do |page_export| %>
            <li class="notae-options-list-item">
              <span><%= page_export.created_at.strftime("%b %d %H:%M") %></span>
              <% if page_export.downloadable? %>
                <%= link_to "Download",
                            workspace_export_path(workspace_slug: workspace.slug, token: page_export.token),
                            class: "notae-chip-button" %>
              <% elsif page_export.pending? %>
                <span class="notae-options-muted">Preparing...</span>
              <% elsif page_export.failed? %>
                <span class="notae-options-muted">Failed</span>
              <% else %>
                <span class="notae-options-muted">Unavailable</span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="notae-options-empty">No exports yet.</p>
      <% end %>
    </section>

    <section class="notae-options-section"
             data-options-menu-target="section"
             data-options-menu-label="Templates">
      <h3>Templates</h3>
      <%= form_with model: new_page_template,
                    url: save_as_template_page_path(workspace_slug: workspace.slug, id: page.id, options_menu: "open"),
                    class: "notae-options-form-inline" do |form| %>
        <%= form.text_field :name, value: page.title, required: true, class: "notae-options-input", placeholder: "Template name" %>
        <%= form.submit "Save", class: "notae-chip-button" %>
      <% end %>
      <% if page_templates.any? %>
        <ul class="notae-options-list">
          <% page_templates.each do |template| %>
            <li class="notae-options-list-item">
              <span><%= template.name %></span>
              <%= form_with url: instantiate_page_template_path(workspace_slug: workspace.slug, id: template.id, options_menu: "open"),
                            method: :post,
                            class: "notae-options-form-inline" do %>
                <%= text_field_tag "page_template[title]", "", placeholder: "New title", class: "notae-options-input" %>
                <%= submit_tag "Use", class: "notae-chip-button" %>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="notae-options-empty">No templates saved.</p>
      <% end %>
    </section>

    <% if archived_blocks.any? %>
      <section class="notae-options-section"
               data-options-menu-target="section"
               data-options-menu-label="Archived blocks">
        <h3>Archived blocks</h3>
        <ul class="notae-options-list">
          <% archived_blocks.each do |archived_block| %>
            <li class="notae-options-list-item">
              <span><%= archived_block.block_type.humanize %></span>
              <%= button_to "Restore",
                            restore_page_block_path(workspace_slug: workspace.slug, page_id: page.id, id: archived_block.id, options_menu: "open"),
                            method: :patch,
                            class: "notae-chip-button" %>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</div>
