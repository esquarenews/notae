<details id="page-comments-menu"
         class="notae-comments-menu"
         data-controller="lazy-panel"
         data-shell-comments-menu
         data-lazy-panel-url-value="<%= panel_page_path(workspace_slug: workspace.slug, id: page.id, panel: "comments") %>"
         data-lazy-panel-loading-text-value="Loading comments…"
         data-lazy-panel-error-text-value="Could not load comments."
         data-lazy-panel-focus-selector-value="input[name='comment[body]']">
  <summary class="notae-comments-trigger" aria-label="Page comments">💬</summary>
  <div class="notae-comments-panel" data-lazy-panel-target="container"></div>
</details>
