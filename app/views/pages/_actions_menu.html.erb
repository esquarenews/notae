<details id="page-actions-menu"
         class="notae-actions-menu"
         data-controller="actions-menu page-import lazy-panel"
         data-action="lazy-panel:loaded->actions-menu#refresh"
         data-shell-target="actionsMenu"
         data-shell-actions-menu
         data-page-import-default-block-id-value="<%= local_assigns[:default_import_insert_after_id] %>"
         data-lazy-panel-url-value="<%= panel_page_path(workspace_slug: workspace.slug, id: page.id, panel: "actions", current_path: local_assigns.fetch(:current_path, request.fullpath)) %>"
         data-lazy-panel-loading-text-value="Loading actions…"
         data-lazy-panel-error-text-value="Could not load actions."
         <%= "open" if params[:actions_menu].to_s == "open" %>>
  <summary class="notae-chip-button notae-actions-trigger" aria-label="Actions">
    <span class="notae-actions-trigger-icon" aria-hidden="true">⚡</span>
    <span class="notae-actions-trigger-label">Actions</span>
  </summary>

  <div class="notae-actions-panel <%= "is-page-locked" if page.locked? %>"
       data-shell-actions-panel
       data-actions-menu-target="panel"
       data-lazy-panel-target="container"></div>
</details>
