<% content_for :title, @page.title.presence || "New page" %>
<% content_for :topbar_page_icon, @page.icon.presence || "📄" %>
<% content_for :topbar_privacy, @page.permission_mode.humanize %>
<% content_for :content_class, "notae-content-page" %>
<% content_for :topbar_actions do %>
  <span class="notae-topbar-meta">Edited <%= time_ago_in_words(@page.updated_at) %> ago</span>
  <% unless @page.locked? %>
    <% if @page_favorite.present? %>
      <%= button_to page_favorite_path(workspace_slug: @workspace.slug, page_id: @page.id),
                    method: :delete,
                    class: "notae-inline-icon-button notae-favorite-toggle is-favorited",
                    title: "Remove from favorites",
                    aria: { label: "Remove from favorites" } do %>
        ★
      <% end %>
    <% else %>
      <%= button_to page_favorite_path(workspace_slug: @workspace.slug, page_id: @page.id),
                    method: :post,
                    class: "notae-inline-icon-button notae-favorite-toggle",
                    title: "Add to favorites",
                    aria: { label: "Add to favorites" } do %>
        ☆
      <% end %>
    <% end %>
    <%= render "pages/comments_menu",
               workspace: @workspace,
               page: @page,
               can_comment_on_page: @can_comment_on_page,
               new_page_comment: @new_page_comment,
               page_comments: @page_comments %>
  <% end %>
  <%= render "pages/actions_menu",
             workspace: @workspace,
             page: @page,
             move_target_pages: @move_target_pages,
             can_manage_permissions: @can_manage_permissions,
             can_archive_page: @can_archive_page,
             page_plain_text: @page_plain_text,
             page_word_count: @page_word_count,
             page_versions: @page_versions,
             recent_audit_events: @recent_audit_events %>
  <% unless @page.locked? %>
    <%= render "pages/options_menu",
               workspace: @workspace,
               page: @page,
               can_manage_permissions: @can_manage_permissions,
               memberships: @memberships,
               shared_user_ids: @shared_user_ids,
               share_links: @share_links,
               page_exports: @page_exports,
               new_page_template: @new_page_template,
               page_templates: @page_templates,
               archived_blocks: @archived_blocks %>
  <% end %>
<% end %>

<% has_cover = @page.cover? %>
<% doc_layout_classes = [ "notae-doc-layout" ] %>
<% doc_layout_classes << "is-full-width" if @page.full_width? %>
<% doc_layout_classes << "is-small-text" if @page.small_text? %>
<% doc_layout_classes << "is-font-serif" if @page.font_style == "serif" %>
<% doc_layout_classes << "is-font-mono" if @page.font_style == "mono" %>
<% doc_layout_classes << "is-reader-mode" if @page_reader_mode %>
<% if has_cover %>
  <section class="notae-page-cover">
    <div class="notae-page-cover-frame">
      <% if @page.cover_image.attached? %>
        <%= image_tag @page.cover_image,
                      class: "notae-page-cover-image",
                      style: "object-position: center #{@page.cover_focal_y}%" %>
      <% elsif (cover_asset = page_cover_asset_path(@page.cover_preset_key)).present? %>
        <div class="notae-page-cover-preset"
             style="background-image: url('<%= asset_path(cover_asset) %>'); background-position: center <%= @page.cover_focal_y %>%;">
        </div>
      <% end %>

      <% if @can_update_page %>
        <div class="notae-page-cover-controls">
          <details class="notae-cover-picker">
            <summary class="notae-chip-button notae-cover-chip">Change</summary>
            <div class="notae-cover-picker-panel">
              <div class="notae-cover-picker-grid">
                <% Page::COVER_PRESET_KEYS.each do |preset_key| %>
                  <% preset_asset = page_cover_asset_path(preset_key) %>
                  <% next if preset_asset.blank? %>
                  <%= button_to page_path(workspace_slug: @workspace.slug, id: @page.id),
                                method: :patch,
                                params: { page: { cover_action: "preset", cover_preset_key: preset_key } },
                                class: [ "notae-cover-picker-tile-button", ("is-active" if @page.cover_preset_key == preset_key) ].compact.join(" "),
                                title: preset_key.humanize,
                                aria: { label: "Use #{preset_key.humanize} cover" } do %>
                    <span class="notae-cover-picker-tile"
                          style="background-image: url('<%= asset_path(preset_asset) %>');"></span>
                  <% end %>
                <% end %>
              </div>
              <div class="notae-cover-picker-quick-actions">
                <%= button_to "Random",
                              page_path(workspace_slug: @workspace.slug, id: @page.id),
                              method: :patch,
                              params: { page: { cover_action: "random" } },
                              class: "notae-cover-picker-action" %>
                <%= button_to "Remove",
                              page_path(workspace_slug: @workspace.slug, id: @page.id),
                              method: :patch,
                              params: { page: { cover_action: "clear" } },
                              class: "notae-cover-picker-action is-danger" %>
              </div>
              <%= form_with model: @page,
                            url: page_path(workspace_slug: @workspace.slug, id: @page.id),
                            method: :patch,
                            class: "notae-cover-picker-upload-form" do |form| %>
                <%= hidden_field_tag "page[cover_action]", "upload" %>
                <%= form.file_field :cover_image, accept: "image/*", class: "notae-cover-picker-upload-input" %>
                <%= form.submit "Upload", class: "notae-cover-picker-action" %>
              <% end %>
            </div>
          </details>
          <%= button_to "↑",
                        page_path(workspace_slug: @workspace.slug, id: @page.id),
                        method: :patch,
                        params: { page: { cover_shift: "up" } },
                        class: "notae-chip-button notae-cover-chip",
                        title: "Move cover up",
                        aria: { label: "Move cover up" } %>
          <%= button_to "↓",
                        page_path(workspace_slug: @workspace.slug, id: @page.id),
                        method: :patch,
                        params: { page: { cover_shift: "down" } },
                        class: "notae-chip-button notae-cover-chip",
                        title: "Move cover down",
                        aria: { label: "Move cover down" } %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>

<section class="<%= doc_layout_classes.join(" ") %>"
         data-controller="page-collaboration"
         data-page-collaboration-workspace-slug-value="<%= @workspace.slug %>"
         data-page-collaboration-page-id-value="<%= @page.id %>"
         data-page-collaboration-current-user-id-value="<%= current_user.id %>">

  <header class="notae-doc-header">
    <div class="notae-page-header-main">
      <% if @page.icon.present? %>
        <div class="notae-page-icon-display"><%= @page.icon %></div>
      <% end %>

      <% if !@page.locked? && (@can_update_page || @can_comment_on_page) %>
        <div class="notae-page-header-tools">
          <% if @can_update_page %>
            <details class="notae-page-header-action">
              <summary><span class="notae-page-header-action-icon">◌</span> <%= @page.icon.present? ? "Change icon" : "Add icon" %></summary>
              <div class="notae-page-header-panel">
                <%= form_with model: @page,
                              url: page_path(workspace_slug: @workspace.slug, id: @page.id),
                              method: :patch,
                              class: "notae-page-header-panel-form" do |form| %>
                  <%= hidden_field_tag "page[icon_action]", "set" %>
                  <%= form.text_field :icon,
                                      maxlength: 8,
                                      placeholder: "😀",
                                      class: "notae-options-input",
                                      value: @page.icon %>
                  <%= form.submit(@page.icon.present? ? "Update icon" : "Add icon", class: "notae-chip-button") %>
                <% end %>
                <div class="notae-page-emoji-grid">
                  <% Page::ICON_SUGGESTIONS.each do |emoji| %>
                    <%= button_to page_path(workspace_slug: @workspace.slug, id: @page.id),
                                  method: :patch,
                                  params: { page: { icon_action: "set", icon: emoji } },
                                  class: "notae-page-emoji-button",
                                  title: "Use #{emoji}" do %>
                      <%= emoji %>
                    <% end %>
                  <% end %>
                </div>
                <% if @page.icon.present? %>
                  <%= button_to "Remove icon",
                                page_path(workspace_slug: @workspace.slug, id: @page.id),
                                method: :patch,
                                params: { page: { icon_action: "clear" } },
                                class: "notae-page-header-link-button" %>
                <% end %>
              </div>
            </details>

            <details class="notae-page-header-action">
              <summary><span class="notae-page-header-action-icon">▭</span> <%= has_cover ? "Change cover" : "Add cover" %></summary>
              <div class="notae-page-header-panel">
                <div class="notae-page-cover-panel-actions">
                  <%= button_to "Random cover",
                                page_path(workspace_slug: @workspace.slug, id: @page.id),
                                method: :patch,
                                params: { page: { cover_action: "random" } },
                                class: "notae-chip-button" %>
                  <%= button_to "Move up",
                                page_path(workspace_slug: @workspace.slug, id: @page.id),
                                method: :patch,
                                params: { page: { cover_shift: "up" } },
                                class: "notae-chip-button" %>
                  <%= button_to "Move down",
                                page_path(workspace_slug: @workspace.slug, id: @page.id),
                                method: :patch,
                                params: { page: { cover_shift: "down" } },
                                class: "notae-chip-button" %>
                </div>
                <%= form_with model: @page,
                              url: page_path(workspace_slug: @workspace.slug, id: @page.id),
                              method: :patch,
                              class: "notae-page-header-panel-form" do |form| %>
                  <%= hidden_field_tag "page[cover_action]", "upload" %>
                  <%= form.file_field :cover_image, accept: "image/*", class: "notae-options-input" %>
                  <%= form.submit "Upload cover", class: "notae-chip-button" %>
                <% end %>
                <% if has_cover %>
                  <%= button_to "Remove cover",
                                page_path(workspace_slug: @workspace.slug, id: @page.id),
                                method: :patch,
                                params: { page: { cover_action: "clear" } },
                                class: "notae-page-header-link-button" %>
                <% end %>
              </div>
            </details>
          <% end %>

          <% if @can_comment_on_page %>
            <button type="button" class="notae-page-header-link" data-action="click->shell#openCommentsMenu">
              <span class="notae-page-header-action-icon">💬</span> Add comment
            </button>
          <% end %>
        </div>
      <% end %>

      <%= form_with model: @page,
                    url: page_path(workspace_slug: @workspace.slug, id: @page.id),
                    method: :patch,
                    class: "notae-page-title-form",
                    data: {
                      controller: "page-title",
                      page_title_url_value: page_path(workspace_slug: @workspace.slug, id: @page.id)
                    } do |form| %>
        <%= form.text_field :title,
                            placeholder: "New page",
                            class: "notae-page-title-input",
                            data: {
                              page_title_target: "input",
                              action: "input->page-title#queueSave blur->page-title#flushSave change->page-title#flushSave keydown.enter->page-title#preventSubmit"
                            },
                            aria: { label: "Page title" } %>
        <span class="notae-doc-muted" data-page-title-target="status" aria-live="polite">Saved</span>
      <% end %>
    </div>
  </header>

  <div class="notae-doc-canvas">
    <%= render partial: "pages/block_tree",
               locals: {
                 workspace: @workspace,
                 page: @page,
                 blocks_by_parent: @blocks_by_parent,
                 parent_id: nil,
                 all_pages: @move_target_pages,
                 reader_mode: @page_reader_mode
               } %>

    <% if !@page_reader_mode && policy(Block.new(workspace: @workspace, page: @page, created_by: current_user)).create? %>
      <%= form_with model: Block.new,
                    url: page_blocks_path(workspace_slug: @workspace.slug, page_id: @page.id),
                    class: "notae-doc-add-form" do |form| %>
        <%= form.hidden_field :parent_block_id %>
        <%= form.hidden_field :block_type, value: "paragraph" %>
        <%= form.submit "+ Add block", class: "notae-doc-add-button" %>
      <% end %>
    <% end %>
  </div>

  <section class="notae-doc-backlinks">
    <h2>Backlinks</h2>
    <% backlink_pages = @backlinks.map(&:source_page).uniq { |source_page| source_page.id } %>
    <% if backlink_pages.any? %>
      <ul>
        <% backlink_pages.each do |source_page| %>
          <li>
            <%= link_to source_page.title,
                        page_path(workspace_slug: @workspace.slug, id: source_page.id),
                        data: { backlink_source: source_page.id } %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p>No backlinks yet.</p>
    <% end %>
  </section>
</section>
