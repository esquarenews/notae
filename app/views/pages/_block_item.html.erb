<% reader_mode = local_assigns.fetch(:reader_mode, false) %>
<% embedded_page_params = local_assigns.fetch(:embedded_page_params, params[:embedded].to_s == "1" ? { embedded: "1" } : {}) %>
<% embedded_preview = embedded_page_params[:embedded].to_s == "1" || params[:embedded].to_s == "1" %>
<% linked_target_pages_by_id = local_assigns.fetch(:linked_target_pages_by_id, {}) %>
<% document_target_urls = local_assigns[:document_target_urls] || {} %>
<% turn_into_items = page_block_turn_into_items %>
<% turn_into_block_type_map = page_block_turn_into_block_type_map %>
<% color_items = page_block_color_items %>
<% highlight_items = page_block_highlight_items %>
<% is_embed_block = block.block_type == "embed" %>
<% is_gantt_embed_block = block.block_type == "gantt_embed" %>
<% is_graph_embed_block = block.block_type == "graph_embed" %>
<% is_media_block = %w[image video file].include?(block.block_type) %>
<% block_color = block.color.to_s %>
<% active_color = block_color.presence || "default" %>
<% block_highlight = block.highlight_color.to_s %>
<% active_highlight = block_highlight.presence || "default" %>
<% layout_columns_count = block.layout_columns_count %>
<% block_route_params = { workspace_slug: workspace.slug, page_id: page.id, id: block.id }.merge(embedded_page_params) %>
<% page_blocks_route_params = { workspace_slug: workspace.slug, page_id: page.id }.merge(embedded_page_params) %>
<% move_page_search_url = document_target_urls[:move_page_search_url] || workspace_document_targets_path(workspace_slug: workspace.slug, kind: "move_page", exclude_page_id: page.id) %>
<% note_search_url = document_target_urls[:note_search_url] || workspace_document_targets_path(workspace_slug: workspace.slug, kind: "note", exclude_page_id: page.id) %>
<% grid_search_url = document_target_urls[:grid_search_url] || workspace_document_targets_path(workspace_slug: workspace.slug, kind: "grid") %>
<% linked_target_page_id = Blocks::SplitLinkResolver.target_page_id(content_json: block.content_json) %>
<% linked_target_page =
     if linked_target_page_id.present? && linked_target_pages_by_id.any?
       linked_target_pages_by_id[linked_target_page_id.to_s]
     elsif linked_target_page_id.present?
       Blocks::SplitLinkResolver.target_page(content_json: block.content_json, workspace: workspace)
     end %>
<% linked_target_kind = if linked_target_page.present?
                          linked_target_page.linked_database.present? ? "Grid" : "Nota"
                        end %>
<% primary_link_command = linked_target_kind.present? ? "unlink_linked_document" : "create_linked_nota" %>
<% primary_link_label = linked_target_kind.present? ? "Unlink #{linked_target_kind}" : "Create linked Nota" %>
<% primary_link_icon = linked_target_kind.present? ? "⨯" : "↗" %>
<% primary_link_classes = [ "notae-block-menu-item" ] %>
<% primary_link_classes << "is-danger" if linked_target_kind.present? %>

<article id="block_<%= block.id %>"
         class="notae-doc-block is-type-<%= block.block_type.to_s.tr('_', '-') %> <%= "is-color-#{block_color}" if block_color.present? %> <%= "is-highlight-#{block_highlight}" if block_highlight.present? %> <%= "is-columns" if block.block_type.start_with?("columns_") %> <%= "is-layout-columns-#{layout_columns_count}" if layout_columns_count.present? %>"
         data-block-list-target="item"
         data-action="dragenter->block-list#handleDragEnter dragleave->block-list#handleDragLeave dragover->block-list#handleDragOver drop->block-list#handleDrop"
         data-block-id="<%= block.id %>"
         data-block-index="<%= index %>"
         data-controller="block-tools"
         data-block-tools-block-id-value="<%= block.id %>"
         data-block-tools-page-title-value="<%= page.title %>"
         data-block-tools-block-text-value="<%= block.search_text %>">
  <% unless reader_mode || embedded_preview %>
    <div class="notae-doc-block-row">
      <span class="notae-doc-handle"
            title="Drag block"
            draggable="true"
            data-action="pointerdown->block-list#prepareDragStart dragstart->block-list#handleDragStart dragend->block-list#handleDragEnd">
        ⋮⋮
      </span>
      <p class="hidden pb-1 text-xs font-medium text-sky-700" data-editing-indicator-for="<%= block.id %>"></p>
      <details class="notae-block-menu" data-action="toggle->block-tools#positionMenu">
        <summary class="notae-block-menu-trigger" aria-label="Block options">⋯</summary>
        <div class="notae-block-menu-panel">
        <section class="notae-block-menu-section">
          <h4>Turn into</h4>
          <div class="notae-block-menu-grid">
            <% turn_into_items.each do |icon, label, key| %>
              <% turn_into_classes = ["notae-block-menu-item"] %>
              <% turn_into_classes << "is-active" if turn_into_block_type_map[key] == block.block_type || (is_media_block && layout_columns_count == key.split("_").last.to_i) %>
              <%= button_to command_page_block_path(block_route_params),
                            method: :post,
                            params: { block_command: { command: "turn_into", target: key } },
                            form: { class: "notae-block-menu-inline-form", data: { turbo_stream: true } },
                            class: turn_into_classes.join(" ") do %>
                <span class="notae-menu-item-icon"><%= icon %></span>
                <span class="notae-menu-item-label"><%= label %></span>
              <% end %>
            <% end %>
          </div>
        </section>

        <section class="notae-block-menu-section">
          <h4>Color</h4>
          <div class="notae-block-menu-grid is-color-grid">
            <% color_items.each do |label, key| %>
              <% color_classes = ["notae-block-menu-item"] %>
              <% color_classes << "is-active" if key == active_color %>
              <%= button_to command_page_block_path(block_route_params),
                            method: :post,
                            params: { block_command: { command: "color", color: key } },
                            form: { class: "notae-block-menu-inline-form", data: { turbo_stream: true } },
                            class: color_classes.join(" ") do %>
                <span class="notae-menu-color-dot is-<%= key %>"></span>
                <span class="notae-menu-item-label"><%= label %></span>
              <% end %>
            <% end %>
          </div>
        </section>

        <section class="notae-block-menu-section">
          <h4>Highlight</h4>
          <div class="notae-block-menu-grid is-color-grid">
            <% highlight_items.each do |label, key| %>
              <% highlight_classes = ["notae-block-menu-item"] %>
              <% highlight_classes << "is-active" if key == active_highlight %>
              <%= button_to command_page_block_path(block_route_params),
                            method: :post,
                            params: { block_command: { command: "highlight", highlight: key } },
                            form: { class: "notae-block-menu-inline-form", data: { turbo_stream: true } },
                            class: highlight_classes.join(" ") do %>
                <span class="notae-menu-highlight-swatch is-<%= key %>"></span>
                <span class="notae-menu-item-label"><%= label %></span>
              <% end %>
            <% end %>
          </div>
        </section>

        <section class="notae-block-menu-section">
          <h4>Actions</h4>
          <div class="notae-block-menu-grid">
            <%= button_to command_page_block_path(block_route_params),
                          method: :post,
                          params: { block_command: { command: "add_block_above" } },
                          form_class: "notae-block-menu-inline-form",
                          class: "notae-block-menu-item" do %>
              <span class="notae-menu-item-icon">↑</span>
              <span class="notae-menu-item-label">Add block above</span>
            <% end %>
            <%= button_to command_page_block_path(block_route_params),
                          method: :post,
                          params: { block_command: { command: "add_block_below" } },
                          form_class: "notae-block-menu-inline-form",
                          class: "notae-block-menu-item" do %>
              <span class="notae-menu-item-icon">↓</span>
              <span class="notae-menu-item-label">Add block below</span>
            <% end %>
            <button type="button" class="notae-block-menu-item" data-action="block-tools#indent">
              <span class="notae-menu-item-icon">→</span>
              <span class="notae-menu-item-label">Indent</span>
            </button>
            <button type="button" class="notae-block-menu-item" data-action="block-tools#outdent">
              <span class="notae-menu-item-icon">←</span>
              <span class="notae-menu-item-label">Outdent</span>
            </button>
            <button type="button" class="notae-block-menu-item" data-action="block-tools#copyLink">
              <span class="notae-menu-item-icon">#</span>
              <span class="notae-menu-item-label">Copy link to block</span>
            </button>
            <%= button_to command_page_block_path(block_route_params),
                          method: :post,
                          params: { block_command: { command: "duplicate" } },
                          form_class: "notae-block-menu-inline-form",
                          class: "notae-block-menu-item" do %>
              <span class="notae-menu-item-icon">+</span>
              <span class="notae-menu-item-label">Duplicate</span>
            <% end %>
            <%= form_with url: command_page_block_path(block_route_params),
                          method: :post,
                          class: "notae-block-menu-picker-form notae-block-menu-picker-form-full-width",
                          data: {
                            controller: "document-picker",
                            document_picker_search_url_value: move_page_search_url,
                            document_picker_empty_text_value: "No matching pages."
                          } do %>
              <%= hidden_field_tag "block_command[command]", "move_to" %>
              <%= hidden_field_tag "block_command[target_page_id]", "", data: { document_picker_target: "hiddenInput" } %>
              <%= button_tag type: "button",
                             class: "notae-block-menu-item",
                             data: { action: "block-tools#togglePicker" } do %>
                <span class="notae-menu-item-icon">></span>
                <span class="notae-menu-item-label">Move to</span>
              <% end %>
              <div class="notae-block-menu-picker" hidden>
                <%= search_field_tag :block_move_page_search,
                                     "",
                                     placeholder: "Search pages",
                                     autocomplete: "off",
                                     class: "notae-block-menu-select",
                                     data: {
                                       document_picker_target: "searchInput",
                                       action: "focus->document-picker#ensureLoaded input->document-picker#queueSearch search->document-picker#queueSearch"
                                     } %>
                <p class="notae-document-picker-loading" hidden data-document-picker-target="loading">Searching…</p>
                <div class="notae-document-picker-results" data-document-picker-target="results"></div>
                <p class="notae-options-empty" hidden data-document-picker-target="emptyState">No matching pages.</p>
              </div>
            <% end %>
            <% note_picker_form_id = "block-link-existing-nota-#{block.id}" %>
            <% grid_picker_form_id = "block-link-existing-grid-#{block.id}" %>
            <div class="notae-block-menu-picker-row"
                 data-controller="document-picker"
                 data-document-picker-search-url-value="<%= note_search_url %>"
                 data-document-picker-empty-text-value="No matching notas.">
              <%= button_to command_page_block_path(block_route_params),
                            method: :post,
                            params: { block_command: { command: primary_link_command } },
                            form_class: "notae-block-menu-inline-form",
                            class: primary_link_classes.join(" ") do %>
                <span class="notae-menu-item-icon"><%= primary_link_icon %></span>
                <span class="notae-menu-item-label"><%= primary_link_label %></span>
              <% end %>
              <%= form_with url: command_page_block_path(block_route_params),
                            method: :post,
                            id: note_picker_form_id,
                            class: "notae-block-menu-picker-form" do %>
                <%= hidden_field_tag "block_command[command]", "link_existing_nota" %>
                <%= hidden_field_tag "block_command[target_page_id]", "", data: { document_picker_target: "hiddenInput" } %>
                <%= button_tag type: "button",
                               class: "notae-block-menu-item",
                               data: { action: "block-tools#togglePicker" } do %>
                  <span class="notae-menu-item-icon">🔗</span>
                  <span class="notae-menu-item-label">Link existing Nota</span>
                <% end %>
              <% end %>
              <div class="notae-block-menu-picker" hidden>
                <%= search_field_tag :block_link_note_search,
                                     "",
                                     placeholder: "Search notas",
                                     autocomplete: "off",
                                     class: "notae-block-menu-select",
                                     data: {
                                       document_picker_target: "searchInput",
                                       action: "focus->document-picker#ensureLoaded input->document-picker#queueSearch search->document-picker#queueSearch"
                                     } %>
                <p class="notae-document-picker-loading" hidden data-document-picker-target="loading">Searching…</p>
                <div class="notae-document-picker-results" data-document-picker-target="results"></div>
                <p class="notae-options-empty" hidden data-document-picker-target="emptyState">No matching notas.</p>
              </div>
            </div>
            <div class="notae-block-menu-picker-row"
                 data-controller="document-picker"
                 data-document-picker-search-url-value="<%= grid_search_url %>"
                 data-document-picker-empty-text-value="No matching grids.">
              <%= button_to command_page_block_path(block_route_params),
                            method: :post,
                            params: { block_command: { command: "create_linked_grid" } },
                            form_class: "notae-block-menu-inline-form",
                            class: "notae-block-menu-item" do %>
                <span class="notae-menu-item-icon">⊞</span>
                <span class="notae-menu-item-label">Create linked Grid</span>
              <% end %>
              <%= form_with url: command_page_block_path(block_route_params),
                            method: :post,
                            id: grid_picker_form_id,
                            class: "notae-block-menu-picker-form" do %>
                <%= hidden_field_tag "block_command[command]", "link_existing_grid" %>
                <%= hidden_field_tag "block_command[target_database_id]", "", data: { document_picker_target: "hiddenInput" } %>
                <%= button_tag type: "button",
                               class: "notae-block-menu-item",
                               data: { action: "block-tools#togglePicker" } do %>
                  <span class="notae-menu-item-icon">⊡</span>
                  <span class="notae-menu-item-label">Link existing Grid</span>
                <% end %>
              <% end %>
              <div class="notae-block-menu-picker" hidden>
                <%= search_field_tag :block_link_grid_search,
                                     "",
                                     placeholder: "Search grids",
                                     autocomplete: "off",
                                     class: "notae-block-menu-select",
                                     data: {
                                       document_picker_target: "searchInput",
                                       action: "focus->document-picker#ensureLoaded input->document-picker#queueSearch search->document-picker#queueSearch"
                                     } %>
                <p class="notae-document-picker-loading" hidden data-document-picker-target="loading">Searching…</p>
                <div class="notae-document-picker-results" data-document-picker-target="results"></div>
                <p class="notae-options-empty" hidden data-document-picker-target="emptyState">No matching grids.</p>
              </div>
            </div>
            <%= button_to command_page_block_path(block_route_params),
                          method: :post,
                          params: { block_command: { command: "delete" } },
                          form_class: "notae-block-menu-inline-form",
                          class: "notae-block-menu-item is-danger" do %>
              <span class="notae-menu-item-icon">x</span>
              <span class="notae-menu-item-label">Delete</span>
            <% end %>
            <button type="button" class="notae-block-menu-item" data-action="block-tools#suggestEdits">
              <span class="notae-menu-item-icon">~</span>
              <span class="notae-menu-item-label">Suggest edits</span>
            </button>
            <button type="button"
                    class="notae-block-menu-item"
                    data-prompt-template="Improve this block on <%= page.title %>."
                    data-action="block-tools#askAi">
              <span class="notae-menu-item-icon">*</span>
              <span class="notae-menu-item-label">Ask AI</span>
            </button>
            <%= button_to command_page_block_path(block_route_params),
                          method: :post,
                          params: { block_command: { command: "insert_media", target: "media" } },
                          form_class: "notae-block-menu-inline-form",
                          class: "notae-block-menu-item" do %>
              <span class="notae-menu-item-icon">Md</span>
              <span class="notae-menu-item-label">Add media</span>
            <% end %>
          </div>
        </section>
        </div>
      </details>
    </div>
  <% end %>

  <% if is_embed_block %>
    <div class="notae-doc-embed">
      <%= form_with model: block,
                    url: page_block_path(block_route_params),
                    method: :patch,
                    class: "notae-doc-inline-form" do |form| %>
        <%= form.url_field :embed_url, placeholder: "https://www.youtube.com/embed/...", class: "notae-doc-input" %>
        <%= form.submit "Save", class: "notae-chip-button" %>
      <% end %>
      <% if block.embed_url.present? %>
        <iframe src="<%= block.embed_url %>" class="notae-doc-embed-frame" loading="lazy" allowfullscreen></iframe>
      <% else %>
        <p class="notae-doc-muted">Allowed embed domains: youtube, vimeo, figma, loom.</p>
      <% end %>
    </div>
  <% elsif is_gantt_embed_block %>
    <div class="notae-doc-gantt-embed">
      <% if block.gantt_database_id.present? %>
        <iframe src="<%= gantt_embed_database_path(workspace_slug: block.gantt_workspace_slug || workspace.slug, id: block.gantt_database_id, view_id: block.gantt_view_id.presence) %>"
                class="notae-doc-gantt-embed-frame"
                loading="lazy"
                title="Embedded Gantt chart"></iframe>
      <% else %>
        <p class="notae-doc-muted">Copy a Gantt chart from a grid to embed it here.</p>
      <% end %>
    </div>
  <% elsif is_graph_embed_block %>
    <div class="notae-doc-graph-embed">
      <% if block.graph_database_id.present? %>
        <iframe src="<%= graph_embed_database_path(workspace_slug: block.graph_workspace_slug || workspace.slug, id: block.graph_database_id, view_id: block.graph_view_id.presence) %>"
                class="notae-doc-graph-embed-frame"
                loading="lazy"
                title="Embedded graph"></iframe>
      <% else %>
        <p class="notae-doc-muted">Copy a graph from a grid to embed it here.</p>
      <% end %>
    </div>
  <% elsif is_media_block %>
    <%= render partial: "pages/block_media",
               locals: {
                 workspace: workspace,
                 page: page,
                 block: block,
                 embedded_page_params: embedded_page_params
               } %>
  <% else %>
    <div data-controller="block-editor"
         data-block-editor-url-value="<%= page_block_path(block_route_params) %>"
         data-block-editor-create-url-value="<%= page_blocks_path(page_blocks_route_params) %>"
         data-block-editor-initial-json-value="<%= block.content_json.to_json %>"
         data-block-editor-block-type-value="<%= block.block_type %>"
         data-block-editor-block-id-value="<%= block.id %>">
      <div data-block-editor-target="editor"
           class="notae-doc-editor is-<%= block.block_type.to_s.tr('_', '-') %> <%= "is-color-#{block_color}" if block_color.present? %> <%= "is-highlight-#{block_highlight}" if block_highlight.present? %>">
      </div>
    </div>
  <% end %>

  <div class="notae-doc-children">
    <%= render partial: "pages/block_tree",
               locals: {
                 workspace: workspace,
                 page: page,
                 blocks_by_parent: blocks_by_parent,
                 linked_target_pages_by_id: linked_target_pages_by_id,
                 document_target_urls: document_target_urls,
                 parent_id: block.id,
                 reader_mode: reader_mode,
                 embedded_page_params: embedded_page_params
               } %>

  </div>
</article>
