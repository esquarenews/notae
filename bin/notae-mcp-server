#!/bin/sh

set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
launcher="$script_dir/../services/notae_mcp_server/launcher.mjs"

if [ -n "${NOTAE_NODE_BINARY:-}" ] && [ -x "$NOTAE_NODE_BINARY" ]; then
  node_binary="$NOTAE_NODE_BINARY"
elif command -v node >/dev/null 2>&1; then
  node_binary=$(command -v node)
elif [ -x /opt/homebrew/bin/node ]; then
  node_binary=/opt/homebrew/bin/node
elif [ -x /usr/local/bin/node ]; then
  node_binary=/usr/local/bin/node
else
  echo "Notae MCP could not find Node.js. Install Node or set NOTAE_NODE_BINARY to an executable path." >&2
  exit 127
fi

exec "$node_binary" "$launcher"
